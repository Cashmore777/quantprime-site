// VORTEX INPUTS
check_1_digit = input.bool(true,  "Check last 1 digit",                       group="Vortex — Core")
check_2_digit = input.bool(true,  "Check sum of last 2 digits (digital root)", group="Vortex — Core")
check_3_digit = input.bool(true, "Check sum of last 3 digits (digital root)", group="Vortex — Core")
check_4_digit = input.bool(true, "Check sum of last 4 digits (digital root)", group="Vortex — Core")
check_5_digit = input.bool(false, "Check sum of last 5 digits (digital root)", group="Vortex — Core")
check_6_digit = input.bool(false, "Check sum of last 6 digits (digital root)", group="Vortex — Core")
mark_highs = input.bool(true, "Mark highs", group="Vortex — Core")
mark_lows  = input.bool(true, "Mark lows",  group="Vortex — Core")
enable_t0_p1 = input.bool(true, "3", group="Vortex — Enable T=0 (3,6,9)", inline="t0")
enable_t0_p2 = input.bool(true, "6", group="Vortex — Enable T=0 (3,6,9)", inline="t0")
enable_t0_p3 = input.bool(true, "9", group="Vortex — Enable T=0 (3,6,9)", inline="t0")
enable_t1_p1 = input.bool(true, "1", group="Vortex — Enable T=1 (1,4,7)", inline="t1")
enable_t1_p2 = input.bool(true, "4", group="Vortex — Enable T=1 (1,4,7)", inline="t1")
enable_t1_p3 = input.bool(true, "7", group="Vortex — Enable T=1 (1,4,7)", inline="t1")
enable_t2_p1 = input.bool(true, "2", group="Vortex — Enable T=2 (2,5,8)", inline="t2")
enable_t2_p2 = input.bool(true, "5", group="Vortex — Enable T=2 (2,5,8)", inline="t2")
enable_t2_p3 = input.bool(true, "8", group="Vortex — Enable T=2 (2,5,8)", inline="t2")

// ═══════════════════════════════════════════════════════════════
// VORTEX HELPERS
// ═══════════════════════════════════════════════════════════════
string TZ = "UTC-4"

get_last_decimals(float price, int digits) =>
    str_price = str.tostring(price, format.mintick)
    parts = str.split(str_price, ".")
    string result = ""
    if array.size(parts) > 1
        decimals = array.get(parts, 1)
        len = str.length(decimals)
        result := len >= digits ? str.substring(decimals, len - digits, len) : decimals
    result

get_last_full_digits(float price, int digits) =>
    s = str.tostring(price, format.mintick)
    s := str.replace_all(s, ".", "")
    s := str.replace_all(s, ",", "")
    len = str.length(s)
    len >= digits ? str.substring(s, len - digits, len) : s

get_digital_root(int num) =>
    int result = num
    while result > 9
        int sum  = 0
        int temp = result
        while temp > 0
            sum  += (temp % 10)
            temp := int(temp / 10)
        result := sum
    result

check_digit_vortex(float price, int target, int N) =>
    s  = get_last_full_digits(price, N)
    ok = false
    if str.length(s) == N
        sumN = 0
        for i = 0 to N - 1
            d = str.tonumber(str.substring(s, i, i + 1))
            if na(d)
                break
            sumN += int(d)
        dr = get_digital_root(sumN)
        ok := dr == target
    ok

check_price_condition(float price, int target) =>
    bool matched = false
    if check_1_digit
        one = get_last_decimals(price, 1)
        lf  = str.tonumber(one)
        if not na(lf) and int(lf) == target
            matched := true
    if not matched and check_2_digit and check_digit_vortex(price, target, 2)
        matched := true
    if not matched and check_3_digit and check_digit_vortex(price, target, 3)
        matched := true
    if not matched and check_4_digit and check_digit_vortex(price, target, 4)
        matched := true
    if not matched and check_5_digit and check_digit_vortex(price, target, 5)
        matched := true
    if not matched and check_6_digit and check_digit_vortex(price, target, 6)
        matched := true
    matched

vortex_matches(float price, int bar_hour) =>
    bool is_t0 = bar_hour == 0  or bar_hour == 3  or bar_hour == 6  or
                 bar_hour == 9  or bar_hour == 12 or bar_hour == 15 or
                 bar_hour == 18 or bar_hour == 21
    bool is_t1 = bar_hour == 1  or bar_hour == 4  or bar_hour == 7  or
                 bar_hour == 10 or bar_hour == 13 or bar_hour == 16 or
                 bar_hour == 19 or bar_hour == 22
    bool is_t2 = bar_hour == 2  or bar_hour == 5  or bar_hour == 8  or
                 bar_hour == 11 or bar_hour == 14 or bar_hour == 17 or
                 bar_hour == 20 or bar_hour == 23
    bool hit = false
    if is_t0
        if enable_t0_p1 and check_price_condition(price, 3)
            hit := true
        if enable_t0_p2 and check_price_condition(price, 6)
            hit := true
        if enable_t0_p3 and check_price_condition(price, 9)
            hit := true
    if is_t1
        if enable_t1_p1 and check_price_condition(price, 1)
            hit := true
        if enable_t1_p2 and check_price_condition(price, 4)
            hit := true
        if enable_t1_p3 and check_price_condition(price, 7)
            hit := true
    if is_t2
        if enable_t2_p1 and check_price_condition(price, 2)
            hit := true
        if enable_t2_p2 and check_price_condition(price, 5)
            hit := true
        if enable_t2_p3 and check_price_condition(price, 8)
            hit := true
    hit


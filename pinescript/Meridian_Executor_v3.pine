var bool  amd6h_m_done   = false
var bool  amd6h_armed_hi_this_cycle = false
var bool  amd6h_armed_lo_this_cycle = false
var AmdLine[] amd6h_hi_lines = array.new<AmdLine>()
var AmdLine[] amd6h_lo_lines = array.new<AmdLine>()
var AmdLine amd6h_cur_hi_ln = na
var AmdLine amd6h_cur_lo_ln = na

var int   amd3h_cyc_start = na
var float amd3h_a_hi     = na
var float amd3h_a_lo     = na
var float amd3h_m_hi     = na
var float amd3h_m_lo     = na
var float amd3h_d_hi     = na
var float amd3h_d_lo     = na
var bool  amd3h_a_done   = false
var bool  amd3h_m_done   = false
var bool  amd3h_armed_hi_this_cycle = false
var bool  amd3h_armed_lo_this_cycle = false
var AmdLine[] amd3h_hi_lines = array.new<AmdLine>()
var AmdLine[] amd3h_lo_lines = array.new<AmdLine>()
var AmdLine amd3h_cur_hi_ln = na
var AmdLine amd3h_cur_lo_ln = na

var int  amd_liq_bias_eng           = 0
var bool amd_sweep_signal_fired_eng = false

// ═══════════════════════════════════════════════════════════════
// AMD PHASE FUNCTIONS
// ═══════════════════════════════════════════════════════════════
f_amd_cycle_start(int t, float cycle_hours) =>
    int yy = year(t, amd_tz)
    int mm = month(t, amd_tz)
    int dd = dayofmonth(t, amd_tz)
    float hr = hour(t, amd_tz) + minute(t, amd_tz) / 60.0
    int cycle_index = int(math.floor(hr / cycle_hours))
    float cycle_start_hr = cycle_index * cycle_hours
    int midnight = timestamp(amd_tz, yy, mm, dd, 0, 0)
    midnight + math.round(cycle_start_hr * 3600000)

f_amd_phase(int t, float cycle_hours) =>
    int cyc_start = f_amd_cycle_start(t, cycle_hours)
    int a_end_t   = cyc_start + math.round(cycle_hours * 0.5 * 3600000)
    int m_end_t   = cyc_start + math.round(cycle_hours * 0.75 * 3600000)
    int cyc_end_t = cyc_start + math.round(cycle_hours * 1.0 * 3600000)
    string phase = t < a_end_t ? "A" : t < m_end_t ? "M" : "D"
    [cyc_start, a_end_t, m_end_t, cyc_end_t, phase]

// ═══════════════════════════════════════════════════════════════
// POSITION TRACKING
// ═══════════════════════════════════════════════════════════════
type GoldTrade
    int    entry_bar
    int    entry_time
    float  entry_price
    bool   is_long
    float  sl_price
    bool   is_open
    int    close_bar
    float  close_price
    string close_reason
    box    tp_box
    box    sl_box
    line   pnl_line
    label  info_lbl

var GoldTrade[] trades = array.new<GoldTrade>()
var int   gold_n = 0
var float gold_sl_price = na
var bool  gold_is_long = false

// ═══════════════════════════════════════════════════════════════
// AMD ENGINE
// ═══════════════════════════════════════════════════════════════
if barstate.isconfirmed
    // --- 12 HOUR ---
    if amd_on and amd_12h_on
        [c12_start, c12_a_end, c12_m_end, c12_end, c12_phase] = f_amd_phase(time, 24.0)
        if na(amd12h_cyc_start) or c12_start != amd12h_cyc_start
            amd12h_cyc_start := c12_start
            amd12h_a_hi      := high
            amd12h_a_lo      := low
            amd12h_m_hi      := na
            amd12h_m_lo      := na
            amd12h_d_hi      := na
            amd12h_d_lo      := na
            amd12h_a_done    := false
            amd12h_m_done    := false
            amd12h_armed_hi_this_cycle := false
            amd12h_armed_lo_this_cycle := false
            new_hi_ln = AmdLine.new(high, line.new(c12_start, high, time, high, xloc=xloc.bar_time,
                 color=amd_12h_line_col, width=amd_12h_line_width))
            array.push(amd12h_hi_lines, new_hi_ln)
            amd12h_cur_hi_ln := new_hi_ln
            new_lo_ln = AmdLine.new(low, line.new(c12_start, low, time, low, xloc=xloc.bar_time,
                 color=amd_12h_line_col, width=amd_12h_line_width))
            array.push(amd12h_lo_lines, new_lo_ln)
            amd12h_cur_lo_ln := new_lo_ln

        if c12_phase == "A"
            amd12h_a_hi := math.max(amd12h_a_hi, high)
            amd12h_a_lo := math.min(amd12h_a_lo, low)
            amd12h_cur_hi_ln.price := amd12h_a_hi
            line.set_y1(amd12h_cur_hi_ln.ln, amd12h_a_hi)
            line.set_y2(amd12h_cur_hi_ln.ln, amd12h_a_hi)
            amd12h_cur_lo_ln.price := amd12h_a_lo
            line.set_y1(amd12h_cur_lo_ln.ln, amd12h_a_lo)
            line.set_y2(amd12h_cur_lo_ln.ln, amd12h_a_lo)
        else
            amd12h_a_done := true

        if c12_phase == "M"
            amd12h_m_hi := na(amd12h_m_hi) ? high : math.max(amd12h_m_hi, high)
            amd12h_m_lo := na(amd12h_m_lo) ? low  : math.min(amd12h_m_lo, low)
        else if not na(amd12h_m_hi)
            amd12h_m_done := true

        if c12_phase == "D"
            amd12h_d_hi := na(amd12h_d_hi) ? high : math.max(amd12h_d_hi, high)
            amd12h_d_lo := na(amd12h_d_lo) ? low  : math.min(amd12h_d_lo, low)

        int hi12_sz = array.size(amd12h_hi_lines)
        if hi12_sz > 0
            for hi12i = hi12_sz - 1 to 0
                hln = array.get(amd12h_hi_lines, hi12i)
                if high > hln.price
                    line.delete(hln.ln)
                    array.remove(amd12h_hi_lines, hi12i)
                    amd_liq_bias_eng           := -1
                    amd_sweep_signal_fired_eng := false
                else
                    line.set_x2(hln.ln, time)
        int lo12_sz = array.size(amd12h_lo_lines)
        if lo12_sz > 0
            for lo12i = lo12_sz - 1 to 0
                lln = array.get(amd12h_lo_lines, lo12i)
                if low < lln.price
                    line.delete(lln.ln)
                    array.remove(amd12h_lo_lines, lo12i)
                    amd_liq_bias_eng           := 1
                    amd_sweep_signal_fired_eng := false
                else
                    line.set_x2(lln.ln, time)

    // --- 6 HOUR ---
    if amd_on and amd_6h_on
        [c6_start, c6_a_end, c6_m_end, c6_end, c6_phase] = f_amd_phase(time, 12.0)
        if na(amd6h_cyc_start) or c6_start != amd6h_cyc_start
            amd6h_cyc_start := c6_start
            amd6h_a_hi      := high
            amd6h_a_lo      := low
            amd6h_m_hi      := na
            amd6h_m_lo      := na
            amd6h_d_hi      := na
            amd6h_d_lo      := na
            amd6h_a_done    := false
            amd6h_m_done    := false
            amd6h_armed_hi_this_cycle := false
            amd6h_armed_lo_this_cycle := false
            new_hi_ln6 = AmdLine.new(high, line.new(c6_start, high, time, high, xloc=xloc.bar_time,
                 color=amd_6h_line_col, width=amd_6h_line_width))
            array.push(amd6h_hi_lines, new_hi_ln6)
            amd6h_cur_hi_ln := new_hi_ln6
            new_lo_ln6 = AmdLine.new(low, line.new(c6_start, low, time, low, xloc=xloc.bar_time,
                 color=amd_6h_line_col, width=amd_6h_line_width))
            array.push(amd6h_lo_lines, new_lo_ln6)
            amd6h_cur_lo_ln := new_lo_ln6

        if c6_phase == "A"
            amd6h_a_hi := math.max(amd6h_a_hi, high)
            amd6h_a_lo := math.min(amd6h_a_lo, low)
            amd6h_cur_hi_ln.price := amd6h_a_hi
            line.set_y1(amd6h_cur_hi_ln.ln, amd6h_a_hi)
            line.set_y2(amd6h_cur_hi_ln.ln, amd6h_a_hi)
            amd6h_cur_lo_ln.price := amd6h_a_lo
            line.set_y1(amd6h_cur_lo_ln.ln, amd6h_a_lo)
            line.set_y2(amd6h_cur_lo_ln.ln, amd6h_a_lo)
        else
            amd6h_a_done := true

        if c6_phase == "M"
            amd6h_m_hi := na(amd6h_m_hi) ? high : math.max(amd6h_m_hi, high)
            amd6h_m_lo := na(amd6h_m_lo) ? low  : math.min(amd6h_m_lo, low)
        else if not na(amd6h_m_hi)
            amd6h_m_done := true

        if c6_phase == "D"
            amd6h_d_hi := na(amd6h_d_hi) ? high : math.max(amd6h_d_hi, high)
            amd6h_d_lo := na(amd6h_d_lo) ? low  : math.min(amd6h_d_lo, low)

        int hi6_sz = array.size(amd6h_hi_lines)
        if hi6_sz > 0
            for hi6i = hi6_sz - 1 to 0
                hln6 = array.get(amd6h_hi_lines, hi6i)
                if high > hln6.price
                    line.delete(hln6.ln)
                    array.remove(amd6h_hi_lines, hi6i)
                    amd_liq_bias_eng           := -1
                    amd_sweep_signal_fired_eng := false
                else
                    line.set_x2(hln6.ln, time)
        int lo6_sz = array.size(amd6h_lo_lines)
        if lo6_sz > 0
            for lo6i = lo6_sz - 1 to 0
                lln6 = array.get(amd6h_lo_lines, lo6i)
                if low < lln6.price
                    line.delete(lln6.ln)
                    array.remove(amd6h_lo_lines, lo6i)
                    amd_liq_bias_eng           := 1
                    amd_sweep_signal_fired_eng := false
                else
                    line.set_x2(lln6.ln, time)

    // --- 3 HOUR ---
    if amd_on and amd_3h_on
        [c3_start, c3_a_end, c3_m_end, c3_end, c3_phase] = f_amd_phase(time, 6.0)
        if na(amd3h_cyc_start) or c3_start != amd3h_cyc_start
            amd3h_cyc_start := c3_start
            amd3h_a_hi      := high
            amd3h_a_lo      := low
            amd3h_m_hi      := na
            amd3h_m_lo      := na
            amd3h_d_hi      := na
            amd3h_d_lo      := na
            amd3h_a_done    := false
            amd3h_m_done    := false
            amd3h_armed_hi_this_cycle := false
            amd3h_armed_lo_this_cycle := false
            new_hi_ln3 = AmdLine.new(high, line.new(c3_start, high, time, high, xloc=xloc.bar_time,
                 color=amd_3h_line_col, width=amd_3h_line_width))
            array.push(amd3h_hi_lines, new_hi_ln3)
            amd3h_cur_hi_ln := new_hi_ln3
            new_lo_ln3 = AmdLine.new(low, line.new(c3_start, low, time, low, xloc=xloc.bar_time,
                 color=amd_3h_line_col, width=amd_3h_line_width))
            array.push(amd3h_lo_lines, new_lo_ln3)
            amd3h_cur_lo_ln := new_lo_ln3

        if c3_phase == "A"
            amd3h_a_hi := math.max(amd3h_a_hi, high)
            amd3h_a_lo := math.min(amd3h_a_lo, low)
            amd3h_cur_hi_ln.price := amd3h_a_hi
            line.set_y1(amd3h_cur_hi_ln.ln, amd3h_a_hi)
            line.set_y2(amd3h_cur_hi_ln.ln, amd3h_a_hi)
            amd3h_cur_lo_ln.price := amd3h_a_lo
            line.set_y1(amd3h_cur_lo_ln.ln, amd3h_a_lo)
            line.set_y2(amd3h_cur_lo_ln.ln, amd3h_a_lo)
        else
            amd3h_a_done := true

        if c3_phase == "M"
            amd3h_m_hi := na(amd3h_m_hi) ? high : math.max(amd3h_m_hi, high)
            amd3h_m_lo := na(amd3h_m_lo) ? low  : math.min(amd3h_m_lo, low)
        else if not na(amd3h_m_hi)
            amd3h_m_done := true

        if c3_phase == "D"
            amd3h_d_hi := na(amd3h_d_hi) ? high : math.max(amd3h_d_hi, high)
            amd3h_d_lo := na(amd3h_d_lo) ? low  : math.min(amd3h_d_lo, low)

        int hi3_sz = array.size(amd3h_hi_lines)
        if hi3_sz > 0
            for hi3i = hi3_sz - 1 to 0
                hln3 = array.get(amd3h_hi_lines, hi3i)
                if high > hln3.price
                    line.delete(hln3.ln)
                    array.remove(amd3h_hi_lines, hi3i)
                    amd_liq_bias_eng           := -1
                    amd_sweep_signal_fired_eng := false
                else
                    line.set_x2(hln3.ln, time)
        int lo3_sz = array.size(amd3h_lo_lines)
        if lo3_sz > 0
            for lo3i = lo3_sz - 1 to 0
                lln3 = array.get(amd3h_lo_lines, lo3i)
                if low < lln3.price
                    line.delete(lln3.ln)
                    array.remove(amd3h_lo_lines, lo3i)
                    amd_liq_bias_eng           := 1
                    amd_sweep_signal_fired_eng := false
                else
                    line.set_x2(lln3.ln, time)

    // SL check on all open trades
    if use_tight_sl
        int _ssz = array.size(trades)
        if _ssz > 0
            for _si = 0 to _ssz - 1
                GoldTrade _st = array.get(trades, _si)
                if _st.is_open and not na(_st.sl_price)
                    bool _hit = _st.is_long ? low <= _st.sl_price : high >= _st.sl_price
                    if _hit
                        _st.is_open := false
                        _st.close_bar := bar_index
                        _st.close_price := _st.sl_price
                        _st.close_reason := "SL"
                        if executor_on
                            string _ds = _st.is_long ? "LONG" : "SHORT"
                            float _pips = (_st.is_long ? _st.sl_price - _st.entry_price : _st.entry_price - _st.sl_price) / pip_size
                            alert(f_ex_close("SL_HIT", _ds, _st.entry_price, _st.sl_price, _pips), alert.freq_once_per_bar)

    // GOLD SIGNALS
    if amd_mss_on and not amd_sweep_signal_fired_eng and amd_liq_bias_eng != 0
        if amd_liq_bias_eng == 1 and mark_lows
            if vortex_matches(low, hour(time, TZ))
                amd_sweep_signal_fired_eng := true
                int _csz = array.size(trades)
                if _csz > 0
                    for _ci = 0 to _csz - 1
                        GoldTrade _ct = array.get(trades, _ci)
                        if _ct.is_open and not _ct.is_long
                            _ct.is_open := false
                            _ct.close_bar := bar_index
                            _ct.close_price := close
                            _ct.close_reason := "FLIP"
                            if executor_on
                                float _fp = (_ct.entry_price - close) / pip_size
                                alert(f_ex_close("FLIP", "SHORT", _ct.entry_price, close, _fp), alert.freq_once_per_bar)
                gold_n += 1
                gold_is_long := true
                float _sl_l = use_tight_sl ? low - local_atr * sl_buffer : na
                gold_sl_price := _sl_l
                array.push(trades, GoldTrade.new(bar_index, time, close, true, _sl_l, true, -1, na, "", na, na, na, na))
                if executor_on
                    alert(f_ex_open("LONG", close, _sl_l), alert.freq_once_per_bar)
                if array.size(trades) > 100
                    GoldTrade _old = array.shift(trades)
                    box.delete(_old.tp_box)
                    box.delete(_old.sl_box)
                    line.delete(_old.pnl_line)
                    label.delete(_old.info_lbl)
                label.new(bar_index, low, "◆", style=label.style_label_up,
                     color=color.new(color.black, 100), textcolor=#c9a84c, size=size.large)
        else if amd_liq_bias_eng == -1 and mark_highs
            if vortex_matches(high, hour(time, TZ))
                amd_sweep_signal_fired_eng := true
                int _csz2 = array.size(trades)
                if _csz2 > 0
                    for _ci2 = 0 to _csz2 - 1
                        GoldTrade _ct2 = array.get(trades, _ci2)
                        if _ct2.is_open and _ct2.is_long
                            _ct2.is_open := false
                            _ct2.close_bar := bar_index
                            _ct2.close_price := close
                            _ct2.close_reason := "FLIP"
                            if executor_on
                                float _fp2 = (close - _ct2.entry_price) / pip_size
                                alert(f_ex_close("FLIP", "LONG", _ct2.entry_price, close, _fp2), alert.freq_once_per_bar)
                gold_n += 1
                gold_is_long := false
                float _sl_s = use_tight_sl ? high + local_atr * sl_buffer : na
                gold_sl_price := _sl_s
                array.push(trades, GoldTrade.new(bar_index, time, close, false, _sl_s, true, -1, na, "", na, na, na, na))
                if executor_on
                    alert(f_ex_open("SHORT", close, _sl_s), alert.freq_once_per_bar)
                if array.size(trades) > 100
                    GoldTrade _old2 = array.shift(trades)
                    box.delete(_old2.tp_box)
                    box.delete(_old2.sl_box)
                    line.delete(_old2.pnl_line)
                    label.delete(_old2.info_lbl)
                label.new(bar_index, high, "◆", style=label.style_label_down,
                     color=color.new(color.black, 100), textcolor=#c9a84c, size=size.large)


// ═══════════════════════════════════════════════════════════════
// RENDER TRADE BOXES
// ═══════════════════════════════════════════════════════════════
if barstate.islast and show_boxes
    int _rsz = array.size(trades)
    if _rsz > 0
        for _ri = 0 to _rsz - 1
            GoldTrade _t = array.get(trades, _ri)
            int _rb = _t.is_open ? bar_index : _t.close_bar
            int _bms = timeframe.in_seconds(timeframe.period) * 1000
            int _rbt = _t.entry_time + (_rb - _t.entry_bar) * _bms

            float _ep = _t.is_open ? close : _t.close_price
            bool _fav = _t.is_long ? _ep >= _t.entry_price : _ep <= _t.entry_price
            color _pc = _t.is_open ? (_fav ? #00abff : #c9a84c) :
                 (_t.close_reason == "FLIP" ? #00abff : #f23645)

            if na(_t.pnl_line)
                _t.pnl_line := line.new(_t.entry_time, _t.entry_price, _rbt, _ep,
                     xloc=xloc.bar_time, color=_pc, width=1, style=line.style_dashed)
            else
                line.set_x2(_t.pnl_line, _rbt)
                line.set_y2(_t.pnl_line, _ep)
                line.set_color(_t.pnl_line, _pc)

            if not na(_t.sl_price) and na(_t.sl_box)
                float _st2 = math.max(_t.entry_price, _t.sl_price)
                float _sb2 = math.min(_t.entry_price, _t.sl_price)
                _t.sl_box := box.new(_t.entry_time, _st2, _rbt, _sb2,
                     xloc=xloc.bar_time, border_color=sl_color, bgcolor=sl_color)
            else if not na(_t.sl_box)
                box.set_right(_t.sl_box, _rbt)

            if show_labels
                string _dir = _t.is_long ? "LONG" : "SHORT"
                string _sts = _t.is_open ? "LIVE" : _t.close_reason
                float _pips = (_t.is_long ? _ep - _t.entry_price : _t.entry_price - _ep) / pip_size
                string _txt = _dir + " · " + str.tostring(_pips, "#.#") + " pips\n" + _sts
                if na(_t.info_lbl)
                    _t.info_lbl := label.new(_t.entry_time, _t.entry_price, _txt,
                         xloc=xloc.bar_time, style=label.style_label_right,
                         color=lbl_bg, textcolor=lbl_col, size=size.small)
                else
                    label.set_text(_t.info_lbl, _txt)

// ═══════════════════════════════════════════════════════════════
// DASHBOARD
// ═══════════════════════════════════════════════════════════════
dash_txt_sz = size.large
dash_txt_sz := dash_size_str == "Tiny"  ? size.tiny  : dash_txt_sz
dash_txt_sz := dash_size_str == "Small" ? size.small : dash_txt_sz
dash_txt_sz := dash_size_str == "Normal" ? size.normal : dash_txt_sz

d_pos = dash_position == "Bottom Right" ? position.bottom_right : dash_position == "Bottom Left" ? position.bottom_left : dash_position == "Top Left" ? position.top_left : position.top_right

var table dash = na
if barstate.islast
    if na(dash)
        dash := table.new(d_pos, 2, 4, bgcolor=#131313,
             border_color=#1a1d24, border_width=1, frame_color=#c9a84c, frame_width=1)
    table.cell(dash, 0, 0, " QUANT PRIME — MERIDIAN ", text_color=#c9a84c,
         text_size=dash_txt_sz, bgcolor=color.rgb(10,10,25))
    table.merge_cells(dash, 0, 0, 1, 0)

    string bias_str = amd_liq_bias_eng == 1 ? "LONG" : amd_liq_bias_eng == -1 ? "SHORT" : "NEUTRAL"
    color  bias_col = amd_liq_bias_eng == 1 ? #00abff : amd_liq_bias_eng == -1 ? #c9a84c : #8a877f
    table.cell(dash, 0, 1, " AMD BIAS ", text_color=#8a877f, text_size=dash_txt_sz, bgcolor=#131313)
    table.cell(dash, 1, 1, " " + bias_str + " ", text_color=bias_col, text_size=dash_txt_sz, bgcolor=#131313)

    string armed_str = amd_sweep_signal_fired_eng ? "FIRED" : amd_liq_bias_eng != 0 ? "ARMED" : "SCANNING"
    color  armed_col = amd_sweep_signal_fired_eng ? #8a877f : amd_liq_bias_eng != 0 ? #00abff : #8a877f
    table.cell(dash, 0, 2, " SIGNAL ", text_color=#8a877f, text_size=dash_txt_sz, bgcolor=#131313)
    table.cell(dash, 1, 2, " " + armed_str + " ", text_color=armed_col, text_size=dash_txt_sz, bgcolor=#131313)

    int _open = 0
    int _tsz3 = array.size(trades)
    if _tsz3 > 0
        for _ti3 = 0 to _tsz3 - 1
            if array.get(trades, _ti3).is_open
                _open += 1
    table.cell(dash, 0, 3, " OPEN ", text_color=#8a877f, text_size=dash_txt_sz, bgcolor=#131313)
    table.cell(dash, 1, 3, " " + str.tostring(_open) + " ", text_color=_open > 0 ? #00abff : #e8e6e1, text_size=dash_txt_sz, bgcolor=#131313)

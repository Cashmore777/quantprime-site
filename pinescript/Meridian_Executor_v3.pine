f_ex_open(string dir, float entry, float sl) =>
    '{"secret":"' + executor_secret + '","indicator":"MERIDIAN","action":"OPEN","symbol":"' + syminfo.ticker + '","direction":"' + dir + '","entry":' + str.tostring(entry, format.mintick) + (na(sl) ? "" : ',"sl":' + str.tostring(sl, format.mintick)) + ',"timeframe":"' + timeframe.period + '","timestamp":' + str.tostring(math.round(timenow / 1000)) + '}'

f_ex_close(string action, string dir, float entry, float close_at, float pips) =>
    '{"secret":"' + executor_secret + '","indicator":"MERIDIAN","action":"' + action + '","symbol":"' + syminfo.ticker + '","direction":"' + dir + '","entry":' + str.tostring(entry, format.mintick) + ',"close_price":' + str.tostring(close_at, format.mintick) + ',"pips":' + str.tostring(pips, "#.#") + ',"timestamp":' + str.tostring(math.round(timenow / 1000)) + '}'


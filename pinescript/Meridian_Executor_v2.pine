var bool  amd12h_m_done   = false
var bool  amd12h_armed_hi_this_cycle = false
var bool  amd12h_armed_lo_this_cycle = false
var AmdLine[] amd12h_hi_lines = array.new<AmdLine>()
var AmdLine[] amd12h_lo_lines = array.new<AmdLine>()
var AmdLine amd12h_cur_hi_ln = na
var AmdLine amd12h_cur_lo_ln = na

var int   amd6h_cyc_start = na
var float amd6h_a_hi     = na
var float amd6h_a_lo     = na
var float amd6h_m_hi     = na
var float amd6h_m_lo     = na
var float amd6h_d_hi     = na
var float amd6h_d_lo     = na

var AmdLine amd3h_cur_lo_ln = na

var int  amd_liq_bias_eng           = 0
var bool amd_sweep_signal_fired_eng = false

// ═══════════════════════════════════════════════════════════════
// AMD PHASE FUNCTIONS
// ═══════════════════════════════════════════════════════════════
f_amd_cycle_start(int t, float cycle_hours) =>
    int yy = year(t, amd_tz)
    int mm = month(t, amd_tz)
    int dd = dayofmonth(t, amd_tz)
    float hr = hour(t, amd_tz) + minute(t, amd_tz) / 60.0
    int cycle_index = int(math.floor(hr / cycle_hours))
    float cycle_start_hr = cycle_index * cycle_hours
    int midnight = timestamp(amd_tz, yy, mm, dd, 0, 0)
    midnight + math.round(cycle_start_hr * 3600000)

f_amd_phase(int t, float cycle_hours) =>
    int cyc_start = f_amd_cycle_start(t, cycle_hours)
    int a_end_t   = cyc_start + math.round(cycle_hours * 0.5 * 3600000)
    int m_end_t   = cyc_start + math.round(cycle_hours * 0.75 * 3600000)
    int cyc_end_t = cyc_start + math.round(cycle_hours * 1.0 * 3600000)
    string phase = t < a_end_t ? "A" : t < m_end_t ? "M" : "D"
    [cyc_start, a_end_t, m_end_t, cyc_end_t, phase]

// ═══════════════════════════════════════════════════════════════
// POSITION TRACKING
// ═══════════════════════════════════════════════════════════════
type GoldTrade
    int    entry_bar
    int    entry_time
    float  entry_price
    bool   is_long
    float  sl_price
    float  max_fav
    float  max_adv
    bool   is_open
    int    close_bar
    float  close_price
    string close_reason
    box    tp_box
    box    sl_box
    line   pnl_line
    label  info_lbl

var GoldTrade[] trades = array.new<GoldTrade>()
var int   gold_n = 0
var float gold_sl_price = na
var bool  gold_is_long = false

// ═══════════════════════════════════════════════════════════════
// AMD ENGINE
// ═══════════════════════════════════════════════════════════════
if barstate.isconfirmed
    // --- 12 HOUR ---
    if amd_on and amd_12h_on
        [c12_start, c12_a_end, c12_m_end, c12_end, c12_phase] = f_amd_phase(time, 24.0)
        if na(amd12h_cyc_start) or c12_start != amd12h_cyc_start
            amd12h_cyc_start := c12_start
            amd12h_a_hi      := high
            amd12h_a_lo      := low
            amd12h_m_hi      := na
            amd12h_m_lo      := na
            amd12h_d_hi      := na
            amd12h_d_lo      := na
            amd12h_a_done    := false
            amd12h_m_done    := false
            amd12h_armed_hi_this_cycle := false
            amd12h_armed_lo_this_cycle := false
            new_hi_ln = AmdLine.new(high, line.new(c12_start, high, time, high, xloc=xloc.bar_time,
                 color=amd_12h_line_col, width=amd_12h_line_width))
            array.push(amd12h_hi_lines, new_hi_ln)
            amd12h_cur_hi_ln := new_hi_ln
            new_lo_ln = AmdLine.new(low, line.new(c12_start, low, time, low, xloc=xloc.bar_time,
                 color=amd_12h_line_col, width=amd_12h_line_width))
            array.push(amd12h_lo_lines, new_lo_ln)
            amd12h_cur_lo_ln := new_lo_ln

        if c12_phase == "A"
            amd12h_a_hi := math.max(amd12h_a_hi, high)
            amd12h_a_lo := math.min(amd12h_a_lo, low)
            amd12h_cur_hi_ln.price := amd12h_a_hi
            line.set_y1(amd12h_cur_hi_ln.ln, amd12h_a_hi)
            line.set_y2(amd12h_cur_hi_ln.ln, amd12h_a_hi)
            amd12h_cur_lo_ln.price := amd12h_a_lo
            line.set_y1(amd12h_cur_lo_ln.ln, amd12h_a_lo)
            line.set_y2(amd12h_cur_lo_ln.ln, amd12h_a_lo)
        else
            amd12h_a_done := true

        if c12_phase == "M"
            amd12h_m_hi := na(amd12h_m_hi) ? high : math.max(amd12h_m_hi, high)
            amd12h_m_lo := na(amd12h_m_lo) ? low  : math.min(amd12h_m_lo, low)
        else if not na(amd12h_m_hi)
            amd12h_m_done := true

        if c12_phase == "D"
            amd12h_d_hi := na(amd12h_d_hi) ? high : math.max(amd12h_d_hi, high)
            amd12h_d_lo := na(amd12h_d_lo) ? low  : math.min(amd12h_d_lo, low)

        int hi12_sz = array.size(amd12h_hi_lines)
        if hi12_sz > 0
            for hi12i = hi12_sz - 1 to 0
                hln = array.get(amd12h_hi_lines, hi12i)
                if high > hln.price
                    line.delete(hln.ln)
                    array.remove(amd12h_hi_lines, hi12i)
                    amd_liq_bias_eng           := -1
                    amd_sweep_signal_fired_eng := false
                else
                    line.set_x2(hln.ln, time)
        int lo12_sz = array.size(amd12h_lo_lines)
        if lo12_sz > 0
            for lo12i = lo12_sz - 1 to 0
                lln = array.get(amd12h_lo_lines, lo12i)
                if low < lln.price
                    line.delete(lln.ln)
                    array.remove(amd12h_lo_lines, lo12i)
                    amd_liq_bias_eng           := 1
                    amd_sweep_signal_fired_eng := false
                else
                    line.set_x2(lln.ln, time)

    // --- 6 HOUR ---
    if amd_on and amd_6h_on
        [c6_start, c6_a_end, c6_m_end, c6_end, c6_phase] = f_amd_phase(time, 12.0)
        if na(amd6h_cyc_start) or c6_start != amd6h_cyc_start
            amd6h_cyc_start := c6_start
            amd6h_a_hi      := high
            amd6h_a_lo      := low
            amd6h_m_hi      := na
            amd6h_m_lo      := na
            amd6h_d_hi      := na
            amd6h_d_lo      := na
            amd6h_a_done    := false
            amd6h_m_done    := false
            amd6h_armed_hi_this_cycle := false
            amd6h_armed_lo_this_cycle := false
            new_hi_ln6 = AmdLine.new(high, line.new(c6_start, high, time, high, xloc=xloc.bar_time,
                 color=amd_6h_line_col, width=amd_6h_line_width))
            array.push(amd6h_hi_lines, new_hi_ln6)
            amd6h_cur_hi_ln := new_hi_ln6
            new_lo_ln6 = AmdLine.new(low, line.new(c6_start, low, time, low, xloc=xloc.bar_time,
                 color=amd_6h_line_col, width=amd_6h_line_width))
            array.push(amd6h_lo_lines, new_lo_ln6)
            amd6h_cur_lo_ln := new_lo_ln6

        if c6_phase == "A"
            amd6h_a_hi := math.max(amd6h_a_hi, high)
            amd6h_a_lo := math.min(amd6h_a_lo, low)
            amd6h_cur_hi_ln.price := amd6h_a_hi
            line.set_y1(amd6h_cur_hi_ln.ln, amd6h_a_hi)
            line.set_y2(amd6h_cur_hi_ln.ln, amd6h_a_hi)
            amd6h_cur_lo_ln.price := amd6h_a_lo
            line.set_y1(amd6h_cur_lo_ln.ln, amd6h_a_lo)
            line.set_y2(amd6h_cur_lo_ln.ln, amd6h_a_lo)
        else
            amd6h_a_done := true

        if c6_phase == "M"
            amd6h_m_hi := na(amd6h_m_hi) ? high : math.max(amd6h_m_hi, high)
            amd6h_m_lo := na(amd6h_m_lo) ? low  : math.min(amd6h_m_lo, low)
        else if not na(amd6h_m_hi)
            amd6h_m_done := true

        if c6_phase == "D"
            amd6h_d_hi := na(amd6h_d_hi) ? high : math.max(amd6h_d_hi, high)
            amd6h_d_lo := na(amd6h_d_lo) ? low  : math.min(amd6h_d_lo, low)

        int hi6_sz = array.size(amd6h_hi_lines)
        if hi6_sz > 0
            for hi6i = hi6_sz - 1 to 0
                hln6 = array.get(amd6h_hi_lines, hi6i)
                if high > hln6.price
                    line.delete(hln6.ln)
                    array.remove(amd6h_hi_lines, hi6i)
                    amd_liq_bias_eng           := -1
                    amd_sweep_signal_fired_eng := false
                else
                    line.set_x2(hln6.ln, time)
        int lo6_sz = array.size(amd6h_lo_lines)
        if lo6_sz > 0
            for lo6i = lo6_sz - 1 to 0
                lln6 = array.get(amd6h_lo_lines, lo6i)
                if low < lln6.price
                    line.delete(lln6.ln)
                    array.remove(amd6h_lo_lines, lo6i)
                    amd_liq_bias_eng           := 1
                    amd_sweep_signal_fired_eng := false
                else
                    line.set_x2(lln6.ln, time)

    // --- 3 HOUR ---
    if amd_on and amd_3h_on
        [c3_start, c3_a_end, c3_m_end, c3_end, c3_phase] = f_amd_phase(time, 6.0)
        if na(amd3h_cyc_start) or c3_start != amd3h_cyc_start
            amd3h_cyc_start := c3_start
            amd3h_a_hi      := high
            amd3h_a_lo      := low
            amd3h_m_hi      := na
            amd3h_m_lo      := na
            amd3h_d_hi      := na
            amd3h_d_lo      := na
            amd3h_a_done    := false
            amd3h_m_done    := false
            amd3h_armed_hi_this_cycle := false
            amd3h_armed_lo_this_cycle := false
            new_hi_ln3 = AmdLine.new(high, line.new(c3_start, high, time, high, xloc=xloc.bar_time,
                 color=amd_3h_line_col, width=amd_3h_line_width))
            array.push(amd3h_hi_lines, new_hi_ln3)
            amd3h_cur_hi_ln := new_hi_ln3
            new_lo_ln3 = AmdLine.new(low, line.new(c3_start, low, time, low, xloc=xloc.bar_time,
                 color=amd_3h_line_col, width=amd_3h_line_width))
            array.push(amd3h_lo_lines, new_lo_ln3)
            amd3h_cur_lo_ln := new_lo_ln3

        if c3_phase == "A"
            amd3h_a_hi := math.max(amd3h_a_hi, high)
            amd3h_a_lo := math.min(amd3h_a_lo, low)
            amd3h_cur_hi_ln.price := amd3h_a_hi
            line.set_y1(amd3h_cur_hi_ln.ln, amd3h_a_hi)

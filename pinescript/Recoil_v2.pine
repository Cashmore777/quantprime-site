//@version=6
indicator("Quant Prime — Recoil", shorttitle="RECOIL", overlay=true, max_lines_count=500, max_boxes_count=500, max_labels_count=500)

// ═══════════════════════════════════════════════════════════════
// QUANT PRIME — RECOIL
// A standalone volatility fade engine. When a statistically
// exceptional candle closes (volatility bands 6/7/8 -- yellow /
// orange / red), Recoil fades it: a bearish closure triggers a
// LONG, a bullish closure triggers a SHORT, on the premise that
// overextended candles snap back. Each band carries its own risk
// multiplier (1x / 2x / 5x by default) expressed against the
// user's own base unit -- e.g. with a 0.01 base lot: yellow=0.01,
// orange=0.02, red=0.05.
//
// Fully independent of the Meridian sweep/vortex engine. The EMA
// stack provides the trend state, which scales risk rather than
// gating trades: with-trend fades run at 2x the band foundation,
// counter-trend at 0.5x, and consolidation fades both directions
// at 1x (all adjustable). Fair value gaps are detected internally
// PURELY to power the "FVG Gap" stop-loss mode -- they are never
// drawn at low opacity (toggleable). No LP liquidity lines --
// FVGs and the EMA stack are the only context layers.
//
// No P&L, no win counting, no dollars -- consistent with the
// Quant Prime line: the tool defines the trade study; the account
// is yours.
// ═══════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════
// PRESETS — backtested configurations per trading style.
// Selecting a preset overrides TP, SL, and engine settings.
// Choose Custom to use the manual inputs below.
// ═══════════════════════════════════════════════════════════════
preset = input.string("Custom", "Trading Style", options=[
     "Scalping (3M)",
     "Intra-Day (21M)",
     "Swing (4H)",
     "Custom"],
     group="Preset",
     tooltip="Scalping: 3M EURUSD, TP 100% body, SL wick+3.0 ATR. PF 1.246, 63.5% WR.\nIntra-Day: 21M EURUSD, TP 50% body, SL wick+1.0 ATR. PF 1.507, 65.5% WR.\nSwing: 4H EURUSD, TP 100% body, SL wick+1.0 ATR. PF 1.209, 46.4% WR.\nCustom: use the manual inputs below.")

is_scalp   = preset == "Scalping (3M)"
is_intra   = preset == "Intra-Day (21M)"
is_swing   = preset == "Swing (4H)"
is_custom  = preset == "Custom"

// ═══════════════════════════════════════════════════════════════
// VOLATILITY INPUTS
// ═══════════════════════════════════════════════════════════════
atrLen = input.int(8, "ATR Length", group="Volatility")

volThresh1 = input.float(0.30, "Threshold 1 (Extremely Low → Very Low)",     group="Volatility", step=0.05)
volThresh2 = input.float(0.75, "Threshold 2 (Very Low → Low)",               group="Volatility", step=0.05)
volThresh3 = input.float(1.20, "Threshold 3 (Low → Lower Medium)",           group="Volatility", step=0.05)
volThresh4 = input.float(1.65, "Threshold 4 (Lower Medium → Medium)",        group="Volatility", step=0.05)
volThresh5 = input.float(2.10, "Threshold 5 (Medium → High Medium)",         group="Volatility", step=0.05)
volThresh6 = input.float(2.55, "Threshold 6 (High Medium → High)",          group="Volatility", step=0.05)
volThresh7 = input.float(3.00, "Threshold 7 (High → Very High)",            group="Volatility", step=0.05)

volColor1 = input.color(#1e1e28,       "Extremely Low",  group="Volatility — Colors")
volColor2 = input.color(#2a2a36,       "Very Low",       group="Volatility — Colors")
volColor3 = input.color(#363644,       "Low",            group="Volatility — Colors")
volColor4 = input.color(#424252,       "Lower Medium",   group="Volatility — Colors")
volColor5 = input.color(#4e4e60,       "Medium",         group="Volatility — Colors")
volColor6 = input.color(#e6a830,       "High Medium (Trigger 1x)",  group="Volatility — Colors")
volColor7 = input.color(#c9a84c,       "High (Trigger 2x)",         group="Volatility — Colors")
volColor8 = input.color(#f23645,       "Very High (Trigger 5x)",    group="Volatility — Colors")

volTagFromBand = input.int(6, "Show Tag From Band # Upward", minval=1, maxval=8, group="Volatility",
     tooltip="The small '#.##x' text tag only appears on candles whose volatility band is this number or higher (1=Extremely Low ... 8=Very High). Default 6 tags only the trigger bands.")

// ═══════════════════════════════════════════════════════════════
// DISPLAY INPUTS
// ═══════════════════════════════════════════════════════════════
colorCandles   = input.bool(true,  "Color Candles By Volatility", group="Display")
showTag        = input.bool(false, "Show Volatility Tag",         group="Display")
labelTextColor = input.color(color.white, "Tag Text Color",       group="Display")

// ═══════════════════════════════════════════════════════════════
// EMA INPUTS
// ═══════════════════════════════════════════════════════════════
showEMAs  = input.bool(true,  "Show EMAs",    group="EMAs")
ema1Len   = input.int(8,      "EMA 1 Length", group="EMAs")
ema2Len   = input.int(26,     "EMA 2 Length", group="EMAs")
ema3Len   = input.int(80,     "EMA 3 Length", group="EMAs")
ema4Len   = input.int(233,    "EMA 4 Length", group="EMAs")
ema1Color = input.color(#7fdbff, "EMA 1 Color", group="EMAs")
ema2Color = input.color(#00abff, "EMA 2 Color", group="EMAs")
ema3Color = input.color(#0085c7, "EMA 3 Color", group="EMAs")
ema4Color = input.color(#005e8c, "EMA 4 Color", group="EMAs")

// ═══════════════════════════════════════════════════════════════
// RECOIL ENGINE
// ═══════════════════════════════════════════════════════════════
fade_band6_on = input.bool(true, "Fade Band 6 (Amber)", group="Recoil Engine", inline="b6")
band6_mult    = input.float(1.0, "Risk Mult", minval=0.0, step=0.5, group="Recoil Engine", inline="b6",
     tooltip="Risk multiplier for Band 6 triggers, expressed against your own base unit. With a 0.01 base lot: 1x = 0.01.")
fade_band7_on = input.bool(true, "Fade Band 7 (Gold)", group="Recoil Engine", inline="b7")
band7_mult    = input.float(2.0, "Risk Mult", minval=0.0, step=0.5, group="Recoil Engine", inline="b7",
     tooltip="Risk multiplier for Band 7 triggers. With a 0.01 base lot: 2x = 0.02.")
fade_band8_on = input.bool(true, "Fade Band 8 (Red)", group="Recoil Engine", inline="b8")
band8_mult    = input.float(5.0, "Risk Mult", minval=0.0, step=0.5, group="Recoil Engine", inline="b8",
     tooltip="Risk multiplier for Band 8 triggers. With a 0.01 base lot: 5x = 0.05.")

trend_with_mult    = input.float(2.0, "Risk Mult — With Trend",     minval=0.0, step=0.25, group="Recoil Engine — Trend Alignment",
     tooltip="Multiplies the band foundation when the fade's direction AGREES with a genuine EMA trend (e.g. a SHORT fade during a fully-aligned bearish stack).")
trend_against_mult = input.float(0.5, "Risk Mult — Against Trend",  minval=0.0, step=0.25, group="Recoil Engine — Trend Alignment",
     tooltip="Multiplies the band foundation when the fade's direction OPPOSES a genuine EMA trend. Set to 0 to skip counter-trend fades entirely.")
trend_consol_mult  = input.float(1.0, "Risk Mult — Consolidation",  minval=0.0, step=0.25, group="Recoil Engine — Trend Alignment",
     tooltip="Multiplies the band foundation when the EMA stack is NOT in a genuine trend -- any direction fades at this rate. 1.0 = the band foundation unchanged.")
close_on_trend_flip = input.bool(true, "Emergency Close on Opposite Trend Flip", group="Recoil Engine — Trend Alignment",
     tooltip="The moment the EMA stack TRANSITIONS into a genuine trend (e.g. consolidation -> bearish), every open fade in the opposite direction closes immediately at that bar's close.")

min_body_atr = input.float(0.5, "Min Body Size (x ATR)", minval=0.0, step=0.05, group="Recoil Engine",
     tooltip="A trigger candle's BODY (open-to-close) must be at least this many ATRs for a fade to fire.")
fade_timeout_bars = input.int(0, "Max Bars In Trade (0 = no limit)", minval=0, group="Recoil Engine",
     tooltip="Optional time stop: if neither TP nor SL has been hit after this many bars, the fade closes at market on that bar's close.")

// ═══════════════════════════════════════════════════════════════
// TAKE PROFIT
// ═══════════════════════════════════════════════════════════════
tp_mode = input.string("% of Body", "TP Mode", options=["% of Body", "% of Range", "R Multiple"], group="Take Profit",
     tooltip="% of Body: TP distance = the chosen % of the trigger candle's open-to-close body, measured from entry.")
tp_pct  = input.float(50.0, "TP % (of Body / Range)", minval=1.0, maxval=200.0, step=5.0, group="Take Profit")
tp_r    = input.float(1.0,  "TP R Multiple", minval=0.1, step=0.1, group="Take Profit")

// Preset overrides for TP
float eff_tp_pct = is_scalp ? 100.0 : is_intra ? 50.0 : is_swing ? 100.0 : tp_pct
string eff_tp_mode = is_custom ? tp_mode : "% of Body"
float eff_tp_r = is_custom ? tp_r : 1.0

// TP1 partial settings
tp1_on      = input.bool(false, "Enable Partial TP (TP1)", group="Take Profit — Partial",
     tooltip="Adds an intermediate target between entry and the full TP. When price reaches TP1, the stop moves to breakeven.")
tp1_pct     = input.float(25.0, "TP1 % (of Body / Range)", minval=1.0, maxval=100.0, step=5.0, group="Take Profit — Partial",
     tooltip="TP1 distance as a percentage of the trigger candle's body.")
tp1_close_pct = input.float(50.0, "Close % at TP1", minval=10.0, maxval=90.0, step=5.0, group="Take Profit — Partial",
     tooltip="What percentage of the position to close when TP1 is hit.")
tp1_move_be = input.bool(false, "Move SL to Breakeven at TP1", group="Take Profit — Partial",
     tooltip="When TP1 is hit, automatically move the stop loss to the entry price (breakeven).")

// ═══════════════════════════════════════════════════════════════
// STOP LOSS
// ═══════════════════════════════════════════════════════════════
sl_mode = input.string("Wick + Buffer", "SL Mode", options=["Wick + Buffer", "FVG Gap"], group="Stop Loss")
sl_wick_buffer_atr = input.float(3.0, "Wick Buffer (x ATR)", minval=0.0, step=0.05, group="Stop Loss",
     tooltip="Wick + Buffer mode: the stop sits this many ATRs beyond the trigger candle's extreme.")
sl_gap_atr_mult = input.float(1.0, "FVG Gap Threshold (x ATR)", minval=0.1, step=0.1, group="Stop Loss",
     tooltip="FVG Gap mode: minimum clear space (in ATR multiples) between FVG zones to count as a safe gap.")
sl_gap_mode = input.string("2nd Gap", "FVG Gap Selection", options=["Closest Gap", "2nd Gap", "3rd Gap", "4th Gap"], group="Stop Loss",
     tooltip="FVG Gap mode: which consolidated clear gap beyond entry the stop lands in.")

// Preset overrides for SL
float eff_sl_buffer = is_scalp ? 3.0 : is_intra ? 1.0 : is_swing ? 1.0 : sl_wick_buffer_atr
string eff_sl_mode = is_custom ? sl_mode : "Wick + Buffer"

// ═══════════════════════════════════════════════════════════════
// FVG DETECTION (SL ENGINE)
// ═══════════════════════════════════════════════════════════════
fvg1_on = input.bool(true,  "Enable", group="FVG SL Engine — Timeframe 1", inline="f1")
fvg1_tf = input.timeframe("1",  "",   group="FVG SL Engine — Timeframe 1", inline="f1")
fvg2_on = input.bool(true,  "Enable", group="FVG SL Engine — Timeframe 2", inline="f2")
fvg2_tf = input.timeframe("3",  "",   group="FVG SL Engine — Timeframe 2", inline="f2")
fvg3_on = input.bool(true,  "Enable", group="FVG SL Engine — Timeframe 3", inline="f3")
fvg3_tf = input.timeframe("30", "",   group="FVG SL Engine — Timeframe 3", inline="f3")

show_fvg_zones = input.bool(false, "Show FVG Zones", group="FVG SL Engine",
     tooltip="Draws the tracked FVGs at low opacity so you can see where an FVG Gap stop comes from.")
fvg_zone_color = input.color(color.new(#00abff, 88), "FVG Zone Color", group="FVG SL Engine")
fvg_max_store  = input.int(250, "Max FVGs Tracked (per timeframe)", minval=50, maxval=500, group="FVG SL Engine")

// ═══════════════════════════════════════════════════════════════
// TRADE DISPLAY
// ═══════════════════════════════════════════════════════════════
show_pos_boxes   = input.bool(true,  "Show Trade Boxes",   group="Trade Display")
show_pos_labels  = input.bool(true,  "Show Entry Labels (Direction + Risk Mult)", group="Trade Display")
pos_box_gap_bars = input.int(0, "Gap Between Closed Trade Boxes (bars)", minval=0, maxval=20, group="Trade Display")
pos_tp_color     = input.color(color.new(#26a269, 75), "TP Box Color", group="Trade Display")
pos_sl_color     = input.color(color.new(#f23645, 75), "SL Box Color", group="Trade Display")
pos_label_size_str = input.string("Small", "Label Size", options=["Tiny","Small","Normal","Large"], group="Trade Display")
pos_label_text_color = input.color(#e8e6e1, "Label Text Color", group="Trade Display")
pos_label_bg_color   = input.color(color.new(color.black, 15), "Label Background", group="Trade Display")
reset_weekly     = input.bool(true, "Reset Trade Boxes Weekly", group="Trade Display",
     tooltip="ON: trade boxes wipe every Sunday 22:00 UTC.")

// ═══════════════════════════════════════════════════════════════
// DASHBOARD INPUTS
// ═══════════════════════════════════════════════════════════════
show_dashboard = input.bool(true, "Show Dashboard", group="Dashboard")
dash_position  = input.string("Bottom", "Position", options=["Top","Bottom"], group="Dashboard")
dash_size_str  = input.string("Large", "Text Size", options=["Tiny","Small","Normal","Large"], group="Dashboard")

dash_bg_color     = input.color(#131313, "Background",  group="Dashboard — Colors")
dash_title_color  = input.color(#00abff, "Title",       group="Dashboard — Colors")
dash_white        = input.color(#e8e6e1, "Text White",  group="Dashboard — Colors")
dash_label_color  = input.color(#8a877f, "Labels",      group="Dashboard — Colors")
dash_border_color = input.color(#1a1d24, "Border",      group="Dashboard — Colors")
dash_bull_color   = input.color(#00abff, "Bull",        group="Dashboard — Colors")
dash_bear_color   = input.color(#c9a84c, "Bear",        group="Dashboard — Colors")

// ═══════════════════════════════════════════════════════════════
// VOLATILITY CALCULATIONS
// ═══════════════════════════════════════════════════════════════
trueRange = ta.tr(true)
atrVal    = ta.atr(atrLen)
ratio     = trueRange / atrVal

volBand =
     ratio < volThresh1 ? 1 :
     ratio < volThresh2 ? 2 :
     ratio < volThresh3 ? 3 :
     ratio < volThresh4 ? 4 :
     ratio < volThresh5 ? 5 :
     ratio < volThresh6 ? 6 :
     ratio < volThresh7 ? 7 : 8

volColor =
     volBand == 1 ? volColor1 :
     volBand == 2 ? volColor2 :
     volBand == 3 ? volColor3 :
     volBand == 4 ? volColor4 :
     volBand == 5 ? volColor5 :
     volBand == 6 ? volColor6 :
     volBand == 7 ? volColor7 : volColor8

notableVol = volBand >= volTagFromBand

// ═══════════════════════════════════════════════════════════════
// EMA CALCULATIONS + BIAS CLASSIFIER
// ═══════════════════════════════════════════════════════════════
ema1 = ta.ema(close, ema1Len)
ema2 = ta.ema(close, ema2Len)
ema3 = ta.ema(close, ema3Len)
ema4 = ta.ema(close, ema4Len)

is_trend_bull  = ema4 < ema3 and ema3 < ema2
is_trend_bear  = ema4 > ema3 and ema3 > ema2
ema_bias_long  = is_trend_bull or (not is_trend_bull and not is_trend_bear and ema1 < ema2)
ema_bias_short = is_trend_bear or (not is_trend_bull and not is_trend_bear and ema1 > ema2)

ema_bias_str = ema_bias_long ? "LONG" : ema_bias_short ? "SHORT" : "NEUTRAL"
ema_bias_col = ema_bias_long ? dash_bull_color : ema_bias_short ? dash_bear_color : dash_label_color

// ═══════════════════════════════════════════════════════════════
// PLOTS
// ═══════════════════════════════════════════════════════════════
plot(showEMAs ? ema1 : na, title="EMA 1", color=ema1Color, linewidth=1)
plot(showEMAs ? ema2 : na, title="EMA 2", color=ema2Color, linewidth=1)
plot(showEMAs ? ema3 : na, title="EMA 3", color=ema3Color, linewidth=1)
plot(showEMAs ? ema4 : na, title="EMA 4", color=ema4Color, linewidth=2)

barcolor(colorCandles ? volColor : na, title="Volatility Color")

var label volLabel = na
label.delete(volLabel)
if showTag
    if barstate.isconfirmed
        if notableVol
            label.new(bar_index, high,
                 text=str.tostring(ratio, "#.##") + "x",
                 style=label.style_label_down,
                 color=volColor,
                 textcolor=labelTextColor,
                 size=size.small,
                 yloc=yloc.abovebar)
        label.delete(volLabel)
        volLabel := na
    else if barstate.islast
        label.delete(volLabel)
        volLabel := label.new(bar_index, high,
             text=str.tostring(ratio, "#.##") + "x",
             style=label.style_label_down,
             color=volColor,
             textcolor=labelTextColor,
             size=size.small,
             yloc=yloc.abovebar)

// ═══════════════════════════════════════════════════════════════
// FVG DETECTION
// ═══════════════════════════════════════════════════════════════
type FVG
    float top
    float bot
    float mid
    bool  is_bull
    int   state
    box   bx

get_fvg() =>
    var float top     = na
    var float bot     = na
    var bool  is_bull = bool(na)
    var bool  valid   = false
    valid := false
    if barstate.isconfirmed
        bull = high[2] < low[0]
        bear = low[2]  > high[0]
        if bull
            top     := low[0]
            bot     := high[2]
            is_bull := true
            valid   := true
        else if bear
            top     := low[2]
            bot     := high[0]
            is_bull := false
            valid   := true
    [top, bot, is_bull, valid]

[ft1, fb1, fbull1, fv1] = request.security(syminfo.tickerid, fvg1_tf,
    get_fvg(), lookahead=barmerge.lookahead_off)
[ft2, fb2, fbull2, fv2] = request.security(syminfo.tickerid, fvg2_tf,
    get_fvg(), lookahead=barmerge.lookahead_off)
[ft3, fb3, fbull3, fv3] = request.security(syminfo.tickerid, fvg3_tf,
    get_fvg(), lookahead=barmerge.lookahead_off)

var FVG[] fvgs1 = array.new<FVG>()
var FVG[] fvgs2 = array.new<FVG>()
var FVG[] fvgs3 = array.new<FVG>()

add_fvg(arr, top, bot, is_bull) =>
    exists = false
    sz_chk = array.size(arr)
    if sz_chk > 0
        for i = 0 to sz_chk - 1
            f_chk = array.get(arr, i)
            if f_chk.state == 0 and math.abs(f_chk.top - top) < syminfo.mintick * 2 and math.abs(f_chk.bot - bot) < syminfo.mintick * 2
                exists := true
    if not exists
        mid = (top + bot) / 2
        box bx = na
        if show_fvg_zones
            bx := box.new(bar_index, top, bar_index + 1, bot,
                 border_color=fvg_zone_color, bgcolor=fvg_zone_color, extend=extend.none, border_width=1)
        array.push(arr, FVG.new(top, bot, mid, is_bull, 0, bx))
        if array.size(arr) > fvg_max_store
            old = array.shift(arr)
            box.delete(old.bx)

update_fvgs(arr) =>
    sz = array.size(arr)
    if sz > 0
        for i = 0 to sz - 1
            f = array.get(arr, i)
            if f.state < 4 and not na(f.bx)
                box.set_right(f.bx, bar_index)
            if f.state == 0
                tapped = f.is_bull ? low < f.mid : high > f.mid
                if tapped
                    f.state := 1
            else if f.state == 1
                filled = f.is_bull ? close < f.bot : close > f.top
                if filled
                    f.state := 2
            else if f.state == 2
                tapped = f.is_bull ? high > f.mid : low < f.mid
                if tapped
                    f.state := 3
            else if f.state == 3
                filled = f.is_bull ? close > f.top : close < f.bot
                if filled
                    if not na(f.bx)
                        box.set_right(f.bx, bar_index)
                    f.state := 4

if fvg1_on and fv1
    add_fvg(fvgs1, ft1, fb1, fbull1)
if fvg2_on and fv2
    add_fvg(fvgs2, ft2, fb2, fbull2)
if fvg3_on and fv3
    add_fvg(fvgs3, ft3, fb3, fbull3)

update_fvgs(fvgs1)
update_fvgs(fvgs2)
update_fvgs(fvgs3)

// ═══════════════════════════════════════════════════════════════
// FVG GAP-SCAN
// ═══════════════════════════════════════════════════════════════
find_sl_gap(float entry_price, bool is_long_pos) =>
    var float[] r_tops = array.new<float>()
    var float[] r_bots = array.new<float>()
    array.clear(r_tops)
    array.clear(r_bots)

    if fvg1_on
        sz1 = array.size(fvgs1)
        if sz1 > 0
            for i = 0 to sz1 - 1
                f = array.get(fvgs1, i)
                if f.state < 4
                    if is_long_pos and f.top < entry_price
                        array.push(r_tops, f.top)
                        array.push(r_bots, f.bot)
                    else if not is_long_pos and f.bot > entry_price
                        array.push(r_tops, f.top)
                        array.push(r_bots, f.bot)
    if fvg2_on
        sz2 = array.size(fvgs2)
        if sz2 > 0
            for i = 0 to sz2 - 1
                f = array.get(fvgs2, i)
                if f.state < 4
                    if is_long_pos and f.top < entry_price
                        array.push(r_tops, f.top)
                        array.push(r_bots, f.bot)
                    else if not is_long_pos and f.bot > entry_price
                        array.push(r_tops, f.top)
                        array.push(r_bots, f.bot)
    if fvg3_on
        sz3 = array.size(fvgs3)
        if sz3 > 0
            for i = 0 to sz3 - 1
                f = array.get(fvgs3, i)
                if f.state < 4
                    if is_long_pos and f.top < entry_price
                        array.push(r_tops, f.top)
                        array.push(r_bots, f.bot)
                    else if not is_long_pos and f.bot > entry_price
                        array.push(r_tops, f.top)
                        array.push(r_bots, f.bot)

    float result_sl = na
    int rsz = array.size(r_tops)
    if rsz > 0
        var int[] order_idx = array.new<int>()
        array.clear(order_idx)
        for i = 0 to rsz - 1
            array.push(order_idx, i)
        if rsz > 1
            for i = 1 to rsz - 1
                int key = array.get(order_idx, i)
                float key_top = array.get(r_tops, key)
                int j = i - 1
                while j >= 0 and (is_long_pos ?
                     array.get(r_tops, array.get(order_idx, j)) < key_top :
                     array.get(r_tops, array.get(order_idx, j)) > key_top)
                    array.set(order_idx, j + 1, array.get(order_idx, j))
                    j -= 1
                array.set(order_idx, j + 1, key)

        float min_gap = atrVal * sl_gap_atr_mult

        var float[] zone_near = array.new<float>()
        var float[] zone_far  = array.new<float>()
        array.clear(zone_near)
        array.clear(zone_far)

        float cur_near = na
        float cur_far  = na
        for i = 0 to rsz - 1
            int   idx      = array.get(order_idx, i)
            float this_top = array.get(r_tops, idx)
            float this_bot = array.get(r_bots, idx)
            float this_near = is_long_pos ? this_top : this_bot
            float this_far  = is_long_pos ? this_bot : this_top
            if na(cur_near)
                cur_near := this_near
                cur_far  := this_far
            else
                float gap_to_this = is_long_pos ? cur_far - this_near : this_near - cur_far
                bool touches = gap_to_this < min_gap
                if touches
                    cur_far := is_long_pos ? math.min(cur_far, this_far) : math.max(cur_far, this_far)
                else
                    array.push(zone_near, cur_near)
                    array.push(zone_far, cur_far)
                    cur_near := this_near
                    cur_far  := this_far
        if not na(cur_near)
            array.push(zone_near, cur_near)
            array.push(zone_far, cur_far)

        float cursor = entry_price
        var float[] found_gaps = array.new<float>()
        array.clear(found_gaps)
        int zsz = array.size(zone_near)
        for i = 0 to zsz - 1
            float z_near = array.get(zone_near, i)
            float z_far  = array.get(zone_far, i)
            float dist = is_long_pos ? cursor - z_near : z_near - cursor
            if dist >= min_gap
                float gap_sl = is_long_pos ? cursor - min_gap * 0.5 : cursor + min_gap * 0.5
                array.push(found_gaps, gap_sl)
            cursor := is_long_pos ? math.min(cursor, z_far) : math.max(cursor, z_far)

        int gsz = array.size(found_gaps)
        if gsz > 0
            int pick_idx = 0
            if sl_gap_mode == "2nd Gap"
                pick_idx := math.min(1, gsz - 1)
            else if sl_gap_mode == "3rd Gap"
                pick_idx := math.min(2, gsz - 1)
            else if sl_gap_mode == "4th Gap"
                pick_idx := math.min(3, gsz - 1)
            result_sl := array.get(found_gaps, pick_idx)
        else
            result_sl := is_long_pos ? cursor - min_gap : cursor + min_gap
    else
        result_sl := is_long_pos ? entry_price - atrVal * 2 : entry_price + atrVal * 2

    result_sl

// ═══════════════════════════════════════════════════════════════
// FADE POSITION TYPE
// ═══════════════════════════════════════════════════════════════
var float pip_size = syminfo.mintick * 10

type Fade
    int    entry_bar
    int    entry_time
    float  entry_price
    bool   is_long
    float  sl_price
    float  tp_price
    float  tp1_price
    bool   tp1_hit
    float  risk_mult
    int    band
    bool   is_open
    int    close_bar
    float  close_price
    string close_reason
    int    frozen_right_bar
    box    tp_box
    box    sl_box
    line   pnl_line
    label  info_lbl

var Fade[] fades = array.new<Fade>()

// ═══════════════════════════════════════════════════════════════
// CREATE FADE
// ═══════════════════════════════════════════════════════════════
create_fade(int bar_idx, int entry_t, float entry_price, bool is_long_pos, float body_size, float range_size, float wick_extreme, float r_mult, int band_n) =>
    float sl = na
    if eff_sl_mode == "Wick + Buffer"
        float buf = atrVal * eff_sl_buffer
        sl := is_long_pos ? wick_extreme - buf : wick_extreme + buf
    else
        sl := find_sl_gap(entry_price, is_long_pos)

    float sl_dist = math.max(math.abs(entry_price - sl), syminfo.mintick)

    float tp_dist = na
    if eff_tp_mode == "% of Body"
        tp_dist := body_size * (eff_tp_pct / 100.0)
    else if eff_tp_mode == "% of Range"
        tp_dist := range_size * (eff_tp_pct / 100.0)
    else
        tp_dist := sl_dist * eff_tp_r
    float tp = is_long_pos ? entry_price + tp_dist : entry_price - tp_dist

    float tp1 = na
    if tp1_on
        float tp1_dist = na
        if eff_tp_mode == "% of Body"
            tp1_dist := body_size * (tp1_pct / 100.0)
        else if eff_tp_mode == "% of Range"
            tp1_dist := range_size * (tp1_pct / 100.0)
        else
            tp1_dist := sl_dist * (tp1_pct / 100.0)
        tp1 := is_long_pos ? entry_price + tp1_dist : entry_price - tp1_dist

    array.push(fades, Fade.new(
         bar_idx, entry_t, entry_price, is_long_pos, sl, tp,
         tp1, false,
         r_mult, band_n, true, -1, na, "", na,
         na, na, na, na))

    if array.size(fades) > 60
        old = array.shift(fades)
        box.delete(old.tp_box)
        box.delete(old.sl_box)
        line.delete(old.pnl_line)
        label.delete(old.info_lbl)

// ═══════════════════════════════════════════════════════════════
// RENDER FADE BOXES
// ═══════════════════════════════════════════════════════════════
pos_lbl_sz = size.small
pos_lbl_sz := pos_label_size_str == "Tiny"   ? size.tiny   : pos_lbl_sz
pos_lbl_sz := pos_label_size_str == "Normal" ? size.normal : pos_lbl_sz
pos_lbl_sz := pos_label_size_str == "Large"  ? size.large  : pos_lbl_sz

render_fade(Fade p, int right_edge_bar) =>
    int box_right = right_edge_bar
    if not na(p.frozen_right_bar)
        int trimmed = p.frozen_right_bar - pos_box_gap_bars
        box_right := trimmed > p.entry_bar ? trimmed : p.entry_bar + 1

    int bar_ms      = timeframe.in_seconds(timeframe.period) * 1000
    int box_right_t = p.entry_time + (box_right - p.entry_bar) * bar_ms

    float tp_top = math.max(p.entry_price, p.tp_price)
    float tp_bot = math.min(p.entry_price, p.tp_price)
    if na(p.tp_box)
        p.tp_box := box.new(p.entry_time, tp_top, box_right_t, tp_bot, xloc=xloc.bar_time,
             border_color=pos_tp_color, bgcolor=pos_tp_color, border_width=1, extend=extend.none)
    else
        box.set_right(p.tp_box, box_right_t)

    float sl_top = math.max(p.entry_price, p.sl_price)
    float sl_bot = math.min(p.entry_price, p.sl_price)
    if na(p.sl_box)
        p.sl_box := box.new(p.entry_time, sl_top, box_right_t, sl_bot, xloc=xloc.bar_time,
             border_color=pos_sl_color, bgcolor=pos_sl_color, border_width=1, extend=extend.none)
    else
        box.set_right(p.sl_box, box_right_t)

    float pnl_end_price = p.is_open ? close : p.close_price
    bool  favorable     = p.is_long ? pnl_end_price >= p.entry_price : pnl_end_price <= p.entry_price
    color pnl_color = p.is_open ? (favorable ? dash_bull_color : dash_bear_color) :
         (p.close_reason == "TP" or p.close_reason == "TP2") ? dash_bull_color :
         p.close_reason == "SL" ? dash_bear_color :
         (favorable ? dash_bull_color : dash_bear_color)

    if na(p.pnl_line)
        p.pnl_line := line.new(p.entry_time, p.entry_price, box_right_t, pnl_end_price,
             xloc=xloc.bar_time, color=pnl_color, width=1, style=line.style_dashed)
    else
        line.set_x2(p.pnl_line, box_right_t)
        line.set_y2(p.pnl_line, pnl_end_price)
        line.set_color(p.pnl_line, pnl_color)

    if show_pos_labels
        string dir_txt    = p.is_long ? "LONG" : "SHORT"
        string status_txt = p.is_open ? "LIVE" : p.close_reason
        string be_txt     = p.tp1_hit ? " · BE" : ""
        string tp1_info   = tp1_on and not na(p.tp1_price) ? "TP1 " + str.tostring(p.tp1_price, format.mintick) + " → " : ""
        float tp_dist     = math.abs(p.tp_price - p.entry_price)
        float sl_dist     = math.abs(p.sl_price - p.entry_price)
        float sl_pips     = sl_dist / pip_size
        float rr_ratio    = sl_dist > 0 ? tp_dist / sl_dist : 0
        string rr_txt     = str.tostring(rr_ratio, "#.##") + ":1 RR"
        string sl_pips_txt = " (" + str.tostring(sl_pips, "#.#") + " pips)"
        string info_txt = dir_txt + " · " + str.tostring(p.risk_mult, "#.##") + "x · B" + str.tostring(p.band) + " · " + rr_txt + be_txt + "\n" + tp1_info + "TP " + str.tostring(p.tp_price, format.mintick) + " | SL " + str.tostring(p.sl_price, format.mintick) + sl_pips_txt + "\n" + status_txt

        if na(p.info_lbl)
            p.info_lbl := label.new(p.entry_time, p.entry_price, info_txt,
                 xloc=xloc.bar_time,
                 style=label.style_label_right, color=pos_label_bg_color,
                 textcolor=pos_label_text_color, size=pos_lbl_sz)
        else
            label.set_text(p.info_lbl, info_txt)
            label.set_textcolor(p.info_lbl, pos_label_text_color)

    true

// ═══════════════════════════════════════════════════════════════
// WEEK WINDOW
// ═══════════════════════════════════════════════════════════════
f_week_start(int t) =>
    int yy  = year(t, "UTC")
    int mm  = month(t, "UTC")
    int dd  = dayofmonth(t, "UTC")
    int dow = dayofweek(t, "UTC")
    int hr  = hour(t, "UTC")
    int days_back = dow == dayofweek.sunday ? (hr >= 22 ? 0 : 7) : (dow - 1)
    int this_day_midnight = timestamp("UTC", yy, mm, dd, 0, 0)
    int day_ms = 86400000
    (this_day_midnight - days_back * day_ms) + 22 * 3600000

int bar_week_start = f_week_start(time)

var bool engine_initialized = false
var int  cur_week_start     = 0
var bool new_long_fade_this_bar  = false
var bool new_short_fade_this_bar = false
var bool prev_trend_bull_rc = false
var bool prev_trend_bear_rc = false

// ═══════════════════════════════════════════════════════════════
// RECOIL ENGINE
// ═══════════════════════════════════════════════════════════════
new_long_fade_this_bar  := false
new_short_fade_this_bar := false

if barstate.isconfirmed
    bool week_rolled = false
    if not engine_initialized
        engine_initialized := true
        cur_week_start     := bar_week_start
    else if bar_week_start != cur_week_start
        cur_week_start := bar_week_start
        week_rolled    := true

    if week_rolled and reset_weekly
        int fsz_clear = array.size(fades)
        if fsz_clear > 0
            for ci = 0 to fsz_clear - 1
                cp = array.get(fades, ci)
                box.delete(cp.tp_box)
                box.delete(cp.sl_box)
                line.delete(cp.pnl_line)
                label.delete(cp.info_lbl)
        array.clear(fades)

    int fsz = array.size(fades)
    if fsz > 0
        for fi = 0 to fsz - 1
            p = array.get(fades, fi)
            if p.is_open and bar_index > p.entry_bar
                if tp1_on and not p.tp1_hit and not na(p.tp1_price)
                    bool hit_tp1 = p.is_long ? high >= p.tp1_price : low <= p.tp1_price
                    if hit_tp1
                        p.tp1_hit := true
                        if tp1_move_be
                            p.sl_price := p.entry_price

                bool hit_sl = p.is_long ? low  <= p.sl_price : high >= p.sl_price
                bool hit_tp = p.is_long ? high >= p.tp_price : low <= p.tp_price
                if hit_sl
                    p.is_open          := false
                    p.close_bar        := bar_index
                    p.close_price      := p.sl_price
                    p.close_reason     := "SL"
                    p.frozen_right_bar := bar_index
                else if hit_tp
                    p.is_open          := false
                    p.close_bar        := bar_index
                    p.close_price      := p.tp_price
                    p.close_reason     := p.tp1_hit ? "TP2" : "TP"
                    p.frozen_right_bar := bar_index
                else if fade_timeout_bars > 0 and bar_index - p.entry_bar >= fade_timeout_bars
                    p.is_open          := false
                    p.close_bar        := bar_index
                    p.close_price      := close
                    p.close_reason     := "TIME"
                    p.frozen_right_bar := bar_index

    bool flipped_to_bull = is_trend_bull and not prev_trend_bull_rc
    bool flipped_to_bear = is_trend_bear and not prev_trend_bear_rc
    if close_on_trend_flip and (flipped_to_bull or flipped_to_bear)
        int fsz_flip = array.size(fades)
        if fsz_flip > 0
            for fj = 0 to fsz_flip - 1
                fp = array.get(fades, fj)
                if fp.is_open and ((flipped_to_bull and not fp.is_long) or (flipped_to_bear and fp.is_long))
                    fp.is_open          := false
                    fp.close_bar        := bar_index
                    fp.close_price      := close
                    fp.close_reason     := "FLIP"
                    fp.frozen_right_bar := bar_index
    prev_trend_bull_rc := is_trend_bull
    prev_trend_bear_rc := is_trend_bear

    bool band_enabled = (volBand == 6 and fade_band6_on) or (volBand == 7 and fade_band7_on) or (volBand == 8 and fade_band8_on)
    float body_size  = math.abs(close - open)
    float range_size = high - low

    float min_body = math.max(syminfo.mintick, atrVal * min_body_atr)
    if band_enabled and body_size > min_body
        bool fade_is_long  = close < open
        bool fade_is_short = close > open

        float band_mult = volBand == 6 ? band6_mult : volBand == 7 ? band7_mult : band8_mult
        bool  trending  = is_trend_bull or is_trend_bear
        float align_mult = trend_consol_mult
        if trending
            bool with_trend = fade_is_long ? is_trend_bull : is_trend_bear
            align_mult := with_trend ? trend_with_mult : trend_against_mult
        float r_mult = band_mult * align_mult
        if true
            if r_mult > 0
                float wick_extreme = fade_is_long ? low : high
                create_fade(bar_index, time, close, fade_is_long, body_size, range_size, wick_extreme, r_mult, volBand)
                if fade_is_long
                    new_long_fade_this_bar := true
                else
                    new_short_fade_this_bar := true

// ═══════════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════════
alertcondition(new_long_fade_this_bar,  title="Recoil — Long Fade",  message="RECOIL: long fade triggered (bearish high-volatility closure)")
alertcondition(new_short_fade_this_bar, title="Recoil — Short Fade", message="RECOIL: short fade triggered (bullish high-volatility closure)")

// ═══════════════════════════════════════════════════════════════
// DASHBOARD
// ═══════════════════════════════════════════════════════════════
dash_txt_sz = size.large
dash_txt_sz := dash_size_str == "Tiny"  ? size.tiny  : dash_txt_sz
dash_txt_sz := dash_size_str == "Small" ? size.small : dash_txt_sz
dash_txt_sz := dash_size_str == "Normal" ? size.normal : dash_txt_sz

dash_pos = dash_position == "Bottom" ? position.bottom_right : position.top_right

var table dash = na

if show_dashboard
    if na(dash)
        dash := table.new(
             dash_pos, 2, 5,
             bgcolor=dash_bg_color,
             border_color=dash_border_color,
             border_width=1,
             frame_color=#c9a84c,
             frame_width=1)

    table.cell(dash, 0, 0, " QUANT PRIME — RECOIL ",
         text_color=dash_title_color,
         text_size=dash_txt_sz,
         bgcolor=color.rgb(10, 10, 25))
    table.merge_cells(dash, 0, 0, 1, 0)

    string vol_txt = " VOL: " + str.tostring(ratio, "#.##") + "x · B" + str.tostring(volBand) + " "
    table.cell(dash, 0, 1, " VOLATILITY ", text_color=dash_label_color, text_size=dash_txt_sz, bgcolor=dash_bg_color)
    table.cell(dash, 1, 1, vol_txt, text_color=volBand >= 6 ? volColor : dash_white, text_size=dash_txt_sz, bgcolor=dash_bg_color)

    string trend_str = is_trend_bull ? "BULL" : is_trend_bear ? "BEAR" : "CONSOLIDATION"
    color  trend_col = is_trend_bull ? dash_bull_color : is_trend_bear ? dash_bear_color : dash_label_color
    table.cell(dash, 0, 2, " TREND ", text_color=dash_label_color, text_size=dash_txt_sz, bgcolor=dash_bg_color)
    table.cell(dash, 1, 2, " " + trend_str + " ", text_color=trend_col, text_size=dash_txt_sz, bgcolor=dash_bg_color)

    table.cell(dash, 0, 3, " EMA BIAS ", text_color=dash_label_color, text_size=dash_txt_sz, bgcolor=dash_bg_color)
    table.cell(dash, 1, 3, " " + ema_bias_str + " ", text_color=ema_bias_col, text_size=dash_txt_sz, bgcolor=dash_bg_color)

    int open_fades = 0
    int fsz_d = array.size(fades)
    if fsz_d > 0
        for i = 0 to fsz_d - 1
            fd = array.get(fades, i)
            if fd.is_open
                open_fades += 1
    table.cell(dash, 0, 4, " OPEN FADES ", text_color=dash_label_color, text_size=dash_txt_sz, bgcolor=dash_bg_color)
    table.cell(dash, 1, 4, " " + str.tostring(open_fades) + " ", text_color=open_fades > 0 ? dash_bull_color : dash_white, text_size=dash_txt_sz, bgcolor=dash_bg_color)

// ═══════════════════════════════════════════════════════════════
// RENDER PASS
// ═══════════════════════════════════════════════════════════════
if barstate.islast and show_pos_boxes
    int fsz_render = array.size(fades)
    if fsz_render > 0
        for fi = 0 to fsz_render - 1
            p = array.get(fades, fi)
            render_fade(p, bar_index)

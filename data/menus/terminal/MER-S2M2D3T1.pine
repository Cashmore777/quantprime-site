//@version=6
// ═════════════════════════════════════════════════════════════
//  QUANT PRIME — BUILD MENU · TERMINAL TIER
//  MER-S2M2D3T1
//    S2  Liquidity Levels
//    M2  Liquidity Map
//    D3  Session Clock
//    T1  Sweep Report
// ═════════════════════════════════════════════════════════════

indicator("QP Terminal · S2M2D3T1", shorttitle = "QPS2M2D3T1", overlay = true, max_lines_count = 500, max_labels_count = 500)

// ═══════════════════════════════════════════════════════════════
//  QUANT PRIME — BUILD MENU · TERMINAL TIER
//  STARTER 2 · LIQUIDITY LEVELS
// ───────────────────────────────────────────────────────────────
//  A swing high is where somebody's stop is sitting. So is a
//  swing low. Those orders are the only thing on a chart that is
//  guaranteed to exist, and price has a persistent habit of going
//  to collect them before it does anything else.
//
//  This finds those levels across three timeframes using fractal
//  pivots, extends each one right, and freezes it the moment
//  price reaches through it. What is left running is the
//  liquidity that has not been taken yet.
//
//  A frozen level is not finished. Where price went afterwards is
//  the whole question, and the Sweep Tracker in the Main course
//  answers it.
//
//  Draws no table. Safe to combine with any other Meridian piece.
//  All identifiers namespaced s2_ to avoid collisions.
// ═══════════════════════════════════════════════════════════════

// ─── TIMEFRAMES ───────────────────────────────────────────────
s2_gTf = "Timeframes"

s2_t1On   = input.bool(true, "TF1", group = s2_gTf, inline = "t1")
s2_t1     = input.timeframe("3", "", group = s2_gTf, inline = "t1")
s2_t1L    = input.int(4, "L", minval = 1, maxval = 20, group = s2_gTf, inline = "t1")
s2_t1R    = input.int(2, "R", minval = 1, maxval = 20, group = s2_gTf, inline = "t1")
s2_t1Col  = input.color(#2962ff, "", group = s2_gTf, inline = "t1")

s2_t2On   = input.bool(true, "TF2", group = s2_gTf, inline = "t2")
s2_t2     = input.timeframe("30", "", group = s2_gTf, inline = "t2")
s2_t2L    = input.int(4, "L", minval = 1, maxval = 20, group = s2_gTf, inline = "t2")
s2_t2R    = input.int(2, "R", minval = 1, maxval = 20, group = s2_gTf, inline = "t2")
s2_t2Col  = input.color(#2962ff, "", group = s2_gTf, inline = "t2")

s2_t3On   = input.bool(true, "TF3", group = s2_gTf, inline = "t3")
s2_t3     = input.timeframe("180", "", group = s2_gTf, inline = "t3")
s2_t3L    = input.int(4, "L", minval = 1, maxval = 20, group = s2_gTf, inline = "t3")
s2_t3R    = input.int(2, "R", minval = 1, maxval = 20, group = s2_gTf, inline = "t3")
s2_t3Col  = input.color(#ffffff, "", group = s2_gTf, inline = "t3",
     tooltip = "L and R are how many bars either side a pivot needs to qualify. Higher values find fewer, more significant levels. R also delays confirmation by that many bars.")

// ─── LIFECYCLE ────────────────────────────────────────────────
s2_gLife = "Lifecycle"

s2_sweepMode = input.string("Wick through", "A level is swept by", options = ["Wick through", "Close beyond"], group = s2_gLife,
     tooltip = "Wick through freezes a level as soon as price reaches it, which is what taking liquidity actually looks like. Close beyond waits for a candle to finish past it, which finds fewer and larger events.")

s2_keepSwept = input.bool(true, "Keep swept levels visible", group = s2_gLife,
     tooltip = "On: a swept level stops extending and stays as a faded line. Off: it is removed. Keeping them shows you where liquidity has already been taken, which is often where price will not return.")

s2_sweptFade = input.int(65, "Swept level fade", minval = 0, maxval = 95, group = s2_gLife)

s2_maxLevels = input.int(200, "Maximum levels tracked", minval = 20, maxval = 500, group = s2_gLife,
     tooltip = "Three timeframes generate levels quickly. Once this is reached the oldest are removed.")

// ─── DISPLAY ──────────────────────────────────────────────────
s2_gDisp = "Display"

s2_showHighs = input.bool(true, "Highs", group = s2_gDisp, inline = "hl")
s2_showLows  = input.bool(true, "Lows",  group = s2_gDisp, inline = "hl")

s2_width = input.int(1, "Line width", minval = 1, maxval = 4, group = s2_gDisp)

s2_showTf = input.bool(false, "Label levels with their timeframe", group = s2_gDisp)
s2_lblSize = input.string("Tiny", "Label size", options = ["Tiny", "Small", "Normal"], group = s2_gDisp)

// ─── STORE ────────────────────────────────────────────────────
type S2Level
    float px
    bool  isHigh
    bool  swept
    color col
    line  ln
    label lb

var S2Level[] s2_levels = array.new<S2Level>()

s2_sizeOf(_s) =>
    _s == "Tiny" ? size.tiny : _s == "Small" ? size.small : size.normal

s2_tfLabel(string _tf) =>
    string _out = _tf
    float  _n   = str.tonumber(_tf)
    if not na(_n)
        int _m = int(_n)
        _out := _m >= 1440 and _m % 1440 == 0 ? str.tostring(_m / 1440) + "D" :
             _m >= 60 and _m % 60 == 0 ? str.tostring(_m / 60) + "H" :
             str.tostring(_m) + "M"
    _out

// Higher timeframe pivots repeat across several chart bars, so
// anything at effectively the same price is treated as already
// known rather than drawn twice.
s2_exists(float _px) =>
    bool _found = false
    int  _sz = array.size(s2_levels)
    if _sz > 0
        for i = 0 to _sz - 1
            S2Level _l = array.get(s2_levels, i)
            if not _l.swept and math.abs(_l.px - _px) < syminfo.mintick * 2
                _found := true
    _found

s2_add(float _px, bool _isHigh, color _col, int _right, string _tf) =>
    if not na(_px) and not s2_exists(_px) and (_isHigh ? s2_showHighs : s2_showLows)
        // Anchor to the pivot candle itself, not to the bar that
        // confirmed it R bars later.
        int _x1 = bar_index - _right
        line _ln = line.new(_x1, _px, bar_index + 1, _px,
             extend = extend.none, color = _col, width = s2_width)
        label _lb = na
        if s2_showTf
            _lb := label.new(bar_index + 1, _px, s2_tfLabel(_tf),
                 style = label.style_label_left, color = color.new(color.black, 100),
                 textcolor = _col, size = s2_sizeOf(s2_lblSize))
        array.push(s2_levels, S2Level.new(_px, _isHigh, false, _col, _ln, _lb))
        while array.size(s2_levels) > s2_maxLevels
            S2Level _old = array.shift(s2_levels)
            line.delete(_old.ln)
            label.delete(_old.lb)

// ─── PIVOT FEED ───────────────────────────────────────────────
[s2_h1, s2_l1] = request.security(syminfo.tickerid, s2_t1,
     [ta.pivothigh(high, s2_t1L, s2_t1R), ta.pivotlow(low, s2_t1L, s2_t1R)], lookahead = barmerge.lookahead_off)
[s2_h2, s2_l2] = request.security(syminfo.tickerid, s2_t2,
     [ta.pivothigh(high, s2_t2L, s2_t2R), ta.pivotlow(low, s2_t2L, s2_t2R)], lookahead = barmerge.lookahead_off)
[s2_h3, s2_l3] = request.security(syminfo.tickerid, s2_t3,
     [ta.pivothigh(high, s2_t3L, s2_t3R), ta.pivotlow(low, s2_t3L, s2_t3R)], lookahead = barmerge.lookahead_off)

if barstate.isconfirmed
    if s2_t1On
        s2_add(s2_h1, true,  s2_t1Col, s2_t1R, s2_t1)
        s2_add(s2_l1, false, s2_t1Col, s2_t1R, s2_t1)
    if s2_t2On
        s2_add(s2_h2, true,  s2_t2Col, s2_t2R, s2_t2)
        s2_add(s2_l2, false, s2_t2Col, s2_t2R, s2_t2)
    if s2_t3On
        s2_add(s2_h3, true,  s2_t3Col, s2_t3R, s2_t3)
        s2_add(s2_l3, false, s2_t3Col, s2_t3R, s2_t3)

    // --- extend live levels, freeze the ones price has taken ---
    int s2_n = array.size(s2_levels)
    if s2_n > 0
        for i = 0 to s2_n - 1
            S2Level _l = array.get(s2_levels, i)
            if not _l.swept and not na(_l.ln)
                bool _hit = s2_sweepMode == "Wick through" ?
                     (_l.isHigh ? high >= _l.px : low <= _l.px) :
                     (_l.isHigh ? close > _l.px : close < _l.px)
                if _hit
                    _l.swept := true
                    if s2_keepSwept
                        line.set_x2(_l.ln, bar_index)
                        line.set_style(_l.ln, line.style_dotted)
                        line.set_color(_l.ln, color.new(_l.col, s2_sweptFade))
                        label.delete(_l.lb)
                        _l.lb := na
                    else
                        line.delete(_l.ln)
                        label.delete(_l.lb)
                        _l.ln := na
                        _l.lb := na
                else
                    line.set_x2(_l.ln, bar_index + 1)
                    if not na(_l.lb)
                        label.set_x(_l.lb, bar_index + 1)

// ─── ALERTS ───────────────────────────────────────────────────
// Fires when any tracked level is taken on this bar.
s2_sweptThisBar = false
if barstate.isconfirmed
    int _n2 = array.size(s2_levels)
    if _n2 > 0
        for i = 0 to _n2 - 1
            S2Level _l = array.get(s2_levels, i)
            if _l.swept and not na(_l.ln) and line.get_x2(_l.ln) == bar_index
                s2_sweptThisBar := true

alertcondition(s2_sweptThisBar, "Liquidity swept",
     "A tracked liquidity level has been taken.")

// ═══════════════════════════════════════════════════════════════
//  QUANT PRIME — BUILD MENU · TERMINAL TIER
//  MAIN 2 · LIQUIDITY MAP
// ───────────────────────────────────────────────────────────────
//  Where is price actually going.
//
//  The Sweep Tracker looks backwards at levels that have already
//  been taken. This looks forwards at the ones that have not.
//
//  Every unswept level above and below current price, sorted by
//  distance, with the nearest on each side highlighted. Then a
//  simple imbalance reading: if there are nine unswept levels
//  above and two below, the resting orders are mostly overhead,
//  and price has more to collect in that direction.
//
//  That is not a prediction. Liquidity sitting above price is not
//  a reason to be long. It is a statement about where the obvious
//  stops are, and what the market has left to do if it goes
//  looking for them.
//
//  Draws one table. All identifiers namespaced m2_.
// ═══════════════════════════════════════════════════════════════

// ─── TIMEFRAMES ───────────────────────────────────────────────
m2_gTf = "Levels"

m2_t1On = input.bool(true, "TF1", group = m2_gTf, inline = "t1")
m2_t1   = input.timeframe("3", "", group = m2_gTf, inline = "t1")
m2_t1L  = input.int(4, "L", minval = 1, maxval = 20, group = m2_gTf, inline = "t1")
m2_t1R  = input.int(2, "R", minval = 1, maxval = 20, group = m2_gTf, inline = "t1")

m2_t2On = input.bool(true, "TF2", group = m2_gTf, inline = "t2")
m2_t2   = input.timeframe("30", "", group = m2_gTf, inline = "t2")
m2_t2L  = input.int(4, "L", minval = 1, maxval = 20, group = m2_gTf, inline = "t2")
m2_t2R  = input.int(2, "R", minval = 1, maxval = 20, group = m2_gTf, inline = "t2")

m2_t3On = input.bool(true, "TF3", group = m2_gTf, inline = "t3")
m2_t3   = input.timeframe("180", "", group = m2_gTf, inline = "t3")
m2_t3L  = input.int(4, "L", minval = 1, maxval = 20, group = m2_gTf, inline = "t3")
m2_t3R  = input.int(2, "R", minval = 1, maxval = 20, group = m2_gTf, inline = "t3",
     tooltip = "Higher L and R finds fewer, more significant levels. A 3H level matters considerably more than a 3M one.")

// ─── MAP ──────────────────────────────────────────────────────
m2_gMap = "Map"

m2_show = input.int(4, "Levels to list each side", minval = 1, maxval = 8, group = m2_gMap,
     tooltip = "How many unswept levels above and below to list in the table, nearest first.")

m2_range = input.float(0.0, "Ignore levels beyond N x ATR", minval = 0.0, step = 0.5, group = m2_gMap,
     tooltip = "Levels further away than this are excluded from the map and the imbalance count. 0 disables the filter. Useful on instruments with a long history of far-away pivots that will not be reached today.")

m2_atrLen = input.int(14, "ATR length", minval = 1, group = m2_gMap)

m2_unit = input.string("Pips", "Distance shown in", options = ["Pips", "ATR", "Price"], group = m2_gMap)

// ─── DISPLAY ──────────────────────────────────────────────────
m2_gDisp = "Display"

m2_showLines = input.bool(true, "Draw unswept levels", group = m2_gDisp)
m2_markNear  = input.bool(true, "Highlight the nearest each side", group = m2_gDisp)

m2_aboveCol = input.color(#b4342a, "Above", group = m2_gDisp, inline = "c")
m2_belowCol = input.color(#2f6b41, "Below", group = m2_gDisp, inline = "c")
m2_nearCol  = input.color(#c9a84c, "Nearest", group = m2_gDisp, inline = "c")

m2_width  = input.int(1, "Line width", minval = 1, maxval = 3, group = m2_gDisp)
m2_maxLv  = input.int(150, "Maximum levels tracked", minval = 20, maxval = 500, group = m2_gDisp)

// ─── TABLE ────────────────────────────────────────────────────
m2_gTbl = "Table"

m2_tblOn   = input.bool(true, "Show table", group = m2_gTbl)
m2_tblPos  = input.string("Top Right", "Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right"], group = m2_gTbl)
m2_tblSize = input.string("Tiny", "Size", options = ["Tiny", "Small", "Normal"], group = m2_gTbl)

// ─── STATE ────────────────────────────────────────────────────
type M2Level
    float px
    bool  isHigh
    string tf
    bool  swept
    line  ln

var M2Level[] m2_levels = array.new<M2Level>()

m2_atr = ta.atr(m2_atrLen)

m2_pipMult() =>
    str.contains(syminfo.ticker, "JPY") ? 100.0 :
     str.contains(syminfo.ticker, "XAU") or str.contains(syminfo.ticker, "XAG") ? 10.0 :
     syminfo.type == "forex" ? 10000.0 : 1.0

m2_sizeOf(_s) =>
    _s == "Tiny" ? size.tiny : _s == "Small" ? size.small : size.normal

m2_posOf(_p) =>
    _p == "Top Left" ? position.top_left :
     _p == "Bottom Right" ? position.bottom_right :
     _p == "Bottom Left" ? position.bottom_left :
     _p == "Middle Right" ? position.middle_right : position.top_right

m2_tfLabel(string _tf) =>
    string _out = _tf
    float  _n   = str.tonumber(_tf)
    if not na(_n)
        int _m = int(_n)
        _out := _m >= 1440 and _m % 1440 == 0 ? str.tostring(_m / 1440) + "D" :
             _m >= 60 and _m % 60 == 0 ? str.tostring(_m / 60) + "H" :
             str.tostring(_m) + "M"
    _out

m2_dist(float _px) =>
    float _d = math.abs(_px - close)
    m2_unit == "Pips" ? _d * m2_pipMult() :
     m2_unit == "ATR" ? (m2_atr > 0 ? _d / m2_atr : 0.0) : _d

m2_distStr(float _px) =>
    float _v = m2_dist(_px)
    m2_unit == "Pips" ? str.tostring(math.round(_v, 1)) :
     m2_unit == "ATR" ? str.tostring(math.round(_v, 2)) + "x" :
     str.tostring(math.round_to_mintick(_v))

m2_known(float _px) =>
    bool _f = false
    int _n = array.size(m2_levels)
    if _n > 0
        for i = 0 to _n - 1
            M2Level _l = array.get(m2_levels, i)
            if not _l.swept and math.abs(_l.px - _px) < syminfo.mintick * 2
                _f := true
    _f

m2_add(float _px, bool _isHigh, string _tf, int _right) =>
    if not na(_px) and not m2_known(_px)
        line _ln = na
        if m2_showLines
            _ln := line.new(bar_index - _right, _px, bar_index + 1, _px,
                 color = _isHigh ? m2_aboveCol : m2_belowCol, width = m2_width)
        array.push(m2_levels, M2Level.new(_px, _isHigh, _tf, false, _ln))
        while array.size(m2_levels) > m2_maxLv
            M2Level _old = array.shift(m2_levels)
            line.delete(_old.ln)

// ─── PIVOT FEED ───────────────────────────────────────────────
[m2_h1, m2_l1] = request.security(syminfo.tickerid, m2_t1,
     [ta.pivothigh(high, m2_t1L, m2_t1R), ta.pivotlow(low, m2_t1L, m2_t1R)], lookahead = barmerge.lookahead_off)
[m2_h2, m2_l2] = request.security(syminfo.tickerid, m2_t2,
     [ta.pivothigh(high, m2_t2L, m2_t2R), ta.pivotlow(low, m2_t2L, m2_t2R)], lookahead = barmerge.lookahead_off)
[m2_h3, m2_l3] = request.security(syminfo.tickerid, m2_t3,
     [ta.pivothigh(high, m2_t3L, m2_t3R), ta.pivotlow(low, m2_t3L, m2_t3R)], lookahead = barmerge.lookahead_off)

// ─── ENGINE ───────────────────────────────────────────────────
if barstate.isconfirmed
    if m2_t1On
        m2_add(m2_h1, true,  m2_t1, m2_t1R)
        m2_add(m2_l1, false, m2_t1, m2_t1R)
    if m2_t2On
        m2_add(m2_h2, true,  m2_t2, m2_t2R)
        m2_add(m2_l2, false, m2_t2, m2_t2R)
    if m2_t3On
        m2_add(m2_h3, true,  m2_t3, m2_t3R)
        m2_add(m2_l3, false, m2_t3, m2_t3R)

    int m2_n = array.size(m2_levels)
    if m2_n > 0
        for i = 0 to m2_n - 1
            M2Level _l = array.get(m2_levels, i)
            if not _l.swept
                // once taken, a level leaves the map entirely
                if _l.isHigh ? high >= _l.px : low <= _l.px
                    _l.swept := true
                    line.delete(_l.ln)
                    _l.ln := na
                else if not na(_l.ln)
                    line.set_x2(_l.ln, bar_index + 1)

// ─── BUILD THE MAP ────────────────────────────────────────────
//  Collected fresh each bar: unswept, within range, sorted by
//  distance from price.
var float[] m2_upPx  = array.new_float()
var float[] m2_dnPx  = array.new_float()
var string[] m2_upTf = array.new_string()
var string[] m2_dnTf = array.new_string()

if barstate.islast
    array.clear(m2_upPx)
    array.clear(m2_dnPx)
    array.clear(m2_upTf)
    array.clear(m2_dnTf)

    int _n = array.size(m2_levels)
    if _n > 0
        for i = 0 to _n - 1
            M2Level _l = array.get(m2_levels, i)
            if not _l.swept
                bool _inRange = m2_range <= 0 or m2_atr <= 0 or
                     math.abs(_l.px - close) <= m2_atr * m2_range
                if _inRange
                    if _l.px > close
                        array.push(m2_upPx, _l.px)
                        array.push(m2_upTf, _l.tf)
                    else if _l.px < close
                        array.push(m2_dnPx, _l.px)
                        array.push(m2_dnTf, _l.tf)

    // insertion sort: above ascending, below descending. Both put
    // the nearest to current price first.
    int _un = array.size(m2_upPx)
    if _un > 1
        for i = 1 to _un - 1
            float _p = array.get(m2_upPx, i)
            string _t = array.get(m2_upTf, i)
            int j = i - 1
            while j >= 0 and array.get(m2_upPx, j) > _p
                array.set(m2_upPx, j + 1, array.get(m2_upPx, j))
                array.set(m2_upTf, j + 1, array.get(m2_upTf, j))
                j -= 1
            array.set(m2_upPx, j + 1, _p)
            array.set(m2_upTf, j + 1, _t)

    int _dn = array.size(m2_dnPx)
    if _dn > 1
        for i = 1 to _dn - 1
            float _p = array.get(m2_dnPx, i)
            string _t = array.get(m2_dnTf, i)
            int j = i - 1
            while j >= 0 and array.get(m2_dnPx, j) < _p
                array.set(m2_dnPx, j + 1, array.get(m2_dnPx, j))
                array.set(m2_dnTf, j + 1, array.get(m2_dnTf, j))
                j -= 1
            array.set(m2_dnPx, j + 1, _p)
            array.set(m2_dnTf, j + 1, _t)

// ─── HIGHLIGHT NEAREST ────────────────────────────────────────
if m2_markNear and barstate.islast
    int _n2 = array.size(m2_levels)
    float _nearUp = array.size(m2_upPx) > 0 ? array.get(m2_upPx, 0) : na
    float _nearDn = array.size(m2_dnPx) > 0 ? array.get(m2_dnPx, 0) : na
    if _n2 > 0
        for i = 0 to _n2 - 1
            M2Level _l = array.get(m2_levels, i)
            if not _l.swept and not na(_l.ln)
                bool _isNear = (not na(_nearUp) and _l.px == _nearUp) or
                     (not na(_nearDn) and _l.px == _nearDn)
                line.set_color(_l.ln, _isNear ? m2_nearCol :
                     _l.isHigh ? m2_aboveCol : m2_belowCol)
                line.set_width(_l.ln, _isNear ? m2_width + 1 : m2_width)

// ─── TABLE ────────────────────────────────────────────────────
var table m2_tbl = na

if m2_tblOn and barstate.islast
    int _rows = m2_show * 2 + 3
    if na(m2_tbl)
        m2_tbl := table.new(m2_posOf(m2_tblPos), 3, _rows,
             bgcolor = color.new(color.black, 20),
             border_color = color.new(color.gray, 60),
             border_width = 1)

    color _hdr = color.new(color.gray, 20)
    string _uLbl = m2_unit == "Pips" ? "PIPS" : m2_unit == "ATR" ? "ATR" : "DIST"

    table.cell(m2_tbl, 0, 0, "MAP",  text_color = _hdr, text_size = m2_sizeOf(m2_tblSize))
    table.cell(m2_tbl, 1, 0, "TF",   text_color = _hdr, text_size = m2_sizeOf(m2_tblSize))
    table.cell(m2_tbl, 2, 0, _uLbl,  text_color = _hdr, text_size = m2_sizeOf(m2_tblSize))

    int _r = 1
    int _nUp = array.size(m2_upPx)

    // above, furthest first so the list reads top down like a chart
    for i = 0 to m2_show - 1
        int _idx = m2_show - 1 - i
        if _idx < _nUp
            float _px = array.get(m2_upPx, _idx)
            bool _isNear = _idx == 0
            table.cell(m2_tbl, 0, _r, str.tostring(math.round_to_mintick(_px)),
                 text_color = _isNear ? m2_nearCol : m2_aboveCol, text_size = m2_sizeOf(m2_tblSize))
            table.cell(m2_tbl, 1, _r, m2_tfLabel(array.get(m2_upTf, _idx)),
                 text_color = color.new(color.gray, 20), text_size = m2_sizeOf(m2_tblSize))
            table.cell(m2_tbl, 2, _r, m2_distStr(_px),
                 text_color = _isNear ? m2_nearCol : m2_aboveCol, text_size = m2_sizeOf(m2_tblSize))
        else
            table.cell(m2_tbl, 0, _r, "—", text_color = color.new(color.gray, 50), text_size = m2_sizeOf(m2_tblSize))
            table.cell(m2_tbl, 1, _r, "",  text_size = m2_sizeOf(m2_tblSize))
            table.cell(m2_tbl, 2, _r, "",  text_size = m2_sizeOf(m2_tblSize))
        _r += 1

    // price row
    table.cell(m2_tbl, 0, _r, str.tostring(math.round_to_mintick(close)),
         text_color = color.white, text_size = m2_sizeOf(m2_tblSize))
    table.cell(m2_tbl, 1, _r, "NOW", text_color = color.white, text_size = m2_sizeOf(m2_tblSize))
    table.cell(m2_tbl, 2, _r, "", text_size = m2_sizeOf(m2_tblSize))
    _r += 1

    // below, nearest first
    int _nDn = array.size(m2_dnPx)
    for i = 0 to m2_show - 1
        if i < _nDn
            float _px = array.get(m2_dnPx, i)
            bool _isNear = i == 0
            table.cell(m2_tbl, 0, _r, str.tostring(math.round_to_mintick(_px)),
                 text_color = _isNear ? m2_nearCol : m2_belowCol, text_size = m2_sizeOf(m2_tblSize))
            table.cell(m2_tbl, 1, _r, m2_tfLabel(array.get(m2_dnTf, i)),
                 text_color = color.new(color.gray, 20), text_size = m2_sizeOf(m2_tblSize))
            table.cell(m2_tbl, 2, _r, m2_distStr(_px),
                 text_color = _isNear ? m2_nearCol : m2_belowCol, text_size = m2_sizeOf(m2_tblSize))
        else
            table.cell(m2_tbl, 0, _r, "—", text_color = color.new(color.gray, 50), text_size = m2_sizeOf(m2_tblSize))
            table.cell(m2_tbl, 1, _r, "",  text_size = m2_sizeOf(m2_tblSize))
            table.cell(m2_tbl, 2, _r, "",  text_size = m2_sizeOf(m2_tblSize))
        _r += 1

    // imbalance row
    string _imb = _nUp + _nDn == 0 ? "—" :
         str.tostring(_nUp) + " up / " + str.tostring(_nDn) + " dn"
    color _imbCol = _nUp == _nDn ? color.new(color.gray, 20) :
         _nUp > _nDn ? m2_aboveCol : m2_belowCol

    table.cell(m2_tbl, 0, _r, "RESTING", text_color = _hdr, text_size = m2_sizeOf(m2_tblSize))
    table.cell(m2_tbl, 1, _r, _imb, text_color = _imbCol, text_size = m2_sizeOf(m2_tblSize))
    table.cell(m2_tbl, 2, _r, "", text_size = m2_sizeOf(m2_tblSize))

// ─── ALERTS ───────────────────────────────────────────────────
m2_nearUpNow = array.size(m2_upPx) > 0 ? array.get(m2_upPx, 0) : na
m2_nearDnNow = array.size(m2_dnPx) > 0 ? array.get(m2_dnPx, 0) : na

alertcondition(not na(m2_nearUpNow) and m2_atr > 0 and (m2_nearUpNow - close) <= m2_atr * 0.25,
     "Approaching liquidity above", "Price is within a quarter ATR of the nearest unswept level above.")

alertcondition(not na(m2_nearDnNow) and m2_atr > 0 and (close - m2_nearDnNow) <= m2_atr * 0.25,
     "Approaching liquidity below", "Price is within a quarter ATR of the nearest unswept level below.")

// ═══════════════════════════════════════════════════════════════
//  QUANT PRIME — BUILD MENU · TERMINAL TIER
//  SIDE 3 · SESSION CLOCK
// ───────────────────────────────────────────────────────────────
//  Is a window open, and how long has it got.
//
//  Meridian only resolves conditions inside its trading windows.
//  Outside them the engine still sees sweeps and rejections and
//  does nothing with them, which is the single most common reason
//  somebody concludes the instrument is broken.
//
//  This says plainly whether a window is live, how much of it is
//  left, and how long until the next one opens.
//
//  It pairs with the Phase Clock. That one counts the AMD cycle
//  in the anchor timezone; this counts the trading windows in
//  UTC. Two different clocks, and the instrument runs on both.
//
//  The defaults are Meridian's own windows, in UTC. If you have
//  changed them in the instrument, change them here too or this
//  will be counting down to windows that do not exist.
//
//  Draws one table and optional shading. Namespaced d3_.
// ═══════════════════════════════════════════════════════════════

// ─── WINDOWS ──────────────────────────────────────────────────
d3_gWin = "Windows"

d3_tz = input.string("UTC", "Timezone", group = d3_gWin,
     options = ["UTC-12","UTC-11","UTC-10","UTC-9","UTC-8","UTC-7","UTC-6","UTC-5","UTC-4","UTC-3","UTC-2","UTC-1",
                "UTC","UTC+1","UTC+2","UTC+3","UTC+4","UTC+5","UTC+6","UTC+7","UTC+8","UTC+9","UTC+10","UTC+11","UTC+12"],
     tooltip = "Meridian's windows are expressed in plain UTC. This is a separate setting from the AMD cycle anchor, which defaults to UTC+1.")

d3_w1On   = input.bool(true, "W1", group = d3_gWin, inline = "w1")
d3_w1From = input.int(0, "from", minval = 0, maxval = 23, group = d3_gWin, inline = "w1")
d3_w1To   = input.int(2, "to",   minval = 1, maxval = 24, group = d3_gWin, inline = "w1")

d3_w2On   = input.bool(true, "W2", group = d3_gWin, inline = "w2")
d3_w2From = input.int(4, "from", minval = 0, maxval = 23, group = d3_gWin, inline = "w2")
d3_w2To   = input.int(6, "to",   minval = 1, maxval = 24, group = d3_gWin, inline = "w2")

d3_w3On   = input.bool(true, "W3", group = d3_gWin, inline = "w3")
d3_w3From = input.int(19, "from", minval = 0, maxval = 23, group = d3_gWin, inline = "w3")
d3_w3To   = input.int(20, "to",   minval = 1, maxval = 24, group = d3_gWin, inline = "w3",
     tooltip = "Defaults are Meridian's shipped windows. Whether they hold on your instrument is a question the Session Report answers.")

// ─── WARNING ──────────────────────────────────────────────────
d3_gWarn = "Warning"

d3_warnOn  = input.bool(true, "Flag when a window is nearly over", group = d3_gWarn)
d3_warnMin = input.int(10, "Minutes remaining to flag at", minval = 1, maxval = 120, group = d3_gWarn,
     tooltip = "A condition resolving in the last few minutes of a window leaves very little room for it to work.")

// ─── DISPLAY ──────────────────────────────────────────────────
d3_gDisp = "Display"

d3_shade = input.bool(true, "Shade the live window", group = d3_gDisp)
d3_fade  = input.int(93, "Shading transparency", minval = 80, maxval = 99, group = d3_gDisp)

d3_tblPos  = input.string("Bottom Left", "Table position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right"], group = d3_gDisp)
d3_tblSize = input.string("Tiny", "Table size", options = ["Tiny", "Small", "Normal"], group = d3_gDisp)

d3_openCol  = input.color(#ffb74d, "Open",    group = d3_gDisp, inline = "c")
d3_shutCol  = input.color(#9a9da3, "Closed",  group = d3_gDisp, inline = "c")
d3_warnCol  = input.color(#ffffff, "Warning", group = d3_gDisp, inline = "c")

// ─── ENGINE ───────────────────────────────────────────────────
// Minutes elapsed since midnight in the chosen timezone.
d3_now = hour(time, d3_tz) * 60.0 + minute(time, d3_tz) + second(time, d3_tz) / 60.0

// Windows are half open: from inclusive, to exclusive. A window
// whose "to" is less than its "from" wraps past midnight.
d3_inWin(bool _on, int _f, int _t) =>
    bool _r = false
    if _on
        float _fm = _f * 60.0
        float _tm = _t * 60.0
        _r := _tm > _fm ? (d3_now >= _fm and d3_now < _tm) :
             (d3_now >= _fm or d3_now < _tm)
    _r

// Minutes until a window closes. Only meaningful while inside it.
d3_leftIn(int _f, int _t) =>
    float _tm = _t * 60.0
    float _fm = _f * 60.0
    float _r = 0.0
    if _tm > _fm
        _r := _tm - d3_now
    else
        _r := d3_now >= _fm ? (1440.0 - d3_now) + _tm : _tm - d3_now
    _r

// Minutes until a window opens. Only meaningful while outside it.
d3_untilIn(int _f) =>
    float _fm = _f * 60.0
    _fm > d3_now ? _fm - d3_now : (1440.0 - d3_now) + _fm

d3_clock(float _mins) =>
    int _m = int(math.round(_mins))
    _m >= 60 ? str.tostring(math.floor(_m / 60)) + "h " +
         str.format("{0,number,00}", _m % 60) + "m" :
         str.tostring(_m) + "m"

d3_sizeOf(_s) =>
    _s == "Tiny" ? size.tiny : _s == "Small" ? size.small : size.normal

d3_posOf(_p) =>
    _p == "Top Right" ? position.top_right :
     _p == "Top Left" ? position.top_left :
     _p == "Bottom Right" ? position.bottom_right :
     _p == "Middle Right" ? position.middle_right : position.bottom_left

d3_pad(int _h) =>
    str.format("{0,number,00}", _h) + ":00"

// ─── STATE ────────────────────────────────────────────────────
d3_in1 = d3_inWin(d3_w1On, d3_w1From, d3_w1To)
d3_in2 = d3_inWin(d3_w2On, d3_w2From, d3_w2To)
d3_in3 = d3_inWin(d3_w3On, d3_w3From, d3_w3To)

d3_anyOpen = d3_in1 or d3_in2 or d3_in3

// minutes left on whichever window is live
d3_liveLeft = d3_in1 ? d3_leftIn(d3_w1From, d3_w1To) :
     d3_in2 ? d3_leftIn(d3_w2From, d3_w2To) :
     d3_in3 ? d3_leftIn(d3_w3From, d3_w3To) : na

d3_closingSoon = d3_warnOn and d3_anyOpen and not na(d3_liveLeft) and d3_liveLeft <= d3_warnMin

// soonest window to open, when nothing is live
float d3_nextIn = na
int   d3_nextNo = 0
if not d3_anyOpen
    if d3_w1On
        float _u = d3_untilIn(d3_w1From)
        if na(d3_nextIn) or _u < d3_nextIn
            d3_nextIn := _u
            d3_nextNo := 1
    if d3_w2On
        float _u = d3_untilIn(d3_w2From)
        if na(d3_nextIn) or _u < d3_nextIn
            d3_nextIn := _u
            d3_nextNo := 2
    if d3_w3On
        float _u = d3_untilIn(d3_w3From)
        if na(d3_nextIn) or _u < d3_nextIn
            d3_nextIn := _u
            d3_nextNo := 3

// ─── SHADING ──────────────────────────────────────────────────
bgcolor(d3_shade and d3_anyOpen ?
     color.new(d3_closingSoon ? d3_warnCol : d3_openCol, d3_fade) : na,
     title = "Live window")

// ─── TABLE ────────────────────────────────────────────────────
var table d3_tbl = na

if barstate.islast
    if na(d3_tbl)
        d3_tbl := table.new(d3_posOf(d3_tblPos), 3, 5,
             bgcolor = color.new(color.black, 20),
             border_color = color.new(color.gray, 60),
             border_width = 1)

    color _hdr = color.new(color.gray, 20)
    string _sz = d3_tblSize

    // headline status
    string _statTxt = d3_anyOpen ? "OPEN" : "CLOSED"
    color  _statCol = d3_closingSoon ? d3_warnCol : d3_anyOpen ? d3_openCol : d3_shutCol
    string _statRhs = d3_anyOpen ?
         (na(d3_liveLeft) ? "" : d3_clock(d3_liveLeft) + " left") :
         (na(d3_nextIn) ? "no windows on" : "W" + str.tostring(d3_nextNo) + " in " + d3_clock(d3_nextIn))

    table.cell(d3_tbl, 0, 0, "WINDOW", text_color = _hdr, text_size = d3_sizeOf(_sz))
    table.cell(d3_tbl, 1, 0, _statTxt, text_color = _statCol, text_size = d3_sizeOf(_sz))
    table.cell(d3_tbl, 2, 0, _statRhs, text_color = _statCol, text_size = d3_sizeOf(_sz))

    // the three windows
    bool[] _ons  = array.from(d3_w1On, d3_w2On, d3_w3On)
    int[]  _frs  = array.from(d3_w1From, d3_w2From, d3_w3From)
    int[]  _tos  = array.from(d3_w1To, d3_w2To, d3_w3To)
    bool[] _ins  = array.from(d3_in1, d3_in2, d3_in3)

    for i = 0 to 2
        int _row = i + 1
        bool _on = array.get(_ons, i)
        bool _live = array.get(_ins, i)

        table.cell(d3_tbl, 0, _row, "W" + str.tostring(i + 1),
             text_color = _on ? color.white : color.new(color.gray, 60), text_size = d3_sizeOf(_sz))

        table.cell(d3_tbl, 1, _row, _on ?
             d3_pad(array.get(_frs, i)) + "–" + d3_pad(array.get(_tos, i)) : "off",
             text_color = _on ? (_live ? d3_openCol : color.white) : color.new(color.gray, 60),
             text_size = d3_sizeOf(_sz))

        string _rhs = not _on ? "" :
             _live ? d3_clock(d3_leftIn(array.get(_frs, i), array.get(_tos, i))) + " left" :
             "in " + d3_clock(d3_untilIn(array.get(_frs, i)))

        table.cell(d3_tbl, 2, _row, _rhs,
             text_color = _live ? (d3_closingSoon ? d3_warnCol : d3_openCol) : color.new(color.gray, 30),
             text_size = d3_sizeOf(_sz))

    // timezone reminder, because this is the thing that gets set wrong
    table.cell(d3_tbl, 0, 4, "TZ", text_color = _hdr, text_size = d3_sizeOf(_sz))
    table.cell(d3_tbl, 1, 4, d3_tz, text_color = color.new(color.gray, 20), text_size = d3_sizeOf(_sz))
    table.cell(d3_tbl, 2, 4, "", text_size = d3_sizeOf(_sz))

// ─── ALERTS ───────────────────────────────────────────────────
alertcondition(d3_anyOpen and not d3_anyOpen[1], "Window opened",
     "A Meridian trading window has opened.")

alertcondition(not d3_anyOpen and d3_anyOpen[1], "Window closed",
     "The Meridian trading window has closed. Conditions will not resolve until the next one.")

alertcondition(d3_closingSoon and not d3_closingSoon[1], "Window closing soon",
     "The live trading window is nearly over.")

// ═══════════════════════════════════════════════════════════════
//  QUANT PRIME — BUILD MENU · TERMINAL TIER
//  DESSERT 1 · SWEEP REPORT
// ───────────────────────────────────────────────────────────────
//  Does the premise hold on your instrument.
//
//  When price takes out a prior high or low, two things can
//  happen. It comes back through, meaning the break failed and the
//  move was a grab for the orders resting there. Or it stays
//  beyond and runs, meaning the level genuinely broke.
//
//  Meridian's whole premise is that the first happens more often
//  than the second. That was measured on one instrument. Whether
//  it survives on yours is a question only your own data answers.
//
//  Note this is a different event to what Recoil measures. Recoil
//  fades an exceptional candle. This measures whether a broken
//  level holds.
//
//  This runs the test. Every level swept in your history, split by
//  timeframe, graded on what price did afterwards:
//
//    REVERSED     came back through by the required amount
//    RAN ON       stayed beyond and kept going
//    UNRESOLVED   neither, inside the window
//
//  A reversal rate meaningfully above 50% supports the premise on
//  that timeframe. Around 50% means a break tells you nothing on
//  its own. Below it means the opposite is true on your pair, and
//  trading the failure puts you on the wrong side of it.
//
//  Rows with fewer than thirty graded sweeps are left ungraded,
//  because a 70% rate from six occurrences means nothing and
//  showing it as a number invites exactly the wrong conclusion.
//
//  Use a large sample. Five thousand candles, not five hundred.
//  Meridian's levels are swept less often than Recoil's candles
//  fire, so this table fills slowly.
//
//  Draws one table. Namespaced t1_.
// ═══════════════════════════════════════════════════════════════

// ─── TIMEFRAMES ───────────────────────────────────────────────
t1_gTf = "Levels"

t1_t1On = input.bool(true, "TF1", group = t1_gTf, inline = "t1")
t1_t1   = input.timeframe("3", "", group = t1_gTf, inline = "t1")
t1_t2On = input.bool(true, "TF2", group = t1_gTf, inline = "t2")
t1_t2   = input.timeframe("30", "", group = t1_gTf, inline = "t2")
t1_t3On = input.bool(true, "TF3", group = t1_gTf, inline = "t3")
t1_t3   = input.timeframe("180", "", group = t1_gTf, inline = "t3")

t1_pvL = input.int(4, "Pivot L", minval = 1, maxval = 20, group = t1_gTf, inline = "p")
t1_pvR = input.int(2, "Pivot R", minval = 1, maxval = 20, group = t1_gTf, inline = "p",
     tooltip = "Applied to all three timeframes. Higher values find fewer, more significant levels and will slow the sample down further.")

// ─── TEST ─────────────────────────────────────────────────────
t1_gTest = "Test"

t1_mode = input.string("Wick through", "A sweep is", options = ["Wick through", "Close beyond"], group = t1_gTest,
     tooltip = "Should match how you read a sweep on the chart. Close beyond finds fewer events and tends to produce higher rejection rates, because it has already filtered out the shallowest touches.")

t1_window = input.int(20, "Grade over N bars", minval = 3, maxval = 200, group = t1_gTest)

t1_rejPct = input.float(50.0, "Rejection needs % of the overshoot back", minval = 10.0, maxval = 100.0, step = 5.0, group = t1_gTest,
     tooltip = "How much of the move beyond the level price must give back for the sweep to grade REJECTED. Measured as a percentage of how far beyond it went, so it scales across instruments.")

t1_minSample = input.int(30, "Minimum graded sweeps", minval = 5, maxval = 200, group = t1_gTest,
     tooltip = "Rows below this are shown but left ungraded. Lowering it does not make a thin sample meaningful.")

// ─── SPLIT ────────────────────────────────────────────────────
t1_gSplit = "Split"

t1_bySide = input.bool(true, "Separate highs from lows", group = t1_gSplit,
     tooltip = "Highs taken and lows taken are not the same event on most instruments, and a pair that behaves symmetrically is worth knowing about.")

t1_maxLv = input.int(400, "Levels tracked", minval = 50, maxval = 500, group = t1_gSplit)

// ─── TABLE ────────────────────────────────────────────────────
t1_gTbl = "Table"

t1_tblPos  = input.string("Bottom Right", "Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right"], group = t1_gTbl)
t1_tblSize = input.string("Tiny", "Size", options = ["Tiny", "Small", "Normal"], group = t1_gTbl)

t1_legend = input.bool(true, "Show the plain english summary", group = t1_gTbl,
     tooltip = "A verdict row and a one line legend under the table, so the numbers do not need decoding on first use.")

t1_goodCol = input.color(#2f6b41, "Reverses",   group = t1_gTbl, inline = "c")
t1_badCol  = input.color(#b4342a, "Runs on",     group = t1_gTbl, inline = "c")
t1_thinCol = input.color(#9a9da3, "Thin",       group = t1_gTbl, inline = "c")

// ─── STATE ────────────────────────────────────────────────────
//  outcome: 0 pending · 1 rejected · 2 continued · 3 unresolved
type T1Lv
    float px
    bool  isHigh
    int   tfi
    bool  swept
    int   sweptBar
    float extreme
    int   outcome

var T1Lv[] t1_lv = array.new<T1Lv>()

// tallies indexed [timeframe * 2 + side], side 0 = highs, 1 = lows
var int[] t1_rej = array.from(0,0,0,0,0,0)
var int[] t1_con = array.from(0,0,0,0,0,0)
var int[] t1_unr = array.from(0,0,0,0,0,0)

t1_sizeOf(_s) =>
    _s == "Tiny" ? size.tiny : _s == "Small" ? size.small : size.normal

t1_posOf(_p) =>
    _p == "Top Right" ? position.top_right :
     _p == "Top Left" ? position.top_left :
     _p == "Bottom Left" ? position.bottom_left :
     _p == "Middle Right" ? position.middle_right : position.bottom_right

t1_tfLabel(string _tf) =>
    string _out = _tf
    float  _n   = str.tonumber(_tf)
    if not na(_n)
        int _m = int(_n)
        _out := _m >= 1440 and _m % 1440 == 0 ? str.tostring(_m / 1440) + "D" :
             _m >= 60 and _m % 60 == 0 ? str.tostring(_m / 60) + "H" :
             str.tostring(_m) + "M"
    _out

t1_known(float _px) =>
    bool _f = false
    int _n = array.size(t1_lv)
    if _n > 0
        for i = 0 to _n - 1
            T1Lv _l = array.get(t1_lv, i)
            if not _l.swept and math.abs(_l.px - _px) < syminfo.mintick * 2
                _f := true
    _f

t1_add(float _px, bool _isHigh, int _tfi) =>
    if not na(_px) and not t1_known(_px)
        array.push(t1_lv, T1Lv.new(_px, _isHigh, _tfi, false, na, na, 0))
        while array.size(t1_lv) > t1_maxLv
            array.shift(t1_lv)

// ─── PIVOT FEED ───────────────────────────────────────────────
[t1_h1, t1_l1] = request.security(syminfo.tickerid, t1_t1,
     [ta.pivothigh(high, t1_pvL, t1_pvR), ta.pivotlow(low, t1_pvL, t1_pvR)], lookahead = barmerge.lookahead_off)
[t1_h2, t1_l2] = request.security(syminfo.tickerid, t1_t2,
     [ta.pivothigh(high, t1_pvL, t1_pvR), ta.pivotlow(low, t1_pvL, t1_pvR)], lookahead = barmerge.lookahead_off)
[t1_h3, t1_l3] = request.security(syminfo.tickerid, t1_t3,
     [ta.pivothigh(high, t1_pvL, t1_pvR), ta.pivotlow(low, t1_pvL, t1_pvR)], lookahead = barmerge.lookahead_off)

// ─── ENGINE ───────────────────────────────────────────────────
if barstate.isconfirmed
    if t1_t1On
        t1_add(t1_h1, true,  0)
        t1_add(t1_l1, false, 0)
    if t1_t2On
        t1_add(t1_h2, true,  1)
        t1_add(t1_l2, false, 1)
    if t1_t3On
        t1_add(t1_h3, true,  2)
        t1_add(t1_l3, false, 2)

    int _n = array.size(t1_lv)
    if _n > 0
        for i = 0 to _n - 1
            T1Lv _l = array.get(t1_lv, i)

            if not _l.swept
                bool _hit = t1_mode == "Wick through" ?
                     (_l.isHigh ? high >= _l.px : low <= _l.px) :
                     (_l.isHigh ? close > _l.px : close < _l.px)
                if _hit
                    _l.swept    := true
                    _l.sweptBar := bar_index
                    _l.extreme  := _l.isHigh ? high : low

            else if _l.outcome == 0
                _l.extreme := _l.isHigh ? math.max(_l.extreme, high) : math.min(_l.extreme, low)

                float _over = math.abs(_l.extreme - _l.px)
                float _need = _l.px + (_l.isHigh ? -1 : 1) * _over * (t1_rejPct / 100.0)

                bool _rej = _over > 0 and (_l.isHigh ? close <= _need : close >= _need)
                bool _exp = bar_index - _l.sweptBar >= t1_window

                if _rej
                    _l.outcome := 1
                else if _exp
                    _l.outcome := (_l.isHigh ? close > _l.px : close < _l.px) ? 2 : 3

                if _l.outcome != 0
                    int _slot = _l.tfi * 2 + (_l.isHigh ? 0 : 1)
                    if _l.outcome == 1
                        array.set(t1_rej, _slot, array.get(t1_rej, _slot) + 1)
                    else if _l.outcome == 2
                        array.set(t1_con, _slot, array.get(t1_con, _slot) + 1)
                    else
                        array.set(t1_unr, _slot, array.get(t1_unr, _slot) + 1)

// ─── TABLE ────────────────────────────────────────────────────
var table t1_tbl = na

if barstate.islast
    int _rows = (t1_bySide ? 8 : 5) + (t1_legend ? 2 : 0)
    if na(t1_tbl)
        t1_tbl := table.new(t1_posOf(t1_tblPos), 5, _rows,
             bgcolor = color.new(color.black, 20),
             border_color = color.new(color.gray, 60),
             border_width = 1)

    color _hdr = color.new(color.gray, 20)
    string _sz = t1_tblSize

    table.cell(t1_tbl, 0, 0, "SWEEPS",  text_color = _hdr, text_size = t1_sizeOf(_sz))
    table.cell(t1_tbl, 1, 0, "SWEPT",   text_color = _hdr, text_size = t1_sizeOf(_sz))
    table.cell(t1_tbl, 2, 0, "CAME BK", text_color = _hdr, text_size = t1_sizeOf(_sz))
    table.cell(t1_tbl, 3, 0, "RAN ON",  text_color = _hdr, text_size = t1_sizeOf(_sz))
    table.cell(t1_tbl, 4, 0, "REV %",   text_color = _hdr, text_size = t1_sizeOf(_sz))

    string[] _tfs = array.from(t1_t1, t1_t2, t1_t3)
    bool[]   _ons = array.from(t1_t1On, t1_t2On, t1_t3On)

    int _row = 1
    int _allR = 0
    int _allC = 0
    int _allU = 0

    for i = 0 to 2
        if not array.get(_ons, i)
            continue

        int _rH = array.get(t1_rej, i * 2)
        int _cH = array.get(t1_con, i * 2)
        int _uH = array.get(t1_unr, i * 2)
        int _rL = array.get(t1_rej, i * 2 + 1)
        int _cL = array.get(t1_con, i * 2 + 1)
        int _uL = array.get(t1_unr, i * 2 + 1)

        _allR += _rH + _rL
        _allC += _cH + _cL
        _allU += _uH + _uL

        if t1_bySide
            // highs row
            int _gH = _rH + _cH
            table.cell(t1_tbl, 0, _row, t1_tfLabel(array.get(_tfs, i)) + " hi", text_color = color.white, text_size = t1_sizeOf(_sz))
            table.cell(t1_tbl, 1, _row, str.tostring(_gH + _uH), text_color = color.white, text_size = t1_sizeOf(_sz))
            table.cell(t1_tbl, 2, _row, str.tostring(_rH), text_color = color.white, text_size = t1_sizeOf(_sz))
            table.cell(t1_tbl, 3, _row, str.tostring(_cH), text_color = color.white, text_size = t1_sizeOf(_sz))
            if _gH < t1_minSample
                table.cell(t1_tbl, 4, _row, "thin", text_color = t1_thinCol, text_size = t1_sizeOf(_sz))
            else
                float _p = _rH / _gH * 100.0
                table.cell(t1_tbl, 4, _row, str.tostring(math.round(_p)) + "%",
                     text_color = _p >= 55 ? t1_goodCol : _p <= 45 ? t1_badCol : t1_thinCol,
                     text_size = t1_sizeOf(_sz))
            _row += 1

            // lows row
            int _gL = _rL + _cL
            table.cell(t1_tbl, 0, _row, t1_tfLabel(array.get(_tfs, i)) + " lo", text_color = color.white, text_size = t1_sizeOf(_sz))
            table.cell(t1_tbl, 1, _row, str.tostring(_gL + _uL), text_color = color.white, text_size = t1_sizeOf(_sz))
            table.cell(t1_tbl, 2, _row, str.tostring(_rL), text_color = color.white, text_size = t1_sizeOf(_sz))
            table.cell(t1_tbl, 3, _row, str.tostring(_cL), text_color = color.white, text_size = t1_sizeOf(_sz))
            if _gL < t1_minSample
                table.cell(t1_tbl, 4, _row, "thin", text_color = t1_thinCol, text_size = t1_sizeOf(_sz))
            else
                float _p = _rL / _gL * 100.0
                table.cell(t1_tbl, 4, _row, str.tostring(math.round(_p)) + "%",
                     text_color = _p >= 55 ? t1_goodCol : _p <= 45 ? t1_badCol : t1_thinCol,
                     text_size = t1_sizeOf(_sz))
            _row += 1
        else
            int _r = _rH + _rL
            int _c = _cH + _cL
            int _u = _uH + _uL
            int _g = _r + _c
            table.cell(t1_tbl, 0, _row, t1_tfLabel(array.get(_tfs, i)), text_color = color.white, text_size = t1_sizeOf(_sz))
            table.cell(t1_tbl, 1, _row, str.tostring(_g + _u), text_color = color.white, text_size = t1_sizeOf(_sz))
            table.cell(t1_tbl, 2, _row, str.tostring(_r), text_color = color.white, text_size = t1_sizeOf(_sz))
            table.cell(t1_tbl, 3, _row, str.tostring(_c), text_color = color.white, text_size = t1_sizeOf(_sz))
            if _g < t1_minSample
                table.cell(t1_tbl, 4, _row, "thin", text_color = t1_thinCol, text_size = t1_sizeOf(_sz))
            else
                float _p = _r / _g * 100.0
                table.cell(t1_tbl, 4, _row, str.tostring(math.round(_p)) + "%",
                     text_color = _p >= 55 ? t1_goodCol : _p <= 45 ? t1_badCol : t1_thinCol,
                     text_size = t1_sizeOf(_sz))
            _row += 1

    int _allRow = _rows - (t1_legend ? 3 : 1)

    // fill any unused rows so the table does not show stale cells
    while _row < _allRow
        for c = 0 to 4
            table.cell(t1_tbl, c, _row, "", text_size = t1_sizeOf(_sz))
        _row += 1

    // total
    int _allG = _allR + _allC
    table.cell(t1_tbl, 0, _allRow, "ALL", text_color = _hdr, text_size = t1_sizeOf(_sz))
    table.cell(t1_tbl, 1, _allRow, str.tostring(_allG + _allU), text_color = color.white, text_size = t1_sizeOf(_sz))
    table.cell(t1_tbl, 2, _allRow, str.tostring(_allR), text_color = color.white, text_size = t1_sizeOf(_sz))
    table.cell(t1_tbl, 3, _allRow, str.tostring(_allC), text_color = color.white, text_size = t1_sizeOf(_sz))
    if _allG < t1_minSample
        table.cell(t1_tbl, 4, _allRow, "thin", text_color = t1_thinCol, text_size = t1_sizeOf(_sz))
    else
        float _p = _allR / _allG * 100.0
        table.cell(t1_tbl, 4, _allRow, str.tostring(math.round(_p)) + "%",
             text_color = _p >= 55 ? t1_goodCol : _p <= 45 ? t1_badCol : t1_thinCol,
             text_size = t1_sizeOf(_sz))

    // ─── PLAIN ENGLISH ────────────────────────────────────────
    //  The table above is the evidence. This is what it says.
    if t1_legend
        int _lr = _rows - 2

        string _verdict = ""
        color  _vCol    = t1_thinCol

        if _allG < t1_minSample
            _verdict := "Not enough sweeps yet — use more history"
        else
            float _pAll = _allR / _allG * 100.0

            // count how many graded rows fall each side of the line
            int _sup = 0
            int _con = 0
            for i = 0 to 2
                if array.get(_ons, i)
                    int _r2 = array.get(t1_rej, i * 2) + array.get(t1_rej, i * 2 + 1)
                    int _c2 = array.get(t1_con, i * 2) + array.get(t1_con, i * 2 + 1)
                    int _g2 = _r2 + _c2
                    if _g2 >= t1_minSample
                        float _p2 = _r2 / _g2 * 100.0
                        if _p2 >= 55
                            _sup += 1
                        else if _p2 <= 45
                            _con += 1

            if _pAll >= 55
                _vCol := t1_goodCol
                _verdict := _con > 0 ?
                     "Broken levels mostly reverse — but check the red rows" :
                     "Broken levels reverse — " + str.tostring(math.round(_pAll)) + "% came back through"
            else if _pAll <= 45
                _vCol := t1_badCol
                _verdict := "Broken levels run on more than they reverse"
            else
                _verdict := "No clear edge — a break alone says little here"

        // Merged across the full width so the long strings do not
        // stretch the data columns. Pine sizes a column to its
        // widest cell, and a merged cell is exempt from that.
        table.cell(t1_tbl, 0, _lr, _verdict,
             text_color = _vCol, text_size = t1_sizeOf(_sz),
             text_halign = text.align_center)
        table.cell(t1_tbl, 1, _lr, "", text_size = t1_sizeOf(_sz))
        table.cell(t1_tbl, 2, _lr, "", text_size = t1_sizeOf(_sz))
        table.cell(t1_tbl, 3, _lr, "", text_size = t1_sizeOf(_sz))
        table.cell(t1_tbl, 4, _lr, "", text_size = t1_sizeOf(_sz))
        table.merge_cells(t1_tbl, 0, _lr, 4, _lr)

        table.cell(t1_tbl, 0, _rows - 1,
             "REV % = how often a broken level came back through   ·   green supports it, red argues against",
             text_color = t1_thinCol, text_size = t1_sizeOf(_sz),
             text_halign = text.align_center)
        table.cell(t1_tbl, 1, _rows - 1, "", text_size = t1_sizeOf(_sz))
        table.cell(t1_tbl, 2, _rows - 1, "", text_size = t1_sizeOf(_sz))
        table.cell(t1_tbl, 3, _rows - 1, "", text_size = t1_sizeOf(_sz))
        table.cell(t1_tbl, 4, _rows - 1, "", text_size = t1_sizeOf(_sz))
        table.merge_cells(t1_tbl, 0, _rows - 1, 4, _rows - 1)

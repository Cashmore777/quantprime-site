//@version=6
// ═════════════════════════════════════════════════════════════
//  QUANT PRIME — BUILD MENU · TERMINAL TIER
//  MER-D2T1
//    D2  Stack Monitor
//    T1  Sweep Report
// ═════════════════════════════════════════════════════════════

indicator("QP Terminal · D2T1", shorttitle = "QPD2T1", overlay = true, max_lines_count = 100)

// ═══════════════════════════════════════════════════════════════
//  QUANT PRIME — BUILD MENU · TERMINAL TIER
//  SIDE 2 · STACK MONITOR
// ───────────────────────────────────────────────────────────────
//  How much are you carrying, and how far away is the thing that
//  closes all of it.
//
//  Meridian does not use a stop. It stacks in one direction and
//  exits when an opposite condition appears, which closes the
//  whole position and reverses it. That makes the usual questions
//  the wrong ones. There is no stop distance to size from, and
//  "this trade" is not a meaningful unit when a single bias might
//  be carrying four entries.
//
//  The two questions that do matter:
//
//    WHAT IS THE BIAS, AND HOW OLD IS IT
//    A bias set two hours ago with price forty pips in your favour
//    is a different position to one set on the last candle.
//
//    WHERE IS THE FLIP
//    An opposite sweep is what closes everything. The nearest
//    unswept level on the other side is the most likely place that
//    comes from, and the distance to it is the closest thing
//    Meridian has to a risk figure.
//
//  This cannot know how many entries you actually have open. The
//  tap that opens each one is the instrument's job and does not
//  live in the menu. What it can do is show you the bias, the flip
//  distance, and your own position against both, once you log it.
//
//  Draws one table. Namespaced d2_.
// ═══════════════════════════════════════════════════════════════

// ─── LEVELS ───────────────────────────────────────────────────
d2_gLv = "Levels"

d2_tf = input.timeframe("30", "Level timeframe", group = d2_gLv,
     tooltip = "The timeframe whose swept levels set the bias and whose unswept levels are watched for the flip. Should match the cycle you are actually trading.")

d2_pvL = input.int(4, "L", minval = 1, maxval = 20, group = d2_gLv, inline = "p")
d2_pvR = input.int(2, "R", minval = 1, maxval = 20, group = d2_gLv, inline = "p")

d2_maxLv = input.int(100, "Levels tracked", minval = 20, maxval = 300, group = d2_gLv)

// ─── YOUR POSITION ────────────────────────────────────────────
d2_gPos = "Your entries"

d2_logOn = input.bool(false, "Log my entries", group = d2_gPos,
     tooltip = "Type in the prices you actually entered at. Leave any unused at 0. The table then shows your average entry, how far the flip level sits from it, and what the stack is currently worth.")

d2_e1 = input.price(0.0, "Entry 1", group = d2_gPos)
d2_e2 = input.price(0.0, "Entry 2", group = d2_gPos)
d2_e3 = input.price(0.0, "Entry 3", group = d2_gPos)
d2_e4 = input.price(0.0, "Entry 4", group = d2_gPos)
d2_e5 = input.price(0.0, "Entry 5", group = d2_gPos)

d2_lots = input.float(0.0, "Lots per entry", minval = 0.0, step = 0.01, group = d2_gPos,
     tooltip = "Optional. If set, the table shows total exposure and what the flip level is worth in currency. Leave at 0 to work in pips only.")

d2_pipVal = input.float(10.0, "Value per pip per lot", minval = 0.0, step = 0.01, group = d2_gPos,
     tooltip = "Forex standard is 10. Check yours on indices and metals, where contract sizes vary between brokers.")

// ─── WARNING ──────────────────────────────────────────────────
d2_gWarn = "Warning"

d2_warnOn  = input.bool(true, "Flag when the flip is close", group = d2_gWarn)
d2_warnAtr = input.float(0.5, "Flag within N x ATR of the flip level", minval = 0.1, step = 0.1, group = d2_gWarn)
d2_atrLen  = input.int(14, "ATR length", minval = 1, group = d2_gWarn)

// ─── DISPLAY ──────────────────────────────────────────────────
d2_gDisp = "Display"

d2_drawFlip = input.bool(true, "Draw the flip level", group = d2_gDisp)
d2_drawAvg  = input.bool(true, "Draw my average entry", group = d2_gDisp)

d2_tblPos  = input.string("Bottom Left", "Table position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right"], group = d2_gDisp)
d2_tblSize = input.string("Tiny", "Table size", options = ["Tiny", "Small", "Normal"], group = d2_gDisp)

d2_bullCol = input.color(#2f6b41, "Bullish", group = d2_gDisp, inline = "c")
d2_bearCol = input.color(#b4342a, "Bearish", group = d2_gDisp, inline = "c")
d2_flatCol = input.color(#9a9da3, "Flat",    group = d2_gDisp, inline = "c")
d2_warnCol = input.color(#c9a84c, "Warning", group = d2_gDisp, inline = "c")

// ─── HELPERS ──────────────────────────────────────────────────
d2_pipMult() =>
    str.contains(syminfo.ticker, "JPY") ? 100.0 :
     str.contains(syminfo.ticker, "XAU") or str.contains(syminfo.ticker, "XAG") ? 10.0 :
     syminfo.type == "forex" ? 10000.0 : 1.0

d2_sizeOf(_s) =>
    _s == "Tiny" ? size.tiny : _s == "Small" ? size.small : size.normal

d2_posOf(_p) =>
    _p == "Top Right" ? position.top_right :
     _p == "Top Left" ? position.top_left :
     _p == "Bottom Right" ? position.bottom_right :
     _p == "Middle Right" ? position.middle_right : position.bottom_left

// ─── LEVEL STATE ──────────────────────────────────────────────
type D2Level
    float px
    bool  isHigh
    bool  swept

var D2Level[] d2_levels = array.new<D2Level>()

var int   d2_bias    = 0        // 1 bullish, -1 bearish, 0 none
var int   d2_biasBar = na
var float d2_biasPx  = na       // price when the bias was set

d2_atr = ta.atr(d2_atrLen)

d2_known(float _px) =>
    bool _f = false
    int _n = array.size(d2_levels)
    if _n > 0
        for i = 0 to _n - 1
            D2Level _l = array.get(d2_levels, i)
            if not _l.swept and math.abs(_l.px - _px) < syminfo.mintick * 2
                _f := true
    _f

[d2_ph, d2_pl] = request.security(syminfo.tickerid, d2_tf,
     [ta.pivothigh(high, d2_pvL, d2_pvR), ta.pivotlow(low, d2_pvL, d2_pvR)], lookahead = barmerge.lookahead_off)

if barstate.isconfirmed
    if not na(d2_ph) and not d2_known(d2_ph)
        array.push(d2_levels, D2Level.new(d2_ph, true, false))
    if not na(d2_pl) and not d2_known(d2_pl)
        array.push(d2_levels, D2Level.new(d2_pl, false, false))
    while array.size(d2_levels) > d2_maxLv
        array.shift(d2_levels)

    int _n = array.size(d2_levels)
    if _n > 0
        for i = 0 to _n - 1
            D2Level _l = array.get(d2_levels, i)
            if not _l.swept
                if _l.isHigh ? high >= _l.px : low <= _l.px
                    _l.swept := true
                    // a high taken sets bearish, a low taken sets bullish
                    d2_bias    := _l.isHigh ? -1 : 1
                    d2_biasBar := bar_index
                    d2_biasPx  := close

// ─── THE FLIP LEVEL ───────────────────────────────────────────
//  Whichever unswept level on the opposite side of the bias sits
//  nearest to price. That is where an opposite sweep most likely
//  comes from, and therefore where the whole stack closes.
var float d2_flip = na

if barstate.islast
    d2_flip := na
    int _n2 = array.size(d2_levels)
    if _n2 > 0 and d2_bias != 0
        for i = 0 to _n2 - 1
            D2Level _l = array.get(d2_levels, i)
            if not _l.swept
                // bullish bias flips on a high being taken above
                // bearish bias flips on a low being taken below
                bool _relevant = d2_bias == 1 ? (_l.isHigh and _l.px > close) :
                     (not _l.isHigh and _l.px < close)
                if _relevant
                    if na(d2_flip) or math.abs(_l.px - close) < math.abs(d2_flip - close)
                        d2_flip := _l.px

d2_flipDist = na(d2_flip) ? na : math.abs(d2_flip - close) * d2_pipMult()
d2_flipNear = d2_warnOn and not na(d2_flip) and d2_atr > 0 and
     math.abs(d2_flip - close) <= d2_atr * d2_warnAtr

// ─── YOUR STACK ───────────────────────────────────────────────
d2_count = 0
d2_sum   = 0.0

if d2_logOn
    if d2_e1 > 0
        d2_count += 1
        d2_sum   += d2_e1
    if d2_e2 > 0
        d2_count += 1
        d2_sum   += d2_e2
    if d2_e3 > 0
        d2_count += 1
        d2_sum   += d2_e3
    if d2_e4 > 0
        d2_count += 1
        d2_sum   += d2_e4
    if d2_e5 > 0
        d2_count += 1
        d2_sum   += d2_e5

d2_avg = d2_count > 0 ? d2_sum / d2_count : na

// open movement, in pips, in the direction of the bias
d2_openPips = na(d2_avg) or d2_bias == 0 ? na :
     (close - d2_avg) * d2_bias * d2_pipMult()

// what the flip level is worth from the average entry
d2_flipFromAvg = na(d2_avg) or na(d2_flip) ? na :
     (d2_flip - d2_avg) * d2_bias * d2_pipMult()

d2_exposure = d2_lots > 0 ? d2_lots * d2_count : 0.0
d2_openCcy  = na(d2_openPips) or d2_exposure <= 0 ? na :
     d2_openPips * d2_pipVal * d2_lots * d2_count

// ─── LINES ────────────────────────────────────────────────────
var line d2_lnFlip = na
var line d2_lnAvg  = na

if barstate.islast
    if d2_drawFlip and not na(d2_flip)
        if na(d2_lnFlip)
            d2_lnFlip := line.new(bar_index - 30, d2_flip, bar_index + 15, d2_flip,
                 color = d2_flipNear ? d2_warnCol : d2_flatCol,
                 style = line.style_dashed, width = 2)
        else
            line.set_xy1(d2_lnFlip, bar_index - 30, d2_flip)
            line.set_xy2(d2_lnFlip, bar_index + 15, d2_flip)
            line.set_color(d2_lnFlip, d2_flipNear ? d2_warnCol : d2_flatCol)
    else
        line.delete(d2_lnFlip)
        d2_lnFlip := na

    if d2_drawAvg and not na(d2_avg)
        color _aCol = d2_bias == 1 ? d2_bullCol : d2_bias == -1 ? d2_bearCol : d2_flatCol
        if na(d2_lnAvg)
            d2_lnAvg := line.new(bar_index - 30, d2_avg, bar_index + 15, d2_avg,
                 color = _aCol, style = line.style_solid, width = 1)
        else
            line.set_xy1(d2_lnAvg, bar_index - 30, d2_avg)
            line.set_xy2(d2_lnAvg, bar_index + 15, d2_avg)
            line.set_color(d2_lnAvg, _aCol)
    else
        line.delete(d2_lnAvg)
        d2_lnAvg := na

// ─── TABLE ────────────────────────────────────────────────────
var table d2_tbl = na

if barstate.islast
    if na(d2_tbl)
        d2_tbl := table.new(d2_posOf(d2_tblPos), 3, 6,
             bgcolor = color.new(color.black, 20),
             border_color = color.new(color.gray, 60),
             border_width = 1)

    color _hdr = color.new(color.gray, 20)
    string _sz = d2_tblSize
    color _bCol = d2_bias == 1 ? d2_bullCol : d2_bias == -1 ? d2_bearCol : d2_flatCol

    // bias and age
    table.cell(d2_tbl, 0, 0, "BIAS", text_color = _hdr, text_size = d2_sizeOf(_sz))
    table.cell(d2_tbl, 1, 0, d2_bias == 0 ? "NONE" : d2_bias == 1 ? "BULL" : "BEAR",
         text_color = _bCol, text_size = d2_sizeOf(_sz))
    table.cell(d2_tbl, 2, 0, na(d2_biasBar) ? "—" : str.tostring(bar_index - d2_biasBar) + " bars",
         text_color = color.white, text_size = d2_sizeOf(_sz))

    // move since the bias was set
    float _sincePips = na(d2_biasPx) or d2_bias == 0 ? na :
         (close - d2_biasPx) * d2_bias * d2_pipMult()
    table.cell(d2_tbl, 0, 1, "Since set", text_color = _hdr, text_size = d2_sizeOf(_sz))
    table.cell(d2_tbl, 1, 1, na(_sincePips) ? "—" :
         (_sincePips >= 0 ? "+" : "") + str.tostring(math.round(_sincePips, 1)) + "p",
         text_color = na(_sincePips) ? d2_flatCol : _sincePips >= 0 ? d2_bullCol : d2_bearCol,
         text_size = d2_sizeOf(_sz))
    table.cell(d2_tbl, 2, 1, "", text_size = d2_sizeOf(_sz))

    // the flip
    table.cell(d2_tbl, 0, 2, "FLIP AT", text_color = _hdr, text_size = d2_sizeOf(_sz))
    table.cell(d2_tbl, 1, 2, na(d2_flip) ? "none found" : str.tostring(math.round_to_mintick(d2_flip)),
         text_color = d2_flipNear ? d2_warnCol : color.white, text_size = d2_sizeOf(_sz))
    table.cell(d2_tbl, 2, 2, na(d2_flipDist) ? "—" : str.tostring(math.round(d2_flipDist, 1)) + "p away",
         text_color = d2_flipNear ? d2_warnCol : color.white, text_size = d2_sizeOf(_sz))

    // the stack
    table.cell(d2_tbl, 0, 3, "STACK", text_color = _hdr, text_size = d2_sizeOf(_sz))
    table.cell(d2_tbl, 1, 3, not d2_logOn ? "not logged" :
         d2_count == 0 ? "0 entries" : str.tostring(d2_count) + " entries",
         text_color = d2_count > 0 ? color.white : d2_flatCol, text_size = d2_sizeOf(_sz))
    table.cell(d2_tbl, 2, 3, d2_exposure > 0 ? str.tostring(math.round(d2_exposure, 2)) + " lots" : "",
         text_color = color.white, text_size = d2_sizeOf(_sz))

    // average entry and open movement
    table.cell(d2_tbl, 0, 4, "Avg entry", text_color = _hdr, text_size = d2_sizeOf(_sz))
    table.cell(d2_tbl, 1, 4, na(d2_avg) ? "—" : str.tostring(math.round_to_mintick(d2_avg)),
         text_color = color.white, text_size = d2_sizeOf(_sz))
    table.cell(d2_tbl, 2, 4, na(d2_openPips) ? "" :
         (d2_openPips >= 0 ? "+" : "") + str.tostring(math.round(d2_openPips, 1)) + "p",
         text_color = na(d2_openPips) ? d2_flatCol : d2_openPips >= 0 ? d2_bullCol : d2_bearCol,
         text_size = d2_sizeOf(_sz))

    // what the flip costs from where you are
    table.cell(d2_tbl, 0, 5, "At flip", text_color = _hdr, text_size = d2_sizeOf(_sz))
    table.cell(d2_tbl, 1, 5, na(d2_flipFromAvg) ? "—" :
         (d2_flipFromAvg >= 0 ? "+" : "") + str.tostring(math.round(d2_flipFromAvg, 1)) + "p",
         text_color = na(d2_flipFromAvg) ? d2_flatCol :
              d2_flipFromAvg >= 0 ? d2_bullCol : d2_bearCol,
         text_size = d2_sizeOf(_sz))
    table.cell(d2_tbl, 2, 5, na(d2_openCcy) ? "" :
         (d2_openCcy >= 0 ? "+" : "") + str.tostring(math.round(d2_openCcy, 2)),
         text_color = na(d2_openCcy) ? d2_flatCol : d2_openCcy >= 0 ? d2_bullCol : d2_bearCol,
         text_size = d2_sizeOf(_sz))

// ─── ALERTS ───────────────────────────────────────────────────
alertcondition(d2_bias != d2_bias[1], "Bias changed",
     "A sweep has set a new directional bias. Any open stack would have flipped.")

alertcondition(d2_flipNear and not d2_flipNear[1], "Approaching the flip level",
     "Price is close to the nearest opposite level. A sweep there closes the whole stack and reverses.")

// ═══════════════════════════════════════════════════════════════
//  QUANT PRIME — BUILD MENU · TERMINAL TIER
//  DESSERT 1 · SWEEP REPORT
// ───────────────────────────────────────────────────────────────
//  Does the premise hold on your instrument.
//
//  When price takes out a prior high or low, two things can
//  happen. It comes back through, meaning the break failed and the
//  move was a grab for the orders resting there. Or it stays
//  beyond and runs, meaning the level genuinely broke.
//
//  Meridian's whole premise is that the first happens more often
//  than the second. That was measured on one instrument. Whether
//  it survives on yours is a question only your own data answers.
//
//  Note this is a different event to what Recoil measures. Recoil
//  fades an exceptional candle. This measures whether a broken
//  level holds.
//
//  This runs the test. Every level swept in your history, split by
//  timeframe, graded on what price did afterwards:
//
//    REVERSED     came back through by the required amount
//    RAN ON       stayed beyond and kept going
//    UNRESOLVED   neither, inside the window
//
//  A reversal rate meaningfully above 50% supports the premise on
//  that timeframe. Around 50% means a break tells you nothing on
//  its own. Below it means the opposite is true on your pair, and
//  trading the failure puts you on the wrong side of it.
//
//  Rows with fewer than thirty graded sweeps are left ungraded,
//  because a 70% rate from six occurrences means nothing and
//  showing it as a number invites exactly the wrong conclusion.
//
//  Use a large sample. Five thousand candles, not five hundred.
//  Meridian's levels are swept less often than Recoil's candles
//  fire, so this table fills slowly.
//
//  Draws one table. Namespaced t1_.
// ═══════════════════════════════════════════════════════════════

// ─── TIMEFRAMES ───────────────────────────────────────────────
t1_gTf = "Levels"

t1_t1On = input.bool(true, "TF1", group = t1_gTf, inline = "t1")
t1_t1   = input.timeframe("3", "", group = t1_gTf, inline = "t1")
t1_t2On = input.bool(true, "TF2", group = t1_gTf, inline = "t2")
t1_t2   = input.timeframe("30", "", group = t1_gTf, inline = "t2")
t1_t3On = input.bool(true, "TF3", group = t1_gTf, inline = "t3")
t1_t3   = input.timeframe("180", "", group = t1_gTf, inline = "t3")

t1_pvL = input.int(4, "Pivot L", minval = 1, maxval = 20, group = t1_gTf, inline = "p")
t1_pvR = input.int(2, "Pivot R", minval = 1, maxval = 20, group = t1_gTf, inline = "p",
     tooltip = "Applied to all three timeframes. Higher values find fewer, more significant levels and will slow the sample down further.")

// ─── TEST ─────────────────────────────────────────────────────
t1_gTest = "Test"

t1_mode = input.string("Wick through", "A sweep is", options = ["Wick through", "Close beyond"], group = t1_gTest,
     tooltip = "Should match how you read a sweep on the chart. Close beyond finds fewer events and tends to produce higher rejection rates, because it has already filtered out the shallowest touches.")

t1_window = input.int(20, "Grade over N bars", minval = 3, maxval = 200, group = t1_gTest)

t1_rejPct = input.float(50.0, "Rejection needs % of the overshoot back", minval = 10.0, maxval = 100.0, step = 5.0, group = t1_gTest,
     tooltip = "How much of the move beyond the level price must give back for the sweep to grade REJECTED. Measured as a percentage of how far beyond it went, so it scales across instruments.")

t1_minSample = input.int(30, "Minimum graded sweeps", minval = 5, maxval = 200, group = t1_gTest,
     tooltip = "Rows below this are shown but left ungraded. Lowering it does not make a thin sample meaningful.")

// ─── SPLIT ────────────────────────────────────────────────────
t1_gSplit = "Split"

t1_bySide = input.bool(true, "Separate highs from lows", group = t1_gSplit,
     tooltip = "Highs taken and lows taken are not the same event on most instruments, and a pair that behaves symmetrically is worth knowing about.")

t1_maxLv = input.int(400, "Levels tracked", minval = 50, maxval = 500, group = t1_gSplit)

// ─── TABLE ────────────────────────────────────────────────────
t1_gTbl = "Table"

t1_tblPos  = input.string("Bottom Right", "Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right"], group = t1_gTbl)
t1_tblSize = input.string("Tiny", "Size", options = ["Tiny", "Small", "Normal"], group = t1_gTbl)

t1_legend = input.bool(true, "Show the plain english summary", group = t1_gTbl,
     tooltip = "A verdict row and a one line legend under the table, so the numbers do not need decoding on first use.")

t1_goodCol = input.color(#2f6b41, "Reverses",   group = t1_gTbl, inline = "c")
t1_badCol  = input.color(#b4342a, "Runs on",     group = t1_gTbl, inline = "c")
t1_thinCol = input.color(#9a9da3, "Thin",       group = t1_gTbl, inline = "c")

// ─── STATE ────────────────────────────────────────────────────
//  outcome: 0 pending · 1 rejected · 2 continued · 3 unresolved
type T1Lv
    float px
    bool  isHigh
    int   tfi
    bool  swept
    int   sweptBar
    float extreme
    int   outcome

var T1Lv[] t1_lv = array.new<T1Lv>()

// tallies indexed [timeframe * 2 + side], side 0 = highs, 1 = lows
var int[] t1_rej = array.from(0,0,0,0,0,0)
var int[] t1_con = array.from(0,0,0,0,0,0)
var int[] t1_unr = array.from(0,0,0,0,0,0)

t1_sizeOf(_s) =>
    _s == "Tiny" ? size.tiny : _s == "Small" ? size.small : size.normal

t1_posOf(_p) =>
    _p == "Top Right" ? position.top_right :
     _p == "Top Left" ? position.top_left :
     _p == "Bottom Left" ? position.bottom_left :
     _p == "Middle Right" ? position.middle_right : position.bottom_right

t1_tfLabel(string _tf) =>
    string _out = _tf
    float  _n   = str.tonumber(_tf)
    if not na(_n)
        int _m = int(_n)
        _out := _m >= 1440 and _m % 1440 == 0 ? str.tostring(_m / 1440) + "D" :
             _m >= 60 and _m % 60 == 0 ? str.tostring(_m / 60) + "H" :
             str.tostring(_m) + "M"
    _out

t1_known(float _px) =>
    bool _f = false
    int _n = array.size(t1_lv)
    if _n > 0
        for i = 0 to _n - 1
            T1Lv _l = array.get(t1_lv, i)
            if not _l.swept and math.abs(_l.px - _px) < syminfo.mintick * 2
                _f := true
    _f

t1_add(float _px, bool _isHigh, int _tfi) =>
    if not na(_px) and not t1_known(_px)
        array.push(t1_lv, T1Lv.new(_px, _isHigh, _tfi, false, na, na, 0))
        while array.size(t1_lv) > t1_maxLv
            array.shift(t1_lv)

// ─── PIVOT FEED ───────────────────────────────────────────────
[t1_h1, t1_l1] = request.security(syminfo.tickerid, t1_t1,
     [ta.pivothigh(high, t1_pvL, t1_pvR), ta.pivotlow(low, t1_pvL, t1_pvR)], lookahead = barmerge.lookahead_off)
[t1_h2, t1_l2] = request.security(syminfo.tickerid, t1_t2,
     [ta.pivothigh(high, t1_pvL, t1_pvR), ta.pivotlow(low, t1_pvL, t1_pvR)], lookahead = barmerge.lookahead_off)
[t1_h3, t1_l3] = request.security(syminfo.tickerid, t1_t3,
     [ta.pivothigh(high, t1_pvL, t1_pvR), ta.pivotlow(low, t1_pvL, t1_pvR)], lookahead = barmerge.lookahead_off)

// ─── ENGINE ───────────────────────────────────────────────────
if barstate.isconfirmed
    if t1_t1On
        t1_add(t1_h1, true,  0)
        t1_add(t1_l1, false, 0)
    if t1_t2On
        t1_add(t1_h2, true,  1)
        t1_add(t1_l2, false, 1)
    if t1_t3On
        t1_add(t1_h3, true,  2)
        t1_add(t1_l3, false, 2)

    int _n = array.size(t1_lv)
    if _n > 0
        for i = 0 to _n - 1
            T1Lv _l = array.get(t1_lv, i)

            if not _l.swept
                bool _hit = t1_mode == "Wick through" ?
                     (_l.isHigh ? high >= _l.px : low <= _l.px) :
                     (_l.isHigh ? close > _l.px : close < _l.px)
                if _hit
                    _l.swept    := true
                    _l.sweptBar := bar_index
                    _l.extreme  := _l.isHigh ? high : low

            else if _l.outcome == 0
                _l.extreme := _l.isHigh ? math.max(_l.extreme, high) : math.min(_l.extreme, low)

                float _over = math.abs(_l.extreme - _l.px)
                float _need = _l.px + (_l.isHigh ? -1 : 1) * _over * (t1_rejPct / 100.0)

                bool _rej = _over > 0 and (_l.isHigh ? close <= _need : close >= _need)
                bool _exp = bar_index - _l.sweptBar >= t1_window

                if _rej
                    _l.outcome := 1
                else if _exp
                    _l.outcome := (_l.isHigh ? close > _l.px : close < _l.px) ? 2 : 3

                if _l.outcome != 0
                    int _slot = _l.tfi * 2 + (_l.isHigh ? 0 : 1)
                    if _l.outcome == 1
                        array.set(t1_rej, _slot, array.get(t1_rej, _slot) + 1)
                    else if _l.outcome == 2
                        array.set(t1_con, _slot, array.get(t1_con, _slot) + 1)
                    else
                        array.set(t1_unr, _slot, array.get(t1_unr, _slot) + 1)

// ─── TABLE ────────────────────────────────────────────────────
var table t1_tbl = na

if barstate.islast
    int _rows = (t1_bySide ? 8 : 5) + (t1_legend ? 2 : 0)
    if na(t1_tbl)
        t1_tbl := table.new(t1_posOf(t1_tblPos), 5, _rows,
             bgcolor = color.new(color.black, 20),
             border_color = color.new(color.gray, 60),
             border_width = 1)

    color _hdr = color.new(color.gray, 20)
    string _sz = t1_tblSize

    table.cell(t1_tbl, 0, 0, "SWEEPS",  text_color = _hdr, text_size = t1_sizeOf(_sz))
    table.cell(t1_tbl, 1, 0, "SWEPT",   text_color = _hdr, text_size = t1_sizeOf(_sz))
    table.cell(t1_tbl, 2, 0, "CAME BK", text_color = _hdr, text_size = t1_sizeOf(_sz))
    table.cell(t1_tbl, 3, 0, "RAN ON",  text_color = _hdr, text_size = t1_sizeOf(_sz))
    table.cell(t1_tbl, 4, 0, "REV %",   text_color = _hdr, text_size = t1_sizeOf(_sz))

    string[] _tfs = array.from(t1_t1, t1_t2, t1_t3)
    bool[]   _ons = array.from(t1_t1On, t1_t2On, t1_t3On)

    int _row = 1
    int _allR = 0
    int _allC = 0
    int _allU = 0

    for i = 0 to 2
        if not array.get(_ons, i)
            continue

        int _rH = array.get(t1_rej, i * 2)
        int _cH = array.get(t1_con, i * 2)
        int _uH = array.get(t1_unr, i * 2)
        int _rL = array.get(t1_rej, i * 2 + 1)
        int _cL = array.get(t1_con, i * 2 + 1)
        int _uL = array.get(t1_unr, i * 2 + 1)

        _allR += _rH + _rL
        _allC += _cH + _cL
        _allU += _uH + _uL

        if t1_bySide
            // highs row
            int _gH = _rH + _cH
            table.cell(t1_tbl, 0, _row, t1_tfLabel(array.get(_tfs, i)) + " hi", text_color = color.white, text_size = t1_sizeOf(_sz))
            table.cell(t1_tbl, 1, _row, str.tostring(_gH + _uH), text_color = color.white, text_size = t1_sizeOf(_sz))
            table.cell(t1_tbl, 2, _row, str.tostring(_rH), text_color = color.white, text_size = t1_sizeOf(_sz))
            table.cell(t1_tbl, 3, _row, str.tostring(_cH), text_color = color.white, text_size = t1_sizeOf(_sz))
            if _gH < t1_minSample
                table.cell(t1_tbl, 4, _row, "thin", text_color = t1_thinCol, text_size = t1_sizeOf(_sz))
            else
                float _p = _rH / _gH * 100.0
                table.cell(t1_tbl, 4, _row, str.tostring(math.round(_p)) + "%",
                     text_color = _p >= 55 ? t1_goodCol : _p <= 45 ? t1_badCol : t1_thinCol,
                     text_size = t1_sizeOf(_sz))
            _row += 1

            // lows row
            int _gL = _rL + _cL
            table.cell(t1_tbl, 0, _row, t1_tfLabel(array.get(_tfs, i)) + " lo", text_color = color.white, text_size = t1_sizeOf(_sz))
            table.cell(t1_tbl, 1, _row, str.tostring(_gL + _uL), text_color = color.white, text_size = t1_sizeOf(_sz))
            table.cell(t1_tbl, 2, _row, str.tostring(_rL), text_color = color.white, text_size = t1_sizeOf(_sz))
            table.cell(t1_tbl, 3, _row, str.tostring(_cL), text_color = color.white, text_size = t1_sizeOf(_sz))
            if _gL < t1_minSample
                table.cell(t1_tbl, 4, _row, "thin", text_color = t1_thinCol, text_size = t1_sizeOf(_sz))
            else
                float _p = _rL / _gL * 100.0
                table.cell(t1_tbl, 4, _row, str.tostring(math.round(_p)) + "%",
                     text_color = _p >= 55 ? t1_goodCol : _p <= 45 ? t1_badCol : t1_thinCol,
                     text_size = t1_sizeOf(_sz))
            _row += 1
        else
            int _r = _rH + _rL
            int _c = _cH + _cL
            int _u = _uH + _uL
            int _g = _r + _c
            table.cell(t1_tbl, 0, _row, t1_tfLabel(array.get(_tfs, i)), text_color = color.white, text_size = t1_sizeOf(_sz))
            table.cell(t1_tbl, 1, _row, str.tostring(_g + _u), text_color = color.white, text_size = t1_sizeOf(_sz))
            table.cell(t1_tbl, 2, _row, str.tostring(_r), text_color = color.white, text_size = t1_sizeOf(_sz))
            table.cell(t1_tbl, 3, _row, str.tostring(_c), text_color = color.white, text_size = t1_sizeOf(_sz))
            if _g < t1_minSample
                table.cell(t1_tbl, 4, _row, "thin", text_color = t1_thinCol, text_size = t1_sizeOf(_sz))
            else
                float _p = _r / _g * 100.0
                table.cell(t1_tbl, 4, _row, str.tostring(math.round(_p)) + "%",
                     text_color = _p >= 55 ? t1_goodCol : _p <= 45 ? t1_badCol : t1_thinCol,
                     text_size = t1_sizeOf(_sz))
            _row += 1

    int _allRow = _rows - (t1_legend ? 3 : 1)

    // fill any unused rows so the table does not show stale cells
    while _row < _allRow
        for c = 0 to 4
            table.cell(t1_tbl, c, _row, "", text_size = t1_sizeOf(_sz))
        _row += 1

    // total
    int _allG = _allR + _allC
    table.cell(t1_tbl, 0, _allRow, "ALL", text_color = _hdr, text_size = t1_sizeOf(_sz))
    table.cell(t1_tbl, 1, _allRow, str.tostring(_allG + _allU), text_color = color.white, text_size = t1_sizeOf(_sz))
    table.cell(t1_tbl, 2, _allRow, str.tostring(_allR), text_color = color.white, text_size = t1_sizeOf(_sz))
    table.cell(t1_tbl, 3, _allRow, str.tostring(_allC), text_color = color.white, text_size = t1_sizeOf(_sz))
    if _allG < t1_minSample
        table.cell(t1_tbl, 4, _allRow, "thin", text_color = t1_thinCol, text_size = t1_sizeOf(_sz))
    else
        float _p = _allR / _allG * 100.0
        table.cell(t1_tbl, 4, _allRow, str.tostring(math.round(_p)) + "%",
             text_color = _p >= 55 ? t1_goodCol : _p <= 45 ? t1_badCol : t1_thinCol,
             text_size = t1_sizeOf(_sz))

    // ─── PLAIN ENGLISH ────────────────────────────────────────
    //  The table above is the evidence. This is what it says.
    if t1_legend
        int _lr = _rows - 2

        string _verdict = ""
        color  _vCol    = t1_thinCol

        if _allG < t1_minSample
            _verdict := "Not enough sweeps yet — use more history"
        else
            float _pAll = _allR / _allG * 100.0

            // count how many graded rows fall each side of the line
            int _sup = 0
            int _con = 0
            for i = 0 to 2
                if array.get(_ons, i)
                    int _r2 = array.get(t1_rej, i * 2) + array.get(t1_rej, i * 2 + 1)
                    int _c2 = array.get(t1_con, i * 2) + array.get(t1_con, i * 2 + 1)
                    int _g2 = _r2 + _c2
                    if _g2 >= t1_minSample
                        float _p2 = _r2 / _g2 * 100.0
                        if _p2 >= 55
                            _sup += 1
                        else if _p2 <= 45
                            _con += 1

            if _pAll >= 55
                _vCol := t1_goodCol
                _verdict := _con > 0 ?
                     "Broken levels mostly reverse — but check the red rows" :
                     "Broken levels reverse — " + str.tostring(math.round(_pAll)) + "% came back through"
            else if _pAll <= 45
                _vCol := t1_badCol
                _verdict := "Broken levels run on more than they reverse"
            else
                _verdict := "No clear edge — a break alone says little here"

        // Merged across the full width so the long strings do not
        // stretch the data columns. Pine sizes a column to its
        // widest cell, and a merged cell is exempt from that.
        table.cell(t1_tbl, 0, _lr, _verdict,
             text_color = _vCol, text_size = t1_sizeOf(_sz),
             text_halign = text.align_center)
        table.cell(t1_tbl, 1, _lr, "", text_size = t1_sizeOf(_sz))
        table.cell(t1_tbl, 2, _lr, "", text_size = t1_sizeOf(_sz))
        table.cell(t1_tbl, 3, _lr, "", text_size = t1_sizeOf(_sz))
        table.cell(t1_tbl, 4, _lr, "", text_size = t1_sizeOf(_sz))
        table.merge_cells(t1_tbl, 0, _lr, 4, _lr)

        table.cell(t1_tbl, 0, _rows - 1,
             "REV % = how often a broken level came back through   ·   green supports it, red argues against",
             text_color = t1_thinCol, text_size = t1_sizeOf(_sz),
             text_halign = text.align_center)
        table.cell(t1_tbl, 1, _rows - 1, "", text_size = t1_sizeOf(_sz))
        table.cell(t1_tbl, 2, _rows - 1, "", text_size = t1_sizeOf(_sz))
        table.cell(t1_tbl, 3, _rows - 1, "", text_size = t1_sizeOf(_sz))
        table.cell(t1_tbl, 4, _rows - 1, "", text_size = t1_sizeOf(_sz))
        table.merge_cells(t1_tbl, 0, _rows - 1, 4, _rows - 1)

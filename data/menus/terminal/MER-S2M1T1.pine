//@version=6
// ═════════════════════════════════════════════════════════════
//  QUANT PRIME — BUILD MENU · TERMINAL TIER
//  MER-S2M1T1
//    S2  Liquidity Levels
//    M1  Sweep Tracker
//    T1  Sweep Report
// ═════════════════════════════════════════════════════════════

indicator("QP Terminal · S2M1T1", shorttitle = "QPS2M1T1", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// ═══════════════════════════════════════════════════════════════
//  QUANT PRIME — BUILD MENU · TERMINAL TIER
//  STARTER 2 · LIQUIDITY LEVELS
// ───────────────────────────────────────────────────────────────
//  A swing high is where somebody's stop is sitting. So is a
//  swing low. Those orders are the only thing on a chart that is
//  guaranteed to exist, and price has a persistent habit of going
//  to collect them before it does anything else.
//
//  This finds those levels across three timeframes using fractal
//  pivots, extends each one right, and freezes it the moment
//  price reaches through it. What is left running is the
//  liquidity that has not been taken yet.
//
//  A frozen level is not finished. Where price went afterwards is
//  the whole question, and the Sweep Tracker in the Main course
//  answers it.
//
//  Draws no table. Safe to combine with any other Meridian piece.
//  All identifiers namespaced s2_ to avoid collisions.
// ═══════════════════════════════════════════════════════════════

// ─── TIMEFRAMES ───────────────────────────────────────────────
s2_gTf = "Timeframes"

s2_t1On   = input.bool(true, "TF1", group = s2_gTf, inline = "t1")
s2_t1     = input.timeframe("3", "", group = s2_gTf, inline = "t1")
s2_t1L    = input.int(4, "L", minval = 1, maxval = 20, group = s2_gTf, inline = "t1")
s2_t1R    = input.int(2, "R", minval = 1, maxval = 20, group = s2_gTf, inline = "t1")
s2_t1Col  = input.color(#2962ff, "", group = s2_gTf, inline = "t1")

s2_t2On   = input.bool(true, "TF2", group = s2_gTf, inline = "t2")
s2_t2     = input.timeframe("30", "", group = s2_gTf, inline = "t2")
s2_t2L    = input.int(4, "L", minval = 1, maxval = 20, group = s2_gTf, inline = "t2")
s2_t2R    = input.int(2, "R", minval = 1, maxval = 20, group = s2_gTf, inline = "t2")
s2_t2Col  = input.color(#2962ff, "", group = s2_gTf, inline = "t2")

s2_t3On   = input.bool(true, "TF3", group = s2_gTf, inline = "t3")
s2_t3     = input.timeframe("180", "", group = s2_gTf, inline = "t3")
s2_t3L    = input.int(4, "L", minval = 1, maxval = 20, group = s2_gTf, inline = "t3")
s2_t3R    = input.int(2, "R", minval = 1, maxval = 20, group = s2_gTf, inline = "t3")
s2_t3Col  = input.color(#ffffff, "", group = s2_gTf, inline = "t3",
     tooltip = "L and R are how many bars either side a pivot needs to qualify. Higher values find fewer, more significant levels. R also delays confirmation by that many bars.")

// ─── LIFECYCLE ────────────────────────────────────────────────
s2_gLife = "Lifecycle"

s2_sweepMode = input.string("Wick through", "A level is swept by", options = ["Wick through", "Close beyond"], group = s2_gLife,
     tooltip = "Wick through freezes a level as soon as price reaches it, which is what taking liquidity actually looks like. Close beyond waits for a candle to finish past it, which finds fewer and larger events.")

s2_keepSwept = input.bool(true, "Keep swept levels visible", group = s2_gLife,
     tooltip = "On: a swept level stops extending and stays as a faded line. Off: it is removed. Keeping them shows you where liquidity has already been taken, which is often where price will not return.")

s2_sweptFade = input.int(65, "Swept level fade", minval = 0, maxval = 95, group = s2_gLife)

s2_maxLevels = input.int(200, "Maximum levels tracked", minval = 20, maxval = 500, group = s2_gLife,
     tooltip = "Three timeframes generate levels quickly. Once this is reached the oldest are removed.")

// ─── DISPLAY ──────────────────────────────────────────────────
s2_gDisp = "Display"

s2_showHighs = input.bool(true, "Highs", group = s2_gDisp, inline = "hl")
s2_showLows  = input.bool(true, "Lows",  group = s2_gDisp, inline = "hl")

s2_width = input.int(1, "Line width", minval = 1, maxval = 4, group = s2_gDisp)

s2_showTf = input.bool(false, "Label levels with their timeframe", group = s2_gDisp)
s2_lblSize = input.string("Tiny", "Label size", options = ["Tiny", "Small", "Normal"], group = s2_gDisp)

// ─── STORE ────────────────────────────────────────────────────
type S2Level
    float px
    bool  isHigh
    bool  swept
    color col
    line  ln
    label lb

var S2Level[] s2_levels = array.new<S2Level>()

s2_sizeOf(_s) =>
    _s == "Tiny" ? size.tiny : _s == "Small" ? size.small : size.normal

s2_tfLabel(string _tf) =>
    string _out = _tf
    float  _n   = str.tonumber(_tf)
    if not na(_n)
        int _m = int(_n)
        _out := _m >= 1440 and _m % 1440 == 0 ? str.tostring(_m / 1440) + "D" :
             _m >= 60 and _m % 60 == 0 ? str.tostring(_m / 60) + "H" :
             str.tostring(_m) + "M"
    _out

// Higher timeframe pivots repeat across several chart bars, so
// anything at effectively the same price is treated as already
// known rather than drawn twice.
s2_exists(float _px) =>
    bool _found = false
    int  _sz = array.size(s2_levels)
    if _sz > 0
        for i = 0 to _sz - 1
            S2Level _l = array.get(s2_levels, i)
            if not _l.swept and math.abs(_l.px - _px) < syminfo.mintick * 2
                _found := true
    _found

s2_add(float _px, bool _isHigh, color _col, int _right, string _tf) =>
    if not na(_px) and not s2_exists(_px) and (_isHigh ? s2_showHighs : s2_showLows)
        // Anchor to the pivot candle itself, not to the bar that
        // confirmed it R bars later.
        int _x1 = bar_index - _right
        line _ln = line.new(_x1, _px, bar_index + 1, _px,
             extend = extend.none, color = _col, width = s2_width)
        label _lb = na
        if s2_showTf
            _lb := label.new(bar_index + 1, _px, s2_tfLabel(_tf),
                 style = label.style_label_left, color = color.new(color.black, 100),
                 textcolor = _col, size = s2_sizeOf(s2_lblSize))
        array.push(s2_levels, S2Level.new(_px, _isHigh, false, _col, _ln, _lb))
        while array.size(s2_levels) > s2_maxLevels
            S2Level _old = array.shift(s2_levels)
            line.delete(_old.ln)
            label.delete(_old.lb)

// ─── PIVOT FEED ───────────────────────────────────────────────
[s2_h1, s2_l1] = request.security(syminfo.tickerid, s2_t1,
     [ta.pivothigh(high, s2_t1L, s2_t1R), ta.pivotlow(low, s2_t1L, s2_t1R)], lookahead = barmerge.lookahead_off)
[s2_h2, s2_l2] = request.security(syminfo.tickerid, s2_t2,
     [ta.pivothigh(high, s2_t2L, s2_t2R), ta.pivotlow(low, s2_t2L, s2_t2R)], lookahead = barmerge.lookahead_off)
[s2_h3, s2_l3] = request.security(syminfo.tickerid, s2_t3,
     [ta.pivothigh(high, s2_t3L, s2_t3R), ta.pivotlow(low, s2_t3L, s2_t3R)], lookahead = barmerge.lookahead_off)

if barstate.isconfirmed
    if s2_t1On
        s2_add(s2_h1, true,  s2_t1Col, s2_t1R, s2_t1)
        s2_add(s2_l1, false, s2_t1Col, s2_t1R, s2_t1)
    if s2_t2On
        s2_add(s2_h2, true,  s2_t2Col, s2_t2R, s2_t2)
        s2_add(s2_l2, false, s2_t2Col, s2_t2R, s2_t2)
    if s2_t3On
        s2_add(s2_h3, true,  s2_t3Col, s2_t3R, s2_t3)
        s2_add(s2_l3, false, s2_t3Col, s2_t3R, s2_t3)

    // --- extend live levels, freeze the ones price has taken ---
    int s2_n = array.size(s2_levels)
    if s2_n > 0
        for i = 0 to s2_n - 1
            S2Level _l = array.get(s2_levels, i)
            if not _l.swept and not na(_l.ln)
                bool _hit = s2_sweepMode == "Wick through" ?
                     (_l.isHigh ? high >= _l.px : low <= _l.px) :
                     (_l.isHigh ? close > _l.px : close < _l.px)
                if _hit
                    _l.swept := true
                    if s2_keepSwept
                        line.set_x2(_l.ln, bar_index)
                        line.set_style(_l.ln, line.style_dotted)
                        line.set_color(_l.ln, color.new(_l.col, s2_sweptFade))
                        label.delete(_l.lb)
                        _l.lb := na
                    else
                        line.delete(_l.ln)
                        label.delete(_l.lb)
                        _l.ln := na
                        _l.lb := na
                else
                    line.set_x2(_l.ln, bar_index + 1)
                    if not na(_l.lb)
                        label.set_x(_l.lb, bar_index + 1)

// ─── ALERTS ───────────────────────────────────────────────────
// Fires when any tracked level is taken on this bar.
s2_sweptThisBar = false
if barstate.isconfirmed
    int _n2 = array.size(s2_levels)
    if _n2 > 0
        for i = 0 to _n2 - 1
            S2Level _l = array.get(s2_levels, i)
            if _l.swept and not na(_l.ln) and line.get_x2(_l.ln) == bar_index
                s2_sweptThisBar := true

alertcondition(s2_sweptThisBar, "Liquidity swept",
     "A tracked liquidity level has been taken.")

// ═══════════════════════════════════════════════════════════════
//  QUANT PRIME — BUILD MENU · TERMINAL TIER
//  MAIN 1 · SWEEP TRACKER
// ───────────────────────────────────────────────────────────────
//  A level getting taken is not the event. What price does in the
//  twenty minutes afterwards is the event.
//
//  This watches liquidity levels across three timeframes, marks
//  each one the moment it is swept, and then keeps watching. After
//  a set number of bars it grades the outcome:
//
//    REJECTED     price came back through the level
//    CONTINUED    price stayed beyond it and kept going
//    UNRESOLVED   neither, within the window
//
//  It also tracks which direction the most recent sweep set, and
//  how long that bias has been live, because a bias set forty bars
//  ago is a different thing to one set on the last candle.
//
//  What it does not do is tell you when to enter. A swept level
//  with a rejection is a condition, not a signal, and what happens
//  between that condition and an entry is the instrument's job.
//
//  Draws one table. All identifiers namespaced m1_.
// ═══════════════════════════════════════════════════════════════

// ─── TIMEFRAMES ───────────────────────────────────────────────
m1_gTf = "Levels"

m1_t1On  = input.bool(true, "TF1", group = m1_gTf, inline = "t1")
m1_t1    = input.timeframe("3", "", group = m1_gTf, inline = "t1")
m1_t1L   = input.int(4, "L", minval = 1, maxval = 20, group = m1_gTf, inline = "t1")
m1_t1R   = input.int(2, "R", minval = 1, maxval = 20, group = m1_gTf, inline = "t1")

m1_t2On  = input.bool(true, "TF2", group = m1_gTf, inline = "t2")
m1_t2    = input.timeframe("30", "", group = m1_gTf, inline = "t2")
m1_t2L   = input.int(4, "L", minval = 1, maxval = 20, group = m1_gTf, inline = "t2")
m1_t2R   = input.int(2, "R", minval = 1, maxval = 20, group = m1_gTf, inline = "t2")

m1_t3On  = input.bool(true, "TF3", group = m1_gTf, inline = "t3")
m1_t3    = input.timeframe("180", "", group = m1_gTf, inline = "t3")
m1_t3L   = input.int(4, "L", minval = 1, maxval = 20, group = m1_gTf, inline = "t3")
m1_t3R   = input.int(2, "R", minval = 1, maxval = 20, group = m1_gTf, inline = "t3",
     tooltip = "L and R are how many bars either side a pivot needs to qualify. Higher finds fewer, more significant levels.")

// ─── SWEEP DEFINITION ─────────────────────────────────────────
m1_gSweep = "What counts as a sweep"

m1_mode = input.string("Wick through", "Sweep trigger", options = ["Wick through", "Close beyond"], group = m1_gSweep,
     tooltip = "Wick through fires as soon as price reaches the level, which is what taking liquidity looks like. Close beyond waits for a candle to finish past it and finds fewer, larger events.")

m1_window = input.int(20, "Bars to grade the outcome over", minval = 3, maxval = 200, group = m1_gSweep,
     tooltip = "After a sweep, how many bars to watch before deciding whether price rejected or continued. Shorter is more decisive and less forgiving.")

m1_rejPct = input.float(50.0, "Rejection needs price back through by %", minval = 10.0, maxval = 100.0, step = 5.0, group = m1_gSweep,
     tooltip = "How far back through the level price must come for the sweep to grade REJECTED, as a percentage of how far beyond it went. 50% means it gave back half the overshoot.")

// ─── DISPLAY ──────────────────────────────────────────────────
m1_gDisp = "Display"

m1_showLines  = input.bool(true, "Draw levels", group = m1_gDisp)
m1_showMarks  = input.bool(true, "Mark sweeps on the chart", group = m1_gDisp)
m1_showBias   = input.bool(true, "Shade the current bias", group = m1_gDisp,
     tooltip = "Faint background tint in the direction the last sweep set.")

m1_liveCol   = input.color(#2962ff, "Unswept", group = m1_gDisp, inline = "c1")
m1_rejCol    = input.color(#2f6b41, "Rejected", group = m1_gDisp, inline = "c1")
m1_contCol   = input.color(#b4342a, "Continued", group = m1_gDisp, inline = "c1")
m1_unresCol  = input.color(#9a9da3, "Unresolved", group = m1_gDisp, inline = "c1")

m1_maxLv = input.int(150, "Maximum levels tracked", minval = 20, maxval = 500, group = m1_gDisp)

// ─── TABLE ────────────────────────────────────────────────────
m1_gTbl = "Table"

m1_tblOn  = input.bool(true, "Show table", group = m1_gTbl)
m1_tblPos = input.string("Top Right", "Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right"], group = m1_gTbl)
m1_tblSize = input.string("Tiny", "Size", options = ["Tiny", "Small", "Normal"], group = m1_gTbl)

// ─── STATE ────────────────────────────────────────────────────
//  outcome: 0 live · 1 rejected · 2 continued · 3 unresolved
type M1Level
    float px
    bool  isHigh
    string tf
    bool  swept
    int   sweptBar
    float extreme
    int   outcome
    line  ln
    label lb

var M1Level[] m1_levels = array.new<M1Level>()

// running tallies, by timeframe index 0/1/2
var int[] m1_nRej  = array.from(0, 0, 0)
var int[] m1_nCont = array.from(0, 0, 0)
var int[] m1_nUnr  = array.from(0, 0, 0)

var int   m1_bias     = 0        // 1 bullish, -1 bearish, 0 none
var int   m1_biasBar  = na
var float m1_biasFrom = na

m1_tfIndex(string _tf) =>
    _tf == m1_t1 ? 0 : _tf == m1_t2 ? 1 : 2

m1_sizeOf(_s) =>
    _s == "Tiny" ? size.tiny : _s == "Small" ? size.small : size.normal

m1_posOf(_p) =>
    _p == "Top Left" ? position.top_left :
     _p == "Bottom Right" ? position.bottom_right :
     _p == "Bottom Left" ? position.bottom_left :
     _p == "Middle Right" ? position.middle_right : position.top_right

m1_tfLabel(string _tf) =>
    string _out = _tf
    float  _n   = str.tonumber(_tf)
    if not na(_n)
        int _m = int(_n)
        _out := _m >= 1440 and _m % 1440 == 0 ? str.tostring(_m / 1440) + "D" :
             _m >= 60 and _m % 60 == 0 ? str.tostring(_m / 60) + "H" :
             str.tostring(_m) + "M"
    _out

m1_colOf(int _o) =>
    _o == 0 ? m1_liveCol : _o == 1 ? m1_rejCol : _o == 2 ? m1_contCol : m1_unresCol

// Higher timeframe pivots repeat across chart bars, so anything at
// effectively the same price is treated as already known.
m1_known(float _px) =>
    bool _f = false
    int _n = array.size(m1_levels)
    if _n > 0
        for i = 0 to _n - 1
            M1Level _l = array.get(m1_levels, i)
            if not _l.swept and math.abs(_l.px - _px) < syminfo.mintick * 2
                _f := true
    _f

m1_add(float _px, bool _isHigh, string _tf, int _right) =>
    if not na(_px) and not m1_known(_px)
        line _ln = na
        if m1_showLines
            _ln := line.new(bar_index - _right, _px, bar_index + 1, _px,
                 color = m1_liveCol, width = 1)
        array.push(m1_levels, M1Level.new(_px, _isHigh, _tf, false, na, na, 0, _ln, na))
        while array.size(m1_levels) > m1_maxLv
            M1Level _old = array.shift(m1_levels)
            line.delete(_old.ln)
            label.delete(_old.lb)

// ─── PIVOT FEED ───────────────────────────────────────────────
[m1_h1, m1_l1] = request.security(syminfo.tickerid, m1_t1,
     [ta.pivothigh(high, m1_t1L, m1_t1R), ta.pivotlow(low, m1_t1L, m1_t1R)], lookahead = barmerge.lookahead_off)
[m1_h2, m1_l2] = request.security(syminfo.tickerid, m1_t2,
     [ta.pivothigh(high, m1_t2L, m1_t2R), ta.pivotlow(low, m1_t2L, m1_t2R)], lookahead = barmerge.lookahead_off)
[m1_h3, m1_l3] = request.security(syminfo.tickerid, m1_t3,
     [ta.pivothigh(high, m1_t3L, m1_t3R), ta.pivotlow(low, m1_t3L, m1_t3R)], lookahead = barmerge.lookahead_off)

// ─── ENGINE ───────────────────────────────────────────────────
var bool m1_sweptThisBar = false
var bool m1_gradedThisBar = false

if barstate.isconfirmed
    m1_sweptThisBar  := false
    m1_gradedThisBar := false

    if m1_t1On
        m1_add(m1_h1, true,  m1_t1, m1_t1R)
        m1_add(m1_l1, false, m1_t1, m1_t1R)
    if m1_t2On
        m1_add(m1_h2, true,  m1_t2, m1_t2R)
        m1_add(m1_l2, false, m1_t2, m1_t2R)
    if m1_t3On
        m1_add(m1_h3, true,  m1_t3, m1_t3R)
        m1_add(m1_l3, false, m1_t3, m1_t3R)

    int m1_n = array.size(m1_levels)
    if m1_n > 0
        for i = 0 to m1_n - 1
            M1Level _l = array.get(m1_levels, i)

            // --- still live: extend, and check for the sweep ---
            if not _l.swept
                if not na(_l.ln)
                    line.set_x2(_l.ln, bar_index + 1)

                bool _hit = m1_mode == "Wick through" ?
                     (_l.isHigh ? high >= _l.px : low <= _l.px) :
                     (_l.isHigh ? close > _l.px : close < _l.px)

                if _hit
                    _l.swept    := true
                    _l.sweptBar := bar_index
                    _l.extreme  := _l.isHigh ? high : low
                    m1_sweptThisBar := true

                    // A high taken sets bearish bias, a low taken sets bullish.
                    // The premise is that the move beyond fails, not that it runs.
                    m1_bias     := _l.isHigh ? -1 : 1
                    m1_biasBar  := bar_index
                    m1_biasFrom := _l.px

                    if not na(_l.ln)
                        line.set_x2(_l.ln, bar_index)
                        line.set_style(_l.ln, line.style_dotted)

                    if m1_showMarks
                        _l.lb := label.new(bar_index, _l.isHigh ? high : low,
                             m1_tfLabel(_l.tf),
                             style     = _l.isHigh ? label.style_label_down : label.style_label_up,
                             color     = color.new(color.black, 100),
                             textcolor = m1_liveCol,
                             size      = size.tiny)

            // --- swept and still being graded ---
            else if _l.outcome == 0
                // track how far beyond the level price has gone
                if _l.isHigh
                    _l.extreme := math.max(_l.extreme, high)
                else
                    _l.extreme := math.min(_l.extreme, low)

                float _over = math.abs(_l.extreme - _l.px)
                float _need = _l.px + (_l.isHigh ? -1 : 1) * _over * (m1_rejPct / 100.0)

                bool _rejected = _over > 0 and (_l.isHigh ? close <= _need : close >= _need)
                bool _expired  = bar_index - _l.sweptBar >= m1_window

                if _rejected
                    _l.outcome := 1
                else if _expired
                    // beyond the level at the end of the window is a continuation
                    bool _beyond = _l.isHigh ? close > _l.px : close < _l.px
                    _l.outcome := _beyond ? 2 : 3

                if _l.outcome != 0
                    m1_gradedThisBar := true
                    int _tfi = m1_tfIndex(_l.tf)
                    if _l.outcome == 1
                        array.set(m1_nRej, _tfi, array.get(m1_nRej, _tfi) + 1)
                    else if _l.outcome == 2
                        array.set(m1_nCont, _tfi, array.get(m1_nCont, _tfi) + 1)
                    else
                        array.set(m1_nUnr, _tfi, array.get(m1_nUnr, _tfi) + 1)

                    if not na(_l.ln)
                        line.set_color(_l.ln, color.new(m1_colOf(_l.outcome), 40))
                    if not na(_l.lb)
                        label.set_textcolor(_l.lb, m1_colOf(_l.outcome))

// ─── BIAS SHADING ─────────────────────────────────────────────
bgcolor(m1_showBias and m1_bias ==  1 ? color.new(m1_rejCol, 96) : na, title = "Bullish bias")
bgcolor(m1_showBias and m1_bias == -1 ? color.new(m1_contCol, 96) : na, title = "Bearish bias")

// ─── TABLE ────────────────────────────────────────────────────
var table m1_tbl = na

if m1_tblOn and barstate.islast
    if na(m1_tbl)
        m1_tbl := table.new(m1_posOf(m1_tblPos), 5, 6,
             bgcolor = color.new(color.black, 20),
             border_color = color.new(color.gray, 60),
             border_width = 1)

    color _hdr = color.new(color.gray, 20)
    color _txt = color.white

    table.cell(m1_tbl, 0, 0, "SWEEPS",    text_color = _hdr, text_size = m1_sizeOf(m1_tblSize))
    table.cell(m1_tbl, 1, 0, "REJ",       text_color = _hdr, text_size = m1_sizeOf(m1_tblSize))
    table.cell(m1_tbl, 2, 0, "CONT",      text_color = _hdr, text_size = m1_sizeOf(m1_tblSize))
    table.cell(m1_tbl, 3, 0, "UNRES",     text_color = _hdr, text_size = m1_sizeOf(m1_tblSize))
    table.cell(m1_tbl, 4, 0, "REJ %",     text_color = _hdr, text_size = m1_sizeOf(m1_tblSize))

    string[] _tfs = array.from(m1_t1, m1_t2, m1_t3)
    bool[]   _ons = array.from(m1_t1On, m1_t2On, m1_t3On)

    int _totR = 0
    int _totC = 0
    int _totU = 0

    for i = 0 to 2
        int _r = array.get(m1_nRej, i)
        int _c = array.get(m1_nCont, i)
        int _u = array.get(m1_nUnr, i)
        int _graded = _r + _c
        _totR += _r
        _totC += _c
        _totU += _u

        string _pct = _graded < 30 ? "thin" :
             str.tostring(math.round(_r / _graded * 100)) + "%"
        color _pctCol = _graded < 30 ? m1_unresCol :
             _r / _graded >= 0.5 ? m1_rejCol : m1_contCol

        table.cell(m1_tbl, 0, i + 1, array.get(_ons, i) ? m1_tfLabel(array.get(_tfs, i)) : "—",
             text_color = _txt, text_size = m1_sizeOf(m1_tblSize))
        table.cell(m1_tbl, 1, i + 1, str.tostring(_r), text_color = _txt, text_size = m1_sizeOf(m1_tblSize))
        table.cell(m1_tbl, 2, i + 1, str.tostring(_c), text_color = _txt, text_size = m1_sizeOf(m1_tblSize))
        table.cell(m1_tbl, 3, i + 1, str.tostring(_u), text_color = m1_unresCol, text_size = m1_sizeOf(m1_tblSize))
        table.cell(m1_tbl, 4, i + 1, _pct, text_color = _pctCol, text_size = m1_sizeOf(m1_tblSize))

    // --- current bias row ---
    string _bTxt = m1_bias == 0 ? "NONE" : m1_bias == 1 ? "BULL" : "BEAR"
    color  _bCol = m1_bias == 0 ? m1_unresCol : m1_bias == 1 ? m1_rejCol : m1_contCol
    string _age  = na(m1_biasBar) ? "—" : str.tostring(bar_index - m1_biasBar) + " bars"

    table.cell(m1_tbl, 0, 4, "BIAS",  text_color = _hdr, text_size = m1_sizeOf(m1_tblSize))
    table.cell(m1_tbl, 1, 4, _bTxt,   text_color = _bCol, text_size = m1_sizeOf(m1_tblSize))
    table.cell(m1_tbl, 2, 4, _age,    text_color = _txt,  text_size = m1_sizeOf(m1_tblSize))
    table.cell(m1_tbl, 3, 4, "",      text_size = m1_sizeOf(m1_tblSize))
    table.cell(m1_tbl, 4, 4, "",      text_size = m1_sizeOf(m1_tblSize))

    // --- unswept count ---
    int _live = 0
    int _ln = array.size(m1_levels)
    if _ln > 0
        for i = 0 to _ln - 1
            if not array.get(m1_levels, i).swept
                _live += 1

    table.cell(m1_tbl, 0, 5, "UNSWEPT", text_color = _hdr, text_size = m1_sizeOf(m1_tblSize))
    table.cell(m1_tbl, 1, 5, str.tostring(_live), text_color = m1_liveCol, text_size = m1_sizeOf(m1_tblSize))
    table.cell(m1_tbl, 2, 5, "", text_size = m1_sizeOf(m1_tblSize))
    table.cell(m1_tbl, 3, 5, "", text_size = m1_sizeOf(m1_tblSize))
    table.cell(m1_tbl, 4, 5, "", text_size = m1_sizeOf(m1_tblSize))

// ─── ALERTS ───────────────────────────────────────────────────
alertcondition(m1_sweptThisBar, "Level swept",
     "A tracked liquidity level has been taken.")

alertcondition(m1_bias != m1_bias[1], "Bias changed",
     "The most recent sweep has set a new directional bias.")

// ═══════════════════════════════════════════════════════════════
//  QUANT PRIME — BUILD MENU · TERMINAL TIER
//  DESSERT 1 · SWEEP REPORT
// ───────────────────────────────────────────────────────────────
//  Does the premise hold on your instrument.
//
//  When price takes out a prior high or low, two things can
//  happen. It comes back through, meaning the break failed and the
//  move was a grab for the orders resting there. Or it stays
//  beyond and runs, meaning the level genuinely broke.
//
//  Meridian's whole premise is that the first happens more often
//  than the second. That was measured on one instrument. Whether
//  it survives on yours is a question only your own data answers.
//
//  Note this is a different event to what Recoil measures. Recoil
//  fades an exceptional candle. This measures whether a broken
//  level holds.
//
//  This runs the test. Every level swept in your history, split by
//  timeframe, graded on what price did afterwards:
//
//    REVERSED     came back through by the required amount
//    RAN ON       stayed beyond and kept going
//    UNRESOLVED   neither, inside the window
//
//  A reversal rate meaningfully above 50% supports the premise on
//  that timeframe. Around 50% means a break tells you nothing on
//  its own. Below it means the opposite is true on your pair, and
//  trading the failure puts you on the wrong side of it.
//
//  Rows with fewer than thirty graded sweeps are left ungraded,
//  because a 70% rate from six occurrences means nothing and
//  showing it as a number invites exactly the wrong conclusion.
//
//  Use a large sample. Five thousand candles, not five hundred.
//  Meridian's levels are swept less often than Recoil's candles
//  fire, so this table fills slowly.
//
//  Draws one table. Namespaced t1_.
// ═══════════════════════════════════════════════════════════════

// ─── TIMEFRAMES ───────────────────────────────────────────────
t1_gTf = "Levels"

t1_t1On = input.bool(true, "TF1", group = t1_gTf, inline = "t1")
t1_t1   = input.timeframe("3", "", group = t1_gTf, inline = "t1")
t1_t2On = input.bool(true, "TF2", group = t1_gTf, inline = "t2")
t1_t2   = input.timeframe("30", "", group = t1_gTf, inline = "t2")
t1_t3On = input.bool(true, "TF3", group = t1_gTf, inline = "t3")
t1_t3   = input.timeframe("180", "", group = t1_gTf, inline = "t3")

t1_pvL = input.int(4, "Pivot L", minval = 1, maxval = 20, group = t1_gTf, inline = "p")
t1_pvR = input.int(2, "Pivot R", minval = 1, maxval = 20, group = t1_gTf, inline = "p",
     tooltip = "Applied to all three timeframes. Higher values find fewer, more significant levels and will slow the sample down further.")

// ─── TEST ─────────────────────────────────────────────────────
t1_gTest = "Test"

t1_mode = input.string("Wick through", "A sweep is", options = ["Wick through", "Close beyond"], group = t1_gTest,
     tooltip = "Should match how you read a sweep on the chart. Close beyond finds fewer events and tends to produce higher rejection rates, because it has already filtered out the shallowest touches.")

t1_window = input.int(20, "Grade over N bars", minval = 3, maxval = 200, group = t1_gTest)

t1_rejPct = input.float(50.0, "Rejection needs % of the overshoot back", minval = 10.0, maxval = 100.0, step = 5.0, group = t1_gTest,
     tooltip = "How much of the move beyond the level price must give back for the sweep to grade REJECTED. Measured as a percentage of how far beyond it went, so it scales across instruments.")

t1_minSample = input.int(30, "Minimum graded sweeps", minval = 5, maxval = 200, group = t1_gTest,
     tooltip = "Rows below this are shown but left ungraded. Lowering it does not make a thin sample meaningful.")

// ─── SPLIT ────────────────────────────────────────────────────
t1_gSplit = "Split"

t1_bySide = input.bool(true, "Separate highs from lows", group = t1_gSplit,
     tooltip = "Highs taken and lows taken are not the same event on most instruments, and a pair that behaves symmetrically is worth knowing about.")

t1_maxLv = input.int(400, "Levels tracked", minval = 50, maxval = 500, group = t1_gSplit)

// ─── TABLE ────────────────────────────────────────────────────
t1_gTbl = "Table"

t1_tblPos  = input.string("Bottom Right", "Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right"], group = t1_gTbl)
t1_tblSize = input.string("Tiny", "Size", options = ["Tiny", "Small", "Normal"], group = t1_gTbl)

t1_legend = input.bool(true, "Show the plain english summary", group = t1_gTbl,
     tooltip = "A verdict row and a one line legend under the table, so the numbers do not need decoding on first use.")

t1_goodCol = input.color(#2f6b41, "Reverses",   group = t1_gTbl, inline = "c")
t1_badCol  = input.color(#b4342a, "Runs on",     group = t1_gTbl, inline = "c")
t1_thinCol = input.color(#9a9da3, "Thin",       group = t1_gTbl, inline = "c")

// ─── STATE ────────────────────────────────────────────────────
//  outcome: 0 pending · 1 rejected · 2 continued · 3 unresolved
type T1Lv
    float px
    bool  isHigh
    int   tfi
    bool  swept
    int   sweptBar
    float extreme
    int   outcome

var T1Lv[] t1_lv = array.new<T1Lv>()

// tallies indexed [timeframe * 2 + side], side 0 = highs, 1 = lows
var int[] t1_rej = array.from(0,0,0,0,0,0)
var int[] t1_con = array.from(0,0,0,0,0,0)
var int[] t1_unr = array.from(0,0,0,0,0,0)

t1_sizeOf(_s) =>
    _s == "Tiny" ? size.tiny : _s == "Small" ? size.small : size.normal

t1_posOf(_p) =>
    _p == "Top Right" ? position.top_right :
     _p == "Top Left" ? position.top_left :
     _p == "Bottom Left" ? position.bottom_left :
     _p == "Middle Right" ? position.middle_right : position.bottom_right

t1_tfLabel(string _tf) =>
    string _out = _tf
    float  _n   = str.tonumber(_tf)
    if not na(_n)
        int _m = int(_n)
        _out := _m >= 1440 and _m % 1440 == 0 ? str.tostring(_m / 1440) + "D" :
             _m >= 60 and _m % 60 == 0 ? str.tostring(_m / 60) + "H" :
             str.tostring(_m) + "M"
    _out

t1_known(float _px) =>
    bool _f = false
    int _n = array.size(t1_lv)
    if _n > 0
        for i = 0 to _n - 1
            T1Lv _l = array.get(t1_lv, i)
            if not _l.swept and math.abs(_l.px - _px) < syminfo.mintick * 2
                _f := true
    _f

t1_add(float _px, bool _isHigh, int _tfi) =>
    if not na(_px) and not t1_known(_px)
        array.push(t1_lv, T1Lv.new(_px, _isHigh, _tfi, false, na, na, 0))
        while array.size(t1_lv) > t1_maxLv
            array.shift(t1_lv)

// ─── PIVOT FEED ───────────────────────────────────────────────
[t1_h1, t1_l1] = request.security(syminfo.tickerid, t1_t1,
     [ta.pivothigh(high, t1_pvL, t1_pvR), ta.pivotlow(low, t1_pvL, t1_pvR)], lookahead = barmerge.lookahead_off)
[t1_h2, t1_l2] = request.security(syminfo.tickerid, t1_t2,
     [ta.pivothigh(high, t1_pvL, t1_pvR), ta.pivotlow(low, t1_pvL, t1_pvR)], lookahead = barmerge.lookahead_off)
[t1_h3, t1_l3] = request.security(syminfo.tickerid, t1_t3,
     [ta.pivothigh(high, t1_pvL, t1_pvR), ta.pivotlow(low, t1_pvL, t1_pvR)], lookahead = barmerge.lookahead_off)

// ─── ENGINE ───────────────────────────────────────────────────
if barstate.isconfirmed
    if t1_t1On
        t1_add(t1_h1, true,  0)
        t1_add(t1_l1, false, 0)
    if t1_t2On
        t1_add(t1_h2, true,  1)
        t1_add(t1_l2, false, 1)
    if t1_t3On
        t1_add(t1_h3, true,  2)
        t1_add(t1_l3, false, 2)

    int _n = array.size(t1_lv)
    if _n > 0
        for i = 0 to _n - 1
            T1Lv _l = array.get(t1_lv, i)

            if not _l.swept
                bool _hit = t1_mode == "Wick through" ?
                     (_l.isHigh ? high >= _l.px : low <= _l.px) :
                     (_l.isHigh ? close > _l.px : close < _l.px)
                if _hit
                    _l.swept    := true
                    _l.sweptBar := bar_index
                    _l.extreme  := _l.isHigh ? high : low

            else if _l.outcome == 0
                _l.extreme := _l.isHigh ? math.max(_l.extreme, high) : math.min(_l.extreme, low)

                float _over = math.abs(_l.extreme - _l.px)
                float _need = _l.px + (_l.isHigh ? -1 : 1) * _over * (t1_rejPct / 100.0)

                bool _rej = _over > 0 and (_l.isHigh ? close <= _need : close >= _need)
                bool _exp = bar_index - _l.sweptBar >= t1_window

                if _rej
                    _l.outcome := 1
                else if _exp
                    _l.outcome := (_l.isHigh ? close > _l.px : close < _l.px) ? 2 : 3

                if _l.outcome != 0
                    int _slot = _l.tfi * 2 + (_l.isHigh ? 0 : 1)
                    if _l.outcome == 1
                        array.set(t1_rej, _slot, array.get(t1_rej, _slot) + 1)
                    else if _l.outcome == 2
                        array.set(t1_con, _slot, array.get(t1_con, _slot) + 1)
                    else
                        array.set(t1_unr, _slot, array.get(t1_unr, _slot) + 1)

// ─── TABLE ────────────────────────────────────────────────────
var table t1_tbl = na

if barstate.islast
    int _rows = (t1_bySide ? 8 : 5) + (t1_legend ? 2 : 0)
    if na(t1_tbl)
        t1_tbl := table.new(t1_posOf(t1_tblPos), 5, _rows,
             bgcolor = color.new(color.black, 20),
             border_color = color.new(color.gray, 60),
             border_width = 1)

    color _hdr = color.new(color.gray, 20)
    string _sz = t1_tblSize

    table.cell(t1_tbl, 0, 0, "SWEEPS",  text_color = _hdr, text_size = t1_sizeOf(_sz))
    table.cell(t1_tbl, 1, 0, "SWEPT",   text_color = _hdr, text_size = t1_sizeOf(_sz))
    table.cell(t1_tbl, 2, 0, "CAME BK", text_color = _hdr, text_size = t1_sizeOf(_sz))
    table.cell(t1_tbl, 3, 0, "RAN ON",  text_color = _hdr, text_size = t1_sizeOf(_sz))
    table.cell(t1_tbl, 4, 0, "REV %",   text_color = _hdr, text_size = t1_sizeOf(_sz))

    string[] _tfs = array.from(t1_t1, t1_t2, t1_t3)
    bool[]   _ons = array.from(t1_t1On, t1_t2On, t1_t3On)

    int _row = 1
    int _allR = 0
    int _allC = 0
    int _allU = 0

    for i = 0 to 2
        if not array.get(_ons, i)
            continue

        int _rH = array.get(t1_rej, i * 2)
        int _cH = array.get(t1_con, i * 2)
        int _uH = array.get(t1_unr, i * 2)
        int _rL = array.get(t1_rej, i * 2 + 1)
        int _cL = array.get(t1_con, i * 2 + 1)
        int _uL = array.get(t1_unr, i * 2 + 1)

        _allR += _rH + _rL
        _allC += _cH + _cL
        _allU += _uH + _uL

        if t1_bySide
            // highs row
            int _gH = _rH + _cH
            table.cell(t1_tbl, 0, _row, t1_tfLabel(array.get(_tfs, i)) + " hi", text_color = color.white, text_size = t1_sizeOf(_sz))
            table.cell(t1_tbl, 1, _row, str.tostring(_gH + _uH), text_color = color.white, text_size = t1_sizeOf(_sz))
            table.cell(t1_tbl, 2, _row, str.tostring(_rH), text_color = color.white, text_size = t1_sizeOf(_sz))
            table.cell(t1_tbl, 3, _row, str.tostring(_cH), text_color = color.white, text_size = t1_sizeOf(_sz))
            if _gH < t1_minSample
                table.cell(t1_tbl, 4, _row, "thin", text_color = t1_thinCol, text_size = t1_sizeOf(_sz))
            else
                float _p = _rH / _gH * 100.0
                table.cell(t1_tbl, 4, _row, str.tostring(math.round(_p)) + "%",
                     text_color = _p >= 55 ? t1_goodCol : _p <= 45 ? t1_badCol : t1_thinCol,
                     text_size = t1_sizeOf(_sz))
            _row += 1

            // lows row
            int _gL = _rL + _cL
            table.cell(t1_tbl, 0, _row, t1_tfLabel(array.get(_tfs, i)) + " lo", text_color = color.white, text_size = t1_sizeOf(_sz))
            table.cell(t1_tbl, 1, _row, str.tostring(_gL + _uL), text_color = color.white, text_size = t1_sizeOf(_sz))
            table.cell(t1_tbl, 2, _row, str.tostring(_rL), text_color = color.white, text_size = t1_sizeOf(_sz))
            table.cell(t1_tbl, 3, _row, str.tostring(_cL), text_color = color.white, text_size = t1_sizeOf(_sz))
            if _gL < t1_minSample
                table.cell(t1_tbl, 4, _row, "thin", text_color = t1_thinCol, text_size = t1_sizeOf(_sz))
            else
                float _p = _rL / _gL * 100.0
                table.cell(t1_tbl, 4, _row, str.tostring(math.round(_p)) + "%",
                     text_color = _p >= 55 ? t1_goodCol : _p <= 45 ? t1_badCol : t1_thinCol,
                     text_size = t1_sizeOf(_sz))
            _row += 1
        else
            int _r = _rH + _rL
            int _c = _cH + _cL
            int _u = _uH + _uL
            int _g = _r + _c
            table.cell(t1_tbl, 0, _row, t1_tfLabel(array.get(_tfs, i)), text_color = color.white, text_size = t1_sizeOf(_sz))
            table.cell(t1_tbl, 1, _row, str.tostring(_g + _u), text_color = color.white, text_size = t1_sizeOf(_sz))
            table.cell(t1_tbl, 2, _row, str.tostring(_r), text_color = color.white, text_size = t1_sizeOf(_sz))
            table.cell(t1_tbl, 3, _row, str.tostring(_c), text_color = color.white, text_size = t1_sizeOf(_sz))
            if _g < t1_minSample
                table.cell(t1_tbl, 4, _row, "thin", text_color = t1_thinCol, text_size = t1_sizeOf(_sz))
            else
                float _p = _r / _g * 100.0
                table.cell(t1_tbl, 4, _row, str.tostring(math.round(_p)) + "%",
                     text_color = _p >= 55 ? t1_goodCol : _p <= 45 ? t1_badCol : t1_thinCol,
                     text_size = t1_sizeOf(_sz))
            _row += 1

    int _allRow = _rows - (t1_legend ? 3 : 1)

    // fill any unused rows so the table does not show stale cells
    while _row < _allRow
        for c = 0 to 4
            table.cell(t1_tbl, c, _row, "", text_size = t1_sizeOf(_sz))
        _row += 1

    // total
    int _allG = _allR + _allC
    table.cell(t1_tbl, 0, _allRow, "ALL", text_color = _hdr, text_size = t1_sizeOf(_sz))
    table.cell(t1_tbl, 1, _allRow, str.tostring(_allG + _allU), text_color = color.white, text_size = t1_sizeOf(_sz))
    table.cell(t1_tbl, 2, _allRow, str.tostring(_allR), text_color = color.white, text_size = t1_sizeOf(_sz))
    table.cell(t1_tbl, 3, _allRow, str.tostring(_allC), text_color = color.white, text_size = t1_sizeOf(_sz))
    if _allG < t1_minSample
        table.cell(t1_tbl, 4, _allRow, "thin", text_color = t1_thinCol, text_size = t1_sizeOf(_sz))
    else
        float _p = _allR / _allG * 100.0
        table.cell(t1_tbl, 4, _allRow, str.tostring(math.round(_p)) + "%",
             text_color = _p >= 55 ? t1_goodCol : _p <= 45 ? t1_badCol : t1_thinCol,
             text_size = t1_sizeOf(_sz))

    // ─── PLAIN ENGLISH ────────────────────────────────────────
    //  The table above is the evidence. This is what it says.
    if t1_legend
        int _lr = _rows - 2

        string _verdict = ""
        color  _vCol    = t1_thinCol

        if _allG < t1_minSample
            _verdict := "Not enough sweeps yet — use more history"
        else
            float _pAll = _allR / _allG * 100.0

            // count how many graded rows fall each side of the line
            int _sup = 0
            int _con = 0
            for i = 0 to 2
                if array.get(_ons, i)
                    int _r2 = array.get(t1_rej, i * 2) + array.get(t1_rej, i * 2 + 1)
                    int _c2 = array.get(t1_con, i * 2) + array.get(t1_con, i * 2 + 1)
                    int _g2 = _r2 + _c2
                    if _g2 >= t1_minSample
                        float _p2 = _r2 / _g2 * 100.0
                        if _p2 >= 55
                            _sup += 1
                        else if _p2 <= 45
                            _con += 1

            if _pAll >= 55
                _vCol := t1_goodCol
                _verdict := _con > 0 ?
                     "Broken levels mostly reverse — but check the red rows" :
                     "Broken levels reverse — " + str.tostring(math.round(_pAll)) + "% came back through"
            else if _pAll <= 45
                _vCol := t1_badCol
                _verdict := "Broken levels run on more than they reverse"
            else
                _verdict := "No clear edge — a break alone says little here"

        // Merged across the full width so the long strings do not
        // stretch the data columns. Pine sizes a column to its
        // widest cell, and a merged cell is exempt from that.
        table.cell(t1_tbl, 0, _lr, _verdict,
             text_color = _vCol, text_size = t1_sizeOf(_sz),
             text_halign = text.align_center)
        table.cell(t1_tbl, 1, _lr, "", text_size = t1_sizeOf(_sz))
        table.cell(t1_tbl, 2, _lr, "", text_size = t1_sizeOf(_sz))
        table.cell(t1_tbl, 3, _lr, "", text_size = t1_sizeOf(_sz))
        table.cell(t1_tbl, 4, _lr, "", text_size = t1_sizeOf(_sz))
        table.merge_cells(t1_tbl, 0, _lr, 4, _lr)

        table.cell(t1_tbl, 0, _rows - 1,
             "REV % = how often a broken level came back through   ·   green supports it, red argues against",
             text_color = t1_thinCol, text_size = t1_sizeOf(_sz),
             text_halign = text.align_center)
        table.cell(t1_tbl, 1, _rows - 1, "", text_size = t1_sizeOf(_sz))
        table.cell(t1_tbl, 2, _rows - 1, "", text_size = t1_sizeOf(_sz))
        table.cell(t1_tbl, 3, _rows - 1, "", text_size = t1_sizeOf(_sz))
        table.cell(t1_tbl, 4, _rows - 1, "", text_size = t1_sizeOf(_sz))
        table.merge_cells(t1_tbl, 0, _rows - 1, 4, _rows - 1)

//@version=6
// ═════════════════════════════════════════════════════════════
//  QUANT PRIME — BUILD MENU · TERMINAL TIER
//  MER-S3M2D2T3
//    S3  Fair Value Gaps
//    M2  Liquidity Map
//    D2  Stack Monitor
//    T3  Session Report
// ═════════════════════════════════════════════════════════════

indicator("QP Terminal · S3M2D2T3", shorttitle = "QPS3M2D2T3", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// ═══════════════════════════════════════════════════════════════
//  QUANT PRIME — BUILD MENU · TERMINAL TIER
//  STARTER 3 · FAIR VALUE GAPS
// ───────────────────────────────────────────────────────────────
//  Three candles where the first and third do not overlap leave a
//  band of price that nobody traded through properly. Price moved
//  so fast that a stretch of the chart has no two sided activity
//  in it at all.
//
//  Those gaps get revisited. Not always, and not on any schedule,
//  but often enough that knowing where they are is worth more
//  than most things you can draw on a chart.
//
//  What matters more than finding them is tracking what happens
//  to them, so each gap here carries a state:
//
//    FRESH      untouched since it formed
//    TAPPED     price has reached its midpoint
//    FILLED     price has traded fully through it
//    INVERTED   filled, then approached again from the far side
//
//  An inverted gap is not a dead one. It frequently acts as
//  support having previously been resistance, which is why the
//  state is tracked rather than the gap simply being deleted.
//
//  Draws no table. Safe to combine with any other Meridian piece.
//  All identifiers namespaced s3_ to avoid collisions.
// ═══════════════════════════════════════════════════════════════

// ─── TIMEFRAMES ───────────────────────────────────────────────
s3_gTf = "Timeframes"

s3_t1On = input.bool(true, "TF1", group = s3_gTf, inline = "t1")
s3_t1   = input.timeframe("3", "", group = s3_gTf, inline = "t1")

s3_t2On = input.bool(true, "TF2", group = s3_gTf, inline = "t2")
s3_t2   = input.timeframe("30", "", group = s3_gTf, inline = "t2")

s3_t3On = input.bool(false, "TF3", group = s3_gTf, inline = "t3")
s3_t3   = input.timeframe("180", "", group = s3_gTf, inline = "t3",
     tooltip = "Three timeframes of gaps is a lot on one chart. TF3 is off by default -- turn it on when you want the higher timeframe picture and TF1 off.")

// ─── FILTER ───────────────────────────────────────────────────
s3_gFilter = "Filter"

s3_minAtr = input.float(0.0, "Minimum gap size (x ATR)", minval = 0.0, step = 0.05, group = s3_gFilter,
     tooltip = "Ignores gaps smaller than this. Most charts produce a great many tiny gaps that mean nothing. Try 0.25 if the chart is too busy.")

s3_atrLen = input.int(14, "ATR length", minval = 1, group = s3_gFilter)

s3_hideFilled = input.bool(false, "Hide gaps once filled", group = s3_gFilter,
     tooltip = "On: a gap disappears when price trades fully through it. Off: it stays, faded, and can still invert.")

s3_maxGaps = input.int(250, "Maximum gaps tracked", minval = 20, maxval = 500, group = s3_gFilter)

// ─── APPEARANCE ───────────────────────────────────────────────
s3_gApp = "Appearance"

s3_bullCol = input.color(#2962ff, "Bullish gap", group = s3_gApp, inline = "c1")
s3_bearCol = input.color(#b39ddb, "Bearish gap", group = s3_gApp, inline = "c1")

s3_freshFade  = input.int(88, "Fresh",    minval = 60, maxval = 99, group = s3_gApp, inline = "f1")
s3_tappedFade = input.int(93, "Tapped",   minval = 60, maxval = 99, group = s3_gApp, inline = "f1")
s3_filledFade = input.int(96, "Filled",   minval = 60, maxval = 99, group = s3_gApp, inline = "f2")
s3_invCol     = input.color(#c9a84c, "Inverted", group = s3_gApp, inline = "f2")

s3_border = input.bool(false, "Show borders", group = s3_gApp)

s3_showMid = input.bool(false, "Mark the midpoint", group = s3_gApp,
     tooltip = "The 50% line is where a gap is considered tapped. Useful while you are learning to read them, noisy afterwards.")

s3_showState = input.bool(false, "Label gap state", group = s3_gApp)
s3_lblSize   = input.string("Tiny", "Label size", options = ["Tiny", "Small", "Normal"], group = s3_gApp)

// ─── STORE ────────────────────────────────────────────────────
//  state 0 fresh · 1 tapped · 2 filled · 3 inverted
type S3Gap
    float top
    float bot
    float mid
    bool  isBull
    int   state
    box   bx
    line  ln
    label lb

var S3Gap[] s3_gaps = array.new<S3Gap>()

s3_atr = ta.atr(s3_atrLen)

s3_sizeOf(_s) =>
    _s == "Tiny" ? size.tiny : _s == "Small" ? size.small : size.normal

s3_stateName(int _s) =>
    _s == 0 ? "fresh" : _s == 1 ? "tapped" : _s == 2 ? "filled" : "inverted"

s3_gapCol(S3Gap _g) =>
    _g.state == 3 ? s3_invCol : _g.isBull ? s3_bullCol : s3_bearCol

s3_gapFade(S3Gap _g) =>
    _g.state == 0 ? s3_freshFade : _g.state == 1 ? s3_tappedFade : s3_filledFade

// Higher timeframe gaps repeat across chart bars, so anything at
// effectively the same prices is treated as already known.
s3_exists(float _t, float _b) =>
    bool _found = false
    int  _sz = array.size(s3_gaps)
    if _sz > 0
        int _from = math.max(0, _sz - 20)
        for i = _from to _sz - 1
            S3Gap _g = array.get(s3_gaps, i)
            if math.abs(_g.top - _t) < syminfo.mintick * 2 and math.abs(_g.bot - _b) < syminfo.mintick * 2
                _found := true
    _found

s3_add(float _t, float _b, bool _isBull) =>
    if not na(_t) and not na(_b) and _t > _b and not s3_exists(_t, _b)
        if s3_minAtr <= 0 or (_t - _b) >= s3_atr * s3_minAtr
            float _mid = (_t + _b) / 2
            color _c   = _isBull ? s3_bullCol : s3_bearCol
            box _bx = box.new(time, _t, time, _b, xloc = xloc.bar_time,
                 bgcolor      = color.new(_c, s3_freshFade),
                 border_color = s3_border ? color.new(_c, 50) : color.new(_c, 100),
                 border_width = s3_border ? 1 : 0)
            line _ln = na
            if s3_showMid
                _ln := line.new(time, _mid, time, _mid, xloc = xloc.bar_time,
                     color = color.new(_c, 50), style = line.style_dotted, width = 1)
            label _lb = na
            if s3_showState
                _lb := label.new(time, _t, "fresh", xloc = xloc.bar_time,
                     style = label.style_label_left, color = color.new(color.black, 100),
                     textcolor = _c, size = s3_sizeOf(s3_lblSize))
            array.push(s3_gaps, S3Gap.new(_t, _b, _mid, _isBull, 0, _bx, _ln, _lb))
            while array.size(s3_gaps) > s3_maxGaps
                S3Gap _old = array.shift(s3_gaps)
                box.delete(_old.bx)
                line.delete(_old.ln)
                label.delete(_old.lb)

// ─── DETECTION FEED ───────────────────────────────────────────
// A bullish gap is the space between candle 3's high and candle
// 1's low when the two do not overlap. Bearish is the mirror.
s3_read() =>
    [high[0], low[0], high[2], low[2]]

[s3_h1a, s3_l1a, s3_h3a, s3_l3a] = request.security(syminfo.tickerid, s3_t1, s3_read(), lookahead = barmerge.lookahead_off)
[s3_h1b, s3_l1b, s3_h3b, s3_l3b] = request.security(syminfo.tickerid, s3_t2, s3_read(), lookahead = barmerge.lookahead_off)
[s3_h1c, s3_l1c, s3_h3c, s3_l3c] = request.security(syminfo.tickerid, s3_t3, s3_read(), lookahead = barmerge.lookahead_off)

s3_detect(bool _on, float _h1, float _l1, float _h3, float _l3) =>
    if _on and not na(_h1) and not na(_l1) and not na(_h3) and not na(_l3)
        if _l1 > _h3
            s3_add(_l1, _h3, true)
        else if _h1 < _l3
            s3_add(_l3, _h1, false)
    true

// ─── ENGINE ───────────────────────────────────────────────────
if barstate.isconfirmed
    s3_detect(s3_t1On, s3_h1a, s3_l1a, s3_h3a, s3_l3a)
    s3_detect(s3_t2On, s3_h1b, s3_l1b, s3_h3b, s3_l3b)
    s3_detect(s3_t3On, s3_h1c, s3_l1c, s3_h3c, s3_l3c)

    int s3_n = array.size(s3_gaps)
    if s3_n > 0
        for i = 0 to s3_n - 1
            S3Gap _g = array.get(s3_gaps, i)
            if na(_g.bx)
                continue

            int _prev = _g.state

            if _g.state == 0
                // Reaching the midpoint counts as tapped.
                if _g.isBull ? low <= _g.mid : high >= _g.mid
                    _g.state := 1
            else if _g.state == 1
                // Trading fully through it counts as filled.
                if _g.isBull ? close < _g.bot : close > _g.top
                    _g.state := 2
            else if _g.state == 2
                // Coming back from the far side inverts it.
                if _g.isBull ? high >= _g.mid : low <= _g.mid
                    _g.state := 3

            if _g.state == 2 and s3_hideFilled
                box.delete(_g.bx)
                line.delete(_g.ln)
                label.delete(_g.lb)
                _g.bx := na
                _g.ln := na
                _g.lb := na
            else
                box.set_right(_g.bx, time)
                if not na(_g.ln)
                    line.set_x2(_g.ln, time)
                if _g.state != _prev
                    box.set_bgcolor(_g.bx, color.new(s3_gapCol(_g), s3_gapFade(_g)))
                    if s3_border
                        box.set_border_color(_g.bx, color.new(s3_gapCol(_g), 50))
                if not na(_g.lb)
                    label.set_x(_g.lb, time)
                    if _g.state != _prev
                        label.set_text(_g.lb, s3_stateName(_g.state))
                        label.set_textcolor(_g.lb, s3_gapCol(_g))

// ─── ALERTS ───────────────────────────────────────────────────
s3_freshCount = 0
if barstate.islast
    int _n3 = array.size(s3_gaps)
    if _n3 > 0
        for i = 0 to _n3 - 1
            if array.get(s3_gaps, i).state == 0
                s3_freshCount += 1

alertcondition(s3_freshCount > s3_freshCount[1], "New fair value gap",
     "A new fair value gap has formed on a tracked timeframe.")

// ═══════════════════════════════════════════════════════════════
//  QUANT PRIME — BUILD MENU · TERMINAL TIER
//  MAIN 2 · LIQUIDITY MAP
// ───────────────────────────────────────────────────────────────
//  Where is price actually going.
//
//  The Sweep Tracker looks backwards at levels that have already
//  been taken. This looks forwards at the ones that have not.
//
//  Every unswept level above and below current price, sorted by
//  distance, with the nearest on each side highlighted. Then a
//  simple imbalance reading: if there are nine unswept levels
//  above and two below, the resting orders are mostly overhead,
//  and price has more to collect in that direction.
//
//  That is not a prediction. Liquidity sitting above price is not
//  a reason to be long. It is a statement about where the obvious
//  stops are, and what the market has left to do if it goes
//  looking for them.
//
//  Draws one table. All identifiers namespaced m2_.
// ═══════════════════════════════════════════════════════════════

// ─── TIMEFRAMES ───────────────────────────────────────────────
m2_gTf = "Levels"

m2_t1On = input.bool(true, "TF1", group = m2_gTf, inline = "t1")
m2_t1   = input.timeframe("3", "", group = m2_gTf, inline = "t1")
m2_t1L  = input.int(4, "L", minval = 1, maxval = 20, group = m2_gTf, inline = "t1")
m2_t1R  = input.int(2, "R", minval = 1, maxval = 20, group = m2_gTf, inline = "t1")

m2_t2On = input.bool(true, "TF2", group = m2_gTf, inline = "t2")
m2_t2   = input.timeframe("30", "", group = m2_gTf, inline = "t2")
m2_t2L  = input.int(4, "L", minval = 1, maxval = 20, group = m2_gTf, inline = "t2")
m2_t2R  = input.int(2, "R", minval = 1, maxval = 20, group = m2_gTf, inline = "t2")

m2_t3On = input.bool(true, "TF3", group = m2_gTf, inline = "t3")
m2_t3   = input.timeframe("180", "", group = m2_gTf, inline = "t3")
m2_t3L  = input.int(4, "L", minval = 1, maxval = 20, group = m2_gTf, inline = "t3")
m2_t3R  = input.int(2, "R", minval = 1, maxval = 20, group = m2_gTf, inline = "t3",
     tooltip = "Higher L and R finds fewer, more significant levels. A 3H level matters considerably more than a 3M one.")

// ─── MAP ──────────────────────────────────────────────────────
m2_gMap = "Map"

m2_show = input.int(4, "Levels to list each side", minval = 1, maxval = 8, group = m2_gMap,
     tooltip = "How many unswept levels above and below to list in the table, nearest first.")

m2_range = input.float(0.0, "Ignore levels beyond N x ATR", minval = 0.0, step = 0.5, group = m2_gMap,
     tooltip = "Levels further away than this are excluded from the map and the imbalance count. 0 disables the filter. Useful on instruments with a long history of far-away pivots that will not be reached today.")

m2_atrLen = input.int(14, "ATR length", minval = 1, group = m2_gMap)

m2_unit = input.string("Pips", "Distance shown in", options = ["Pips", "ATR", "Price"], group = m2_gMap)

// ─── DISPLAY ──────────────────────────────────────────────────
m2_gDisp = "Display"

m2_showLines = input.bool(true, "Draw unswept levels", group = m2_gDisp)
m2_markNear  = input.bool(true, "Highlight the nearest each side", group = m2_gDisp)

m2_aboveCol = input.color(#b4342a, "Above", group = m2_gDisp, inline = "c")
m2_belowCol = input.color(#2f6b41, "Below", group = m2_gDisp, inline = "c")
m2_nearCol  = input.color(#c9a84c, "Nearest", group = m2_gDisp, inline = "c")

m2_width  = input.int(1, "Line width", minval = 1, maxval = 3, group = m2_gDisp)
m2_maxLv  = input.int(150, "Maximum levels tracked", minval = 20, maxval = 500, group = m2_gDisp)

// ─── TABLE ────────────────────────────────────────────────────
m2_gTbl = "Table"

m2_tblOn   = input.bool(true, "Show table", group = m2_gTbl)
m2_tblPos  = input.string("Top Right", "Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right"], group = m2_gTbl)
m2_tblSize = input.string("Tiny", "Size", options = ["Tiny", "Small", "Normal"], group = m2_gTbl)

// ─── STATE ────────────────────────────────────────────────────
type M2Level
    float px
    bool  isHigh
    string tf
    bool  swept
    line  ln

var M2Level[] m2_levels = array.new<M2Level>()

m2_atr = ta.atr(m2_atrLen)

m2_pipMult() =>
    str.contains(syminfo.ticker, "JPY") ? 100.0 :
     str.contains(syminfo.ticker, "XAU") or str.contains(syminfo.ticker, "XAG") ? 10.0 :
     syminfo.type == "forex" ? 10000.0 : 1.0

m2_sizeOf(_s) =>
    _s == "Tiny" ? size.tiny : _s == "Small" ? size.small : size.normal

m2_posOf(_p) =>
    _p == "Top Left" ? position.top_left :
     _p == "Bottom Right" ? position.bottom_right :
     _p == "Bottom Left" ? position.bottom_left :
     _p == "Middle Right" ? position.middle_right : position.top_right

m2_tfLabel(string _tf) =>
    string _out = _tf
    float  _n   = str.tonumber(_tf)
    if not na(_n)
        int _m = int(_n)
        _out := _m >= 1440 and _m % 1440 == 0 ? str.tostring(_m / 1440) + "D" :
             _m >= 60 and _m % 60 == 0 ? str.tostring(_m / 60) + "H" :
             str.tostring(_m) + "M"
    _out

m2_dist(float _px) =>
    float _d = math.abs(_px - close)
    m2_unit == "Pips" ? _d * m2_pipMult() :
     m2_unit == "ATR" ? (m2_atr > 0 ? _d / m2_atr : 0.0) : _d

m2_distStr(float _px) =>
    float _v = m2_dist(_px)
    m2_unit == "Pips" ? str.tostring(math.round(_v, 1)) :
     m2_unit == "ATR" ? str.tostring(math.round(_v, 2)) + "x" :
     str.tostring(math.round_to_mintick(_v))

m2_known(float _px) =>
    bool _f = false
    int _n = array.size(m2_levels)
    if _n > 0
        for i = 0 to _n - 1
            M2Level _l = array.get(m2_levels, i)
            if not _l.swept and math.abs(_l.px - _px) < syminfo.mintick * 2
                _f := true
    _f

m2_add(float _px, bool _isHigh, string _tf, int _right) =>
    if not na(_px) and not m2_known(_px)
        line _ln = na
        if m2_showLines
            _ln := line.new(bar_index - _right, _px, bar_index + 1, _px,
                 color = _isHigh ? m2_aboveCol : m2_belowCol, width = m2_width)
        array.push(m2_levels, M2Level.new(_px, _isHigh, _tf, false, _ln))
        while array.size(m2_levels) > m2_maxLv
            M2Level _old = array.shift(m2_levels)
            line.delete(_old.ln)

// ─── PIVOT FEED ───────────────────────────────────────────────
[m2_h1, m2_l1] = request.security(syminfo.tickerid, m2_t1,
     [ta.pivothigh(high, m2_t1L, m2_t1R), ta.pivotlow(low, m2_t1L, m2_t1R)], lookahead = barmerge.lookahead_off)
[m2_h2, m2_l2] = request.security(syminfo.tickerid, m2_t2,
     [ta.pivothigh(high, m2_t2L, m2_t2R), ta.pivotlow(low, m2_t2L, m2_t2R)], lookahead = barmerge.lookahead_off)
[m2_h3, m2_l3] = request.security(syminfo.tickerid, m2_t3,
     [ta.pivothigh(high, m2_t3L, m2_t3R), ta.pivotlow(low, m2_t3L, m2_t3R)], lookahead = barmerge.lookahead_off)

// ─── ENGINE ───────────────────────────────────────────────────
if barstate.isconfirmed
    if m2_t1On
        m2_add(m2_h1, true,  m2_t1, m2_t1R)
        m2_add(m2_l1, false, m2_t1, m2_t1R)
    if m2_t2On
        m2_add(m2_h2, true,  m2_t2, m2_t2R)
        m2_add(m2_l2, false, m2_t2, m2_t2R)
    if m2_t3On
        m2_add(m2_h3, true,  m2_t3, m2_t3R)
        m2_add(m2_l3, false, m2_t3, m2_t3R)

    int m2_n = array.size(m2_levels)
    if m2_n > 0
        for i = 0 to m2_n - 1
            M2Level _l = array.get(m2_levels, i)
            if not _l.swept
                // once taken, a level leaves the map entirely
                if _l.isHigh ? high >= _l.px : low <= _l.px
                    _l.swept := true
                    line.delete(_l.ln)
                    _l.ln := na
                else if not na(_l.ln)
                    line.set_x2(_l.ln, bar_index + 1)

// ─── BUILD THE MAP ────────────────────────────────────────────
//  Collected fresh each bar: unswept, within range, sorted by
//  distance from price.
var float[] m2_upPx  = array.new_float()
var float[] m2_dnPx  = array.new_float()
var string[] m2_upTf = array.new_string()
var string[] m2_dnTf = array.new_string()

if barstate.islast
    array.clear(m2_upPx)
    array.clear(m2_dnPx)
    array.clear(m2_upTf)
    array.clear(m2_dnTf)

    int _n = array.size(m2_levels)
    if _n > 0
        for i = 0 to _n - 1
            M2Level _l = array.get(m2_levels, i)
            if not _l.swept
                bool _inRange = m2_range <= 0 or m2_atr <= 0 or
                     math.abs(_l.px - close) <= m2_atr * m2_range
                if _inRange
                    if _l.px > close
                        array.push(m2_upPx, _l.px)
                        array.push(m2_upTf, _l.tf)
                    else if _l.px < close
                        array.push(m2_dnPx, _l.px)
                        array.push(m2_dnTf, _l.tf)

    // insertion sort: above ascending, below descending. Both put
    // the nearest to current price first.
    int _un = array.size(m2_upPx)
    if _un > 1
        for i = 1 to _un - 1
            float _p = array.get(m2_upPx, i)
            string _t = array.get(m2_upTf, i)
            int j = i - 1
            while j >= 0 and array.get(m2_upPx, j) > _p
                array.set(m2_upPx, j + 1, array.get(m2_upPx, j))
                array.set(m2_upTf, j + 1, array.get(m2_upTf, j))
                j -= 1
            array.set(m2_upPx, j + 1, _p)
            array.set(m2_upTf, j + 1, _t)

    int _dn = array.size(m2_dnPx)
    if _dn > 1
        for i = 1 to _dn - 1
            float _p = array.get(m2_dnPx, i)
            string _t = array.get(m2_dnTf, i)
            int j = i - 1
            while j >= 0 and array.get(m2_dnPx, j) < _p
                array.set(m2_dnPx, j + 1, array.get(m2_dnPx, j))
                array.set(m2_dnTf, j + 1, array.get(m2_dnTf, j))
                j -= 1
            array.set(m2_dnPx, j + 1, _p)
            array.set(m2_dnTf, j + 1, _t)

// ─── HIGHLIGHT NEAREST ────────────────────────────────────────
if m2_markNear and barstate.islast
    int _n2 = array.size(m2_levels)
    float _nearUp = array.size(m2_upPx) > 0 ? array.get(m2_upPx, 0) : na
    float _nearDn = array.size(m2_dnPx) > 0 ? array.get(m2_dnPx, 0) : na
    if _n2 > 0
        for i = 0 to _n2 - 1
            M2Level _l = array.get(m2_levels, i)
            if not _l.swept and not na(_l.ln)
                bool _isNear = (not na(_nearUp) and _l.px == _nearUp) or
                     (not na(_nearDn) and _l.px == _nearDn)
                line.set_color(_l.ln, _isNear ? m2_nearCol :
                     _l.isHigh ? m2_aboveCol : m2_belowCol)
                line.set_width(_l.ln, _isNear ? m2_width + 1 : m2_width)

// ─── TABLE ────────────────────────────────────────────────────
var table m2_tbl = na

if m2_tblOn and barstate.islast
    int _rows = m2_show * 2 + 3
    if na(m2_tbl)
        m2_tbl := table.new(m2_posOf(m2_tblPos), 3, _rows,
             bgcolor = color.new(color.black, 20),
             border_color = color.new(color.gray, 60),
             border_width = 1)

    color _hdr = color.new(color.gray, 20)
    string _uLbl = m2_unit == "Pips" ? "PIPS" : m2_unit == "ATR" ? "ATR" : "DIST"

    table.cell(m2_tbl, 0, 0, "MAP",  text_color = _hdr, text_size = m2_sizeOf(m2_tblSize))
    table.cell(m2_tbl, 1, 0, "TF",   text_color = _hdr, text_size = m2_sizeOf(m2_tblSize))
    table.cell(m2_tbl, 2, 0, _uLbl,  text_color = _hdr, text_size = m2_sizeOf(m2_tblSize))

    int _r = 1
    int _nUp = array.size(m2_upPx)

    // above, furthest first so the list reads top down like a chart
    for i = 0 to m2_show - 1
        int _idx = m2_show - 1 - i
        if _idx < _nUp
            float _px = array.get(m2_upPx, _idx)
            bool _isNear = _idx == 0
            table.cell(m2_tbl, 0, _r, str.tostring(math.round_to_mintick(_px)),
                 text_color = _isNear ? m2_nearCol : m2_aboveCol, text_size = m2_sizeOf(m2_tblSize))
            table.cell(m2_tbl, 1, _r, m2_tfLabel(array.get(m2_upTf, _idx)),
                 text_color = color.new(color.gray, 20), text_size = m2_sizeOf(m2_tblSize))
            table.cell(m2_tbl, 2, _r, m2_distStr(_px),
                 text_color = _isNear ? m2_nearCol : m2_aboveCol, text_size = m2_sizeOf(m2_tblSize))
        else
            table.cell(m2_tbl, 0, _r, "—", text_color = color.new(color.gray, 50), text_size = m2_sizeOf(m2_tblSize))
            table.cell(m2_tbl, 1, _r, "",  text_size = m2_sizeOf(m2_tblSize))
            table.cell(m2_tbl, 2, _r, "",  text_size = m2_sizeOf(m2_tblSize))
        _r += 1

    // price row
    table.cell(m2_tbl, 0, _r, str.tostring(math.round_to_mintick(close)),
         text_color = color.white, text_size = m2_sizeOf(m2_tblSize))
    table.cell(m2_tbl, 1, _r, "NOW", text_color = color.white, text_size = m2_sizeOf(m2_tblSize))
    table.cell(m2_tbl, 2, _r, "", text_size = m2_sizeOf(m2_tblSize))
    _r += 1

    // below, nearest first
    int _nDn = array.size(m2_dnPx)
    for i = 0 to m2_show - 1
        if i < _nDn
            float _px = array.get(m2_dnPx, i)
            bool _isNear = i == 0
            table.cell(m2_tbl, 0, _r, str.tostring(math.round_to_mintick(_px)),
                 text_color = _isNear ? m2_nearCol : m2_belowCol, text_size = m2_sizeOf(m2_tblSize))
            table.cell(m2_tbl, 1, _r, m2_tfLabel(array.get(m2_dnTf, i)),
                 text_color = color.new(color.gray, 20), text_size = m2_sizeOf(m2_tblSize))
            table.cell(m2_tbl, 2, _r, m2_distStr(_px),
                 text_color = _isNear ? m2_nearCol : m2_belowCol, text_size = m2_sizeOf(m2_tblSize))
        else
            table.cell(m2_tbl, 0, _r, "—", text_color = color.new(color.gray, 50), text_size = m2_sizeOf(m2_tblSize))
            table.cell(m2_tbl, 1, _r, "",  text_size = m2_sizeOf(m2_tblSize))
            table.cell(m2_tbl, 2, _r, "",  text_size = m2_sizeOf(m2_tblSize))
        _r += 1

    // imbalance row
    string _imb = _nUp + _nDn == 0 ? "—" :
         str.tostring(_nUp) + " up / " + str.tostring(_nDn) + " dn"
    color _imbCol = _nUp == _nDn ? color.new(color.gray, 20) :
         _nUp > _nDn ? m2_aboveCol : m2_belowCol

    table.cell(m2_tbl, 0, _r, "RESTING", text_color = _hdr, text_size = m2_sizeOf(m2_tblSize))
    table.cell(m2_tbl, 1, _r, _imb, text_color = _imbCol, text_size = m2_sizeOf(m2_tblSize))
    table.cell(m2_tbl, 2, _r, "", text_size = m2_sizeOf(m2_tblSize))

// ─── ALERTS ───────────────────────────────────────────────────
m2_nearUpNow = array.size(m2_upPx) > 0 ? array.get(m2_upPx, 0) : na
m2_nearDnNow = array.size(m2_dnPx) > 0 ? array.get(m2_dnPx, 0) : na

alertcondition(not na(m2_nearUpNow) and m2_atr > 0 and (m2_nearUpNow - close) <= m2_atr * 0.25,
     "Approaching liquidity above", "Price is within a quarter ATR of the nearest unswept level above.")

alertcondition(not na(m2_nearDnNow) and m2_atr > 0 and (close - m2_nearDnNow) <= m2_atr * 0.25,
     "Approaching liquidity below", "Price is within a quarter ATR of the nearest unswept level below.")

// ═══════════════════════════════════════════════════════════════
//  QUANT PRIME — BUILD MENU · TERMINAL TIER
//  SIDE 2 · STACK MONITOR
// ───────────────────────────────────────────────────────────────
//  How much are you carrying, and how far away is the thing that
//  closes all of it.
//
//  Meridian does not use a stop. It stacks in one direction and
//  exits when an opposite condition appears, which closes the
//  whole position and reverses it. That makes the usual questions
//  the wrong ones. There is no stop distance to size from, and
//  "this trade" is not a meaningful unit when a single bias might
//  be carrying four entries.
//
//  The two questions that do matter:
//
//    WHAT IS THE BIAS, AND HOW OLD IS IT
//    A bias set two hours ago with price forty pips in your favour
//    is a different position to one set on the last candle.
//
//    WHERE IS THE FLIP
//    An opposite sweep is what closes everything. The nearest
//    unswept level on the other side is the most likely place that
//    comes from, and the distance to it is the closest thing
//    Meridian has to a risk figure.
//
//  This cannot know how many entries you actually have open. The
//  tap that opens each one is the instrument's job and does not
//  live in the menu. What it can do is show you the bias, the flip
//  distance, and your own position against both, once you log it.
//
//  Draws one table. Namespaced d2_.
// ═══════════════════════════════════════════════════════════════

// ─── LEVELS ───────────────────────────────────────────────────
d2_gLv = "Levels"

d2_tf = input.timeframe("30", "Level timeframe", group = d2_gLv,
     tooltip = "The timeframe whose swept levels set the bias and whose unswept levels are watched for the flip. Should match the cycle you are actually trading.")

d2_pvL = input.int(4, "L", minval = 1, maxval = 20, group = d2_gLv, inline = "p")
d2_pvR = input.int(2, "R", minval = 1, maxval = 20, group = d2_gLv, inline = "p")

d2_maxLv = input.int(100, "Levels tracked", minval = 20, maxval = 300, group = d2_gLv)

// ─── YOUR POSITION ────────────────────────────────────────────
d2_gPos = "Your entries"

d2_logOn = input.bool(false, "Log my entries", group = d2_gPos,
     tooltip = "Type in the prices you actually entered at. Leave any unused at 0. The table then shows your average entry, how far the flip level sits from it, and what the stack is currently worth.")

d2_e1 = input.price(0.0, "Entry 1", group = d2_gPos)
d2_e2 = input.price(0.0, "Entry 2", group = d2_gPos)
d2_e3 = input.price(0.0, "Entry 3", group = d2_gPos)
d2_e4 = input.price(0.0, "Entry 4", group = d2_gPos)
d2_e5 = input.price(0.0, "Entry 5", group = d2_gPos)

d2_lots = input.float(0.0, "Lots per entry", minval = 0.0, step = 0.01, group = d2_gPos,
     tooltip = "Optional. If set, the table shows total exposure and what the flip level is worth in currency. Leave at 0 to work in pips only.")

d2_pipVal = input.float(10.0, "Value per pip per lot", minval = 0.0, step = 0.01, group = d2_gPos,
     tooltip = "Forex standard is 10. Check yours on indices and metals, where contract sizes vary between brokers.")

// ─── WARNING ──────────────────────────────────────────────────
d2_gWarn = "Warning"

d2_warnOn  = input.bool(true, "Flag when the flip is close", group = d2_gWarn)
d2_warnAtr = input.float(0.5, "Flag within N x ATR of the flip level", minval = 0.1, step = 0.1, group = d2_gWarn)
d2_atrLen  = input.int(14, "ATR length", minval = 1, group = d2_gWarn)

// ─── DISPLAY ──────────────────────────────────────────────────
d2_gDisp = "Display"

d2_drawFlip = input.bool(true, "Draw the flip level", group = d2_gDisp)
d2_drawAvg  = input.bool(true, "Draw my average entry", group = d2_gDisp)

d2_tblPos  = input.string("Bottom Left", "Table position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right"], group = d2_gDisp)
d2_tblSize = input.string("Tiny", "Table size", options = ["Tiny", "Small", "Normal"], group = d2_gDisp)

d2_bullCol = input.color(#2f6b41, "Bullish", group = d2_gDisp, inline = "c")
d2_bearCol = input.color(#b4342a, "Bearish", group = d2_gDisp, inline = "c")
d2_flatCol = input.color(#9a9da3, "Flat",    group = d2_gDisp, inline = "c")
d2_warnCol = input.color(#c9a84c, "Warning", group = d2_gDisp, inline = "c")

// ─── HELPERS ──────────────────────────────────────────────────
d2_pipMult() =>
    str.contains(syminfo.ticker, "JPY") ? 100.0 :
     str.contains(syminfo.ticker, "XAU") or str.contains(syminfo.ticker, "XAG") ? 10.0 :
     syminfo.type == "forex" ? 10000.0 : 1.0

d2_sizeOf(_s) =>
    _s == "Tiny" ? size.tiny : _s == "Small" ? size.small : size.normal

d2_posOf(_p) =>
    _p == "Top Right" ? position.top_right :
     _p == "Top Left" ? position.top_left :
     _p == "Bottom Right" ? position.bottom_right :
     _p == "Middle Right" ? position.middle_right : position.bottom_left

// ─── LEVEL STATE ──────────────────────────────────────────────
type D2Level
    float px
    bool  isHigh
    bool  swept

var D2Level[] d2_levels = array.new<D2Level>()

var int   d2_bias    = 0        // 1 bullish, -1 bearish, 0 none
var int   d2_biasBar = na
var float d2_biasPx  = na       // price when the bias was set

d2_atr = ta.atr(d2_atrLen)

d2_known(float _px) =>
    bool _f = false
    int _n = array.size(d2_levels)
    if _n > 0
        for i = 0 to _n - 1
            D2Level _l = array.get(d2_levels, i)
            if not _l.swept and math.abs(_l.px - _px) < syminfo.mintick * 2
                _f := true
    _f

[d2_ph, d2_pl] = request.security(syminfo.tickerid, d2_tf,
     [ta.pivothigh(high, d2_pvL, d2_pvR), ta.pivotlow(low, d2_pvL, d2_pvR)], lookahead = barmerge.lookahead_off)

if barstate.isconfirmed
    if not na(d2_ph) and not d2_known(d2_ph)
        array.push(d2_levels, D2Level.new(d2_ph, true, false))
    if not na(d2_pl) and not d2_known(d2_pl)
        array.push(d2_levels, D2Level.new(d2_pl, false, false))
    while array.size(d2_levels) > d2_maxLv
        array.shift(d2_levels)

    int _n = array.size(d2_levels)
    if _n > 0
        for i = 0 to _n - 1
            D2Level _l = array.get(d2_levels, i)
            if not _l.swept
                if _l.isHigh ? high >= _l.px : low <= _l.px
                    _l.swept := true
                    // a high taken sets bearish, a low taken sets bullish
                    d2_bias    := _l.isHigh ? -1 : 1
                    d2_biasBar := bar_index
                    d2_biasPx  := close

// ─── THE FLIP LEVEL ───────────────────────────────────────────
//  Whichever unswept level on the opposite side of the bias sits
//  nearest to price. That is where an opposite sweep most likely
//  comes from, and therefore where the whole stack closes.
var float d2_flip = na

if barstate.islast
    d2_flip := na
    int _n2 = array.size(d2_levels)
    if _n2 > 0 and d2_bias != 0
        for i = 0 to _n2 - 1
            D2Level _l = array.get(d2_levels, i)
            if not _l.swept
                // bullish bias flips on a high being taken above
                // bearish bias flips on a low being taken below
                bool _relevant = d2_bias == 1 ? (_l.isHigh and _l.px > close) :
                     (not _l.isHigh and _l.px < close)
                if _relevant
                    if na(d2_flip) or math.abs(_l.px - close) < math.abs(d2_flip - close)
                        d2_flip := _l.px

d2_flipDist = na(d2_flip) ? na : math.abs(d2_flip - close) * d2_pipMult()
d2_flipNear = d2_warnOn and not na(d2_flip) and d2_atr > 0 and
     math.abs(d2_flip - close) <= d2_atr * d2_warnAtr

// ─── YOUR STACK ───────────────────────────────────────────────
d2_count = 0
d2_sum   = 0.0

if d2_logOn
    if d2_e1 > 0
        d2_count += 1
        d2_sum   += d2_e1
    if d2_e2 > 0
        d2_count += 1
        d2_sum   += d2_e2
    if d2_e3 > 0
        d2_count += 1
        d2_sum   += d2_e3
    if d2_e4 > 0
        d2_count += 1
        d2_sum   += d2_e4
    if d2_e5 > 0
        d2_count += 1
        d2_sum   += d2_e5

d2_avg = d2_count > 0 ? d2_sum / d2_count : na

// open movement, in pips, in the direction of the bias
d2_openPips = na(d2_avg) or d2_bias == 0 ? na :
     (close - d2_avg) * d2_bias * d2_pipMult()

// what the flip level is worth from the average entry
d2_flipFromAvg = na(d2_avg) or na(d2_flip) ? na :
     (d2_flip - d2_avg) * d2_bias * d2_pipMult()

d2_exposure = d2_lots > 0 ? d2_lots * d2_count : 0.0
d2_openCcy  = na(d2_openPips) or d2_exposure <= 0 ? na :
     d2_openPips * d2_pipVal * d2_lots * d2_count

// ─── LINES ────────────────────────────────────────────────────
var line d2_lnFlip = na
var line d2_lnAvg  = na

if barstate.islast
    if d2_drawFlip and not na(d2_flip)
        if na(d2_lnFlip)
            d2_lnFlip := line.new(bar_index - 30, d2_flip, bar_index + 15, d2_flip,
                 color = d2_flipNear ? d2_warnCol : d2_flatCol,
                 style = line.style_dashed, width = 2)
        else
            line.set_xy1(d2_lnFlip, bar_index - 30, d2_flip)
            line.set_xy2(d2_lnFlip, bar_index + 15, d2_flip)
            line.set_color(d2_lnFlip, d2_flipNear ? d2_warnCol : d2_flatCol)
    else
        line.delete(d2_lnFlip)
        d2_lnFlip := na

    if d2_drawAvg and not na(d2_avg)
        color _aCol = d2_bias == 1 ? d2_bullCol : d2_bias == -1 ? d2_bearCol : d2_flatCol
        if na(d2_lnAvg)
            d2_lnAvg := line.new(bar_index - 30, d2_avg, bar_index + 15, d2_avg,
                 color = _aCol, style = line.style_solid, width = 1)
        else
            line.set_xy1(d2_lnAvg, bar_index - 30, d2_avg)
            line.set_xy2(d2_lnAvg, bar_index + 15, d2_avg)
            line.set_color(d2_lnAvg, _aCol)
    else
        line.delete(d2_lnAvg)
        d2_lnAvg := na

// ─── TABLE ────────────────────────────────────────────────────
var table d2_tbl = na

if barstate.islast
    if na(d2_tbl)
        d2_tbl := table.new(d2_posOf(d2_tblPos), 3, 6,
             bgcolor = color.new(color.black, 20),
             border_color = color.new(color.gray, 60),
             border_width = 1)

    color _hdr = color.new(color.gray, 20)
    string _sz = d2_tblSize
    color _bCol = d2_bias == 1 ? d2_bullCol : d2_bias == -1 ? d2_bearCol : d2_flatCol

    // bias and age
    table.cell(d2_tbl, 0, 0, "BIAS", text_color = _hdr, text_size = d2_sizeOf(_sz))
    table.cell(d2_tbl, 1, 0, d2_bias == 0 ? "NONE" : d2_bias == 1 ? "BULL" : "BEAR",
         text_color = _bCol, text_size = d2_sizeOf(_sz))
    table.cell(d2_tbl, 2, 0, na(d2_biasBar) ? "—" : str.tostring(bar_index - d2_biasBar) + " bars",
         text_color = color.white, text_size = d2_sizeOf(_sz))

    // move since the bias was set
    float _sincePips = na(d2_biasPx) or d2_bias == 0 ? na :
         (close - d2_biasPx) * d2_bias * d2_pipMult()
    table.cell(d2_tbl, 0, 1, "Since set", text_color = _hdr, text_size = d2_sizeOf(_sz))
    table.cell(d2_tbl, 1, 1, na(_sincePips) ? "—" :
         (_sincePips >= 0 ? "+" : "") + str.tostring(math.round(_sincePips, 1)) + "p",
         text_color = na(_sincePips) ? d2_flatCol : _sincePips >= 0 ? d2_bullCol : d2_bearCol,
         text_size = d2_sizeOf(_sz))
    table.cell(d2_tbl, 2, 1, "", text_size = d2_sizeOf(_sz))

    // the flip
    table.cell(d2_tbl, 0, 2, "FLIP AT", text_color = _hdr, text_size = d2_sizeOf(_sz))
    table.cell(d2_tbl, 1, 2, na(d2_flip) ? "none found" : str.tostring(math.round_to_mintick(d2_flip)),
         text_color = d2_flipNear ? d2_warnCol : color.white, text_size = d2_sizeOf(_sz))
    table.cell(d2_tbl, 2, 2, na(d2_flipDist) ? "—" : str.tostring(math.round(d2_flipDist, 1)) + "p away",
         text_color = d2_flipNear ? d2_warnCol : color.white, text_size = d2_sizeOf(_sz))

    // the stack
    table.cell(d2_tbl, 0, 3, "STACK", text_color = _hdr, text_size = d2_sizeOf(_sz))
    table.cell(d2_tbl, 1, 3, not d2_logOn ? "not logged" :
         d2_count == 0 ? "0 entries" : str.tostring(d2_count) + " entries",
         text_color = d2_count > 0 ? color.white : d2_flatCol, text_size = d2_sizeOf(_sz))
    table.cell(d2_tbl, 2, 3, d2_exposure > 0 ? str.tostring(math.round(d2_exposure, 2)) + " lots" : "",
         text_color = color.white, text_size = d2_sizeOf(_sz))

    // average entry and open movement
    table.cell(d2_tbl, 0, 4, "Avg entry", text_color = _hdr, text_size = d2_sizeOf(_sz))
    table.cell(d2_tbl, 1, 4, na(d2_avg) ? "—" : str.tostring(math.round_to_mintick(d2_avg)),
         text_color = color.white, text_size = d2_sizeOf(_sz))
    table.cell(d2_tbl, 2, 4, na(d2_openPips) ? "" :
         (d2_openPips >= 0 ? "+" : "") + str.tostring(math.round(d2_openPips, 1)) + "p",
         text_color = na(d2_openPips) ? d2_flatCol : d2_openPips >= 0 ? d2_bullCol : d2_bearCol,
         text_size = d2_sizeOf(_sz))

    // what the flip costs from where you are
    table.cell(d2_tbl, 0, 5, "At flip", text_color = _hdr, text_size = d2_sizeOf(_sz))
    table.cell(d2_tbl, 1, 5, na(d2_flipFromAvg) ? "—" :
         (d2_flipFromAvg >= 0 ? "+" : "") + str.tostring(math.round(d2_flipFromAvg, 1)) + "p",
         text_color = na(d2_flipFromAvg) ? d2_flatCol :
              d2_flipFromAvg >= 0 ? d2_bullCol : d2_bearCol,
         text_size = d2_sizeOf(_sz))
    table.cell(d2_tbl, 2, 5, na(d2_openCcy) ? "" :
         (d2_openCcy >= 0 ? "+" : "") + str.tostring(math.round(d2_openCcy, 2)),
         text_color = na(d2_openCcy) ? d2_flatCol : d2_openCcy >= 0 ? d2_bullCol : d2_bearCol,
         text_size = d2_sizeOf(_sz))

// ─── ALERTS ───────────────────────────────────────────────────
alertcondition(d2_bias != d2_bias[1], "Bias changed",
     "A sweep has set a new directional bias. Any open stack would have flipped.")

alertcondition(d2_flipNear and not d2_flipNear[1], "Approaching the flip level",
     "Price is close to the nearest opposite level. A sweep there closes the whole stack and reverses.")

// ═══════════════════════════════════════════════════════════════
//  QUANT PRIME — BUILD MENU · TERMINAL TIER
//  DESSERT 3 · SESSION REPORT
// ───────────────────────────────────────────────────────────────
//  Are the windows right for your instrument.
//
//  Meridian only resolves conditions inside three trading windows.
//  Those windows were chosen on one instrument. Whether they are
//  the right hours for yours is a question this answers, and the
//  honest answer is sometimes no.
//
//  Every hour of the day, measured across your history:
//
//    BARS     how much data that hour has
//    RANGE    average high to low, in ATR
//    BREAKS   levels taken per hundred bars
//    REV %    of those breaks, how many came back through
//
//  The three configured windows are marked. If the hours inside
//  them do not look different to the hours outside, the windows
//  are not earning their place and you should either move them or
//  switch them off.
//
//  The last column is the one that matters most. A window full of
//  activity is worth nothing if the levels taken in it run on
//  rather than reverse, because that is the opposite of what the
//  instrument trades.
//
//  Hours below the minimum sample are left ungraded.
//
//  Draws one table. Namespaced t3_.
// ═══════════════════════════════════════════════════════════════

// ─── WINDOWS ──────────────────────────────────────────────────
t3_gWin = "Windows"

t3_tz = input.string("UTC", "Timezone", group = t3_gWin,
     options = ["UTC-12","UTC-11","UTC-10","UTC-9","UTC-8","UTC-7","UTC-6","UTC-5","UTC-4","UTC-3","UTC-2","UTC-1",
                "UTC","UTC+1","UTC+2","UTC+3","UTC+4","UTC+5","UTC+6","UTC+7","UTC+8","UTC+9","UTC+10","UTC+11","UTC+12"],
     tooltip = "Meridian's windows are in plain UTC. Separate setting from the AMD cycle anchor.")

t3_w1From = input.int(0,  "W1 from", minval = 0, maxval = 23, group = t3_gWin, inline = "w1")
t3_w1To   = input.int(2,  "to",      minval = 1, maxval = 24, group = t3_gWin, inline = "w1")
t3_w2From = input.int(4,  "W2 from", minval = 0, maxval = 23, group = t3_gWin, inline = "w2")
t3_w2To   = input.int(6,  "to",      minval = 1, maxval = 24, group = t3_gWin, inline = "w2")
t3_w3From = input.int(19, "W3 from", minval = 0, maxval = 23, group = t3_gWin, inline = "w3")
t3_w3To   = input.int(20, "to",      minval = 1, maxval = 24, group = t3_gWin, inline = "w3",
     tooltip = "Defaults are Meridian's shipped windows.")

// ─── LEVELS ───────────────────────────────────────────────────
t3_gLv = "Levels"

t3_lvTf = input.timeframe("30", "Level timeframe", group = t3_gLv)
t3_pvL  = input.int(4, "L", minval = 1, maxval = 20, group = t3_gLv, inline = "p")
t3_pvR  = input.int(2, "R", minval = 1, maxval = 20, group = t3_gLv, inline = "p")

t3_mode = input.string("Close beyond", "A break is", options = ["Close beyond", "Wick through"], group = t3_gLv,
     tooltip = "Close beyond requires a candle to finish past the level. Wick through counts any touch, which on most instruments means a one tick poke grades as a reversal the moment it closes back inside, and every hour reads 80% or higher. Close beyond is the default here for that reason.")

t3_minOver = input.float(0.15, "Minimum overshoot to count (x ATR)", minval = 0.0, step = 0.05, group = t3_gLv,
     tooltip = "How far past the level price must go before the break counts at all. Without this, a break of half a pip is graded the same as a real one. Set to 0 to disable.")

t3_window = input.int(20, "Grade the break over N bars", minval = 3, maxval = 200, group = t3_gLv)
t3_revPct = input.float(50.0, "Reversal needs % of overshoot back", minval = 10.0, maxval = 100.0, step = 5.0, group = t3_gLv)

// ─── TEST ─────────────────────────────────────────────────────
t3_gTest = "Test"

t3_atrLen    = input.int(14, "ATR length", minval = 1, group = t3_gTest)
t3_minBars   = input.int(50, "Minimum bars per hour", minval = 10, maxval = 1000, group = t3_gTest)
t3_minBreaks = input.int(10, "Minimum breaks to grade REV %", minval = 3, maxval = 100, group = t3_gTest,
     tooltip = "Breaks are far rarer than bars, so this threshold is lower than the usual thirty. Treat any graded hour with fewer than thirty as indicative rather than settled.")

// ─── TABLE ────────────────────────────────────────────────────
t3_gTbl = "Table"

t3_legend  = input.bool(true, "Show the plain english summary", group = t3_gTbl)
t3_scope = input.string("Windows and neighbours", "Hours to show",
     options = ["Windows and neighbours", "Windows only", "All hours"], group = t3_gTbl,
     tooltip = "Twenty four rows is a lot of table. Windows and neighbours shows your three windows plus the hour either side of each, which is enough to see whether a window is sitting in the right place.")
t3_tblPos  = input.string("Bottom Right", "Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right"], group = t3_gTbl)
t3_tblSize = input.string("Tiny", "Size", options = ["Tiny", "Small", "Normal"], group = t3_gTbl)

t3_inCol   = input.color(#ffb74d, "In a window", group = t3_gTbl, inline = "c")
t3_goodCol = input.color(#2f6b41, "Reverses",    group = t3_gTbl, inline = "c")
t3_badCol  = input.color(#b4342a, "Runs on",     group = t3_gTbl, inline = "c")
t3_thinCol = input.color(#9a9da3, "Thin",        group = t3_gTbl, inline = "c")

// ─── STATE ────────────────────────────────────────────────────
var int[]   t3_bars  = array.new_int(24, 0)
var float[] t3_range = array.new_float(24, 0.0)
var int[]   t3_brks  = array.new_int(24, 0)
var int[]   t3_rev   = array.new_int(24, 0)
var int[]   t3_ran   = array.new_int(24, 0)

//  outcome: 0 pending · 1 reversed · 2 ran on · 3 unresolved
type T3Lv
    float px
    bool  isHigh
    bool  broken
    int   brokeBar
    int   brokeHour
    float extreme
    int   outcome

var T3Lv[] t3_lv = array.new<T3Lv>()

t3_atr = ta.atr(t3_atrLen)
t3_hour = hour(time, t3_tz)

t3_inWin(int _h) =>
    bool _r = false
    if t3_w1To > t3_w1From
        _r := _r or (_h >= t3_w1From and _h < t3_w1To)
    else
        _r := _r or (_h >= t3_w1From or _h < t3_w1To)
    if t3_w2To > t3_w2From
        _r := _r or (_h >= t3_w2From and _h < t3_w2To)
    else
        _r := _r or (_h >= t3_w2From or _h < t3_w2To)
    if t3_w3To > t3_w3From
        _r := _r or (_h >= t3_w3From and _h < t3_w3To)
    else
        _r := _r or (_h >= t3_w3From or _h < t3_w3To)
    _r

// Is this hour worth a row, given the chosen scope.
t3_inScope(int _h) =>
    bool _r = true
    if t3_scope == "Windows only"
        _r := t3_inWin(_h)
    else if t3_scope == "Windows and neighbours"
        _r := t3_inWin(_h) or t3_inWin((_h + 1) % 24) or t3_inWin((_h + 23) % 24)
    _r

t3_known(float _px) =>
    bool _f = false
    int _n = array.size(t3_lv)
    if _n > 0
        for i = 0 to _n - 1
            T3Lv _l = array.get(t3_lv, i)
            if not _l.broken and math.abs(_l.px - _px) < syminfo.mintick * 2
                _f := true
    _f

t3_sizeOf(_s) =>
    _s == "Tiny" ? size.tiny : _s == "Small" ? size.small : size.normal

t3_posOf(_p) =>
    _p == "Top Right" ? position.top_right :
     _p == "Top Left" ? position.top_left :
     _p == "Bottom Left" ? position.bottom_left :
     _p == "Middle Right" ? position.middle_right : position.bottom_right

t3_pad(int _h) =>
    str.format("{0,number,00}", _h)

// ─── PIVOT FEED ───────────────────────────────────────────────
[t3_ph, t3_pl] = request.security(syminfo.tickerid, t3_lvTf,
     [ta.pivothigh(high, t3_pvL, t3_pvR), ta.pivotlow(low, t3_pvL, t3_pvR)], lookahead = barmerge.lookahead_off)

// ─── ENGINE ───────────────────────────────────────────────────
if barstate.isconfirmed and t3_atr > 0
    int _h = t3_hour

    array.set(t3_bars,  _h, array.get(t3_bars, _h) + 1)
    array.set(t3_range, _h, array.get(t3_range, _h) + (high - low) / t3_atr)

    if not na(t3_ph) and not t3_known(t3_ph)
        array.push(t3_lv, T3Lv.new(t3_ph, true, false, na, na, na, 0))
    if not na(t3_pl) and not t3_known(t3_pl)
        array.push(t3_lv, T3Lv.new(t3_pl, false, false, na, na, na, 0))
    while array.size(t3_lv) > 400
        array.shift(t3_lv)

    int _n = array.size(t3_lv)
    if _n > 0
        for i = 0 to _n - 1
            T3Lv _l = array.get(t3_lv, i)

            if not _l.broken
                bool _hit = t3_mode == "Close beyond" ?
                     (_l.isHigh ? close > _l.px : close < _l.px) :
                     (_l.isHigh ? high >= _l.px : low <= _l.px)

                // a break that barely clears the level is not a break
                float _clear = _l.isHigh ? (high - _l.px) : (_l.px - low)
                bool _enough = t3_minOver <= 0 or _clear >= t3_atr * t3_minOver

                if _hit and _enough
                    _l.broken    := true
                    _l.brokeBar  := bar_index
                    _l.brokeHour := _h
                    _l.extreme   := _l.isHigh ? high : low
                    array.set(t3_brks, _h, array.get(t3_brks, _h) + 1)

            else if _l.outcome == 0
                _l.extreme := _l.isHigh ? math.max(_l.extreme, high) : math.min(_l.extreme, low)

                float _over = math.abs(_l.extreme - _l.px)
                float _need = _l.px + (_l.isHigh ? -1 : 1) * _over * (t3_revPct / 100.0)

                bool _rev = _over > 0 and (_l.isHigh ? close <= _need : close >= _need)
                bool _exp = bar_index - _l.brokeBar >= t3_window

                if _rev
                    _l.outcome := 1
                    array.set(t3_rev, _l.brokeHour, array.get(t3_rev, _l.brokeHour) + 1)
                else if _exp
                    if _l.isHigh ? close > _l.px : close < _l.px
                        _l.outcome := 2
                        array.set(t3_ran, _l.brokeHour, array.get(t3_ran, _l.brokeHour) + 1)
                    else
                        _l.outcome := 3

// ─── TABLE ────────────────────────────────────────────────────
var table t3_tbl = na

if barstate.islast
    // count hours to show
    int _shown = 0
    for h = 0 to 23
        if t3_inScope(h) and array.get(t3_bars, h) > 0
            _shown += 1

    int _rows = 1 + _shown + 2 + (t3_legend ? 2 : 0)

    if na(t3_tbl)
        t3_tbl := table.new(t3_posOf(t3_tblPos), 5, _rows,
             bgcolor = color.new(color.black, 20),
             border_color = color.new(color.gray, 60),
             border_width = 1)

    color _hdr = color.new(color.gray, 20)
    string _sz = t3_tblSize

    table.cell(t3_tbl, 0, 0, "HR",   text_color = _hdr, text_size = t3_sizeOf(_sz))
    table.cell(t3_tbl, 1, 0, "BARS", text_color = _hdr, text_size = t3_sizeOf(_sz))
    table.cell(t3_tbl, 2, 0, "RNG",  text_color = _hdr, text_size = t3_sizeOf(_sz))
    table.cell(t3_tbl, 3, 0, "BRK",  text_color = _hdr, text_size = t3_sizeOf(_sz))
    table.cell(t3_tbl, 4, 0, "REV",  text_color = _hdr, text_size = t3_sizeOf(_sz))

    int _row = 1

    // running totals, split by whether the hour is inside a window
    int _inBars = 0
    int _inRev  = 0
    int _inRan  = 0
    int _ouBars = 0
    int _ouRev  = 0
    int _ouRan  = 0
    float _inRange = 0.0
    float _ouRange = 0.0

    for h = 0 to 23
        int _b = array.get(t3_bars, h)
        if _b == 0
            continue

        bool _in = t3_inWin(h)
        bool _draw = t3_inScope(h)
        int _rv = array.get(t3_rev, h)
        int _rn = array.get(t3_ran, h)
        int _g  = _rv + _rn

        if _in
            _inBars += _b
            _inRev  += _rv
            _inRan  += _rn
            _inRange += array.get(t3_range, h)
        else
            _ouBars += _b
            _ouRev  += _rv
            _ouRan  += _rn
            _ouRange += array.get(t3_range, h)

        if not _draw
            continue

        color _hCol = _in ? t3_inCol : color.white

        table.cell(t3_tbl, 0, _row, t3_pad(h) + (_in ? "●" : ""),
             text_color = _hCol, text_size = t3_sizeOf(_sz))
        table.cell(t3_tbl, 1, _row, str.tostring(_b),
             text_color = _b < t3_minBars ? t3_thinCol : color.white, text_size = t3_sizeOf(_sz))

        if _b < t3_minBars
            table.cell(t3_tbl, 2, _row, "thin", text_color = t3_thinCol, text_size = t3_sizeOf(_sz))
        else
            table.cell(t3_tbl, 2, _row, str.tostring(math.round(array.get(t3_range, h) / _b, 2)) + "x",
                 text_color = color.white, text_size = t3_sizeOf(_sz))

        table.cell(t3_tbl, 3, _row,
             _b < t3_minBars ? "—" : str.tostring(math.round(array.get(t3_brks, h) / _b * 100.0, 1)),
             text_color = _b < t3_minBars ? t3_thinCol : color.white, text_size = t3_sizeOf(_sz))

        if _g < t3_minBreaks
            table.cell(t3_tbl, 4, _row, "thin", text_color = t3_thinCol, text_size = t3_sizeOf(_sz))
        else
            float _p = _rv / _g * 100.0
            table.cell(t3_tbl, 4, _row, str.tostring(math.round(_p)) + "%",
                 text_color = _p >= 55 ? t3_goodCol : _p <= 45 ? t3_badCol : t3_thinCol,
                 text_size = t3_sizeOf(_sz))

        _row += 1

    // in-window and out-of-window summary
    int _inG = _inRev + _inRan
    int _ouG = _ouRev + _ouRan

    table.cell(t3_tbl, 0, _row, "IN●", text_color = t3_inCol, text_size = t3_sizeOf(_sz))
    table.cell(t3_tbl, 1, _row, str.tostring(_inBars), text_color = color.white, text_size = t3_sizeOf(_sz))
    table.cell(t3_tbl, 2, _row, _inBars > 0 ? str.tostring(math.round(_inRange / _inBars, 2)) + "x" : "—",
         text_color = color.white, text_size = t3_sizeOf(_sz))
    table.cell(t3_tbl, 3, _row, str.tostring(_inG), text_color = color.white, text_size = t3_sizeOf(_sz))
    table.cell(t3_tbl, 4, _row, _inG < t3_minBreaks ? "thin" :
         str.tostring(math.round(_inRev / _inG * 100.0)) + "%",
         text_color = _inG < t3_minBreaks ? t3_thinCol :
              _inRev / _inG >= 0.55 ? t3_goodCol : _inRev / _inG <= 0.45 ? t3_badCol : t3_thinCol,
         text_size = t3_sizeOf(_sz))
    _row += 1

    table.cell(t3_tbl, 0, _row, "OUT", text_color = _hdr, text_size = t3_sizeOf(_sz))
    table.cell(t3_tbl, 1, _row, str.tostring(_ouBars), text_color = color.white, text_size = t3_sizeOf(_sz))
    table.cell(t3_tbl, 2, _row, _ouBars > 0 ? str.tostring(math.round(_ouRange / _ouBars, 2)) + "x" : "—",
         text_color = color.white, text_size = t3_sizeOf(_sz))
    table.cell(t3_tbl, 3, _row, str.tostring(_ouG), text_color = color.white, text_size = t3_sizeOf(_sz))
    table.cell(t3_tbl, 4, _row, _ouG < t3_minBreaks ? "thin" :
         str.tostring(math.round(_ouRev / _ouG * 100.0)) + "%",
         text_color = _ouG < t3_minBreaks ? t3_thinCol :
              _ouRev / _ouG >= 0.55 ? t3_goodCol : _ouRev / _ouG <= 0.45 ? t3_badCol : t3_thinCol,
         text_size = t3_sizeOf(_sz))
    _row += 1

    // ─── PLAIN ENGLISH ────────────────────────────────────────
    if t3_legend
        int _lr = _rows - 2

        string _v = ""
        color  _vc = t3_thinCol

        if _inG < t3_minBreaks or _ouG < t3_minBreaks
            _v := "Not enough breaks yet — use more history"
        else
            float _pIn = _inRev / _inG * 100.0
            float _pOu = _ouRev / _ouG * 100.0
            float _gap = _pIn - _pOu

            if _gap >= 5
                _vc := t3_goodCol
                _v := "Windows are the better hours — " +
                     str.tostring(math.round(_pIn)) + "% in vs " +
                     str.tostring(math.round(_pOu)) + "% out"
            else if _gap <= -5
                _vc := t3_badCol
                _v := "Windows are the worse hours — " +
                     str.tostring(math.round(_pIn)) + "% in vs " +
                     str.tostring(math.round(_pOu)) + "% out"
            else
                _v := "Windows look no different to the rest of the day"

        table.cell(t3_tbl, 0, _lr, _v, text_color = _vc,
             text_size = t3_sizeOf(_sz), text_halign = text.align_center)
        for c = 1 to 4
            table.cell(t3_tbl, c, _lr, "", text_size = t3_sizeOf(_sz))
        table.merge_cells(t3_tbl, 0, _lr, 4, _lr)

        table.cell(t3_tbl, 0, _rows - 1,
             "● in a window · BRK per 100 bars · REV = broken levels that came back",
             text_color = t3_thinCol, text_size = t3_sizeOf(_sz), text_halign = text.align_center)
        for c = 1 to 4
            table.cell(t3_tbl, c, _rows - 1, "", text_size = t3_sizeOf(_sz))
        table.merge_cells(t3_tbl, 0, _rows - 1, 4, _rows - 1)

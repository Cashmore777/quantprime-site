//@version=6
// ═════════════════════════════════════════════════════════════
//  QUANT PRIME — BUILD MENU · TERMINAL TIER
//  MER-S1M3D3T1
//    S1  AMD Phases
//    M3  Trend Stack
//    D3  Session Clock
//    T1  Sweep Report
// ═════════════════════════════════════════════════════════════

indicator("QP Terminal · S1M3D3T1", shorttitle = "QPS1M3D3T1", overlay = true, max_lines_count = 500, max_labels_count = 500)

// ═══════════════════════════════════════════════════════════════
//  QUANT PRIME — BUILD MENU · TERMINAL TIER
//  STARTER 1 · AMD PHASES
// ───────────────────────────────────────────────────────────────
//  The market moves through a repeating rhythm. A stretch where
//  price ranges and positions are built. A stretch where it
//  pushes through an obvious level and takes out the orders
//  resting there. Then a stretch where it actually moves.
//
//  Accumulation, manipulation, distribution. This shades all
//  three, on three cycle lengths at once.
//
//  The cycles are anchored to midnight in the chosen timezone
//  rather than rolling with the current bar. That matters: a
//  rolling window puts the boundaries wherever you happen to be
//  looking, while an anchored one puts them where everybody
//  else's are too. The phases are only useful if they are the
//  same phases other people are trading around.
//
//  Draws no table. Safe to combine with any other Meridian piece.
//  All identifiers namespaced s1_ to avoid collisions.
// ═══════════════════════════════════════════════════════════════

// ─── TIMEZONE ─────────────────────────────────────────────────
s1_gTz = "Timezone"

s1_tz = input.string("UTC+0", "Cycle anchor", group = s1_gTz,
     options = ["UTC-12","UTC-11","UTC-10","UTC-9","UTC-8","UTC-7","UTC-6","UTC-5","UTC-4","UTC-3","UTC-2","UTC-1",
                "UTC+0","UTC+1","UTC+2","UTC+3","UTC+4","UTC+5","UTC+6","UTC+7","UTC+8","UTC+9","UTC+10","UTC+11","UTC+12"],
     tooltip = "Midnight in this timezone is where every cycle starts counting. Change it to match the session that actually drives your instrument -- this matters more than any other setting here.")

// ─── CYCLES ───────────────────────────────────────────────────
s1_gCyc = "Cycles"

s1_c24 = input.bool(true, "24 hour", group = s1_gCyc, inline = "c1")
s1_c12 = input.bool(true, "12 hour", group = s1_gCyc, inline = "c1")
s1_c6  = input.bool(true, "6 hour",  group = s1_gCyc, inline = "c1",
     tooltip = "All three run at once and overlap. The 24 hour cycle gives the day's shape; the 6 hour one gives the session's.")

s1_split1 = input.float(50.0, "Accumulation ends at %", minval = 10.0, maxval = 90.0, step = 5.0, group = s1_gCyc,
     tooltip = "How far through a cycle accumulation gives way to manipulation. Default 50%.")

s1_split2 = input.float(75.0, "Manipulation ends at %", minval = 20.0, maxval = 95.0, step = 5.0, group = s1_gCyc,
     tooltip = "How far through a cycle manipulation gives way to distribution. Default 75%.")

// ─── SHADING ──────────────────────────────────────────────────
s1_gShade = "Shading"

s1_shadeA = input.bool(false, "Shade accumulation", group = s1_gShade, inline = "sh")
s1_shadeM = input.bool(true,  "Shade manipulation", group = s1_gShade, inline = "sh")
s1_shadeD = input.bool(false, "Shade distribution", group = s1_gShade, inline = "sh",
     tooltip = "Manipulation only, by default. Shading all three on all three cycles turns the chart into soup.")

s1_colA = input.color(#5b9cf6, "Accumulation", group = s1_gShade, inline = "cc")
s1_colM = input.color(#2962ff, "Manipulation", group = s1_gShade, inline = "cc")
s1_colD = input.color(#c9a84c, "Distribution", group = s1_gShade, inline = "cc")

s1_fade = input.int(95, "Transparency", minval = 80, maxval = 99, group = s1_gShade)

// ─── BOUNDARIES ───────────────────────────────────────────────
s1_gBound = "Boundaries"

s1_showLine = input.bool(true, "Mark phase starts", group = s1_gBound,
     tooltip = "A vertical line where each phase begins, on each enabled cycle.")

s1_showLbl = input.bool(true, "Label phase starts", group = s1_gBound)

s1_lineCol = input.color(#ffffff, "Line and label", group = s1_gBound)
s1_lineFade = input.int(60, "Line transparency", minval = 0, maxval = 95, group = s1_gBound)
s1_lblSize  = input.string("Small", "Label size", options = ["Tiny", "Small", "Normal"], group = s1_gBound)

s1_lookback = input.int(300, "Draw on the last N bars", minval = 20, maxval = 1000, group = s1_gBound,
     tooltip = "Boundary lines and labels are limited to recent bars so older history stays readable. Shading is unaffected.")

// ─── ENGINE ───────────────────────────────────────────────────
// Hours elapsed since midnight in the anchor timezone, as a
// decimal so half hour cycles resolve correctly.
s1_hr = hour(time, s1_tz) + minute(time, s1_tz) / 60.0

// Position within a cycle, as a percentage of that cycle.
s1_posIn(float _cyc) =>
    float _idx = math.floor(s1_hr / _cyc)
    float _pos = s1_hr - _idx * _cyc
    _pos / _cyc * 100.0

// 0 = accumulation, 1 = manipulation, 2 = distribution
s1_phaseOf(float _cyc) =>
    float _p = s1_posIn(_cyc)
    _p < s1_split1 ? 0 : _p < s1_split2 ? 1 : 2

s1_p24 = s1_phaseOf(24.0)
s1_p12 = s1_phaseOf(12.0)
s1_p6  = s1_phaseOf(6.0)

s1_colOf(int _ph) =>
    _ph == 0 ? s1_colA : _ph == 1 ? s1_colM : s1_colD

s1_nameOf(int _ph) =>
    _ph == 0 ? "A" : _ph == 1 ? "M" : "D"

s1_shadeOn(int _ph) =>
    _ph == 0 ? s1_shadeA : _ph == 1 ? s1_shadeM : s1_shadeD

// ─── SHADING ──────────────────────────────────────────────────
color s1_bg24 = s1_c24 and s1_shadeOn(s1_p24) ? color.new(s1_colOf(s1_p24), s1_fade) : na
color s1_bg12 = s1_c12 and s1_shadeOn(s1_p12) ? color.new(s1_colOf(s1_p12), s1_fade) : na
color s1_bg6  = s1_c6  and s1_shadeOn(s1_p6)  ? color.new(s1_colOf(s1_p6),  s1_fade) : na

bgcolor(s1_bg24, title = "24H phase")
bgcolor(s1_bg12, title = "12H phase")
bgcolor(s1_bg6,  title = "6H phase")

// ─── BOUNDARIES ───────────────────────────────────────────────
s1_sizeOf(_s) =>
    _s == "Tiny" ? size.tiny : _s == "Small" ? size.small : size.normal

// Stacked vertical text, so several cycles marking the same bar
// stay readable side by side.
s1_stack(string _cyc, string _ph) =>
    string _out = ""
    for i = 0 to str.length(_cyc) - 1
        _out := _out + str.substring(_cyc, i, i + 1) + "\n"
    _out + "\n" + _ph

s1_mark(bool _on, float _cyc, int _ph, int _phPrev, string _label) =>
    if _on and _ph != _phPrev and bar_index >= last_bar_index - s1_lookback
        if s1_showLine
            line.new(bar_index, low, bar_index, high,
                 extend = extend.both,
                 color  = color.new(s1_lineCol, s1_lineFade),
                 style  = line.style_dotted,
                 width  = 1)
        if s1_showLbl
            label.new(bar_index, high, s1_stack(_label, s1_nameOf(_ph)),
                 style     = label.style_none,
                 textcolor = color.new(s1_lineCol, 30),
                 size      = s1_sizeOf(s1_lblSize),
                 yloc      = yloc.abovebar,
                 textalign = text.align_center)
    true

if barstate.isconfirmed
    s1_mark(s1_c24, 24.0, s1_p24, s1_p24[1], "24H")
    s1_mark(s1_c12, 12.0, s1_p12, s1_p12[1], "12H")
    s1_mark(s1_c6,   6.0, s1_p6,  s1_p6[1],  "6H")

// ─── ALERTS ───────────────────────────────────────────────────
alertcondition(s1_p24 != s1_p24[1], "24H phase changed",
     "The 24 hour cycle has moved into a new phase.")

alertcondition(s1_p12 == 1 and s1_p12[1] != 1, "12H manipulation started",
     "The 12 hour cycle has entered its manipulation phase.")

alertcondition(s1_p6 == 1 and s1_p6[1] != 1, "6H manipulation started",
     "The 6 hour cycle has entered its manipulation phase.")

// ═══════════════════════════════════════════════════════════════
//  QUANT PRIME — BUILD MENU · TERMINAL TIER
//  MAIN 3 · TREND STACK
// ───────────────────────────────────────────────────────────────
//  Four averages, and one question: are they in order.
//
//  8, 26, 80 and 233. A genuine uptrend means fast above medium,
//  medium above slow, slow above anchor, in that order and without
//  exception. Anything else is consolidation.
//
//  That definition is deliberately strict. Most trend filters call
//  anything above a moving average an uptrend, which means they
//  call almost everything a trend and are therefore useless as a
//  filter. This one spends most of its time saying CONSOLIDATION,
//  which is both correct and the reason it is worth having.
//
//  It exists here because both instruments use this stack
//  internally with plotting switched off. Meridian and Recoil both
//  compute it; neither draws it. This is the visible version.
//
//  Draws one table. All identifiers namespaced m3_.
// ═══════════════════════════════════════════════════════════════

// ─── LENGTHS ──────────────────────────────────────────────────
m3_gLen = "Lengths"

m3_fast   = input.int(8,   "Fast",   minval = 1, group = m3_gLen, inline = "a")
m3_med    = input.int(26,  "Medium", minval = 1, group = m3_gLen, inline = "a")
m3_slow   = input.int(80,  "Slow",   minval = 1, group = m3_gLen, inline = "b")
m3_anchor = input.int(233, "Anchor", minval = 1, group = m3_gLen, inline = "b",
     tooltip = "The defaults are what both instruments use internally. Changing them here changes what this piece reports, not what the instruments do.")

m3_src = input.source(close, "Source", group = m3_gLen)

// ─── CLASSIFIER ───────────────────────────────────────────────
m3_gCls = "Classifier"

m3_strict = input.bool(true, "Require the full stack in order", group = m3_gCls,
     tooltip = "On: a trend needs fast > medium > slow > anchor, or the exact inverse. Off: only medium > slow > anchor is required, which finds more trends and weaker ones.")

m3_useSep = input.bool(false, "Require minimum separation", group = m3_gCls,
     tooltip = "Averages can be technically in order while sitting on top of each other, which is not a trend in any useful sense. This requires them to be meaningfully apart.")

m3_sepAtr = input.float(0.5, "Separation, anchor to fast (x ATR)", minval = 0.1, step = 0.1, group = m3_gCls)
m3_atrLen = input.int(14, "ATR length", minval = 1, group = m3_gCls)

// ─── DISPLAY ──────────────────────────────────────────────────
m3_gDisp = "Display"

m3_plot   = input.bool(true, "Plot the averages", group = m3_gDisp)
m3_fill   = input.bool(false, "Fill between fast and anchor", group = m3_gDisp,
     tooltip = "Tinted by trend state. Readable on a clean chart, heavy on a busy one.")
m3_shade  = input.bool(false, "Shade the background by state", group = m3_gDisp)

m3_bullCol = input.color(#2f6b41, "Bullish",       group = m3_gDisp, inline = "c")
m3_bearCol = input.color(#b4342a, "Bearish",       group = m3_gDisp, inline = "c")
m3_consCol = input.color(#9a9da3, "Consolidation", group = m3_gDisp, inline = "c")

m3_fastCol = input.color(#ffffff, "Fast",   group = m3_gDisp, inline = "e")
m3_medCol  = input.color(#f5f0c8, "Medium", group = m3_gDisp, inline = "e")
m3_slowCol = input.color(#ffeb3b, "Slow",   group = m3_gDisp, inline = "e")
m3_anchCol = input.color(#ff9800, "Anchor", group = m3_gDisp, inline = "e")

// ─── TABLE ────────────────────────────────────────────────────
m3_gTbl = "Table"

m3_tblOn   = input.bool(true, "Show table", group = m3_gTbl)
m3_tblPos  = input.string("Top Right", "Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right"], group = m3_gTbl)
m3_tblSize = input.string("Tiny", "Size", options = ["Tiny", "Small", "Normal"], group = m3_gTbl)

// ─── ENGINE ───────────────────────────────────────────────────
m3_e1 = ta.ema(m3_src, m3_fast)
m3_e2 = ta.ema(m3_src, m3_med)
m3_e3 = ta.ema(m3_src, m3_slow)
m3_e4 = ta.ema(m3_src, m3_anchor)

m3_atr = ta.atr(m3_atrLen)

// separation between the outermost two, as a multiple of ATR
m3_sep = m3_atr > 0 ? math.abs(m3_e1 - m3_e4) / m3_atr : 0.0
m3_sepOk = not m3_useSep or m3_sep >= m3_sepAtr

// order tests
m3_upFull = m3_e1 > m3_e2 and m3_e2 > m3_e3 and m3_e3 > m3_e4
m3_dnFull = m3_e1 < m3_e2 and m3_e2 < m3_e3 and m3_e3 < m3_e4
m3_upLoose = m3_e2 > m3_e3 and m3_e3 > m3_e4
m3_dnLoose = m3_e2 < m3_e3 and m3_e3 < m3_e4

m3_up = (m3_strict ? m3_upFull : m3_upLoose) and m3_sepOk
m3_dn = (m3_strict ? m3_dnFull : m3_dnLoose) and m3_sepOk

//  1 bullish · -1 bearish · 0 consolidation
m3_state = m3_up ? 1 : m3_dn ? -1 : 0

m3_stateCol = m3_state == 1 ? m3_bullCol : m3_state == -1 ? m3_bearCol : m3_consCol
m3_stateTxt = m3_state == 1 ? "BULLISH" : m3_state == -1 ? "BEARISH" : "CONSOLIDATION"

// how long the current state has been live
var int m3_since = 0
m3_since := m3_state == m3_state[1] ? m3_since + 1 : 0

// where price sits relative to the stack
m3_aboveAll = close > m3_e1 and close > m3_e2 and close > m3_e3 and close > m3_e4
m3_belowAll = close < m3_e1 and close < m3_e2 and close < m3_e3 and close < m3_e4
m3_posTxt = m3_aboveAll ? "ABOVE ALL" : m3_belowAll ? "BELOW ALL" : "INSIDE"
m3_posCol = m3_aboveAll ? m3_bullCol : m3_belowAll ? m3_bearCol : m3_consCol

// ─── PLOTS ────────────────────────────────────────────────────
p1 = plot(m3_plot ? m3_e1 : na, "Fast",   color = m3_fastCol, linewidth = 1)
p2 = plot(m3_plot ? m3_e2 : na, "Medium", color = m3_medCol,  linewidth = 1)
p3 = plot(m3_plot ? m3_e3 : na, "Slow",   color = m3_slowCol, linewidth = 1)
p4 = plot(m3_plot ? m3_e4 : na, "Anchor", color = m3_anchCol, linewidth = 2)

fill(p1, p4, color = m3_fill and m3_plot ? color.new(m3_stateCol, 92) : na, title = "Stack fill")

bgcolor(m3_shade and m3_state ==  1 ? color.new(m3_bullCol, 95) : na, title = "Bullish")
bgcolor(m3_shade and m3_state == -1 ? color.new(m3_bearCol, 95) : na, title = "Bearish")

// ─── TABLE ────────────────────────────────────────────────────
var table m3_tbl = na

m3_sizeOf(_s) =>
    _s == "Tiny" ? size.tiny : _s == "Small" ? size.small : size.normal

m3_posOf(_p) =>
    _p == "Top Left" ? position.top_left :
     _p == "Bottom Right" ? position.bottom_right :
     _p == "Bottom Left" ? position.bottom_left :
     _p == "Middle Right" ? position.middle_right : position.top_right

if m3_tblOn and barstate.islast
    if na(m3_tbl)
        m3_tbl := table.new(m3_posOf(m3_tblPos), 3, 6,
             bgcolor = color.new(color.black, 20),
             border_color = color.new(color.gray, 60),
             border_width = 1)

    color _hdr = color.new(color.gray, 20)

    table.cell(m3_tbl, 0, 0, "TREND", text_color = _hdr, text_size = m3_sizeOf(m3_tblSize))
    table.cell(m3_tbl, 1, 0, m3_stateTxt, text_color = m3_stateCol, text_size = m3_sizeOf(m3_tblSize))
    table.cell(m3_tbl, 2, 0, str.tostring(m3_since) + " bars", text_color = color.white, text_size = m3_sizeOf(m3_tblSize))

    // the four averages, in stack order, each marked against the one below it
    string[] _names = array.from("FAST", "MED", "SLOW", "ANCHOR")
    float[]  _vals  = array.from(m3_e1, m3_e2, m3_e3, m3_e4)
    color[]  _cols  = array.from(m3_fastCol, m3_medCol, m3_slowCol, m3_anchCol)

    for i = 0 to 3
        float _v = array.get(_vals, i)
        string _mark = ""
        if i < 3
            float _below = array.get(_vals, i + 1)
            _mark := _v > _below ? "▲" : _v < _below ? "▼" : "—"
        table.cell(m3_tbl, 0, i + 1, array.get(_names, i),
             text_color = array.get(_cols, i), text_size = m3_sizeOf(m3_tblSize))
        table.cell(m3_tbl, 1, i + 1, str.tostring(math.round_to_mintick(_v)),
             text_color = color.white, text_size = m3_sizeOf(m3_tblSize))
        table.cell(m3_tbl, 2, i + 1, _mark,
             text_color = _mark == "▲" ? m3_bullCol : _mark == "▼" ? m3_bearCol : m3_consCol,
             text_size = m3_sizeOf(m3_tblSize))

    table.cell(m3_tbl, 0, 5, "PRICE", text_color = _hdr, text_size = m3_sizeOf(m3_tblSize))
    table.cell(m3_tbl, 1, 5, m3_posTxt, text_color = m3_posCol, text_size = m3_sizeOf(m3_tblSize))
    table.cell(m3_tbl, 2, 5, m3_useSep ? str.tostring(math.round(m3_sep, 2)) + "x" : "",
         text_color = m3_sepOk ? color.white : m3_consCol, text_size = m3_sizeOf(m3_tblSize))

// ─── ALERTS ───────────────────────────────────────────────────
alertcondition(m3_state != m3_state[1], "Trend state changed",
     "The EMA stack has moved into a new state.")

alertcondition(m3_state == 1 and m3_state[1] != 1, "Bullish stack formed",
     "The full EMA stack has come into bullish order.")

alertcondition(m3_state == -1 and m3_state[1] != -1, "Bearish stack formed",
     "The full EMA stack has come into bearish order.")

// ═══════════════════════════════════════════════════════════════
//  QUANT PRIME — BUILD MENU · TERMINAL TIER
//  SIDE 3 · SESSION CLOCK
// ───────────────────────────────────────────────────────────────
//  Is a window open, and how long has it got.
//
//  Meridian only resolves conditions inside its trading windows.
//  Outside them the engine still sees sweeps and rejections and
//  does nothing with them, which is the single most common reason
//  somebody concludes the instrument is broken.
//
//  This says plainly whether a window is live, how much of it is
//  left, and how long until the next one opens.
//
//  It pairs with the Phase Clock. That one counts the AMD cycle
//  in the anchor timezone; this counts the trading windows in
//  UTC. Two different clocks, and the instrument runs on both.
//
//  The defaults are Meridian's own windows, in UTC. If you have
//  changed them in the instrument, change them here too or this
//  will be counting down to windows that do not exist.
//
//  Draws one table and optional shading. Namespaced d3_.
// ═══════════════════════════════════════════════════════════════

// ─── WINDOWS ──────────────────────────────────────────────────
d3_gWin = "Windows"

d3_tz = input.string("UTC", "Timezone", group = d3_gWin,
     options = ["UTC-12","UTC-11","UTC-10","UTC-9","UTC-8","UTC-7","UTC-6","UTC-5","UTC-4","UTC-3","UTC-2","UTC-1",
                "UTC","UTC+1","UTC+2","UTC+3","UTC+4","UTC+5","UTC+6","UTC+7","UTC+8","UTC+9","UTC+10","UTC+11","UTC+12"],
     tooltip = "Meridian's windows are expressed in plain UTC. This is a separate setting from the AMD cycle anchor, which defaults to UTC+1.")

d3_w1On   = input.bool(true, "W1", group = d3_gWin, inline = "w1")
d3_w1From = input.int(0, "from", minval = 0, maxval = 23, group = d3_gWin, inline = "w1")
d3_w1To   = input.int(2, "to",   minval = 1, maxval = 24, group = d3_gWin, inline = "w1")

d3_w2On   = input.bool(true, "W2", group = d3_gWin, inline = "w2")
d3_w2From = input.int(4, "from", minval = 0, maxval = 23, group = d3_gWin, inline = "w2")
d3_w2To   = input.int(6, "to",   minval = 1, maxval = 24, group = d3_gWin, inline = "w2")

d3_w3On   = input.bool(true, "W3", group = d3_gWin, inline = "w3")
d3_w3From = input.int(19, "from", minval = 0, maxval = 23, group = d3_gWin, inline = "w3")
d3_w3To   = input.int(20, "to",   minval = 1, maxval = 24, group = d3_gWin, inline = "w3",
     tooltip = "Defaults are Meridian's shipped windows. Whether they hold on your instrument is a question the Session Report answers.")

// ─── WARNING ──────────────────────────────────────────────────
d3_gWarn = "Warning"

d3_warnOn  = input.bool(true, "Flag when a window is nearly over", group = d3_gWarn)
d3_warnMin = input.int(10, "Minutes remaining to flag at", minval = 1, maxval = 120, group = d3_gWarn,
     tooltip = "A condition resolving in the last few minutes of a window leaves very little room for it to work.")

// ─── DISPLAY ──────────────────────────────────────────────────
d3_gDisp = "Display"

d3_shade = input.bool(true, "Shade the live window", group = d3_gDisp)
d3_fade  = input.int(93, "Shading transparency", minval = 80, maxval = 99, group = d3_gDisp)

d3_tblPos  = input.string("Bottom Left", "Table position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right"], group = d3_gDisp)
d3_tblSize = input.string("Tiny", "Table size", options = ["Tiny", "Small", "Normal"], group = d3_gDisp)

d3_openCol  = input.color(#ffb74d, "Open",    group = d3_gDisp, inline = "c")
d3_shutCol  = input.color(#9a9da3, "Closed",  group = d3_gDisp, inline = "c")
d3_warnCol  = input.color(#ffffff, "Warning", group = d3_gDisp, inline = "c")

// ─── ENGINE ───────────────────────────────────────────────────
// Minutes elapsed since midnight in the chosen timezone.
d3_now = hour(time, d3_tz) * 60.0 + minute(time, d3_tz) + second(time, d3_tz) / 60.0

// Windows are half open: from inclusive, to exclusive. A window
// whose "to" is less than its "from" wraps past midnight.
d3_inWin(bool _on, int _f, int _t) =>
    bool _r = false
    if _on
        float _fm = _f * 60.0
        float _tm = _t * 60.0
        _r := _tm > _fm ? (d3_now >= _fm and d3_now < _tm) :
             (d3_now >= _fm or d3_now < _tm)
    _r

// Minutes until a window closes. Only meaningful while inside it.
d3_leftIn(int _f, int _t) =>
    float _tm = _t * 60.0
    float _fm = _f * 60.0
    float _r = 0.0
    if _tm > _fm
        _r := _tm - d3_now
    else
        _r := d3_now >= _fm ? (1440.0 - d3_now) + _tm : _tm - d3_now
    _r

// Minutes until a window opens. Only meaningful while outside it.
d3_untilIn(int _f) =>
    float _fm = _f * 60.0
    _fm > d3_now ? _fm - d3_now : (1440.0 - d3_now) + _fm

d3_clock(float _mins) =>
    int _m = int(math.round(_mins))
    _m >= 60 ? str.tostring(math.floor(_m / 60)) + "h " +
         str.format("{0,number,00}", _m % 60) + "m" :
         str.tostring(_m) + "m"

d3_sizeOf(_s) =>
    _s == "Tiny" ? size.tiny : _s == "Small" ? size.small : size.normal

d3_posOf(_p) =>
    _p == "Top Right" ? position.top_right :
     _p == "Top Left" ? position.top_left :
     _p == "Bottom Right" ? position.bottom_right :
     _p == "Middle Right" ? position.middle_right : position.bottom_left

d3_pad(int _h) =>
    str.format("{0,number,00}", _h) + ":00"

// ─── STATE ────────────────────────────────────────────────────
d3_in1 = d3_inWin(d3_w1On, d3_w1From, d3_w1To)
d3_in2 = d3_inWin(d3_w2On, d3_w2From, d3_w2To)
d3_in3 = d3_inWin(d3_w3On, d3_w3From, d3_w3To)

d3_anyOpen = d3_in1 or d3_in2 or d3_in3

// minutes left on whichever window is live
d3_liveLeft = d3_in1 ? d3_leftIn(d3_w1From, d3_w1To) :
     d3_in2 ? d3_leftIn(d3_w2From, d3_w2To) :
     d3_in3 ? d3_leftIn(d3_w3From, d3_w3To) : na

d3_closingSoon = d3_warnOn and d3_anyOpen and not na(d3_liveLeft) and d3_liveLeft <= d3_warnMin

// soonest window to open, when nothing is live
float d3_nextIn = na
int   d3_nextNo = 0
if not d3_anyOpen
    if d3_w1On
        float _u = d3_untilIn(d3_w1From)
        if na(d3_nextIn) or _u < d3_nextIn
            d3_nextIn := _u
            d3_nextNo := 1
    if d3_w2On
        float _u = d3_untilIn(d3_w2From)
        if na(d3_nextIn) or _u < d3_nextIn
            d3_nextIn := _u
            d3_nextNo := 2
    if d3_w3On
        float _u = d3_untilIn(d3_w3From)
        if na(d3_nextIn) or _u < d3_nextIn
            d3_nextIn := _u
            d3_nextNo := 3

// ─── SHADING ──────────────────────────────────────────────────
bgcolor(d3_shade and d3_anyOpen ?
     color.new(d3_closingSoon ? d3_warnCol : d3_openCol, d3_fade) : na,
     title = "Live window")

// ─── TABLE ────────────────────────────────────────────────────
var table d3_tbl = na

if barstate.islast
    if na(d3_tbl)
        d3_tbl := table.new(d3_posOf(d3_tblPos), 3, 5,
             bgcolor = color.new(color.black, 20),
             border_color = color.new(color.gray, 60),
             border_width = 1)

    color _hdr = color.new(color.gray, 20)
    string _sz = d3_tblSize

    // headline status
    string _statTxt = d3_anyOpen ? "OPEN" : "CLOSED"
    color  _statCol = d3_closingSoon ? d3_warnCol : d3_anyOpen ? d3_openCol : d3_shutCol
    string _statRhs = d3_anyOpen ?
         (na(d3_liveLeft) ? "" : d3_clock(d3_liveLeft) + " left") :
         (na(d3_nextIn) ? "no windows on" : "W" + str.tostring(d3_nextNo) + " in " + d3_clock(d3_nextIn))

    table.cell(d3_tbl, 0, 0, "WINDOW", text_color = _hdr, text_size = d3_sizeOf(_sz))
    table.cell(d3_tbl, 1, 0, _statTxt, text_color = _statCol, text_size = d3_sizeOf(_sz))
    table.cell(d3_tbl, 2, 0, _statRhs, text_color = _statCol, text_size = d3_sizeOf(_sz))

    // the three windows
    bool[] _ons  = array.from(d3_w1On, d3_w2On, d3_w3On)
    int[]  _frs  = array.from(d3_w1From, d3_w2From, d3_w3From)
    int[]  _tos  = array.from(d3_w1To, d3_w2To, d3_w3To)
    bool[] _ins  = array.from(d3_in1, d3_in2, d3_in3)

    for i = 0 to 2
        int _row = i + 1
        bool _on = array.get(_ons, i)
        bool _live = array.get(_ins, i)

        table.cell(d3_tbl, 0, _row, "W" + str.tostring(i + 1),
             text_color = _on ? color.white : color.new(color.gray, 60), text_size = d3_sizeOf(_sz))

        table.cell(d3_tbl, 1, _row, _on ?
             d3_pad(array.get(_frs, i)) + "–" + d3_pad(array.get(_tos, i)) : "off",
             text_color = _on ? (_live ? d3_openCol : color.white) : color.new(color.gray, 60),
             text_size = d3_sizeOf(_sz))

        string _rhs = not _on ? "" :
             _live ? d3_clock(d3_leftIn(array.get(_frs, i), array.get(_tos, i))) + " left" :
             "in " + d3_clock(d3_untilIn(array.get(_frs, i)))

        table.cell(d3_tbl, 2, _row, _rhs,
             text_color = _live ? (d3_closingSoon ? d3_warnCol : d3_openCol) : color.new(color.gray, 30),
             text_size = d3_sizeOf(_sz))

    // timezone reminder, because this is the thing that gets set wrong
    table.cell(d3_tbl, 0, 4, "TZ", text_color = _hdr, text_size = d3_sizeOf(_sz))
    table.cell(d3_tbl, 1, 4, d3_tz, text_color = color.new(color.gray, 20), text_size = d3_sizeOf(_sz))
    table.cell(d3_tbl, 2, 4, "", text_size = d3_sizeOf(_sz))

// ─── ALERTS ───────────────────────────────────────────────────
alertcondition(d3_anyOpen and not d3_anyOpen[1], "Window opened",
     "A Meridian trading window has opened.")

alertcondition(not d3_anyOpen and d3_anyOpen[1], "Window closed",
     "The Meridian trading window has closed. Conditions will not resolve until the next one.")

alertcondition(d3_closingSoon and not d3_closingSoon[1], "Window closing soon",
     "The live trading window is nearly over.")

// ═══════════════════════════════════════════════════════════════
//  QUANT PRIME — BUILD MENU · TERMINAL TIER
//  DESSERT 1 · SWEEP REPORT
// ───────────────────────────────────────────────────────────────
//  Does the premise hold on your instrument.
//
//  When price takes out a prior high or low, two things can
//  happen. It comes back through, meaning the break failed and the
//  move was a grab for the orders resting there. Or it stays
//  beyond and runs, meaning the level genuinely broke.
//
//  Meridian's whole premise is that the first happens more often
//  than the second. That was measured on one instrument. Whether
//  it survives on yours is a question only your own data answers.
//
//  Note this is a different event to what Recoil measures. Recoil
//  fades an exceptional candle. This measures whether a broken
//  level holds.
//
//  This runs the test. Every level swept in your history, split by
//  timeframe, graded on what price did afterwards:
//
//    REVERSED     came back through by the required amount
//    RAN ON       stayed beyond and kept going
//    UNRESOLVED   neither, inside the window
//
//  A reversal rate meaningfully above 50% supports the premise on
//  that timeframe. Around 50% means a break tells you nothing on
//  its own. Below it means the opposite is true on your pair, and
//  trading the failure puts you on the wrong side of it.
//
//  Rows with fewer than thirty graded sweeps are left ungraded,
//  because a 70% rate from six occurrences means nothing and
//  showing it as a number invites exactly the wrong conclusion.
//
//  Use a large sample. Five thousand candles, not five hundred.
//  Meridian's levels are swept less often than Recoil's candles
//  fire, so this table fills slowly.
//
//  Draws one table. Namespaced t1_.
// ═══════════════════════════════════════════════════════════════

// ─── TIMEFRAMES ───────────────────────────────────────────────
t1_gTf = "Levels"

t1_t1On = input.bool(true, "TF1", group = t1_gTf, inline = "t1")
t1_t1   = input.timeframe("3", "", group = t1_gTf, inline = "t1")
t1_t2On = input.bool(true, "TF2", group = t1_gTf, inline = "t2")
t1_t2   = input.timeframe("30", "", group = t1_gTf, inline = "t2")
t1_t3On = input.bool(true, "TF3", group = t1_gTf, inline = "t3")
t1_t3   = input.timeframe("180", "", group = t1_gTf, inline = "t3")

t1_pvL = input.int(4, "Pivot L", minval = 1, maxval = 20, group = t1_gTf, inline = "p")
t1_pvR = input.int(2, "Pivot R", minval = 1, maxval = 20, group = t1_gTf, inline = "p",
     tooltip = "Applied to all three timeframes. Higher values find fewer, more significant levels and will slow the sample down further.")

// ─── TEST ─────────────────────────────────────────────────────
t1_gTest = "Test"

t1_mode = input.string("Wick through", "A sweep is", options = ["Wick through", "Close beyond"], group = t1_gTest,
     tooltip = "Should match how you read a sweep on the chart. Close beyond finds fewer events and tends to produce higher rejection rates, because it has already filtered out the shallowest touches.")

t1_window = input.int(20, "Grade over N bars", minval = 3, maxval = 200, group = t1_gTest)

t1_rejPct = input.float(50.0, "Rejection needs % of the overshoot back", minval = 10.0, maxval = 100.0, step = 5.0, group = t1_gTest,
     tooltip = "How much of the move beyond the level price must give back for the sweep to grade REJECTED. Measured as a percentage of how far beyond it went, so it scales across instruments.")

t1_minSample = input.int(30, "Minimum graded sweeps", minval = 5, maxval = 200, group = t1_gTest,
     tooltip = "Rows below this are shown but left ungraded. Lowering it does not make a thin sample meaningful.")

// ─── SPLIT ────────────────────────────────────────────────────
t1_gSplit = "Split"

t1_bySide = input.bool(true, "Separate highs from lows", group = t1_gSplit,
     tooltip = "Highs taken and lows taken are not the same event on most instruments, and a pair that behaves symmetrically is worth knowing about.")

t1_maxLv = input.int(400, "Levels tracked", minval = 50, maxval = 500, group = t1_gSplit)

// ─── TABLE ────────────────────────────────────────────────────
t1_gTbl = "Table"

t1_tblPos  = input.string("Bottom Right", "Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right"], group = t1_gTbl)
t1_tblSize = input.string("Tiny", "Size", options = ["Tiny", "Small", "Normal"], group = t1_gTbl)

t1_legend = input.bool(true, "Show the plain english summary", group = t1_gTbl,
     tooltip = "A verdict row and a one line legend under the table, so the numbers do not need decoding on first use.")

t1_goodCol = input.color(#2f6b41, "Reverses",   group = t1_gTbl, inline = "c")
t1_badCol  = input.color(#b4342a, "Runs on",     group = t1_gTbl, inline = "c")
t1_thinCol = input.color(#9a9da3, "Thin",       group = t1_gTbl, inline = "c")

// ─── STATE ────────────────────────────────────────────────────
//  outcome: 0 pending · 1 rejected · 2 continued · 3 unresolved
type T1Lv
    float px
    bool  isHigh
    int   tfi
    bool  swept
    int   sweptBar
    float extreme
    int   outcome

var T1Lv[] t1_lv = array.new<T1Lv>()

// tallies indexed [timeframe * 2 + side], side 0 = highs, 1 = lows
var int[] t1_rej = array.from(0,0,0,0,0,0)
var int[] t1_con = array.from(0,0,0,0,0,0)
var int[] t1_unr = array.from(0,0,0,0,0,0)

t1_sizeOf(_s) =>
    _s == "Tiny" ? size.tiny : _s == "Small" ? size.small : size.normal

t1_posOf(_p) =>
    _p == "Top Right" ? position.top_right :
     _p == "Top Left" ? position.top_left :
     _p == "Bottom Left" ? position.bottom_left :
     _p == "Middle Right" ? position.middle_right : position.bottom_right

t1_tfLabel(string _tf) =>
    string _out = _tf
    float  _n   = str.tonumber(_tf)
    if not na(_n)
        int _m = int(_n)
        _out := _m >= 1440 and _m % 1440 == 0 ? str.tostring(_m / 1440) + "D" :
             _m >= 60 and _m % 60 == 0 ? str.tostring(_m / 60) + "H" :
             str.tostring(_m) + "M"
    _out

t1_known(float _px) =>
    bool _f = false
    int _n = array.size(t1_lv)
    if _n > 0
        for i = 0 to _n - 1
            T1Lv _l = array.get(t1_lv, i)
            if not _l.swept and math.abs(_l.px - _px) < syminfo.mintick * 2
                _f := true
    _f

t1_add(float _px, bool _isHigh, int _tfi) =>
    if not na(_px) and not t1_known(_px)
        array.push(t1_lv, T1Lv.new(_px, _isHigh, _tfi, false, na, na, 0))
        while array.size(t1_lv) > t1_maxLv
            array.shift(t1_lv)

// ─── PIVOT FEED ───────────────────────────────────────────────
[t1_h1, t1_l1] = request.security(syminfo.tickerid, t1_t1,
     [ta.pivothigh(high, t1_pvL, t1_pvR), ta.pivotlow(low, t1_pvL, t1_pvR)], lookahead = barmerge.lookahead_off)
[t1_h2, t1_l2] = request.security(syminfo.tickerid, t1_t2,
     [ta.pivothigh(high, t1_pvL, t1_pvR), ta.pivotlow(low, t1_pvL, t1_pvR)], lookahead = barmerge.lookahead_off)
[t1_h3, t1_l3] = request.security(syminfo.tickerid, t1_t3,
     [ta.pivothigh(high, t1_pvL, t1_pvR), ta.pivotlow(low, t1_pvL, t1_pvR)], lookahead = barmerge.lookahead_off)

// ─── ENGINE ───────────────────────────────────────────────────
if barstate.isconfirmed
    if t1_t1On
        t1_add(t1_h1, true,  0)
        t1_add(t1_l1, false, 0)
    if t1_t2On
        t1_add(t1_h2, true,  1)
        t1_add(t1_l2, false, 1)
    if t1_t3On
        t1_add(t1_h3, true,  2)
        t1_add(t1_l3, false, 2)

    int _n = array.size(t1_lv)
    if _n > 0
        for i = 0 to _n - 1
            T1Lv _l = array.get(t1_lv, i)

            if not _l.swept
                bool _hit = t1_mode == "Wick through" ?
                     (_l.isHigh ? high >= _l.px : low <= _l.px) :
                     (_l.isHigh ? close > _l.px : close < _l.px)
                if _hit
                    _l.swept    := true
                    _l.sweptBar := bar_index
                    _l.extreme  := _l.isHigh ? high : low

            else if _l.outcome == 0
                _l.extreme := _l.isHigh ? math.max(_l.extreme, high) : math.min(_l.extreme, low)

                float _over = math.abs(_l.extreme - _l.px)
                float _need = _l.px + (_l.isHigh ? -1 : 1) * _over * (t1_rejPct / 100.0)

                bool _rej = _over > 0 and (_l.isHigh ? close <= _need : close >= _need)
                bool _exp = bar_index - _l.sweptBar >= t1_window

                if _rej
                    _l.outcome := 1
                else if _exp
                    _l.outcome := (_l.isHigh ? close > _l.px : close < _l.px) ? 2 : 3

                if _l.outcome != 0
                    int _slot = _l.tfi * 2 + (_l.isHigh ? 0 : 1)
                    if _l.outcome == 1
                        array.set(t1_rej, _slot, array.get(t1_rej, _slot) + 1)
                    else if _l.outcome == 2
                        array.set(t1_con, _slot, array.get(t1_con, _slot) + 1)
                    else
                        array.set(t1_unr, _slot, array.get(t1_unr, _slot) + 1)

// ─── TABLE ────────────────────────────────────────────────────
var table t1_tbl = na

if barstate.islast
    int _rows = (t1_bySide ? 8 : 5) + (t1_legend ? 2 : 0)
    if na(t1_tbl)
        t1_tbl := table.new(t1_posOf(t1_tblPos), 5, _rows,
             bgcolor = color.new(color.black, 20),
             border_color = color.new(color.gray, 60),
             border_width = 1)

    color _hdr = color.new(color.gray, 20)
    string _sz = t1_tblSize

    table.cell(t1_tbl, 0, 0, "SWEEPS",  text_color = _hdr, text_size = t1_sizeOf(_sz))
    table.cell(t1_tbl, 1, 0, "SWEPT",   text_color = _hdr, text_size = t1_sizeOf(_sz))
    table.cell(t1_tbl, 2, 0, "CAME BK", text_color = _hdr, text_size = t1_sizeOf(_sz))
    table.cell(t1_tbl, 3, 0, "RAN ON",  text_color = _hdr, text_size = t1_sizeOf(_sz))
    table.cell(t1_tbl, 4, 0, "REV %",   text_color = _hdr, text_size = t1_sizeOf(_sz))

    string[] _tfs = array.from(t1_t1, t1_t2, t1_t3)
    bool[]   _ons = array.from(t1_t1On, t1_t2On, t1_t3On)

    int _row = 1
    int _allR = 0
    int _allC = 0
    int _allU = 0

    for i = 0 to 2
        if not array.get(_ons, i)
            continue

        int _rH = array.get(t1_rej, i * 2)
        int _cH = array.get(t1_con, i * 2)
        int _uH = array.get(t1_unr, i * 2)
        int _rL = array.get(t1_rej, i * 2 + 1)
        int _cL = array.get(t1_con, i * 2 + 1)
        int _uL = array.get(t1_unr, i * 2 + 1)

        _allR += _rH + _rL
        _allC += _cH + _cL
        _allU += _uH + _uL

        if t1_bySide
            // highs row
            int _gH = _rH + _cH
            table.cell(t1_tbl, 0, _row, t1_tfLabel(array.get(_tfs, i)) + " hi", text_color = color.white, text_size = t1_sizeOf(_sz))
            table.cell(t1_tbl, 1, _row, str.tostring(_gH + _uH), text_color = color.white, text_size = t1_sizeOf(_sz))
            table.cell(t1_tbl, 2, _row, str.tostring(_rH), text_color = color.white, text_size = t1_sizeOf(_sz))
            table.cell(t1_tbl, 3, _row, str.tostring(_cH), text_color = color.white, text_size = t1_sizeOf(_sz))
            if _gH < t1_minSample
                table.cell(t1_tbl, 4, _row, "thin", text_color = t1_thinCol, text_size = t1_sizeOf(_sz))
            else
                float _p = _rH / _gH * 100.0
                table.cell(t1_tbl, 4, _row, str.tostring(math.round(_p)) + "%",
                     text_color = _p >= 55 ? t1_goodCol : _p <= 45 ? t1_badCol : t1_thinCol,
                     text_size = t1_sizeOf(_sz))
            _row += 1

            // lows row
            int _gL = _rL + _cL
            table.cell(t1_tbl, 0, _row, t1_tfLabel(array.get(_tfs, i)) + " lo", text_color = color.white, text_size = t1_sizeOf(_sz))
            table.cell(t1_tbl, 1, _row, str.tostring(_gL + _uL), text_color = color.white, text_size = t1_sizeOf(_sz))
            table.cell(t1_tbl, 2, _row, str.tostring(_rL), text_color = color.white, text_size = t1_sizeOf(_sz))
            table.cell(t1_tbl, 3, _row, str.tostring(_cL), text_color = color.white, text_size = t1_sizeOf(_sz))
            if _gL < t1_minSample
                table.cell(t1_tbl, 4, _row, "thin", text_color = t1_thinCol, text_size = t1_sizeOf(_sz))
            else
                float _p = _rL / _gL * 100.0
                table.cell(t1_tbl, 4, _row, str.tostring(math.round(_p)) + "%",
                     text_color = _p >= 55 ? t1_goodCol : _p <= 45 ? t1_badCol : t1_thinCol,
                     text_size = t1_sizeOf(_sz))
            _row += 1
        else
            int _r = _rH + _rL
            int _c = _cH + _cL
            int _u = _uH + _uL
            int _g = _r + _c
            table.cell(t1_tbl, 0, _row, t1_tfLabel(array.get(_tfs, i)), text_color = color.white, text_size = t1_sizeOf(_sz))
            table.cell(t1_tbl, 1, _row, str.tostring(_g + _u), text_color = color.white, text_size = t1_sizeOf(_sz))
            table.cell(t1_tbl, 2, _row, str.tostring(_r), text_color = color.white, text_size = t1_sizeOf(_sz))
            table.cell(t1_tbl, 3, _row, str.tostring(_c), text_color = color.white, text_size = t1_sizeOf(_sz))
            if _g < t1_minSample
                table.cell(t1_tbl, 4, _row, "thin", text_color = t1_thinCol, text_size = t1_sizeOf(_sz))
            else
                float _p = _r / _g * 100.0
                table.cell(t1_tbl, 4, _row, str.tostring(math.round(_p)) + "%",
                     text_color = _p >= 55 ? t1_goodCol : _p <= 45 ? t1_badCol : t1_thinCol,
                     text_size = t1_sizeOf(_sz))
            _row += 1

    int _allRow = _rows - (t1_legend ? 3 : 1)

    // fill any unused rows so the table does not show stale cells
    while _row < _allRow
        for c = 0 to 4
            table.cell(t1_tbl, c, _row, "", text_size = t1_sizeOf(_sz))
        _row += 1

    // total
    int _allG = _allR + _allC
    table.cell(t1_tbl, 0, _allRow, "ALL", text_color = _hdr, text_size = t1_sizeOf(_sz))
    table.cell(t1_tbl, 1, _allRow, str.tostring(_allG + _allU), text_color = color.white, text_size = t1_sizeOf(_sz))
    table.cell(t1_tbl, 2, _allRow, str.tostring(_allR), text_color = color.white, text_size = t1_sizeOf(_sz))
    table.cell(t1_tbl, 3, _allRow, str.tostring(_allC), text_color = color.white, text_size = t1_sizeOf(_sz))
    if _allG < t1_minSample
        table.cell(t1_tbl, 4, _allRow, "thin", text_color = t1_thinCol, text_size = t1_sizeOf(_sz))
    else
        float _p = _allR / _allG * 100.0
        table.cell(t1_tbl, 4, _allRow, str.tostring(math.round(_p)) + "%",
             text_color = _p >= 55 ? t1_goodCol : _p <= 45 ? t1_badCol : t1_thinCol,
             text_size = t1_sizeOf(_sz))

    // ─── PLAIN ENGLISH ────────────────────────────────────────
    //  The table above is the evidence. This is what it says.
    if t1_legend
        int _lr = _rows - 2

        string _verdict = ""
        color  _vCol    = t1_thinCol

        if _allG < t1_minSample
            _verdict := "Not enough sweeps yet — use more history"
        else
            float _pAll = _allR / _allG * 100.0

            // count how many graded rows fall each side of the line
            int _sup = 0
            int _con = 0
            for i = 0 to 2
                if array.get(_ons, i)
                    int _r2 = array.get(t1_rej, i * 2) + array.get(t1_rej, i * 2 + 1)
                    int _c2 = array.get(t1_con, i * 2) + array.get(t1_con, i * 2 + 1)
                    int _g2 = _r2 + _c2
                    if _g2 >= t1_minSample
                        float _p2 = _r2 / _g2 * 100.0
                        if _p2 >= 55
                            _sup += 1
                        else if _p2 <= 45
                            _con += 1

            if _pAll >= 55
                _vCol := t1_goodCol
                _verdict := _con > 0 ?
                     "Broken levels mostly reverse — but check the red rows" :
                     "Broken levels reverse — " + str.tostring(math.round(_pAll)) + "% came back through"
            else if _pAll <= 45
                _vCol := t1_badCol
                _verdict := "Broken levels run on more than they reverse"
            else
                _verdict := "No clear edge — a break alone says little here"

        // Merged across the full width so the long strings do not
        // stretch the data columns. Pine sizes a column to its
        // widest cell, and a merged cell is exempt from that.
        table.cell(t1_tbl, 0, _lr, _verdict,
             text_color = _vCol, text_size = t1_sizeOf(_sz),
             text_halign = text.align_center)
        table.cell(t1_tbl, 1, _lr, "", text_size = t1_sizeOf(_sz))
        table.cell(t1_tbl, 2, _lr, "", text_size = t1_sizeOf(_sz))
        table.cell(t1_tbl, 3, _lr, "", text_size = t1_sizeOf(_sz))
        table.cell(t1_tbl, 4, _lr, "", text_size = t1_sizeOf(_sz))
        table.merge_cells(t1_tbl, 0, _lr, 4, _lr)

        table.cell(t1_tbl, 0, _rows - 1,
             "REV % = how often a broken level came back through   ·   green supports it, red argues against",
             text_color = t1_thinCol, text_size = t1_sizeOf(_sz),
             text_halign = text.align_center)
        table.cell(t1_tbl, 1, _rows - 1, "", text_size = t1_sizeOf(_sz))
        table.cell(t1_tbl, 2, _rows - 1, "", text_size = t1_sizeOf(_sz))
        table.cell(t1_tbl, 3, _rows - 1, "", text_size = t1_sizeOf(_sz))
        table.cell(t1_tbl, 4, _rows - 1, "", text_size = t1_sizeOf(_sz))
        table.merge_cells(t1_tbl, 0, _rows - 1, 4, _rows - 1)

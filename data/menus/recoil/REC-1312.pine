//@version=6
// =============================================================
//  QUANT PRIME — RECOIL BUILD  ·  REC-1312
// -------------------------------------------------------------
//  Volatility Bands + Regime Tracker + Candle Clock + Zone Report
//
//  Generated from the Recoil Build menu. Each piece keeps its
//  own settings group and its own namespace, so nothing here
//  interferes with anything else. Remove a piece by rebuilding
//  from the menu rather than editing this file.
// =============================================================

indicator("QP · Recoil 1312", shorttitle = "REC-1312", overlay = true, max_labels_count = 500)

// ═══════════════════════════════════════════════════════════════
//  QUANT PRIME — BUILD MENU · RECOIL TIER
//  STARTER 1 · VOLATILITY BANDS
// ───────────────────────────────────────────────────────────────
//  Every candle's TRUE range -- its full high-to-low movement,
//  including any gap from the prior close -- is divided by
//  ATR(length). The result answers one question: how big is this
//  candle compared to a normal recent candle? 1.0x is exactly
//  average. 3.0x is three times the recent norm.
//
//  That ratio places the candle in one of eight bands:
//
//    1  Extremely Low     5  Medium
//    2  Very Low          6  High Medium
//    3  Low               7  High
//    4  Lower Medium      8  Very High
//
//  ATR Length is the MEMORY of the baseline. Shorter (5) adapts
//  fast and measures abnormal against the last few minutes.
//  Longer (21) is slow, so a volatility burst keeps reading as
//  extreme for longer. The default of 8 is deliberately
//  responsive, suited to a short-timeframe context.
//
//  A wide candle built from wicks is a rejection, not an
//  expansion, and its body is too small to measure anything
//  useful against. The minimum body filter removes those from the
//  high bands entirely so only workable expansions are shown.
//
//  Draws no table. Safe to combine with any other Recoil piece.
//  All identifiers namespaced s1_ to avoid collisions.
// ═══════════════════════════════════════════════════════════════


// ─── VOLATILITY ───────────────────────────────────────────────
s1_gVol = "Volatility"

s1_atrLen = input.int(8, "ATR Length", minval = 1, group = s1_gVol,
     tooltip = "The averaging period used as the volatility baseline. Shorter values adapt faster; longer values keep a burst reading as extreme for longer.")

s1_t1 = input.float(0.30, "Threshold 1 (Extremely Low → Very Low)",  step = 0.05, group = s1_gVol)
s1_t2 = input.float(0.75, "Threshold 2 (Very Low → Low)",            step = 0.05, group = s1_gVol)
s1_t3 = input.float(1.20, "Threshold 3 (Low → Lower Medium)",        step = 0.05, group = s1_gVol)
s1_t4 = input.float(1.65, "Threshold 4 (Lower Medium → Medium)",     step = 0.05, group = s1_gVol)
s1_t5 = input.float(2.10, "Threshold 5 (Medium → High Medium)",      step = 0.05, group = s1_gVol)
s1_t6 = input.float(2.55, "Threshold 6 (High Medium → High)",        step = 0.05, group = s1_gVol)
s1_t7 = input.float(3.00, "Threshold 7 (High → Very High)",          step = 0.05, group = s1_gVol)

s1_minBodyAtr = input.float(0.5, "Min Body Size (x ATR)", minval = 0.0, step = 0.05, group = s1_gVol,
     tooltip = "A candle's body (open-to-close) must be at least this many ATRs to qualify for a high band. Candles that fail are filtered out of bands 6-8 and shown as Medium instead. Set to 0 to disable the filter.")

s1_tagFrom = input.int(6, "Show Tag From Band # Upward", minval = 1, maxval = 8, group = s1_gVol,
     tooltip = "The small '#.##x' text tag only appears on candles whose volatility band is this number or higher (1 = Extremely Low ... 8 = Very High). Default 6 tags only the high bands.")

// ─── COLOURS ──────────────────────────────────────────────────
s1_gCol = "Volatility — Colors"

s1_c1 = input.color(#bbd9fb, "Extremely Low", group = s1_gCol)
s1_c2 = input.color(#90bff9, "Very Low",      group = s1_gCol)
s1_c3 = input.color(#5b9cf6, "Low",           group = s1_gCol)
s1_c4 = input.color(#3179f5, "Lower Medium",  group = s1_gCol)
s1_c5 = input.color(#1848cc, "Medium",        group = s1_gCol)
s1_c6 = input.color(#ffeb3b, "High Medium",   group = s1_gCol)
s1_c7 = input.color(#ff9800, "High",          group = s1_gCol)
s1_c8 = input.color(#f23645, "Very High",     group = s1_gCol)

// ─── DISPLAY ──────────────────────────────────────────────────
s1_gDisp = "Display"

s1_colorCandles = input.bool(true,  "Color Candles By Volatility", group = s1_gDisp)
s1_showTag      = input.bool(false, "Show Volatility Tag",         group = s1_gDisp)
s1_tagTextColor = input.color(color.white, "Tag Text Color",       group = s1_gDisp)

s1_highOnly = input.bool(false, "Color High Bands Only", group = s1_gDisp,
     tooltip = "Leaves bands 1-5 as your chart's normal candle colors and highlights bands 6, 7 and 8 alone.")

// ─── ENGINE ───────────────────────────────────────────────────
// Band classification is lifted verbatim from Quant Prime Recoil,
// so a band 7 candle here is a candle Recoil reads as band 7.
// M2, M3, T1 and T2 reuse this identical block.

s1_trueRange = ta.tr(true)
s1_atr       = ta.atr(s1_atrLen)
s1_ratio     = s1_trueRange / s1_atr

s1_rawBand =
     s1_ratio < s1_t1 ? 1 :
     s1_ratio < s1_t2 ? 2 :
     s1_ratio < s1_t3 ? 3 :
     s1_ratio < s1_t4 ? 4 :
     s1_ratio < s1_t5 ? 5 :
     s1_ratio < s1_t6 ? 6 :
     s1_ratio < s1_t7 ? 7 : 8

// Minimum body filter -- a high band candle whose body is too
// small to be workable is dropped out of the high bands.
s1_body    = math.abs(close - open)
s1_minBody = math.max(syminfo.mintick, s1_atr * s1_minBodyAtr)
s1_bodyOk  = s1_minBodyAtr <= 0 or s1_body > s1_minBody

s1_band = s1_rawBand >= 6 and not s1_bodyOk ? 5 : s1_rawBand

s1_color =
     s1_band == 1 ? s1_c1 :
     s1_band == 2 ? s1_c2 :
     s1_band == 3 ? s1_c3 :
     s1_band == 4 ? s1_c4 :
     s1_band == 5 ? s1_c5 :
     s1_band == 6 ? s1_c6 :
     s1_band == 7 ? s1_c7 : s1_c8

s1_isHigh  = s1_band >= 6
s1_notable = s1_band >= s1_tagFrom

// ─── RENDER ───────────────────────────────────────────────────
s1_paint = s1_colorCandles and (not s1_highOnly or s1_isHigh)
barcolor(s1_paint ? s1_color : na, title = "Volatility Color")

// Tag rendering: confirmed bars get a permanent label, the live
// bar gets a single label that is replaced each tick.
var label s1_liveLabel = na
label.delete(s1_liveLabel)

if s1_showTag
    if barstate.isconfirmed
        if s1_notable
            label.new(bar_index, high,
                 text      = str.tostring(s1_ratio, "#.##") + "x",
                 style     = label.style_label_down,
                 color     = s1_color,
                 textcolor = s1_tagTextColor,
                 size      = size.small,
                 yloc      = yloc.abovebar)
        label.delete(s1_liveLabel)
        s1_liveLabel := na
    else if barstate.islast and s1_notable
        label.delete(s1_liveLabel)
        s1_liveLabel := label.new(bar_index, high,
             text      = str.tostring(s1_ratio, "#.##") + "x",
             style     = label.style_label_down,
             color     = s1_color,
             textcolor = s1_tagTextColor,
             size      = size.small,
             yloc      = yloc.abovebar)

// ─── ALERTS ───────────────────────────────────────────────────
alertcondition(s1_band >= 6 and s1_band[1] < 6, "Volatility expansion",
     "A candle has closed in a high volatility band (6, 7 or 8).")

alertcondition(s1_band == 8, "Band 8 candle",
     "A candle has closed in band 8 -- the most extended condition this instrument produces.")


// ═══════════════════════════════════════════════════════════════
//  QUANT PRIME — BUILD MENU · RECOIL TIER
//  MAIN 3 · REGIME TRACKER
// ───────────────────────────────────────────────────────────────
//  The regime score grades the market's quality out of 90, built
//  from two components:
//
//    STABILITY (0-40)  Current ATR against its own 50 period
//                      average. Scores 40 when the two sit close
//                      together, 20 when loosely aligned, 0 when
//                      they diverge.
//    TREND     (0-50)  ADX, capped at 50.
//
//  Note what stability rewards. It is not measuring how much the
//  market is moving, it is measuring whether it is moving the way
//  it has recently been moving. A run of expansion candles pushes
//  ATR away from its average and drags the score DOWN. High
//  volatility and a high regime score are different things, and a
//  fade taken in a degraded regime is a different trade to the
//  same fade taken in a prime one.
//
//  Identical scoring to the Cockpit regime scanner, so a score
//  read here is the same number Cockpit shows for this timeframe.
//  Cockpit reads five timeframes at once; this reads the chart
//  you are on, and keeps its recent history.
//
//  Draws one table. Safe to combine with any other Recoil piece.
//  All identifiers namespaced m3_ to avoid collisions.
// ═══════════════════════════════════════════════════════════════


// ─── SCORING ──────────────────────────────────────────────────
m3_gScore = "Scoring"

m3_atrLen = input.int(14, "ATR length", minval = 1, group = m3_gScore,
     tooltip = "The current volatility reading. Matches the Cockpit regime scanner.")

m3_avgLen = input.int(50, "ATR average length", minval = 2, group = m3_gScore,
     tooltip = "The baseline the current ATR is compared against. Their ratio drives the stability component.")

m3_adxLen = input.int(14, "ADX length", minval = 1, group = m3_gScore,
     tooltip = "The trend strength reading. Contributes up to 50 points, capped.")

// ─── STABILITY BANDS ──────────────────────────────────────────
m3_gStab = "Stability Bands"

m3_primeLo = input.float(0.85, "Full marks from", step = 0.05, group = m3_gStab, inline = "p")
m3_primeHi = input.float(1.20, "to",              step = 0.05, group = m3_gStab, inline = "p",
     tooltip = "ATR to average ratio within this range scores the full stability points.")

m3_okLo = input.float(0.70, "Half marks from", step = 0.05, group = m3_gStab, inline = "o")
m3_okHi = input.float(1.40, "to",              step = 0.05, group = m3_gStab, inline = "o")

m3_stabFull = input.float(40.0, "Full marks value", step = 5.0, group = m3_gStab, inline = "v")
m3_stabHalf = input.float(20.0, "Half marks value", step = 5.0, group = m3_gStab, inline = "v")
m3_adxCap   = input.float(50.0, "Trend cap",        step = 5.0, group = m3_gStab)

// ─── GRADES ───────────────────────────────────────────────────
m3_gGrade = "Grades"

m3_cutPrime = input.float(70.0, "Prime above",     step = 1.0, group = m3_gGrade)
m3_cutFav   = input.float(55.0, "Favorable above", step = 1.0, group = m3_gGrade)
m3_cutMarg  = input.float(40.0, "Marginal above",  step = 1.0, group = m3_gGrade,
     tooltip = "Anything at or below this reads as degraded.")

m3_colPrime = input.color(#26a269, "Prime",     group = m3_gGrade, inline = "gc1")
m3_colFav   = input.color(#00abff, "Favorable", group = m3_gGrade, inline = "gc1")
m3_colMarg  = input.color(#c9a84c, "Marginal",  group = m3_gGrade, inline = "gc2")
m3_colDeg   = input.color(#f23645, "Degraded",  group = m3_gGrade, inline = "gc2")

// ─── PANEL ────────────────────────────────────────────────────
m3_gPanel = "Panel"

m3_showPanel = input.bool(true, "Show panel", group = m3_gPanel)

m3_pos = input.string("Top right", "Position", options = ["Top right", "Bottom right", "Bottom left", "Top left"], group = m3_gPanel,
     tooltip = "Where the panel sits. When combining several pieces, give each one its own corner so nothing stacks.")

m3_txtSize = input.string("Tiny", "Text size", options = ["Tiny", "Small", "Normal", "Large"], group = m3_gPanel)

m3_stripOn = input.bool(true, "Show score history strip", group = m3_gPanel,
     tooltip = "A coloured cell per recent candle, graded the same way as the score itself. Oldest on the left, current on the right. The strip changes colour before the score crosses a boundary, so quality breaking down is visible early.")

m3_stripLen = input.int(24, "Strip length", minval = 8, maxval = 40, group = m3_gPanel)

m3_bgTint = input.bool(false, "Tint chart background by grade", group = m3_gPanel,
     tooltip = "Shades the whole chart with the grade colour. Effective on a clean chart, heavy once several pieces are stacked.")

m3_bgFade = input.int(94, "Tint transparency", minval = 80, maxval = 99, group = m3_gPanel)

// ─── THEME ────────────────────────────────────────────────────
m3_gTheme = "Theme"

m3_bgPanel  = input.color(#131313, "Panel background", group = m3_gTheme)
m3_bgTitle  = input.color(#c9a84c, "Title",            group = m3_gTheme)
m3_bgLabel  = input.color(#8a877f, "Labels",           group = m3_gTheme)
m3_bgWhite  = input.color(#e8e6e1, "Values",           group = m3_gTheme)
m3_bgBorder = input.color(#1a1d24, "Border",           group = m3_gTheme)

// ─── ENGINE ───────────────────────────────────────────────────
// Lifted from the Cockpit regime scanner so the number reads the
// same in both instruments.

m3_adxOf(int _len) =>
    [_p, _m, _adx] = ta.dmi(_len, _len)
    _adx

m3_atr    = ta.atr(m3_atrLen)
m3_atrAvg = ta.sma(ta.atr(m3_atrLen), m3_avgLen)
m3_adx    = m3_adxOf(m3_adxLen)

m3_ratio = m3_atrAvg > 0 ? m3_atr / m3_atrAvg : 1.0

m3_stablePrime = m3_ratio > m3_primeLo and m3_ratio < m3_primeHi
m3_stableOk    = m3_ratio > m3_okLo    and m3_ratio < m3_okHi

m3_stabScore  = m3_stablePrime ? m3_stabFull : m3_stableOk ? m3_stabHalf : 0.0
m3_trendScore = math.min(m3_adx, m3_adxCap)
m3_score      = m3_stabScore + m3_trendScore
m3_maxScore   = m3_stabFull + m3_adxCap

m3_grade =
     m3_score > m3_cutPrime ? "PRIME" :
     m3_score > m3_cutFav   ? "FAVORABLE" :
     m3_score > m3_cutMarg  ? "MARGINAL" : "DEGRADED"

m3_gradeCol =
     m3_score > m3_cutPrime ? m3_colPrime :
     m3_score > m3_cutFav   ? m3_colFav :
     m3_score > m3_cutMarg  ? m3_colMarg : m3_colDeg

m3_colOfScore(float _s) =>
    _s > m3_cutPrime ? m3_colPrime : _s > m3_cutFav ? m3_colFav : _s > m3_cutMarg ? m3_colMarg : m3_colDeg

// Direction of travel across the strip window.
m3_back  = math.max(1, math.round(m3_stripLen / 2))
m3_drift = m3_score - m3_score[m3_back]
m3_trend = m3_drift > 3 ? "improving" : m3_drift < -3 ? "deteriorating" : "steady"

// How long the current grade has held.
var int m3_held = 0
m3_held := m3_grade == m3_grade[1] ? m3_held + 1 : 0

// Plain language for the stability component.
m3_stabWord = m3_stablePrime ? "aligned" : m3_stableOk ? "drifting" : "dislocated"

// ─── BACKGROUND TINT ──────────────────────────────────────────
bgcolor(m3_bgTint ? color.new(m3_gradeCol, m3_bgFade) : na, title = "Regime tint")

// ─── PANEL ────────────────────────────────────────────────────
m3_sizeOf(_s) =>
    _s == "Tiny" ? size.tiny : _s == "Small" ? size.small : _s == "Normal" ? size.normal : size.large

m3_posOf(_p) =>
    _p == "Top right" ? position.top_right : _p == "Bottom right" ? position.bottom_right : _p == "Bottom left" ? position.bottom_left : position.top_left

var table m3_tbl = na

if barstate.islast and m3_showPanel
    int m3_cols = m3_stripOn ? m3_stripLen : 2
    int m3_rows = m3_stripOn ? 6 : 5
    int m3_last = m3_cols - 1

    if na(m3_tbl)
        m3_tbl := table.new(m3_posOf(m3_pos), m3_cols, m3_rows,
             bgcolor      = m3_bgPanel,
             border_color = m3_bgBorder,
             border_width = 1,
             frame_color  = m3_bgTitle,
             frame_width  = 1)

    table.cell(m3_tbl, 0, 0, " QUANT PRIME — REGIME ",
         text_color = m3_bgTitle, text_size = m3_sizeOf(m3_txtSize), bgcolor = color.rgb(10, 10, 25))

    table.cell(m3_tbl, 0, 1,
         " " + m3_grade + "   " + str.tostring(m3_score, "#") + " / " + str.tostring(m3_maxScore, "#") + " ",
         text_color = m3_gradeCol, text_size = m3_sizeOf(m3_txtSize), bgcolor = m3_bgPanel)

    table.cell(m3_tbl, 0, 2,
         " STABILITY  " + str.tostring(m3_stabScore, "#") + " / " + str.tostring(m3_stabFull, "#") +
         "   " + str.tostring(m3_ratio, "#.##") + "x " + m3_stabWord + " ",
         text_color = m3_stabScore >= m3_stabFull ? m3_bgWhite : m3_stabScore > 0 ? m3_colMarg : m3_colDeg,
         text_size = m3_sizeOf(m3_txtSize), bgcolor = m3_bgPanel)

    table.cell(m3_tbl, 0, 3,
         " TREND      " + str.tostring(m3_trendScore, "#") + " / " + str.tostring(m3_adxCap, "#") +
         "   ADX " + str.tostring(m3_adx, "#.#") + " ",
         text_color = m3_bgWhite, text_size = m3_sizeOf(m3_txtSize), bgcolor = m3_bgPanel)

    table.cell(m3_tbl, 0, 4,
         " " + m3_trend + "  ·  held " + str.tostring(m3_held) + " bars ",
         text_color = m3_bgLabel, text_size = m3_sizeOf(m3_txtSize), bgcolor = m3_bgPanel)

    // Merging is only valid across more than one column.
    if m3_last > 0
        table.merge_cells(m3_tbl, 0, 0, m3_last, 0)
        table.merge_cells(m3_tbl, 0, 1, m3_last, 1)
        table.merge_cells(m3_tbl, 0, 2, m3_last, 2)
        table.merge_cells(m3_tbl, 0, 3, m3_last, 3)
        table.merge_cells(m3_tbl, 0, 4, m3_last, 4)

    // Score history -- oldest on the left, current on the right.
    if m3_stripOn
        for i = 0 to m3_last
            int   _idx = m3_last - i
            float _s   = m3_score[_idx]
            table.cell(m3_tbl, i, 5, "", bgcolor = na(_s) ? m3_bgPanel : m3_colOfScore(_s), width = 1, height = 1)

// ─── ALERTS ───────────────────────────────────────────────────
alertcondition(ta.crossover(m3_score, m3_cutPrime), "Regime turned prime",
     "The regime score has crossed into prime.")

alertcondition(ta.crossunder(m3_score, m3_cutMarg), "Regime degraded",
     "The regime score has dropped into degraded.")

alertcondition(m3_held == 0, "Regime grade changed",
     "The regime grade has changed on this timeframe.")


// ═══════════════════════════════════════════════════════════════
//  QUANT PRIME — BUILD MENU · RECOIL TIER
//  SIDE 1 · CANDLE CLOCK
// ───────────────────────────────────────────────────────────────
//  Nothing else in this menu tells you WHEN. Every other piece
//  reads a candle that has already closed, but a higher timeframe
//  candle spends most of its life unfinished, and what it is
//  going to become is often decided long before it prints.
//
//  For each timeframe this shows two numbers side by side: how
//  far through the candle you are, and how much of its usual
//  range it has already covered. Twenty percent through and
//  eighty percent of the range spent is a candle that is going to
//  matter. Eighty percent through and twenty percent spent is a
//  candle that is not.
//
//  It also counts down. A 3 hour candle that closes in four
//  minutes is about to be finalised, and whatever levels it
//  leaves behind are about to become real.
//
//  Draws one table. Safe to combine with any other Recoil piece.
//  All identifiers namespaced d1_ to avoid collisions.
// ═══════════════════════════════════════════════════════════════


// ─── TIMEFRAMES ───────────────────────────────────────────────
d1_gTf = "Timeframes"

d1_tf1On = input.bool(true, "Timeframe 1", group = d1_gTf, inline = "t1")
d1_tf1   = input.timeframe("3", "", group = d1_gTf, inline = "t1")

d1_tf2On = input.bool(true, "Timeframe 2", group = d1_gTf, inline = "t2")
d1_tf2   = input.timeframe("30", "", group = d1_gTf, inline = "t2")

d1_tf3On = input.bool(true, "Timeframe 3", group = d1_gTf, inline = "t3")
d1_tf3   = input.timeframe("180", "", group = d1_gTf, inline = "t3",
     tooltip = "Each enabled timeframe gets a row. Leave one off to keep the panel compact.")

d1_atrLen = input.int(8, "ATR Length", minval = 1, group = d1_gTf,
     tooltip = "The typical range each candle's progress is measured against, calculated on that timeframe's own data.")

// ─── PACE ─────────────────────────────────────────────────────
d1_gPace = "Pace"

d1_hotGap = input.float(20.0, "Expanding above", minval = 5.0, maxval = 80.0, step = 5.0, group = d1_gPace,
     tooltip = "When range used runs ahead of time elapsed by more than this many points, the candle is covering ground faster than its clock and reads as expanding.")

d1_coldGap = input.float(20.0, "Drifting below", minval = 5.0, maxval = 80.0, step = 5.0, group = d1_gPace,
     tooltip = "When time elapsed runs ahead of range used by more than this, the candle is going nowhere and reads as drifting.")

d1_warnMins = input.float(5.0, "Closing soon (minutes)", minval = 0.0, step = 1.0, group = d1_gPace,
     tooltip = "Highlights a timeframe when its candle is this close to closing. 0 disables it.")

// ─── PANEL ────────────────────────────────────────────────────
d1_gPanel = "Panel"

d1_pos = input.string("Bottom right", "Position", options = ["Top right", "Bottom right", "Bottom left", "Top left"], group = d1_gPanel,
     tooltip = "When combining several pieces, give each one its own corner so nothing stacks.")

d1_txtSize = input.string("Tiny", "Text size", options = ["Tiny", "Small", "Normal", "Large"], group = d1_gPanel)

d1_showBars = input.bool(true, "Show progress bars", group = d1_gPanel,
     tooltip = "Draws each percentage as a small block bar alongside the number, so the two can be compared at a glance.")

// ─── THEME ────────────────────────────────────────────────────
d1_gTheme = "Theme"

d1_bg     = input.color(#131313, "Panel background", group = d1_gTheme)
d1_title  = input.color(#c9a84c, "Title",            group = d1_gTheme)
d1_label  = input.color(#8a877f, "Labels",           group = d1_gTheme)
d1_white  = input.color(#e8e6e1, "Values",           group = d1_gTheme)
d1_border = input.color(#1a1d24, "Border",           group = d1_gTheme)
d1_hotCol = input.color(#ff9800, "Expanding",        group = d1_gTheme, inline = "hc")
d1_coldCol= input.color(#5b9cf6, "Drifting",         group = d1_gTheme, inline = "hc")
d1_warnCol= input.color(#f23645, "Closing soon",     group = d1_gTheme)

// ─── HELPERS ──────────────────────────────────────────────────
d1_tfLabel(string _tf) =>
    string _out = _tf
    float  _n   = str.tonumber(_tf)
    if not na(_n)
        int _m = int(_n)
        _out := _m >= 1440 and _m % 1440 == 0 ? str.tostring(_m / 1440) + "D" :
             _m >= 60 and _m % 60 == 0 ? str.tostring(_m / 60) + "H" :
             str.tostring(_m) + "M"
    _out

// Remaining time as h:mm or m:ss, whichever reads better.
d1_clock(float _ms) =>
    float _s   = math.max(0.0, _ms / 1000.0)
    int   _hh  = int(math.floor(_s / 3600))
    int   _mm  = int(math.floor((_s - _hh * 3600) / 60))
    int   _ss  = int(math.floor(_s - _hh * 3600 - _mm * 60))
    _hh > 0 ? str.tostring(_hh) + "h " + str.tostring(_mm) + "m" : str.tostring(_mm) + ":" + (_ss < 10 ? "0" : "") + str.tostring(_ss)

// A small block bar, ten cells wide.
d1_bar(float _pct) =>
    int _filled = int(math.round(math.min(100.0, math.max(0.0, _pct)) / 10.0))
    string _out = ""
    for i = 1 to 10
        _out := _out + (i <= _filled ? "▊" : "·")
    _out

d1_sizeOf(_s) =>
    _s == "Tiny" ? size.tiny : _s == "Small" ? size.small : _s == "Normal" ? size.normal : size.large

d1_posOf(_p) =>
    _p == "Top right" ? position.top_right : _p == "Bottom right" ? position.bottom_right : _p == "Bottom left" ? position.bottom_left : position.top_left

// ─── HIGHER TIMEFRAME READ ────────────────────────────────────
// The developing candle on each timeframe: when it opened, and
// how much range it has covered so far against its own typical.

d1_read() =>
    [time, high - low, ta.atr(d1_atrLen)]

[d1_t1, d1_r1, d1_a1] = request.security(syminfo.tickerid, d1_tf1, d1_read(), lookahead = barmerge.lookahead_off)
[d1_t2, d1_r2, d1_a2] = request.security(syminfo.tickerid, d1_tf2, d1_read(), lookahead = barmerge.lookahead_off)
[d1_t3, d1_r3, d1_a3] = request.security(syminfo.tickerid, d1_tf3, d1_read(), lookahead = barmerge.lookahead_off)

d1_secs1 = timeframe.in_seconds(d1_tf1) * 1000.0
d1_secs2 = timeframe.in_seconds(d1_tf2) * 1000.0
d1_secs3 = timeframe.in_seconds(d1_tf3) * 1000.0

d1_elapsed1 = timenow - d1_t1
d1_elapsed2 = timenow - d1_t2
d1_elapsed3 = timenow - d1_t3

d1_pctT1 = math.min(100.0, math.max(0.0, d1_elapsed1 / d1_secs1 * 100.0))
d1_pctT2 = math.min(100.0, math.max(0.0, d1_elapsed2 / d1_secs2 * 100.0))
d1_pctT3 = math.min(100.0, math.max(0.0, d1_elapsed3 / d1_secs3 * 100.0))

d1_pctR1 = d1_a1 > 0 ? d1_r1 / d1_a1 * 100.0 : 0.0
d1_pctR2 = d1_a2 > 0 ? d1_r2 / d1_a2 * 100.0 : 0.0
d1_pctR3 = d1_a3 > 0 ? d1_r3 / d1_a3 * 100.0 : 0.0

d1_left1 = d1_secs1 - d1_elapsed1
d1_left2 = d1_secs2 - d1_elapsed2
d1_left3 = d1_secs3 - d1_elapsed3

// ─── PANEL ────────────────────────────────────────────────────
var table d1_tbl = na

d1_paceWord(float _pctT, float _pctR) =>
    _pctR - _pctT > d1_hotGap ? "expanding" : _pctT - _pctR > d1_coldGap ? "drifting" : "steady"

d1_paceCol(float _pctT, float _pctR) =>
    _pctR - _pctT > d1_hotGap ? d1_hotCol : _pctT - _pctR > d1_coldGap ? d1_coldCol : d1_white

d1_row(int _r, bool _on, string _tf, float _pctT, float _pctR, float _left) =>
    if _on
        bool _soon = d1_warnMins > 0 and _left <= d1_warnMins * 60000.0
        table.cell(d1_tbl, 0, _r, " " + d1_tfLabel(_tf) + " ",
             text_color = _soon ? d1_warnCol : d1_white, text_size = d1_sizeOf(d1_txtSize), bgcolor = d1_bg)
        table.cell(d1_tbl, 1, _r, " " + str.tostring(_pctT, "#") + "% " + (d1_showBars ? d1_bar(_pctT) : "") + " ",
             text_color = d1_label, text_size = d1_sizeOf(d1_txtSize), bgcolor = d1_bg)
        table.cell(d1_tbl, 2, _r, " " + str.tostring(_pctR, "#") + "% " + (d1_showBars ? d1_bar(_pctR) : "") + " ",
             text_color = d1_paceCol(_pctT, _pctR), text_size = d1_sizeOf(d1_txtSize), bgcolor = d1_bg)
        table.cell(d1_tbl, 3, _r, " " + d1_paceWord(_pctT, _pctR) + " ",
             text_color = d1_paceCol(_pctT, _pctR), text_size = d1_sizeOf(d1_txtSize), bgcolor = d1_bg)
        table.cell(d1_tbl, 4, _r, " " + d1_clock(_left) + " ",
             text_color = _soon ? d1_warnCol : d1_label, text_size = d1_sizeOf(d1_txtSize), bgcolor = d1_bg)
    true

if barstate.islast
    if na(d1_tbl)
        d1_tbl := table.new(d1_posOf(d1_pos), 5, 5,
             bgcolor      = d1_bg,
             border_color = d1_border,
             border_width = 1,
             frame_color  = d1_title,
             frame_width  = 1)

    table.cell(d1_tbl, 0, 0, " QUANT PRIME — CANDLE CLOCK ",
         text_color = d1_title, text_size = d1_sizeOf(d1_txtSize), bgcolor = color.rgb(10, 10, 25))
    table.merge_cells(d1_tbl, 0, 0, 4, 0)

    table.cell(d1_tbl, 0, 1, " TF ",       text_color = d1_label, text_size = size.tiny, bgcolor = d1_bg)
    table.cell(d1_tbl, 1, 1, " ELAPSED ",  text_color = d1_label, text_size = size.tiny, bgcolor = d1_bg)
    table.cell(d1_tbl, 2, 1, " RANGE ",    text_color = d1_label, text_size = size.tiny, bgcolor = d1_bg)
    table.cell(d1_tbl, 3, 1, " PACE ",     text_color = d1_label, text_size = size.tiny, bgcolor = d1_bg)
    table.cell(d1_tbl, 4, 1, " CLOSES ",   text_color = d1_label, text_size = size.tiny, bgcolor = d1_bg)

    d1_row(2, d1_tf1On, d1_tf1, d1_pctT1, d1_pctR1, d1_left1)
    d1_row(3, d1_tf2On, d1_tf2, d1_pctT2, d1_pctR2, d1_left2)
    d1_row(4, d1_tf3On, d1_tf3, d1_pctT3, d1_pctR3, d1_left3)

// ─── ALERTS ───────────────────────────────────────────────────
d1_anyExpanding = (d1_tf1On and d1_pctR1 - d1_pctT1 > d1_hotGap) or (d1_tf2On and d1_pctR2 - d1_pctT2 > d1_hotGap) or (d1_tf3On and d1_pctR3 - d1_pctT3 > d1_hotGap)

alertcondition(d1_anyExpanding, "Candle expanding",
     "A tracked timeframe is covering range faster than its clock is running.")


// ═══════════════════════════════════════════════════════════════
//  QUANT PRIME — BUILD MENU · RECOIL TIER
//  DESSERT 2 · ZONE REPORT
// ───────────────────────────────────────────────────────────────
//  Volatility Zones draws the quarter, half, three quarter and
//  full marks across the body of every high volatility candle on
//  a higher timeframe. This measures whether they are worth
//  drawing.
//
//  For each level it records three things. How often price came
//  back and reached it at all. How long that took. And what
//  happened afterwards -- how far price travelled back in the
//  direction of the original move once the level was touched,
//  measured as a share of the candle that created it.
//
//  A level that gets reached constantly but produces nothing is a
//  line on a chart. A level that is reached less often but turns
//  price when it is reached is a level. The difference only shows
//  up in the third column.
//
//  A zone that has not been reached within the patience window is
//  counted as a miss rather than left pending, so the reach rate
//  is honest about the ones that never came back.
//
//  Draws one table. Safe to combine with any other Recoil piece.
//  All identifiers namespaced t2_ to avoid collisions.
// ═══════════════════════════════════════════════════════════════


// ─── SOURCE ───────────────────────────────────────────────────
t2_gSrc = "Source"

t2_tf = input.timeframe("30", "Timeframe", group = t2_gSrc,
     tooltip = "Which higher timeframe's candles generate the zones. One layer at a time -- run it again on another timeframe to compare.")

t2_atrLen = input.int(8, "ATR Length", minval = 1, group = t2_gSrc)

t2_trigBand = input.int(6, "Trigger from band # upward", minval = 6, maxval = 8, group = t2_gSrc,
     tooltip = "A candle closing in this band or above generates a set of zones.")

t2_minBodyAtr = input.float(0.5, "Min Body Size (x ATR)", minval = 0.0, step = 0.05, group = t2_gSrc,
     tooltip = "The candle's body must clear this to qualify. Set to 0 to disable.")

// ─── ZONE MARKS ───────────────────────────────────────────────
t2_gMarks = "Zone Marks"

t2_z1a = input.float(24.0,  "Quarter from",       step = 1.0, group = t2_gMarks, inline = "z1")
t2_z1b = input.float(26.0,  "to",                 step = 1.0, group = t2_gMarks, inline = "z1")
t2_z2a = input.float(48.0,  "Half from",          step = 1.0, group = t2_gMarks, inline = "z2")
t2_z2b = input.float(52.0,  "to",                 step = 1.0, group = t2_gMarks, inline = "z2")
t2_z3a = input.float(74.0,  "Three quarter from", step = 1.0, group = t2_gMarks, inline = "z3")
t2_z3b = input.float(76.0,  "to",                 step = 1.0, group = t2_gMarks, inline = "z3")
t2_z4a = input.float(97.0,  "Full from",          step = 1.0, group = t2_gMarks, inline = "z4")
t2_z4b = input.float(100.0, "to",                 step = 1.0, group = t2_gMarks, inline = "z4")

// ─── MEASUREMENT ──────────────────────────────────────────────
t2_gMeas = "Measurement"

t2_patience = input.int(200, "Patience (chart bars)", minval = 10, maxval = 2000, group = t2_gMeas,
     tooltip = "How long a zone is given to be reached before it is counted as never reached. Too short flatters the reach rate by discarding slow ones; too long leaves everything pending.")

t2_reactBars = input.int(20, "Measure reaction over N bars", minval = 1, maxval = 200, group = t2_gMeas,
     tooltip = "How long after a zone is reached the reaction is measured. The reaction is how far price travels back in the direction of the original move.")

t2_reactMark = input.float(25.0, "Reaction counts above (% of body)", minval = 1.0, maxval = 200.0, step = 5.0, group = t2_gMeas,
     tooltip = "A reaction this large or greater counts as the level having done something. Measured against the body of the candle that created the zone, the same span the zones themselves are drawn across.")

t2_maxTrack = input.int(400, "Maximum zones tracked at once", minval = 20, maxval = 1000, group = t2_gMeas)

// ─── GRADING ──────────────────────────────────────────────────
t2_gGrade = "Grading"

t2_goodPct = input.float(50.0, "Strong above", minval = 0.0, maxval = 100.0, step = 5.0, group = t2_gGrade)
t2_badPct  = input.float(25.0, "Weak below",   minval = 0.0, maxval = 100.0, step = 5.0, group = t2_gGrade)
t2_minN    = input.int(30, "Minimum sample to grade", minval = 1, maxval = 200, group = t2_gGrade,
     tooltip = "Levels with fewer completed zones than this stay neutral and are marked with an asterisk.")

// ─── PANEL ────────────────────────────────────────────────────
t2_gPanel = "Panel"

t2_pos = input.string("Bottom left", "Position", options = ["Top right", "Bottom right", "Bottom left", "Top left"], group = t2_gPanel)
t2_txtSize = input.string("Tiny", "Text size", options = ["Tiny", "Small", "Normal", "Large"], group = t2_gPanel)

// ─── THEME ────────────────────────────────────────────────────
t2_gTheme = "Theme"

t2_bg     = input.color(#131313, "Panel background", group = t2_gTheme)
t2_title  = input.color(#c9a84c, "Title",            group = t2_gTheme)
t2_label  = input.color(#8a877f, "Labels",           group = t2_gTheme)
t2_white  = input.color(#e8e6e1, "Values",           group = t2_gTheme)
t2_border = input.color(#1a1d24, "Border",           group = t2_gTheme)
t2_good   = input.color(#26a269, "Strong", group = t2_gTheme, inline = "gr")
t2_bad    = input.color(#f23645, "Weak",   group = t2_gTheme, inline = "gr")

// ─── HIGHER TIMEFRAME READ ────────────────────────────────────
t2_htf() =>
    float _atr   = ta.atr(t2_atrLen)
    float _ratio = ta.tr(true) / _atr
    int   _raw   = _ratio < 0.30 ? 1 : _ratio < 0.75 ? 2 : _ratio < 1.20 ? 3 : _ratio < 1.65 ? 4 : _ratio < 2.10 ? 5 : _ratio < 2.55 ? 6 : _ratio < 3.00 ? 7 : 8
    float _body  = math.abs(close - open)
    float _minB  = math.max(syminfo.mintick, _atr * t2_minBodyAtr)
    int   _band  = _raw >= 6 and (t2_minBodyAtr > 0 and _body <= _minB) ? 5 : _raw
    [_band[1], high[1], low[1], open[1], close[1], time[1]]

[t2_band, t2_hi, t2_lo, t2_op, t2_cl, t2_t] = request.security(syminfo.tickerid, t2_tf, t2_htf(), lookahead = barmerge.lookahead_off)

// ─── ZONE TRACKING ────────────────────────────────────────────
type T2Zone
    int   lvl
    float top
    float bot
    bool  bear
    float srcRange
    int   bornBar
    bool  tapped
    int   tapBar
    float tapPx
    float ext

var T2Zone[] t2_live = array.new<T2Zone>()

// Completed measurements, one accumulator per level.
var int[]   t2_n     = array.new<int>(5, 0)
var int[]   t2_hit   = array.new<int>(5, 0)
var int[]   t2_bars  = array.new<int>(5, 0)
var float[] t2_react = array.new<float>(5, 0.0)
var int[]   t2_reactN = array.new<int>(5, 0)
var int[]   t2_worked = array.new<int>(5, 0)

t2_addZone(int _lvl, float _pa, float _pb, float _anchorPx, float _span, int _dir, bool _bear, float _srcRange) =>
    if _span > 0
        float _p1 = _anchorPx + _dir * _span * _pa / 100.0
        float _p2 = _anchorPx + _dir * _span * _pb / 100.0
        array.push(t2_live, T2Zone.new(_lvl, math.max(_p1, _p2), math.min(_p1, _p2),
             _bear, _srcRange, bar_index, false, na, na, na))

// ─── ENGINE ───────────────────────────────────────────────────
t2_newHtf = ta.change(t2_t) != 0

if barstate.isconfirmed

    // --- advance every tracked zone ---
    int _n = array.size(t2_live)
    if _n > 0
        for i = _n - 1 to 0
            T2Zone z = array.get(t2_live, i)
            bool _finish = false

            if not z.tapped
                if high >= z.bot and low <= z.top
                    z.tapped := true
                    z.tapBar := bar_index
                    // Price arrives at the near edge of the zone.
                    z.tapPx  := z.bear ? z.bot : z.top
                    z.ext    := z.tapPx
                else if bar_index - z.bornBar >= t2_patience
                    // Never came back. Counts as a miss.
                    array.set(t2_n, z.lvl, array.get(t2_n, z.lvl) + 1)
                    _finish := true
            else
                // Reaction is travel back in the direction the
                // original candle was moving.
                z.ext := z.bear ? math.min(z.ext, low) : math.max(z.ext, high)

                if bar_index - z.tapBar >= t2_reactBars
                    float _move = z.bear ? z.tapPx - z.ext : z.ext - z.tapPx
                    float _pct  = z.srcRange > 0 ? _move / z.srcRange * 100.0 : 0.0

                    array.set(t2_n,      z.lvl, array.get(t2_n, z.lvl) + 1)
                    array.set(t2_hit,    z.lvl, array.get(t2_hit, z.lvl) + 1)
                    array.set(t2_bars,   z.lvl, array.get(t2_bars, z.lvl) + (z.tapBar - z.bornBar))
                    array.set(t2_react,  z.lvl, array.get(t2_react, z.lvl) + _pct)
                    array.set(t2_reactN, z.lvl, array.get(t2_reactN, z.lvl) + 1)
                    if _pct >= t2_reactMark
                        array.set(t2_worked, z.lvl, array.get(t2_worked, z.lvl) + 1)
                    _finish := true

            if _finish
                array.remove(t2_live, i)

    // --- a qualifying higher timeframe candle just closed ---
    if t2_newHtf and t2_band >= t2_trigBand
        // Matches Volatility Zones exactly: the body, measured back
        // from where the move finished.
        bool  _bull   = t2_cl >= t2_op
        float _anchor = t2_cl
        float _far    = t2_op
        float _span   = math.abs(_far - _anchor)
        int   _dir    = _far >= _anchor ? 1 : -1
        float _range  = _span

        t2_addZone(1, t2_z1a, t2_z1b, _anchor, _span, _dir, not _bull, _range)
        t2_addZone(2, t2_z2a, t2_z2b, _anchor, _span, _dir, not _bull, _range)
        t2_addZone(3, t2_z3a, t2_z3b, _anchor, _span, _dir, not _bull, _range)
        t2_addZone(4, t2_z4a, t2_z4b, _anchor, _span, _dir, not _bull, _range)

        while array.size(t2_live) > t2_maxTrack
            array.shift(t2_live)

// ─── PANEL ────────────────────────────────────────────────────
t2_sizeOf(_s) =>
    _s == "Tiny" ? size.tiny : _s == "Small" ? size.small : _s == "Normal" ? size.normal : size.large

t2_posOf(_p) =>
    _p == "Top right" ? position.top_right : _p == "Bottom right" ? position.bottom_right : _p == "Bottom left" ? position.bottom_left : position.top_left

t2_gradeOf(float _pct, int _n) =>
    _n < t2_minN ? t2_label : _pct >= t2_goodPct ? t2_good : _pct < t2_badPct ? t2_bad : t2_white

t2_lvlName(int _l) =>
    _l == 1 ? "25%" : _l == 2 ? "50%" : _l == 3 ? "75%" : "100%"

t2_tfLabel(string _tf) =>
    string _out = _tf
    float  _n2  = str.tonumber(_tf)
    if not na(_n2)
        int _m = int(_n2)
        _out := _m >= 1440 and _m % 1440 == 0 ? str.tostring(_m / 1440) + "D" :
             _m >= 60 and _m % 60 == 0 ? str.tostring(_m / 60) + "H" :
             str.tostring(_m) + "M"
    _out

var table t2_tbl = na

if barstate.islast
    if na(t2_tbl)
        t2_tbl := table.new(t2_posOf(t2_pos), 6, 7,
             bgcolor      = t2_bg,
             border_color = t2_border,
             border_width = 1,
             frame_color  = t2_title,
             frame_width  = 1)

    table.cell(t2_tbl, 0, 0, " QUANT PRIME — ZONE REPORT ",
         text_color = t2_title, text_size = t2_sizeOf(t2_txtSize), bgcolor = color.rgb(10, 10, 25))
    table.merge_cells(t2_tbl, 0, 0, 5, 0)

    table.cell(t2_tbl, 0, 1, " ZONE ",    text_color = t2_label, text_size = size.tiny, bgcolor = t2_bg)
    table.cell(t2_tbl, 1, 1, " N ",       text_color = t2_label, text_size = size.tiny, bgcolor = t2_bg)
    table.cell(t2_tbl, 2, 1, " REACHED ", text_color = t2_label, text_size = size.tiny, bgcolor = t2_bg)
    table.cell(t2_tbl, 3, 1, " BARS ",    text_color = t2_label, text_size = size.tiny, bgcolor = t2_bg)
    table.cell(t2_tbl, 4, 1, " REACT ",   text_color = t2_label, text_size = size.tiny, bgcolor = t2_bg)
    table.cell(t2_tbl, 5, 1, " ≥" + str.tostring(t2_reactMark, "#") + "% ", text_color = t2_label, text_size = size.tiny, bgcolor = t2_bg)

    for l = 1 to 4
        int   _c   = array.get(t2_n, l)
        int   _h   = array.get(t2_hit, l)
        int   _rn  = array.get(t2_reactN, l)
        float _rch = _c > 0 ? _h / _c * 100.0 : 0.0
        float _bar = _h > 0 ? array.get(t2_bars, l) / _h : 0.0
        float _rct = _rn > 0 ? array.get(t2_react, l) / _rn : 0.0
        float _wk  = _rn > 0 ? array.get(t2_worked, l) / _rn * 100.0 : 0.0

        table.cell(t2_tbl, 0, l + 1, " " + t2_lvlName(l) + " ",
             text_color = t2_white, text_size = t2_sizeOf(t2_txtSize), bgcolor = t2_bg)
        table.cell(t2_tbl, 1, l + 1, " " + str.tostring(_c) + (_c > 0 and _c < t2_minN ? "*" : "") + " ",
             text_color = _c >= t2_minN ? t2_white : t2_label, text_size = t2_sizeOf(t2_txtSize), bgcolor = t2_bg)
        table.cell(t2_tbl, 2, l + 1, " " + (_c > 0 ? str.tostring(_rch, "#") + "%" : "—") + " ",
             text_color = _c > 0 ? t2_gradeOf(_rch, _c) : t2_label, text_size = t2_sizeOf(t2_txtSize), bgcolor = t2_bg)
        table.cell(t2_tbl, 3, l + 1, " " + (_h > 0 ? str.tostring(_bar, "#") : "—") + " ",
             text_color = t2_label, text_size = t2_sizeOf(t2_txtSize), bgcolor = t2_bg)
        table.cell(t2_tbl, 4, l + 1, " " + (_rn > 0 ? str.tostring(_rct, "#") + "%" : "—") + " ",
             text_color = _rn > 0 ? t2_white : t2_label, text_size = t2_sizeOf(t2_txtSize), bgcolor = t2_bg)
        table.cell(t2_tbl, 5, l + 1, " " + (_rn > 0 ? str.tostring(_wk, "#") + "%" : "—") + " ",
             text_color = _rn > 0 ? t2_gradeOf(_wk, _rn) : t2_label, text_size = t2_sizeOf(t2_txtSize), bgcolor = t2_bg)

    table.cell(t2_tbl, 0, 6,
         " " + t2_tfLabel(t2_tf) + " zones  ·  " + str.tostring(array.size(t2_live)) + " still open  ·  " +
         str.tostring(t2_reactBars) + " bar reaction  ·  * too few to grade ",
         text_color = t2_label, text_size = size.tiny, bgcolor = t2_bg, text_formatting = text.format_italic)
    table.merge_cells(t2_tbl, 0, 6, 5, 6)


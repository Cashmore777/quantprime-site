//@version=6
// =============================================================
//  QUANT PRIME — RECOIL BUILD  ·  REC-1000
// -------------------------------------------------------------
//  Volatility Bands
//
//  Generated from the Recoil Build menu. Each piece keeps its
//  own settings group and its own namespace, so nothing here
//  interferes with anything else. Remove a piece by rebuilding
//  from the menu rather than editing this file.
// =============================================================

indicator("QP · Recoil 1000", shorttitle = "REC-1000", overlay = true, max_labels_count = 500)

// ═══════════════════════════════════════════════════════════════
//  QUANT PRIME — BUILD MENU · RECOIL TIER
//  STARTER 1 · VOLATILITY BANDS
// ───────────────────────────────────────────────────────────────
//  Every candle's TRUE range -- its full high-to-low movement,
//  including any gap from the prior close -- is divided by
//  ATR(length). The result answers one question: how big is this
//  candle compared to a normal recent candle? 1.0x is exactly
//  average. 3.0x is three times the recent norm.
//
//  That ratio places the candle in one of eight bands:
//
//    1  Extremely Low     5  Medium
//    2  Very Low          6  High Medium
//    3  Low               7  High
//    4  Lower Medium      8  Very High
//
//  ATR Length is the MEMORY of the baseline. Shorter (5) adapts
//  fast and measures abnormal against the last few minutes.
//  Longer (21) is slow, so a volatility burst keeps reading as
//  extreme for longer. The default of 8 is deliberately
//  responsive, suited to a short-timeframe context.
//
//  A wide candle built from wicks is a rejection, not an
//  expansion, and its body is too small to measure anything
//  useful against. The minimum body filter removes those from the
//  high bands entirely so only workable expansions are shown.
//
//  Draws no table. Safe to combine with any other Recoil piece.
//  All identifiers namespaced s1_ to avoid collisions.
// ═══════════════════════════════════════════════════════════════


// ─── VOLATILITY ───────────────────────────────────────────────
s1_gVol = "Volatility"

s1_atrLen = input.int(8, "ATR Length", minval = 1, group = s1_gVol,
     tooltip = "The averaging period used as the volatility baseline. Shorter values adapt faster; longer values keep a burst reading as extreme for longer.")

s1_t1 = input.float(0.30, "Threshold 1 (Extremely Low → Very Low)",  step = 0.05, group = s1_gVol)
s1_t2 = input.float(0.75, "Threshold 2 (Very Low → Low)",            step = 0.05, group = s1_gVol)
s1_t3 = input.float(1.20, "Threshold 3 (Low → Lower Medium)",        step = 0.05, group = s1_gVol)
s1_t4 = input.float(1.65, "Threshold 4 (Lower Medium → Medium)",     step = 0.05, group = s1_gVol)
s1_t5 = input.float(2.10, "Threshold 5 (Medium → High Medium)",      step = 0.05, group = s1_gVol)
s1_t6 = input.float(2.55, "Threshold 6 (High Medium → High)",        step = 0.05, group = s1_gVol)
s1_t7 = input.float(3.00, "Threshold 7 (High → Very High)",          step = 0.05, group = s1_gVol)

s1_minBodyAtr = input.float(0.5, "Min Body Size (x ATR)", minval = 0.0, step = 0.05, group = s1_gVol,
     tooltip = "A candle's body (open-to-close) must be at least this many ATRs to qualify for a high band. Candles that fail are filtered out of bands 6-8 and shown as Medium instead. Set to 0 to disable the filter.")

s1_tagFrom = input.int(6, "Show Tag From Band # Upward", minval = 1, maxval = 8, group = s1_gVol,
     tooltip = "The small '#.##x' text tag only appears on candles whose volatility band is this number or higher (1 = Extremely Low ... 8 = Very High). Default 6 tags only the high bands.")

// ─── COLOURS ──────────────────────────────────────────────────
s1_gCol = "Volatility — Colors"

s1_c1 = input.color(#bbd9fb, "Extremely Low", group = s1_gCol)
s1_c2 = input.color(#90bff9, "Very Low",      group = s1_gCol)
s1_c3 = input.color(#5b9cf6, "Low",           group = s1_gCol)
s1_c4 = input.color(#3179f5, "Lower Medium",  group = s1_gCol)
s1_c5 = input.color(#1848cc, "Medium",        group = s1_gCol)
s1_c6 = input.color(#ffeb3b, "High Medium",   group = s1_gCol)
s1_c7 = input.color(#ff9800, "High",          group = s1_gCol)
s1_c8 = input.color(#f23645, "Very High",     group = s1_gCol)

// ─── DISPLAY ──────────────────────────────────────────────────
s1_gDisp = "Display"

s1_colorCandles = input.bool(true,  "Color Candles By Volatility", group = s1_gDisp)
s1_showTag      = input.bool(false, "Show Volatility Tag",         group = s1_gDisp)
s1_tagTextColor = input.color(color.white, "Tag Text Color",       group = s1_gDisp)

s1_highOnly = input.bool(false, "Color High Bands Only", group = s1_gDisp,
     tooltip = "Leaves bands 1-5 as your chart's normal candle colors and highlights bands 6, 7 and 8 alone.")

// ─── ENGINE ───────────────────────────────────────────────────
// Band classification is lifted verbatim from Quant Prime Recoil,
// so a band 7 candle here is a candle Recoil reads as band 7.
// M2, M3, T1 and T2 reuse this identical block.

s1_trueRange = ta.tr(true)
s1_atr       = ta.atr(s1_atrLen)
s1_ratio     = s1_trueRange / s1_atr

s1_rawBand =
     s1_ratio < s1_t1 ? 1 :
     s1_ratio < s1_t2 ? 2 :
     s1_ratio < s1_t3 ? 3 :
     s1_ratio < s1_t4 ? 4 :
     s1_ratio < s1_t5 ? 5 :
     s1_ratio < s1_t6 ? 6 :
     s1_ratio < s1_t7 ? 7 : 8

// Minimum body filter -- a high band candle whose body is too
// small to be workable is dropped out of the high bands.
s1_body    = math.abs(close - open)
s1_minBody = math.max(syminfo.mintick, s1_atr * s1_minBodyAtr)
s1_bodyOk  = s1_minBodyAtr <= 0 or s1_body > s1_minBody

s1_band = s1_rawBand >= 6 and not s1_bodyOk ? 5 : s1_rawBand

s1_color =
     s1_band == 1 ? s1_c1 :
     s1_band == 2 ? s1_c2 :
     s1_band == 3 ? s1_c3 :
     s1_band == 4 ? s1_c4 :
     s1_band == 5 ? s1_c5 :
     s1_band == 6 ? s1_c6 :
     s1_band == 7 ? s1_c7 : s1_c8

s1_isHigh  = s1_band >= 6
s1_notable = s1_band >= s1_tagFrom

// ─── RENDER ───────────────────────────────────────────────────
s1_paint = s1_colorCandles and (not s1_highOnly or s1_isHigh)
barcolor(s1_paint ? s1_color : na, title = "Volatility Color")

// Tag rendering: confirmed bars get a permanent label, the live
// bar gets a single label that is replaced each tick.
var label s1_liveLabel = na
label.delete(s1_liveLabel)

if s1_showTag
    if barstate.isconfirmed
        if s1_notable
            label.new(bar_index, high,
                 text      = str.tostring(s1_ratio, "#.##") + "x",
                 style     = label.style_label_down,
                 color     = s1_color,
                 textcolor = s1_tagTextColor,
                 size      = size.small,
                 yloc      = yloc.abovebar)
        label.delete(s1_liveLabel)
        s1_liveLabel := na
    else if barstate.islast and s1_notable
        label.delete(s1_liveLabel)
        s1_liveLabel := label.new(bar_index, high,
             text      = str.tostring(s1_ratio, "#.##") + "x",
             style     = label.style_label_down,
             color     = s1_color,
             textcolor = s1_tagTextColor,
             size      = size.small,
             yloc      = yloc.abovebar)

// ─── ALERTS ───────────────────────────────────────────────────
alertcondition(s1_band >= 6 and s1_band[1] < 6, "Volatility expansion",
     "A candle has closed in a high volatility band (6, 7 or 8).")

alertcondition(s1_band == 8, "Band 8 candle",
     "A candle has closed in band 8 -- the most extended condition this instrument produces.")


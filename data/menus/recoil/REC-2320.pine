//@version=6
// =============================================================
//  QUANT PRIME — RECOIL BUILD  ·  REC-2320
// -------------------------------------------------------------
//  ATR Envelope + Regime Tracker + Position Sizer
//
//  Generated from the Recoil Build menu. Each piece keeps its
//  own settings group and its own namespace, so nothing here
//  interferes with anything else. Remove a piece by rebuilding
//  from the menu rather than editing this file.
// =============================================================

indicator("QP · Recoil 2320", shorttitle = "REC-2320", overlay = true, max_labels_count = 100)

// ═══════════════════════════════════════════════════════════════
//  QUANT PRIME — BUILD MENU · RECOIL TIER
//  STARTER 2 · ATR ENVELOPE
// ───────────────────────────────────────────────────────────────
//  Three pairs of rails set at fixed ATR distances either side of
//  a moving anchor. They answer a different question to the
//  volatility bands: those measure how big THIS candle is, these
//  measure how far price has TRAVELLED from equilibrium.
//
//  A candle can be perfectly ordinary and still sit three ATRs
//  from the anchor after a long grind. Equally a single band 8
//  candle can leave price barely stretched at all if it started
//  on the far side. Reading both together is the point.
//
//  Rails escalate in colour the same way the volatility bands do:
//  blue is normal, yellow is stretched, red is extended.
//
//  Draws no table. Safe to combine with any other Recoil piece.
//  All identifiers namespaced s2_ to avoid collisions.
// ═══════════════════════════════════════════════════════════════


// ─── ANCHOR ───────────────────────────────────────────────────
s2_gAnchor = "Anchor"

s2_anchorType = input.string("EMA", "Anchor type", options = ["EMA", "SMA"], group = s2_gAnchor,
     tooltip = "The centre line the rails are measured from. EMA reacts faster to recent price; SMA gives a steadier centre.")

s2_anchorLen = input.int(26, "Anchor length", minval = 1, group = s2_gAnchor,
     tooltip = "Shorter anchors hug price, so the rails only flag sharp moves. Longer anchors stay put, so a slow grind away from value still registers as stretched.")

s2_showAnchor = input.bool(true, "Show anchor line", group = s2_gAnchor)
s2_anchorCol  = input.color(#8a877f, "Anchor color", group = s2_gAnchor)

// ─── ATR ──────────────────────────────────────────────────────
s2_gAtr = "ATR"

s2_atrLen = input.int(8, "ATR Length", minval = 1, group = s2_gAtr,
     tooltip = "Matches the Recoil default so rail distances stay consistent with the volatility band readings.")

// ─── RAILS ────────────────────────────────────────────────────
s2_gRails = "Rails"

s2_r1On   = input.bool(true, "Rail 1", group = s2_gRails, inline = "r1")
s2_r1Mult = input.float(1.0, "x ATR", minval = 0.1, step = 0.25, group = s2_gRails, inline = "r1")
s2_r1Col  = input.color(#3179f5, "", group = s2_gRails, inline = "r1")

s2_r2On   = input.bool(true, "Rail 2", group = s2_gRails, inline = "r2")
s2_r2Mult = input.float(2.0, "x ATR", minval = 0.1, step = 0.25, group = s2_gRails, inline = "r2")
s2_r2Col  = input.color(#ffeb3b, "", group = s2_gRails, inline = "r2")

s2_r3On   = input.bool(true, "Rail 3", group = s2_gRails, inline = "r3")
s2_r3Mult = input.float(3.0, "x ATR", minval = 0.1, step = 0.25, group = s2_gRails, inline = "r3")
s2_r3Col  = input.color(#f23645, "", group = s2_gRails, inline = "r3")

s2_width = input.int(1, "Line width", minval = 1, maxval = 4, group = s2_gRails)

s2_fill = input.bool(false, "Shade between rails", group = s2_gRails,
     tooltip = "Fills the space between the rails at low opacity. Useful for reading stretch at a glance, busier on a dense chart.")

s2_fillOp = input.int(94, "Shade transparency", minval = 70, maxval = 99, group = s2_gRails)

// ─── STRETCH READOUT ──────────────────────────────────────────
s2_gRead = "Stretch Readout"

s2_showRead = input.bool(true, "Show stretch label on last bar", group = s2_gRead,
     tooltip = "A single label at the current bar showing how many ATRs price sits from the anchor, and which side.")

s2_readSize = input.string("Tiny", "Label size", options = ["Tiny", "Small", "Normal"], group = s2_gRead)

// ─── ENGINE ───────────────────────────────────────────────────
s2_atr    = ta.atr(s2_atrLen)
s2_anchor = s2_anchorType == "EMA" ? ta.ema(close, s2_anchorLen) : ta.sma(close, s2_anchorLen)

s2_u1 = s2_anchor + s2_atr * s2_r1Mult
s2_l1 = s2_anchor - s2_atr * s2_r1Mult
s2_u2 = s2_anchor + s2_atr * s2_r2Mult
s2_l2 = s2_anchor - s2_atr * s2_r2Mult
s2_u3 = s2_anchor + s2_atr * s2_r3Mult
s2_l3 = s2_anchor - s2_atr * s2_r3Mult

// How far price sits from the anchor, expressed in ATRs.
s2_stretch = s2_atr > 0 ? (close - s2_anchor) / s2_atr : 0.0
s2_absStr  = math.abs(s2_stretch)

s2_zoneCol = s2_absStr >= s2_r3Mult ? s2_r3Col : s2_absStr >= s2_r2Mult ? s2_r2Col : s2_absStr >= s2_r1Mult ? s2_r1Col : s2_anchorCol

// ─── RENDER ───────────────────────────────────────────────────
s2_pAnchor = plot(s2_showAnchor ? s2_anchor : na, title = "Anchor", color = s2_anchorCol, linewidth = 1)

s2_pU1 = plot(s2_r1On ? s2_u1 : na, title = "Rail 1 upper", color = s2_r1Col, linewidth = s2_width)
s2_pL1 = plot(s2_r1On ? s2_l1 : na, title = "Rail 1 lower", color = s2_r1Col, linewidth = s2_width)
s2_pU2 = plot(s2_r2On ? s2_u2 : na, title = "Rail 2 upper", color = s2_r2Col, linewidth = s2_width)
s2_pL2 = plot(s2_r2On ? s2_l2 : na, title = "Rail 2 lower", color = s2_r2Col, linewidth = s2_width)
s2_pU3 = plot(s2_r3On ? s2_u3 : na, title = "Rail 3 upper", color = s2_r3Col, linewidth = s2_width)
s2_pL3 = plot(s2_r3On ? s2_l3 : na, title = "Rail 3 lower", color = s2_r3Col, linewidth = s2_width)

fill(s2_pU1, s2_pU2, color = s2_fill ? color.new(s2_r2Col, s2_fillOp) : na, title = "Upper 1 to 2")
fill(s2_pU2, s2_pU3, color = s2_fill ? color.new(s2_r3Col, s2_fillOp) : na, title = "Upper 2 to 3")
fill(s2_pL2, s2_pL1, color = s2_fill ? color.new(s2_r2Col, s2_fillOp) : na, title = "Lower 1 to 2")
fill(s2_pL3, s2_pL2, color = s2_fill ? color.new(s2_r3Col, s2_fillOp) : na, title = "Lower 2 to 3")

s2_sizeOf(_s) =>
    _s == "Tiny" ? size.tiny : _s == "Small" ? size.small : size.normal

var label s2_readLbl = na

if barstate.islast and s2_showRead
    label.delete(s2_readLbl)
    string s2_side = s2_stretch > 0 ? "above" : s2_stretch < 0 ? "below" : "at"
    s2_readLbl := label.new(bar_index, close,
         text      = str.tostring(s2_absStr, "#.##") + " ATR " + s2_side,
         style     = label.style_label_left,
         color     = color.new(color.black, 15),
         textcolor = s2_zoneCol,
         size      = s2_sizeOf(s2_readSize))

// ─── ALERTS ───────────────────────────────────────────────────
alertcondition(ta.crossover(close, s2_u3), "Stretched above outer rail",
     "Price has closed beyond the outer ATR rail on the upside.")

alertcondition(ta.crossunder(close, s2_l3), "Stretched below outer rail",
     "Price has closed beyond the outer ATR rail on the downside.")

alertcondition(ta.crossover(s2_absStr, s2_r2Mult), "Stretch exceeded rail 2",
     "Price has moved beyond the middle ATR rail from the anchor.")


// ═══════════════════════════════════════════════════════════════
//  QUANT PRIME — BUILD MENU · RECOIL TIER
//  MAIN 3 · REGIME TRACKER
// ───────────────────────────────────────────────────────────────
//  The regime score grades the market's quality out of 90, built
//  from two components:
//
//    STABILITY (0-40)  Current ATR against its own 50 period
//                      average. Scores 40 when the two sit close
//                      together, 20 when loosely aligned, 0 when
//                      they diverge.
//    TREND     (0-50)  ADX, capped at 50.
//
//  Note what stability rewards. It is not measuring how much the
//  market is moving, it is measuring whether it is moving the way
//  it has recently been moving. A run of expansion candles pushes
//  ATR away from its average and drags the score DOWN. High
//  volatility and a high regime score are different things, and a
//  fade taken in a degraded regime is a different trade to the
//  same fade taken in a prime one.
//
//  Identical scoring to the Cockpit regime scanner, so a score
//  read here is the same number Cockpit shows for this timeframe.
//  Cockpit reads five timeframes at once; this reads the chart
//  you are on, and keeps its recent history.
//
//  Draws one table. Safe to combine with any other Recoil piece.
//  All identifiers namespaced m3_ to avoid collisions.
// ═══════════════════════════════════════════════════════════════


// ─── SCORING ──────────────────────────────────────────────────
m3_gScore = "Scoring"

m3_atrLen = input.int(14, "ATR length", minval = 1, group = m3_gScore,
     tooltip = "The current volatility reading. Matches the Cockpit regime scanner.")

m3_avgLen = input.int(50, "ATR average length", minval = 2, group = m3_gScore,
     tooltip = "The baseline the current ATR is compared against. Their ratio drives the stability component.")

m3_adxLen = input.int(14, "ADX length", minval = 1, group = m3_gScore,
     tooltip = "The trend strength reading. Contributes up to 50 points, capped.")

// ─── STABILITY BANDS ──────────────────────────────────────────
m3_gStab = "Stability Bands"

m3_primeLo = input.float(0.85, "Full marks from", step = 0.05, group = m3_gStab, inline = "p")
m3_primeHi = input.float(1.20, "to",              step = 0.05, group = m3_gStab, inline = "p",
     tooltip = "ATR to average ratio within this range scores the full stability points.")

m3_okLo = input.float(0.70, "Half marks from", step = 0.05, group = m3_gStab, inline = "o")
m3_okHi = input.float(1.40, "to",              step = 0.05, group = m3_gStab, inline = "o")

m3_stabFull = input.float(40.0, "Full marks value", step = 5.0, group = m3_gStab, inline = "v")
m3_stabHalf = input.float(20.0, "Half marks value", step = 5.0, group = m3_gStab, inline = "v")
m3_adxCap   = input.float(50.0, "Trend cap",        step = 5.0, group = m3_gStab)

// ─── GRADES ───────────────────────────────────────────────────
m3_gGrade = "Grades"

m3_cutPrime = input.float(70.0, "Prime above",     step = 1.0, group = m3_gGrade)
m3_cutFav   = input.float(55.0, "Favorable above", step = 1.0, group = m3_gGrade)
m3_cutMarg  = input.float(40.0, "Marginal above",  step = 1.0, group = m3_gGrade,
     tooltip = "Anything at or below this reads as degraded.")

m3_colPrime = input.color(#26a269, "Prime",     group = m3_gGrade, inline = "gc1")
m3_colFav   = input.color(#00abff, "Favorable", group = m3_gGrade, inline = "gc1")
m3_colMarg  = input.color(#c9a84c, "Marginal",  group = m3_gGrade, inline = "gc2")
m3_colDeg   = input.color(#f23645, "Degraded",  group = m3_gGrade, inline = "gc2")

// ─── PANEL ────────────────────────────────────────────────────
m3_gPanel = "Panel"

m3_showPanel = input.bool(true, "Show panel", group = m3_gPanel)

m3_pos = input.string("Top right", "Position", options = ["Top right", "Bottom right", "Bottom left", "Top left"], group = m3_gPanel,
     tooltip = "Where the panel sits. When combining several pieces, give each one its own corner so nothing stacks.")

m3_txtSize = input.string("Tiny", "Text size", options = ["Tiny", "Small", "Normal", "Large"], group = m3_gPanel)

m3_stripOn = input.bool(true, "Show score history strip", group = m3_gPanel,
     tooltip = "A coloured cell per recent candle, graded the same way as the score itself. Oldest on the left, current on the right. The strip changes colour before the score crosses a boundary, so quality breaking down is visible early.")

m3_stripLen = input.int(24, "Strip length", minval = 8, maxval = 40, group = m3_gPanel)

m3_bgTint = input.bool(false, "Tint chart background by grade", group = m3_gPanel,
     tooltip = "Shades the whole chart with the grade colour. Effective on a clean chart, heavy once several pieces are stacked.")

m3_bgFade = input.int(94, "Tint transparency", minval = 80, maxval = 99, group = m3_gPanel)

// ─── THEME ────────────────────────────────────────────────────
m3_gTheme = "Theme"

m3_bgPanel  = input.color(#131313, "Panel background", group = m3_gTheme)
m3_bgTitle  = input.color(#c9a84c, "Title",            group = m3_gTheme)
m3_bgLabel  = input.color(#8a877f, "Labels",           group = m3_gTheme)
m3_bgWhite  = input.color(#e8e6e1, "Values",           group = m3_gTheme)
m3_bgBorder = input.color(#1a1d24, "Border",           group = m3_gTheme)

// ─── ENGINE ───────────────────────────────────────────────────
// Lifted from the Cockpit regime scanner so the number reads the
// same in both instruments.

m3_adxOf(int _len) =>
    [_p, _m, _adx] = ta.dmi(_len, _len)
    _adx

m3_atr    = ta.atr(m3_atrLen)
m3_atrAvg = ta.sma(ta.atr(m3_atrLen), m3_avgLen)
m3_adx    = m3_adxOf(m3_adxLen)

m3_ratio = m3_atrAvg > 0 ? m3_atr / m3_atrAvg : 1.0

m3_stablePrime = m3_ratio > m3_primeLo and m3_ratio < m3_primeHi
m3_stableOk    = m3_ratio > m3_okLo    and m3_ratio < m3_okHi

m3_stabScore  = m3_stablePrime ? m3_stabFull : m3_stableOk ? m3_stabHalf : 0.0
m3_trendScore = math.min(m3_adx, m3_adxCap)
m3_score      = m3_stabScore + m3_trendScore
m3_maxScore   = m3_stabFull + m3_adxCap

m3_grade =
     m3_score > m3_cutPrime ? "PRIME" :
     m3_score > m3_cutFav   ? "FAVORABLE" :
     m3_score > m3_cutMarg  ? "MARGINAL" : "DEGRADED"

m3_gradeCol =
     m3_score > m3_cutPrime ? m3_colPrime :
     m3_score > m3_cutFav   ? m3_colFav :
     m3_score > m3_cutMarg  ? m3_colMarg : m3_colDeg

m3_colOfScore(float _s) =>
    _s > m3_cutPrime ? m3_colPrime : _s > m3_cutFav ? m3_colFav : _s > m3_cutMarg ? m3_colMarg : m3_colDeg

// Direction of travel across the strip window.
m3_back  = math.max(1, math.round(m3_stripLen / 2))
m3_drift = m3_score - m3_score[m3_back]
m3_trend = m3_drift > 3 ? "improving" : m3_drift < -3 ? "deteriorating" : "steady"

// How long the current grade has held.
var int m3_held = 0
m3_held := m3_grade == m3_grade[1] ? m3_held + 1 : 0

// Plain language for the stability component.
m3_stabWord = m3_stablePrime ? "aligned" : m3_stableOk ? "drifting" : "dislocated"

// ─── BACKGROUND TINT ──────────────────────────────────────────
bgcolor(m3_bgTint ? color.new(m3_gradeCol, m3_bgFade) : na, title = "Regime tint")

// ─── PANEL ────────────────────────────────────────────────────
m3_sizeOf(_s) =>
    _s == "Tiny" ? size.tiny : _s == "Small" ? size.small : _s == "Normal" ? size.normal : size.large

m3_posOf(_p) =>
    _p == "Top right" ? position.top_right : _p == "Bottom right" ? position.bottom_right : _p == "Bottom left" ? position.bottom_left : position.top_left

var table m3_tbl = na

if barstate.islast and m3_showPanel
    int m3_cols = m3_stripOn ? m3_stripLen : 2
    int m3_rows = m3_stripOn ? 6 : 5
    int m3_last = m3_cols - 1

    if na(m3_tbl)
        m3_tbl := table.new(m3_posOf(m3_pos), m3_cols, m3_rows,
             bgcolor      = m3_bgPanel,
             border_color = m3_bgBorder,
             border_width = 1,
             frame_color  = m3_bgTitle,
             frame_width  = 1)

    table.cell(m3_tbl, 0, 0, " QUANT PRIME — REGIME ",
         text_color = m3_bgTitle, text_size = m3_sizeOf(m3_txtSize), bgcolor = color.rgb(10, 10, 25))

    table.cell(m3_tbl, 0, 1,
         " " + m3_grade + "   " + str.tostring(m3_score, "#") + " / " + str.tostring(m3_maxScore, "#") + " ",
         text_color = m3_gradeCol, text_size = m3_sizeOf(m3_txtSize), bgcolor = m3_bgPanel)

    table.cell(m3_tbl, 0, 2,
         " STABILITY  " + str.tostring(m3_stabScore, "#") + " / " + str.tostring(m3_stabFull, "#") +
         "   " + str.tostring(m3_ratio, "#.##") + "x " + m3_stabWord + " ",
         text_color = m3_stabScore >= m3_stabFull ? m3_bgWhite : m3_stabScore > 0 ? m3_colMarg : m3_colDeg,
         text_size = m3_sizeOf(m3_txtSize), bgcolor = m3_bgPanel)

    table.cell(m3_tbl, 0, 3,
         " TREND      " + str.tostring(m3_trendScore, "#") + " / " + str.tostring(m3_adxCap, "#") +
         "   ADX " + str.tostring(m3_adx, "#.#") + " ",
         text_color = m3_bgWhite, text_size = m3_sizeOf(m3_txtSize), bgcolor = m3_bgPanel)

    table.cell(m3_tbl, 0, 4,
         " " + m3_trend + "  ·  held " + str.tostring(m3_held) + " bars ",
         text_color = m3_bgLabel, text_size = m3_sizeOf(m3_txtSize), bgcolor = m3_bgPanel)

    // Merging is only valid across more than one column.
    if m3_last > 0
        table.merge_cells(m3_tbl, 0, 0, m3_last, 0)
        table.merge_cells(m3_tbl, 0, 1, m3_last, 1)
        table.merge_cells(m3_tbl, 0, 2, m3_last, 2)
        table.merge_cells(m3_tbl, 0, 3, m3_last, 3)
        table.merge_cells(m3_tbl, 0, 4, m3_last, 4)

    // Score history -- oldest on the left, current on the right.
    if m3_stripOn
        for i = 0 to m3_last
            int   _idx = m3_last - i
            float _s   = m3_score[_idx]
            table.cell(m3_tbl, i, 5, "", bgcolor = na(_s) ? m3_bgPanel : m3_colOfScore(_s), width = 1, height = 1)

// ─── ALERTS ───────────────────────────────────────────────────
alertcondition(ta.crossover(m3_score, m3_cutPrime), "Regime turned prime",
     "The regime score has crossed into prime.")

alertcondition(ta.crossunder(m3_score, m3_cutMarg), "Regime degraded",
     "The regime score has dropped into degraded.")

alertcondition(m3_held == 0, "Regime grade changed",
     "The regime grade has changed on this timeframe.")


// ═══════════════════════════════════════════════════════════════
//  QUANT PRIME — BUILD MENU · RECOIL TIER
//  SIDE 2 · POSITION SIZER
// ───────────────────────────────────────────────────────────────
//  A stop that moves with volatility means a position size that
//  has to move with it too. Trading a fixed lot through changing
//  conditions is not consistent risk -- it is the same size
//  taking wildly different amounts off the account depending on
//  how wide the correct stop happened to be that hour.
//
//  This reads the stop distance straight off the chart, applies
//  the risk you are willing to take, and returns the size that
//  makes those two agree. Long and short are shown separately
//  because their stops are not the same distance away.
//
//  It calculates its own stop rather than depending on any other
//  piece, so it works on its own.
//
//  Draws one table. Safe to combine with any other Recoil piece.
//  All identifiers namespaced d2_ to avoid collisions.
// ═══════════════════════════════════════════════════════════════


// ─── ACCOUNT ──────────────────────────────────────────────────
d2_gAcct = "Account"

d2_balance = input.float(1000.0, "Account balance", minval = 1.0, step = 100.0, group = d2_gAcct,
     tooltip = "Your own figure. Nothing is read from a broker -- this is a calculator, not a connection.")

d2_ccy = input.string("£", "Currency symbol", group = d2_gAcct)

d2_riskMode = input.string("Percent of balance", "Risk as", options = ["Percent of balance", "Fixed amount"], group = d2_gAcct)

d2_riskPct = input.float(1.0, "Risk percent", minval = 0.01, maxval = 100.0, step = 0.25, group = d2_gAcct)

d2_riskAmt = input.float(10.0, "Risk amount", minval = 0.01, step = 1.0, group = d2_gAcct)

// ─── STOP ─────────────────────────────────────────────────────
d2_gStop = "Stop"

d2_atrLen = input.int(8, "ATR Length", minval = 1, group = d2_gStop,
     tooltip = "The volatility baseline the buffer is measured in. Matches the Recoil default.")

d2_buffer = input.float(3.0, "Wick buffer (x ATR)", minval = 0.0, step = 0.25, group = d2_gStop,
     tooltip = "How far beyond the current candle's wick the stop sits. 3.0 is the Recoil scalping default. Set both this and ATR Length to match whatever you actually trade.")

d2_manualOn = input.bool(false, "Use a manual stop distance instead", group = d2_gStop,
     tooltip = "Ignores the chart and sizes against a fixed pip distance you type in. Useful for planning a trade you have already decided the stop for.")

d2_manualPips = input.float(10.0, "Manual stop (pips)", minval = 0.1, step = 0.5, group = d2_gStop)

// ─── INSTRUMENT ───────────────────────────────────────────────
d2_gInst = "Instrument"

d2_pipIn = input.float(0.0, "Pip size (0 = auto)", step = 0.00001, minval = 0.0, group = d2_gInst,
     tooltip = "Leave at 0 for automatic detection. Override where the automatic value is wrong -- for example set 1.0 for BTCUSD.")

d2_contract = input.float(100000.0, "Units per lot", minval = 1.0, step = 1000.0, group = d2_gInst,
     tooltip = "100000 for a standard forex lot. Set to 1 on instruments quoted in units rather than lots, and the size column reads as a straight unit count.")

d2_convert = input.float(1.0, "Conversion rate", minval = 0.0001, step = 0.01, group = d2_gInst,
     tooltip = "Only needed when the instrument's quote currency is not your account currency. On EURUSD with a dollar account, leave at 1. On EURGBP with a dollar account, set this to the GBP to USD rate. Getting it wrong scales every size shown here by the same factor.")

d2_maxLots = input.float(0.0, "Warn above N lots", minval = 0.0, step = 0.1, group = d2_gInst,
     tooltip = "Highlights the size in red when the calculation returns more than this. 0 disables it.")

// ─── PANEL ────────────────────────────────────────────────────
d2_gPanel = "Panel"

d2_pos = input.string("Bottom right", "Position", options = ["Top right", "Bottom right", "Bottom left", "Top left"], group = d2_gPanel,
     tooltip = "When combining several pieces, give each one its own corner so nothing stacks.")

d2_txtSize = input.string("Tiny", "Text size", options = ["Tiny", "Small", "Normal", "Large"], group = d2_gPanel)

d2_showLines = input.bool(true, "Show the stop levels on the chart", group = d2_gPanel)

// ─── THEME ────────────────────────────────────────────────────
d2_gTheme = "Theme"

d2_bg     = input.color(#131313, "Panel background", group = d2_gTheme)
d2_title  = input.color(#c9a84c, "Title",            group = d2_gTheme)
d2_label  = input.color(#8a877f, "Labels",           group = d2_gTheme)
d2_white  = input.color(#e8e6e1, "Values",           group = d2_gTheme)
d2_border = input.color(#1a1d24, "Border",           group = d2_gTheme)
d2_longC  = input.color(#00abff, "Long",             group = d2_gTheme, inline = "ls")
d2_shortC = input.color(#c9a84c, "Short",            group = d2_gTheme, inline = "ls")
d2_warnC  = input.color(#f23645, "Warning",          group = d2_gTheme)

// ─── ENGINE ───────────────────────────────────────────────────
d2_pipAuto = syminfo.mintick * (syminfo.mintick == 0.00001 or syminfo.mintick == 0.001 ? 10 : 1)
d2_pip     = d2_pipIn > 0 ? d2_pipIn : d2_pipAuto

d2_atr = ta.atr(d2_atrLen)

// Stop levels, taken from the current candle's own extremes.
d2_longStop  = low  - d2_atr * d2_buffer
d2_shortStop = high + d2_atr * d2_buffer

// Distance in price, then in pips.
d2_longDist  = d2_manualOn ? d2_manualPips * d2_pip : math.max(close - d2_longStop,  syminfo.mintick)
d2_shortDist = d2_manualOn ? d2_manualPips * d2_pip : math.max(d2_shortStop - close, syminfo.mintick)

d2_longPips  = d2_longDist  / d2_pip
d2_shortPips = d2_shortDist / d2_pip

// What is actually at risk.
d2_risk = d2_riskMode == "Percent of balance" ? d2_balance * d2_riskPct / 100.0 : d2_riskAmt

// Value of one pip on one lot, in account currency.
d2_pipValue = d2_pip * d2_contract * d2_convert

d2_longLots  = d2_pipValue > 0 and d2_longPips  > 0 ? d2_risk / (d2_longPips  * d2_pipValue) : 0.0
d2_shortLots = d2_pipValue > 0 and d2_shortPips > 0 ? d2_risk / (d2_shortPips * d2_pipValue) : 0.0

// What the sized position gains or loses per pip of movement.
d2_longPerPip  = d2_longLots  * d2_pipValue
d2_shortPerPip = d2_shortLots * d2_pipValue

d2_longWarn  = d2_maxLots > 0 and d2_longLots  > d2_maxLots
d2_shortWarn = d2_maxLots > 0 and d2_shortLots > d2_maxLots

// ─── STOP LEVELS ON CHART ─────────────────────────────────────
plot(d2_showLines and not d2_manualOn ? d2_longStop : na, title = "Long stop",
     color = d2_longC, linewidth = 1, style = plot.style_linebr)

plot(d2_showLines and not d2_manualOn ? d2_shortStop : na, title = "Short stop",
     color = d2_shortC, linewidth = 1, style = plot.style_linebr)

// ─── PANEL ────────────────────────────────────────────────────
d2_sizeOf(_s) =>
    _s == "Tiny" ? size.tiny : _s == "Small" ? size.small : _s == "Normal" ? size.normal : size.large

d2_posOf(_p) =>
    _p == "Top right" ? position.top_right : _p == "Bottom right" ? position.bottom_right : _p == "Bottom left" ? position.bottom_left : position.top_left

// Lots need more decimals than units do.
d2_lotStr(float _l) =>
    _l >= 100 ? str.tostring(_l, "#") : _l >= 10 ? str.tostring(_l, "#.#") : str.tostring(_l, "#.##")

var table d2_tbl = na

if barstate.islast
    if na(d2_tbl)
        d2_tbl := table.new(d2_posOf(d2_pos), 3, 7,
             bgcolor      = d2_bg,
             border_color = d2_border,
             border_width = 1,
             frame_color  = d2_title,
             frame_width  = 1)

    string _sz = d2_txtSize

    table.cell(d2_tbl, 0, 0, " QUANT PRIME — POSITION SIZER ",
         text_color = d2_title, text_size = d2_sizeOf(_sz), bgcolor = color.rgb(10, 10, 25))
    table.merge_cells(d2_tbl, 0, 0, 2, 0)

    table.cell(d2_tbl, 0, 1, " RISK ", text_color = d2_label, text_size = size.tiny, bgcolor = d2_bg)
    table.cell(d2_tbl, 1, 1,
         " " + d2_ccy + str.tostring(d2_risk, "#.##") +
         (d2_riskMode == "Percent of balance" ? "  ·  " + str.tostring(d2_riskPct, "#.##") + "% of " + d2_ccy + str.tostring(d2_balance, "#") : "") + " ",
         text_color = d2_white, text_size = d2_sizeOf(_sz), bgcolor = d2_bg)
    table.merge_cells(d2_tbl, 1, 1, 2, 1)

    table.cell(d2_tbl, 0, 2, "",        text_color = d2_label, text_size = size.tiny, bgcolor = d2_bg)
    table.cell(d2_tbl, 1, 2, " LONG ",  text_color = d2_longC, text_size = size.tiny, bgcolor = d2_bg)
    table.cell(d2_tbl, 2, 2, " SHORT ", text_color = d2_shortC, text_size = size.tiny, bgcolor = d2_bg)

    table.cell(d2_tbl, 0, 3, " STOP ", text_color = d2_label, text_size = d2_sizeOf(_sz), bgcolor = d2_bg)
    table.cell(d2_tbl, 1, 3, " " + str.tostring(d2_longPips,  "#.#") + " pips ", text_color = d2_white, text_size = d2_sizeOf(_sz), bgcolor = d2_bg)
    table.cell(d2_tbl, 2, 3, " " + str.tostring(d2_shortPips, "#.#") + " pips ", text_color = d2_white, text_size = d2_sizeOf(_sz), bgcolor = d2_bg)

    table.cell(d2_tbl, 0, 4, " SIZE ", text_color = d2_label, text_size = d2_sizeOf(_sz), bgcolor = d2_bg)
    table.cell(d2_tbl, 1, 4, " " + d2_lotStr(d2_longLots)  + " lots ", text_color = d2_longWarn  ? d2_warnC : d2_longC,  text_size = d2_sizeOf(_sz), bgcolor = d2_bg)
    table.cell(d2_tbl, 2, 4, " " + d2_lotStr(d2_shortLots) + " lots ", text_color = d2_shortWarn ? d2_warnC : d2_shortC, text_size = d2_sizeOf(_sz), bgcolor = d2_bg)

    table.cell(d2_tbl, 0, 5, " PER PIP ", text_color = d2_label, text_size = d2_sizeOf(_sz), bgcolor = d2_bg)
    table.cell(d2_tbl, 1, 5, " " + d2_ccy + str.tostring(d2_longPerPip,  "#.##") + " ", text_color = d2_white, text_size = d2_sizeOf(_sz), bgcolor = d2_bg)
    table.cell(d2_tbl, 2, 5, " " + d2_ccy + str.tostring(d2_shortPerPip, "#.##") + " ", text_color = d2_white, text_size = d2_sizeOf(_sz), bgcolor = d2_bg)

    table.cell(d2_tbl, 0, 6,
         " " + (d2_manualOn ? "manual stop " + str.tostring(d2_manualPips, "#.#") + " pips" :
              "wick + " + str.tostring(d2_buffer, "#.##") + " ATR") +
         "  ·  " + d2_ccy + str.tostring(d2_pipValue, "#.##") + " per pip per lot ",
         text_color = d2_label, text_size = size.tiny, bgcolor = d2_bg, text_formatting = text.format_italic)
    table.merge_cells(d2_tbl, 0, 6, 2, 6)

// ─── ALERTS ───────────────────────────────────────────────────
alertcondition(d2_longWarn or d2_shortWarn, "Position size above limit",
     "The calculated position size has exceeded the limit set on this instrument.")


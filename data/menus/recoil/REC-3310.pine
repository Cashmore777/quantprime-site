//@version=6
// =============================================================
//  QUANT PRIME — RECOIL BUILD  ·  REC-3310
// -------------------------------------------------------------
//  Volatility Levels + Regime Tracker + Candle Clock
//
//  Generated from the Recoil Build menu. Each piece keeps its
//  own settings group and its own namespace, so nothing here
//  interferes with anything else. Remove a piece by rebuilding
//  from the menu rather than editing this file.
// =============================================================

indicator("QP · Recoil 3310", shorttitle = "REC-3310", overlay = true, max_labels_count = 500, max_lines_count = 500)

// ═══════════════════════════════════════════════════════════════
//  QUANT PRIME — BUILD MENU · RECOIL TIER
//  STARTER 3 · VOLATILITY LEVELS
// ───────────────────────────────────────────────────────────────
//  When a high volatility candle closes, four of its prices stop
//  being ordinary chart history and start being reference points:
//  the high and low it reached, the open it came from, and the
//  close it finished at. Price spends the following period
//  working around them.
//
//  This draws those four as rails extending right, and freezes
//  each one the moment price passes through it. A rail still
//  running is a level that has not yet been dealt with.
//
//  The close rail is handled differently to the others. Price is
//  sitting exactly on it the moment it is drawn, so it only
//  counts as broken once price has genuinely left it and later
//  come back.
//
//  Uses the same band engine as Volatility Bands, so the candle
//  that triggers a set here is the same candle that colours
//  yellow, orange or red there.
//
//  Draws no table. Safe to combine with any other Recoil piece.
//  All identifiers namespaced s3_ to avoid collisions.
// ═══════════════════════════════════════════════════════════════


// ─── TRIGGER ──────────────────────────────────────────────────
s3_gTrig = "Trigger"

s3_atrLen = input.int(8, "ATR Length", minval = 1, group = s3_gTrig,
     tooltip = "The volatility baseline. Matches the Recoil default.")

s3_trigBand = input.int(6, "Trigger from band # upward", minval = 6, maxval = 8, group = s3_gTrig,
     tooltip = "A candle closing in this band or higher lays down a new set of levels. 6 is the first high volatility band; raise to 7 or 8 for fewer, more significant sets.")

s3_minBodyAtr = input.float(0.5, "Min Body Size (x ATR)", minval = 0.0, step = 0.05, group = s3_gTrig,
     tooltip = "A candle's body must be at least this many ATRs to qualify. Filters out wide candles made mostly of wick. Set to 0 to disable.")

s3_maxSets = input.int(5, "Level sets kept on chart", minval = 1, maxval = 20, group = s3_gTrig,
     tooltip = "How many past expansion candles keep their levels drawn, broken ones included. Once this many sets exist, the oldest is removed from the chart entirely. Set to 1 to see only the most recent candle's levels.")

// ─── BAND THRESHOLDS ──────────────────────────────────────────
s3_gBand = "Band Thresholds"

s3_t1 = input.float(0.30, "Threshold 1", step = 0.05, group = s3_gBand)
s3_t2 = input.float(0.75, "Threshold 2", step = 0.05, group = s3_gBand)
s3_t3 = input.float(1.20, "Threshold 3", step = 0.05, group = s3_gBand)
s3_t4 = input.float(1.65, "Threshold 4", step = 0.05, group = s3_gBand)
s3_t5 = input.float(2.10, "Threshold 5", step = 0.05, group = s3_gBand)
s3_t6 = input.float(2.55, "Threshold 6", step = 0.05, group = s3_gBand)
s3_t7 = input.float(3.00, "Threshold 7", step = 0.05, group = s3_gBand)

// ─── BREAK RULE ───────────────────────────────────────────────
s3_gBreak = "Break Rule"

s3_breakMode = input.string("Wick touch", "A level is broken by", options = ["Wick touch", "Close beyond"], group = s3_gBreak,
     tooltip = "Wick touch freezes a rail as soon as price reaches it. Close beyond keeps the rail running until a candle actually finishes on the far side, so brief spikes through do not retire it.")

s3_keepBroken = input.bool(true, "Keep broken levels visible", group = s3_gBreak,
     tooltip = "On: a broken rail stops extending but stays on the chart as a faded dotted line. Off: it is removed entirely.")

s3_brokenFade = input.int(35, "Broken level fade", minval = 0, maxval = 90, group = s3_gBreak,
     tooltip = "How much a rail dims once it has been broken. Higher values push broken levels further into the background.")

// ─── LEVELS ───────────────────────────────────────────────────
s3_gLev = "Levels"

s3_hiOn = input.bool(true, "High",  group = s3_gLev, inline = "hl")
s3_loOn = input.bool(true, "Low",   group = s3_gLev, inline = "hl")
s3_opOn = input.bool(true, "Open",  group = s3_gLev, inline = "oc")
s3_clOn = input.bool(true, "Close", group = s3_gLev, inline = "oc")

s3_hlCol = input.color(#f23645, "High / Low color",   group = s3_gLev)
s3_ocCol = input.color(#c9a84c, "Open / Close color", group = s3_gLev)

s3_hlWidth = input.int(2, "High / Low width",   minval = 1, maxval = 4, group = s3_gLev)
s3_ocWidth = input.int(1, "Open / Close width", minval = 1, maxval = 4, group = s3_gLev)

s3_useBandCol = input.bool(false, "Color High / Low by source band", group = s3_gLev,
     tooltip = "On: the high and low rails take the colour of the candle that created them. Off: they use the fixed colour above.")

s3_c6 = input.color(#ffeb3b, "Band 6", group = s3_gLev, inline = "bc")
s3_c7 = input.color(#ff9800, "Band 7", group = s3_gLev, inline = "bc")
s3_c8 = input.color(#f23645, "Band 8", group = s3_gLev, inline = "bc")

// ─── DISPLAY ──────────────────────────────────────────────────
s3_gDisp = "Display"

s3_showKeys  = input.bool(true,  "Show level labels", group = s3_gDisp,
     tooltip = "A small H, L, O or C marker sitting at the right end of each rail.")
s3_showPrice = input.bool(false, "Include price in label", group = s3_gDisp)
s3_keySize   = input.string("Tiny", "Label size", options = ["Tiny", "Small", "Normal"], group = s3_gDisp)

// ─── BAND ENGINE ──────────────────────────────────────────────
// Identical classification to Volatility Bands.

s3_atr   = ta.atr(s3_atrLen)
s3_ratio = ta.tr(true) / s3_atr

s3_rawBand =
     s3_ratio < s3_t1 ? 1 :
     s3_ratio < s3_t2 ? 2 :
     s3_ratio < s3_t3 ? 3 :
     s3_ratio < s3_t4 ? 4 :
     s3_ratio < s3_t5 ? 5 :
     s3_ratio < s3_t6 ? 6 :
     s3_ratio < s3_t7 ? 7 : 8

s3_body    = math.abs(close - open)
s3_minBody = math.max(syminfo.mintick, s3_atr * s3_minBodyAtr)
s3_bodyOk  = s3_minBodyAtr <= 0 or s3_body > s3_minBody

s3_band = s3_rawBand >= 6 and not s3_bodyOk ? 5 : s3_rawBand

// ─── LEVEL SET ────────────────────────────────────────────────
//  side  = +1 when the level sat above price at creation,
//          -1 when below, 0 when price was exactly on it.
//  left  = has price genuinely moved off the level since it was
//          drawn. Only relevant for side 0.

type S3Lvl
    float px
    int   side
    bool  left
    bool  broken
    line  ln
    label ky

type S3Set
    S3Lvl hi
    S3Lvl lo
    S3Lvl op
    S3Lvl cl
    int   band

var S3Set[] s3_sets = array.new<S3Set>()

s3_sizeOf(_s) =>
    _s == "Tiny" ? size.tiny : _s == "Small" ? size.small : size.normal

s3_keyText(string _tag, float _px) =>
    s3_showPrice ? _tag + " " + str.tostring(_px, format.mintick) : _tag

s3_mkLvl(bool _on, float _px, int _side, string _tag, color _col, int _w, bool _dashed) =>
    line  _ln = na
    label _ky = na
    if _on
        _ln := line.new(bar_index, _px, bar_index + 1, _px, color = _col, width = _w,
             style = _dashed ? line.style_dashed : line.style_solid)
        if s3_showKeys
            _ky := label.new(bar_index, _px, s3_keyText(_tag, _px),
                 style     = label.style_label_left,
                 color     = color.new(color.black, 100),
                 textcolor = _col,
                 size      = s3_sizeOf(s3_keySize))
    S3Lvl.new(_px, _side, false, false, _ln, _ky)

// Advance one level: extend it, or freeze it if price went through.
s3_step(S3Lvl _l, color _col) =>
    if not _l.broken and not na(_l.ln)
        bool touched = high >= _l.px and low <= _l.px
        bool hit     = false

        if _l.side == 0
            // Level drawn at price. It must be left before a
            // return to it counts as breaking it.
            if not _l.left and not touched
                _l.left := true
            if _l.left
                hit := s3_breakMode == "Wick touch" ? touched : (close != _l.px and touched)
        else if _l.side > 0
            hit := s3_breakMode == "Wick touch" ? high >= _l.px : close > _l.px
        else
            hit := s3_breakMode == "Wick touch" ? low <= _l.px : close < _l.px

        if hit
            _l.broken := true
            if s3_keepBroken
                line.set_x2(_l.ln, bar_index)
                line.set_style(_l.ln, line.style_dotted)
                line.set_color(_l.ln, color.new(_col, s3_brokenFade))
                label.delete(_l.ky)
                _l.ky := na
            else
                line.delete(_l.ln)
                label.delete(_l.ky)
                _l.ln := na
                _l.ky := na
        else
            line.set_x2(_l.ln, bar_index)
            if not na(_l.ky)
                label.set_x(_l.ky, bar_index)
    true

s3_killLvl(S3Lvl _l) =>
    line.delete(_l.ln)
    label.delete(_l.ky)
    true

// ─── ENGINE ───────────────────────────────────────────────────
if barstate.isconfirmed

    // --- extend or freeze every live rail ---
    int s3_n = array.size(s3_sets)
    if s3_n > 0
        for i = 0 to s3_n - 1
            S3Set st  = array.get(s3_sets, i)
            color hlc = s3_useBandCol ? (st.band == 8 ? s3_c8 : st.band == 7 ? s3_c7 : s3_c6) : s3_hlCol
            s3_step(st.hi, hlc)
            s3_step(st.lo, hlc)
            s3_step(st.op, s3_ocCol)
            s3_step(st.cl, s3_ocCol)

    // --- a qualifying candle just closed: lay down a new set ---
    if s3_band >= s3_trigBand
        color hlc = s3_useBandCol ? (s3_band == 8 ? s3_c8 : s3_band == 7 ? s3_c7 : s3_c6) : s3_hlCol

        S3Lvl nHi = s3_mkLvl(s3_hiOn, high,  1, "H", hlc,      s3_hlWidth, false)
        S3Lvl nLo = s3_mkLvl(s3_loOn, low,  -1, "L", hlc,      s3_hlWidth, false)
        S3Lvl nOp = s3_mkLvl(s3_opOn, open, open > close ? 1 : open < close ? -1 : 0, "O", s3_ocCol, s3_ocWidth, true)
        S3Lvl nCl = s3_mkLvl(s3_clOn, close, 0, "C", s3_ocCol, s3_ocWidth, true)

        array.push(s3_sets, S3Set.new(nHi, nLo, nOp, nCl, s3_band))

        while array.size(s3_sets) > s3_maxSets
            S3Set old = array.shift(s3_sets)
            s3_killLvl(old.hi)
            s3_killLvl(old.lo)
            s3_killLvl(old.op)
            s3_killLvl(old.cl)

// ─── ALERTS ───────────────────────────────────────────────────
s3_newSet = barstate.isconfirmed and s3_band >= s3_trigBand

alertcondition(s3_newSet, "New volatility levels",
     "A high volatility candle has closed -- a new set of levels is on the chart.")


// ═══════════════════════════════════════════════════════════════
//  QUANT PRIME — BUILD MENU · RECOIL TIER
//  MAIN 3 · REGIME TRACKER
// ───────────────────────────────────────────────────────────────
//  The regime score grades the market's quality out of 90, built
//  from two components:
//
//    STABILITY (0-40)  Current ATR against its own 50 period
//                      average. Scores 40 when the two sit close
//                      together, 20 when loosely aligned, 0 when
//                      they diverge.
//    TREND     (0-50)  ADX, capped at 50.
//
//  Note what stability rewards. It is not measuring how much the
//  market is moving, it is measuring whether it is moving the way
//  it has recently been moving. A run of expansion candles pushes
//  ATR away from its average and drags the score DOWN. High
//  volatility and a high regime score are different things, and a
//  fade taken in a degraded regime is a different trade to the
//  same fade taken in a prime one.
//
//  Identical scoring to the Cockpit regime scanner, so a score
//  read here is the same number Cockpit shows for this timeframe.
//  Cockpit reads five timeframes at once; this reads the chart
//  you are on, and keeps its recent history.
//
//  Draws one table. Safe to combine with any other Recoil piece.
//  All identifiers namespaced m3_ to avoid collisions.
// ═══════════════════════════════════════════════════════════════


// ─── SCORING ──────────────────────────────────────────────────
m3_gScore = "Scoring"

m3_atrLen = input.int(14, "ATR length", minval = 1, group = m3_gScore,
     tooltip = "The current volatility reading. Matches the Cockpit regime scanner.")

m3_avgLen = input.int(50, "ATR average length", minval = 2, group = m3_gScore,
     tooltip = "The baseline the current ATR is compared against. Their ratio drives the stability component.")

m3_adxLen = input.int(14, "ADX length", minval = 1, group = m3_gScore,
     tooltip = "The trend strength reading. Contributes up to 50 points, capped.")

// ─── STABILITY BANDS ──────────────────────────────────────────
m3_gStab = "Stability Bands"

m3_primeLo = input.float(0.85, "Full marks from", step = 0.05, group = m3_gStab, inline = "p")
m3_primeHi = input.float(1.20, "to",              step = 0.05, group = m3_gStab, inline = "p",
     tooltip = "ATR to average ratio within this range scores the full stability points.")

m3_okLo = input.float(0.70, "Half marks from", step = 0.05, group = m3_gStab, inline = "o")
m3_okHi = input.float(1.40, "to",              step = 0.05, group = m3_gStab, inline = "o")

m3_stabFull = input.float(40.0, "Full marks value", step = 5.0, group = m3_gStab, inline = "v")
m3_stabHalf = input.float(20.0, "Half marks value", step = 5.0, group = m3_gStab, inline = "v")
m3_adxCap   = input.float(50.0, "Trend cap",        step = 5.0, group = m3_gStab)

// ─── GRADES ───────────────────────────────────────────────────
m3_gGrade = "Grades"

m3_cutPrime = input.float(70.0, "Prime above",     step = 1.0, group = m3_gGrade)
m3_cutFav   = input.float(55.0, "Favorable above", step = 1.0, group = m3_gGrade)
m3_cutMarg  = input.float(40.0, "Marginal above",  step = 1.0, group = m3_gGrade,
     tooltip = "Anything at or below this reads as degraded.")

m3_colPrime = input.color(#26a269, "Prime",     group = m3_gGrade, inline = "gc1")
m3_colFav   = input.color(#00abff, "Favorable", group = m3_gGrade, inline = "gc1")
m3_colMarg  = input.color(#c9a84c, "Marginal",  group = m3_gGrade, inline = "gc2")
m3_colDeg   = input.color(#f23645, "Degraded",  group = m3_gGrade, inline = "gc2")

// ─── PANEL ────────────────────────────────────────────────────
m3_gPanel = "Panel"

m3_showPanel = input.bool(true, "Show panel", group = m3_gPanel)

m3_pos = input.string("Top right", "Position", options = ["Top right", "Bottom right", "Bottom left", "Top left"], group = m3_gPanel,
     tooltip = "Where the panel sits. When combining several pieces, give each one its own corner so nothing stacks.")

m3_txtSize = input.string("Tiny", "Text size", options = ["Tiny", "Small", "Normal", "Large"], group = m3_gPanel)

m3_stripOn = input.bool(true, "Show score history strip", group = m3_gPanel,
     tooltip = "A coloured cell per recent candle, graded the same way as the score itself. Oldest on the left, current on the right. The strip changes colour before the score crosses a boundary, so quality breaking down is visible early.")

m3_stripLen = input.int(24, "Strip length", minval = 8, maxval = 40, group = m3_gPanel)

m3_bgTint = input.bool(false, "Tint chart background by grade", group = m3_gPanel,
     tooltip = "Shades the whole chart with the grade colour. Effective on a clean chart, heavy once several pieces are stacked.")

m3_bgFade = input.int(94, "Tint transparency", minval = 80, maxval = 99, group = m3_gPanel)

// ─── THEME ────────────────────────────────────────────────────
m3_gTheme = "Theme"

m3_bgPanel  = input.color(#131313, "Panel background", group = m3_gTheme)
m3_bgTitle  = input.color(#c9a84c, "Title",            group = m3_gTheme)
m3_bgLabel  = input.color(#8a877f, "Labels",           group = m3_gTheme)
m3_bgWhite  = input.color(#e8e6e1, "Values",           group = m3_gTheme)
m3_bgBorder = input.color(#1a1d24, "Border",           group = m3_gTheme)

// ─── ENGINE ───────────────────────────────────────────────────
// Lifted from the Cockpit regime scanner so the number reads the
// same in both instruments.

m3_adxOf(int _len) =>
    [_p, _m, _adx] = ta.dmi(_len, _len)
    _adx

m3_atr    = ta.atr(m3_atrLen)
m3_atrAvg = ta.sma(ta.atr(m3_atrLen), m3_avgLen)
m3_adx    = m3_adxOf(m3_adxLen)

m3_ratio = m3_atrAvg > 0 ? m3_atr / m3_atrAvg : 1.0

m3_stablePrime = m3_ratio > m3_primeLo and m3_ratio < m3_primeHi
m3_stableOk    = m3_ratio > m3_okLo    and m3_ratio < m3_okHi

m3_stabScore  = m3_stablePrime ? m3_stabFull : m3_stableOk ? m3_stabHalf : 0.0
m3_trendScore = math.min(m3_adx, m3_adxCap)
m3_score      = m3_stabScore + m3_trendScore
m3_maxScore   = m3_stabFull + m3_adxCap

m3_grade =
     m3_score > m3_cutPrime ? "PRIME" :
     m3_score > m3_cutFav   ? "FAVORABLE" :
     m3_score > m3_cutMarg  ? "MARGINAL" : "DEGRADED"

m3_gradeCol =
     m3_score > m3_cutPrime ? m3_colPrime :
     m3_score > m3_cutFav   ? m3_colFav :
     m3_score > m3_cutMarg  ? m3_colMarg : m3_colDeg

m3_colOfScore(float _s) =>
    _s > m3_cutPrime ? m3_colPrime : _s > m3_cutFav ? m3_colFav : _s > m3_cutMarg ? m3_colMarg : m3_colDeg

// Direction of travel across the strip window.
m3_back  = math.max(1, math.round(m3_stripLen / 2))
m3_drift = m3_score - m3_score[m3_back]
m3_trend = m3_drift > 3 ? "improving" : m3_drift < -3 ? "deteriorating" : "steady"

// How long the current grade has held.
var int m3_held = 0
m3_held := m3_grade == m3_grade[1] ? m3_held + 1 : 0

// Plain language for the stability component.
m3_stabWord = m3_stablePrime ? "aligned" : m3_stableOk ? "drifting" : "dislocated"

// ─── BACKGROUND TINT ──────────────────────────────────────────
bgcolor(m3_bgTint ? color.new(m3_gradeCol, m3_bgFade) : na, title = "Regime tint")

// ─── PANEL ────────────────────────────────────────────────────
m3_sizeOf(_s) =>
    _s == "Tiny" ? size.tiny : _s == "Small" ? size.small : _s == "Normal" ? size.normal : size.large

m3_posOf(_p) =>
    _p == "Top right" ? position.top_right : _p == "Bottom right" ? position.bottom_right : _p == "Bottom left" ? position.bottom_left : position.top_left

var table m3_tbl = na

if barstate.islast and m3_showPanel
    int m3_cols = m3_stripOn ? m3_stripLen : 2
    int m3_rows = m3_stripOn ? 6 : 5
    int m3_last = m3_cols - 1

    if na(m3_tbl)
        m3_tbl := table.new(m3_posOf(m3_pos), m3_cols, m3_rows,
             bgcolor      = m3_bgPanel,
             border_color = m3_bgBorder,
             border_width = 1,
             frame_color  = m3_bgTitle,
             frame_width  = 1)

    table.cell(m3_tbl, 0, 0, " QUANT PRIME — REGIME ",
         text_color = m3_bgTitle, text_size = m3_sizeOf(m3_txtSize), bgcolor = color.rgb(10, 10, 25))

    table.cell(m3_tbl, 0, 1,
         " " + m3_grade + "   " + str.tostring(m3_score, "#") + " / " + str.tostring(m3_maxScore, "#") + " ",
         text_color = m3_gradeCol, text_size = m3_sizeOf(m3_txtSize), bgcolor = m3_bgPanel)

    table.cell(m3_tbl, 0, 2,
         " STABILITY  " + str.tostring(m3_stabScore, "#") + " / " + str.tostring(m3_stabFull, "#") +
         "   " + str.tostring(m3_ratio, "#.##") + "x " + m3_stabWord + " ",
         text_color = m3_stabScore >= m3_stabFull ? m3_bgWhite : m3_stabScore > 0 ? m3_colMarg : m3_colDeg,
         text_size = m3_sizeOf(m3_txtSize), bgcolor = m3_bgPanel)

    table.cell(m3_tbl, 0, 3,
         " TREND      " + str.tostring(m3_trendScore, "#") + " / " + str.tostring(m3_adxCap, "#") +
         "   ADX " + str.tostring(m3_adx, "#.#") + " ",
         text_color = m3_bgWhite, text_size = m3_sizeOf(m3_txtSize), bgcolor = m3_bgPanel)

    table.cell(m3_tbl, 0, 4,
         " " + m3_trend + "  ·  held " + str.tostring(m3_held) + " bars ",
         text_color = m3_bgLabel, text_size = m3_sizeOf(m3_txtSize), bgcolor = m3_bgPanel)

    // Merging is only valid across more than one column.
    if m3_last > 0
        table.merge_cells(m3_tbl, 0, 0, m3_last, 0)
        table.merge_cells(m3_tbl, 0, 1, m3_last, 1)
        table.merge_cells(m3_tbl, 0, 2, m3_last, 2)
        table.merge_cells(m3_tbl, 0, 3, m3_last, 3)
        table.merge_cells(m3_tbl, 0, 4, m3_last, 4)

    // Score history -- oldest on the left, current on the right.
    if m3_stripOn
        for i = 0 to m3_last
            int   _idx = m3_last - i
            float _s   = m3_score[_idx]
            table.cell(m3_tbl, i, 5, "", bgcolor = na(_s) ? m3_bgPanel : m3_colOfScore(_s), width = 1, height = 1)

// ─── ALERTS ───────────────────────────────────────────────────
alertcondition(ta.crossover(m3_score, m3_cutPrime), "Regime turned prime",
     "The regime score has crossed into prime.")

alertcondition(ta.crossunder(m3_score, m3_cutMarg), "Regime degraded",
     "The regime score has dropped into degraded.")

alertcondition(m3_held == 0, "Regime grade changed",
     "The regime grade has changed on this timeframe.")


// ═══════════════════════════════════════════════════════════════
//  QUANT PRIME — BUILD MENU · RECOIL TIER
//  SIDE 1 · CANDLE CLOCK
// ───────────────────────────────────────────────────────────────
//  Nothing else in this menu tells you WHEN. Every other piece
//  reads a candle that has already closed, but a higher timeframe
//  candle spends most of its life unfinished, and what it is
//  going to become is often decided long before it prints.
//
//  For each timeframe this shows two numbers side by side: how
//  far through the candle you are, and how much of its usual
//  range it has already covered. Twenty percent through and
//  eighty percent of the range spent is a candle that is going to
//  matter. Eighty percent through and twenty percent spent is a
//  candle that is not.
//
//  It also counts down. A 3 hour candle that closes in four
//  minutes is about to be finalised, and whatever levels it
//  leaves behind are about to become real.
//
//  Draws one table. Safe to combine with any other Recoil piece.
//  All identifiers namespaced d1_ to avoid collisions.
// ═══════════════════════════════════════════════════════════════


// ─── TIMEFRAMES ───────────────────────────────────────────────
d1_gTf = "Timeframes"

d1_tf1On = input.bool(true, "Timeframe 1", group = d1_gTf, inline = "t1")
d1_tf1   = input.timeframe("3", "", group = d1_gTf, inline = "t1")

d1_tf2On = input.bool(true, "Timeframe 2", group = d1_gTf, inline = "t2")
d1_tf2   = input.timeframe("30", "", group = d1_gTf, inline = "t2")

d1_tf3On = input.bool(true, "Timeframe 3", group = d1_gTf, inline = "t3")
d1_tf3   = input.timeframe("180", "", group = d1_gTf, inline = "t3",
     tooltip = "Each enabled timeframe gets a row. Leave one off to keep the panel compact.")

d1_atrLen = input.int(8, "ATR Length", minval = 1, group = d1_gTf,
     tooltip = "The typical range each candle's progress is measured against, calculated on that timeframe's own data.")

// ─── PACE ─────────────────────────────────────────────────────
d1_gPace = "Pace"

d1_hotGap = input.float(20.0, "Expanding above", minval = 5.0, maxval = 80.0, step = 5.0, group = d1_gPace,
     tooltip = "When range used runs ahead of time elapsed by more than this many points, the candle is covering ground faster than its clock and reads as expanding.")

d1_coldGap = input.float(20.0, "Drifting below", minval = 5.0, maxval = 80.0, step = 5.0, group = d1_gPace,
     tooltip = "When time elapsed runs ahead of range used by more than this, the candle is going nowhere and reads as drifting.")

d1_warnMins = input.float(5.0, "Closing soon (minutes)", minval = 0.0, step = 1.0, group = d1_gPace,
     tooltip = "Highlights a timeframe when its candle is this close to closing. 0 disables it.")

// ─── PANEL ────────────────────────────────────────────────────
d1_gPanel = "Panel"

d1_pos = input.string("Bottom right", "Position", options = ["Top right", "Bottom right", "Bottom left", "Top left"], group = d1_gPanel,
     tooltip = "When combining several pieces, give each one its own corner so nothing stacks.")

d1_txtSize = input.string("Tiny", "Text size", options = ["Tiny", "Small", "Normal", "Large"], group = d1_gPanel)

d1_showBars = input.bool(true, "Show progress bars", group = d1_gPanel,
     tooltip = "Draws each percentage as a small block bar alongside the number, so the two can be compared at a glance.")

// ─── THEME ────────────────────────────────────────────────────
d1_gTheme = "Theme"

d1_bg     = input.color(#131313, "Panel background", group = d1_gTheme)
d1_title  = input.color(#c9a84c, "Title",            group = d1_gTheme)
d1_label  = input.color(#8a877f, "Labels",           group = d1_gTheme)
d1_white  = input.color(#e8e6e1, "Values",           group = d1_gTheme)
d1_border = input.color(#1a1d24, "Border",           group = d1_gTheme)
d1_hotCol = input.color(#ff9800, "Expanding",        group = d1_gTheme, inline = "hc")
d1_coldCol= input.color(#5b9cf6, "Drifting",         group = d1_gTheme, inline = "hc")
d1_warnCol= input.color(#f23645, "Closing soon",     group = d1_gTheme)

// ─── HELPERS ──────────────────────────────────────────────────
d1_tfLabel(string _tf) =>
    string _out = _tf
    float  _n   = str.tonumber(_tf)
    if not na(_n)
        int _m = int(_n)
        _out := _m >= 1440 and _m % 1440 == 0 ? str.tostring(_m / 1440) + "D" :
             _m >= 60 and _m % 60 == 0 ? str.tostring(_m / 60) + "H" :
             str.tostring(_m) + "M"
    _out

// Remaining time as h:mm or m:ss, whichever reads better.
d1_clock(float _ms) =>
    float _s   = math.max(0.0, _ms / 1000.0)
    int   _hh  = int(math.floor(_s / 3600))
    int   _mm  = int(math.floor((_s - _hh * 3600) / 60))
    int   _ss  = int(math.floor(_s - _hh * 3600 - _mm * 60))
    _hh > 0 ? str.tostring(_hh) + "h " + str.tostring(_mm) + "m" : str.tostring(_mm) + ":" + (_ss < 10 ? "0" : "") + str.tostring(_ss)

// A small block bar, ten cells wide.
d1_bar(float _pct) =>
    int _filled = int(math.round(math.min(100.0, math.max(0.0, _pct)) / 10.0))
    string _out = ""
    for i = 1 to 10
        _out := _out + (i <= _filled ? "▊" : "·")
    _out

d1_sizeOf(_s) =>
    _s == "Tiny" ? size.tiny : _s == "Small" ? size.small : _s == "Normal" ? size.normal : size.large

d1_posOf(_p) =>
    _p == "Top right" ? position.top_right : _p == "Bottom right" ? position.bottom_right : _p == "Bottom left" ? position.bottom_left : position.top_left

// ─── HIGHER TIMEFRAME READ ────────────────────────────────────
// The developing candle on each timeframe: when it opened, and
// how much range it has covered so far against its own typical.

d1_read() =>
    [time, high - low, ta.atr(d1_atrLen)]

[d1_t1, d1_r1, d1_a1] = request.security(syminfo.tickerid, d1_tf1, d1_read(), lookahead = barmerge.lookahead_off)
[d1_t2, d1_r2, d1_a2] = request.security(syminfo.tickerid, d1_tf2, d1_read(), lookahead = barmerge.lookahead_off)
[d1_t3, d1_r3, d1_a3] = request.security(syminfo.tickerid, d1_tf3, d1_read(), lookahead = barmerge.lookahead_off)

d1_secs1 = timeframe.in_seconds(d1_tf1) * 1000.0
d1_secs2 = timeframe.in_seconds(d1_tf2) * 1000.0
d1_secs3 = timeframe.in_seconds(d1_tf3) * 1000.0

d1_elapsed1 = timenow - d1_t1
d1_elapsed2 = timenow - d1_t2
d1_elapsed3 = timenow - d1_t3

d1_pctT1 = math.min(100.0, math.max(0.0, d1_elapsed1 / d1_secs1 * 100.0))
d1_pctT2 = math.min(100.0, math.max(0.0, d1_elapsed2 / d1_secs2 * 100.0))
d1_pctT3 = math.min(100.0, math.max(0.0, d1_elapsed3 / d1_secs3 * 100.0))

d1_pctR1 = d1_a1 > 0 ? d1_r1 / d1_a1 * 100.0 : 0.0
d1_pctR2 = d1_a2 > 0 ? d1_r2 / d1_a2 * 100.0 : 0.0
d1_pctR3 = d1_a3 > 0 ? d1_r3 / d1_a3 * 100.0 : 0.0

d1_left1 = d1_secs1 - d1_elapsed1
d1_left2 = d1_secs2 - d1_elapsed2
d1_left3 = d1_secs3 - d1_elapsed3

// ─── PANEL ────────────────────────────────────────────────────
var table d1_tbl = na

d1_paceWord(float _pctT, float _pctR) =>
    _pctR - _pctT > d1_hotGap ? "expanding" : _pctT - _pctR > d1_coldGap ? "drifting" : "steady"

d1_paceCol(float _pctT, float _pctR) =>
    _pctR - _pctT > d1_hotGap ? d1_hotCol : _pctT - _pctR > d1_coldGap ? d1_coldCol : d1_white

d1_row(int _r, bool _on, string _tf, float _pctT, float _pctR, float _left) =>
    if _on
        bool _soon = d1_warnMins > 0 and _left <= d1_warnMins * 60000.0
        table.cell(d1_tbl, 0, _r, " " + d1_tfLabel(_tf) + " ",
             text_color = _soon ? d1_warnCol : d1_white, text_size = d1_sizeOf(d1_txtSize), bgcolor = d1_bg)
        table.cell(d1_tbl, 1, _r, " " + str.tostring(_pctT, "#") + "% " + (d1_showBars ? d1_bar(_pctT) : "") + " ",
             text_color = d1_label, text_size = d1_sizeOf(d1_txtSize), bgcolor = d1_bg)
        table.cell(d1_tbl, 2, _r, " " + str.tostring(_pctR, "#") + "% " + (d1_showBars ? d1_bar(_pctR) : "") + " ",
             text_color = d1_paceCol(_pctT, _pctR), text_size = d1_sizeOf(d1_txtSize), bgcolor = d1_bg)
        table.cell(d1_tbl, 3, _r, " " + d1_paceWord(_pctT, _pctR) + " ",
             text_color = d1_paceCol(_pctT, _pctR), text_size = d1_sizeOf(d1_txtSize), bgcolor = d1_bg)
        table.cell(d1_tbl, 4, _r, " " + d1_clock(_left) + " ",
             text_color = _soon ? d1_warnCol : d1_label, text_size = d1_sizeOf(d1_txtSize), bgcolor = d1_bg)
    true

if barstate.islast
    if na(d1_tbl)
        d1_tbl := table.new(d1_posOf(d1_pos), 5, 5,
             bgcolor      = d1_bg,
             border_color = d1_border,
             border_width = 1,
             frame_color  = d1_title,
             frame_width  = 1)

    table.cell(d1_tbl, 0, 0, " QUANT PRIME — CANDLE CLOCK ",
         text_color = d1_title, text_size = d1_sizeOf(d1_txtSize), bgcolor = color.rgb(10, 10, 25))
    table.merge_cells(d1_tbl, 0, 0, 4, 0)

    table.cell(d1_tbl, 0, 1, " TF ",       text_color = d1_label, text_size = size.tiny, bgcolor = d1_bg)
    table.cell(d1_tbl, 1, 1, " ELAPSED ",  text_color = d1_label, text_size = size.tiny, bgcolor = d1_bg)
    table.cell(d1_tbl, 2, 1, " RANGE ",    text_color = d1_label, text_size = size.tiny, bgcolor = d1_bg)
    table.cell(d1_tbl, 3, 1, " PACE ",     text_color = d1_label, text_size = size.tiny, bgcolor = d1_bg)
    table.cell(d1_tbl, 4, 1, " CLOSES ",   text_color = d1_label, text_size = size.tiny, bgcolor = d1_bg)

    d1_row(2, d1_tf1On, d1_tf1, d1_pctT1, d1_pctR1, d1_left1)
    d1_row(3, d1_tf2On, d1_tf2, d1_pctT2, d1_pctR2, d1_left2)
    d1_row(4, d1_tf3On, d1_tf3, d1_pctT3, d1_pctR3, d1_left3)

// ─── ALERTS ───────────────────────────────────────────────────
d1_anyExpanding = (d1_tf1On and d1_pctR1 - d1_pctT1 > d1_hotGap) or (d1_tf2On and d1_pctR2 - d1_pctT2 > d1_hotGap) or (d1_tf3On and d1_pctR3 - d1_pctT3 > d1_hotGap)

alertcondition(d1_anyExpanding, "Candle expanding",
     "A tracked timeframe is covering range faster than its clock is running.")


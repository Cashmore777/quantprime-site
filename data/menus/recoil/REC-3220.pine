//@version=6
// =============================================================
//  QUANT PRIME — RECOIL BUILD  ·  REC-3220
// -------------------------------------------------------------
//  Volatility Levels + Volatility Zones + Position Sizer
//
//  Generated from the Recoil Build menu. Each piece keeps its
//  own settings group and its own namespace, so nothing here
//  interferes with anything else. Remove a piece by rebuilding
//  from the menu rather than editing this file.
// =============================================================

indicator("QP · Recoil 3220", shorttitle = "REC-3220", overlay = true, max_boxes_count = 500, max_labels_count = 500, max_lines_count = 500)

// ═══════════════════════════════════════════════════════════════
//  QUANT PRIME — BUILD MENU · RECOIL TIER
//  STARTER 3 · VOLATILITY LEVELS
// ───────────────────────────────────────────────────────────────
//  When a high volatility candle closes, four of its prices stop
//  being ordinary chart history and start being reference points:
//  the high and low it reached, the open it came from, and the
//  close it finished at. Price spends the following period
//  working around them.
//
//  This draws those four as rails extending right, and freezes
//  each one the moment price passes through it. A rail still
//  running is a level that has not yet been dealt with.
//
//  The close rail is handled differently to the others. Price is
//  sitting exactly on it the moment it is drawn, so it only
//  counts as broken once price has genuinely left it and later
//  come back.
//
//  Uses the same band engine as Volatility Bands, so the candle
//  that triggers a set here is the same candle that colours
//  yellow, orange or red there.
//
//  Draws no table. Safe to combine with any other Recoil piece.
//  All identifiers namespaced s3_ to avoid collisions.
// ═══════════════════════════════════════════════════════════════


// ─── TRIGGER ──────────────────────────────────────────────────
s3_gTrig = "Trigger"

s3_atrLen = input.int(8, "ATR Length", minval = 1, group = s3_gTrig,
     tooltip = "The volatility baseline. Matches the Recoil default.")

s3_trigBand = input.int(6, "Trigger from band # upward", minval = 6, maxval = 8, group = s3_gTrig,
     tooltip = "A candle closing in this band or higher lays down a new set of levels. 6 is the first high volatility band; raise to 7 or 8 for fewer, more significant sets.")

s3_minBodyAtr = input.float(0.5, "Min Body Size (x ATR)", minval = 0.0, step = 0.05, group = s3_gTrig,
     tooltip = "A candle's body must be at least this many ATRs to qualify. Filters out wide candles made mostly of wick. Set to 0 to disable.")

s3_maxSets = input.int(5, "Level sets kept on chart", minval = 1, maxval = 20, group = s3_gTrig,
     tooltip = "How many past expansion candles keep their levels drawn, broken ones included. Once this many sets exist, the oldest is removed from the chart entirely. Set to 1 to see only the most recent candle's levels.")

// ─── BAND THRESHOLDS ──────────────────────────────────────────
s3_gBand = "Band Thresholds"

s3_t1 = input.float(0.30, "Threshold 1", step = 0.05, group = s3_gBand)
s3_t2 = input.float(0.75, "Threshold 2", step = 0.05, group = s3_gBand)
s3_t3 = input.float(1.20, "Threshold 3", step = 0.05, group = s3_gBand)
s3_t4 = input.float(1.65, "Threshold 4", step = 0.05, group = s3_gBand)
s3_t5 = input.float(2.10, "Threshold 5", step = 0.05, group = s3_gBand)
s3_t6 = input.float(2.55, "Threshold 6", step = 0.05, group = s3_gBand)
s3_t7 = input.float(3.00, "Threshold 7", step = 0.05, group = s3_gBand)

// ─── BREAK RULE ───────────────────────────────────────────────
s3_gBreak = "Break Rule"

s3_breakMode = input.string("Wick touch", "A level is broken by", options = ["Wick touch", "Close beyond"], group = s3_gBreak,
     tooltip = "Wick touch freezes a rail as soon as price reaches it. Close beyond keeps the rail running until a candle actually finishes on the far side, so brief spikes through do not retire it.")

s3_keepBroken = input.bool(true, "Keep broken levels visible", group = s3_gBreak,
     tooltip = "On: a broken rail stops extending but stays on the chart as a faded dotted line. Off: it is removed entirely.")

s3_brokenFade = input.int(35, "Broken level fade", minval = 0, maxval = 90, group = s3_gBreak,
     tooltip = "How much a rail dims once it has been broken. Higher values push broken levels further into the background.")

// ─── LEVELS ───────────────────────────────────────────────────
s3_gLev = "Levels"

s3_hiOn = input.bool(true, "High",  group = s3_gLev, inline = "hl")
s3_loOn = input.bool(true, "Low",   group = s3_gLev, inline = "hl")
s3_opOn = input.bool(true, "Open",  group = s3_gLev, inline = "oc")
s3_clOn = input.bool(true, "Close", group = s3_gLev, inline = "oc")

s3_hlCol = input.color(#f23645, "High / Low color",   group = s3_gLev)
s3_ocCol = input.color(#c9a84c, "Open / Close color", group = s3_gLev)

s3_hlWidth = input.int(2, "High / Low width",   minval = 1, maxval = 4, group = s3_gLev)
s3_ocWidth = input.int(1, "Open / Close width", minval = 1, maxval = 4, group = s3_gLev)

s3_useBandCol = input.bool(false, "Color High / Low by source band", group = s3_gLev,
     tooltip = "On: the high and low rails take the colour of the candle that created them. Off: they use the fixed colour above.")

s3_c6 = input.color(#ffeb3b, "Band 6", group = s3_gLev, inline = "bc")
s3_c7 = input.color(#ff9800, "Band 7", group = s3_gLev, inline = "bc")
s3_c8 = input.color(#f23645, "Band 8", group = s3_gLev, inline = "bc")

// ─── DISPLAY ──────────────────────────────────────────────────
s3_gDisp = "Display"

s3_showKeys  = input.bool(true,  "Show level labels", group = s3_gDisp,
     tooltip = "A small H, L, O or C marker sitting at the right end of each rail.")
s3_showPrice = input.bool(false, "Include price in label", group = s3_gDisp)
s3_keySize   = input.string("Tiny", "Label size", options = ["Tiny", "Small", "Normal"], group = s3_gDisp)

// ─── BAND ENGINE ──────────────────────────────────────────────
// Identical classification to Volatility Bands.

s3_atr   = ta.atr(s3_atrLen)
s3_ratio = ta.tr(true) / s3_atr

s3_rawBand =
     s3_ratio < s3_t1 ? 1 :
     s3_ratio < s3_t2 ? 2 :
     s3_ratio < s3_t3 ? 3 :
     s3_ratio < s3_t4 ? 4 :
     s3_ratio < s3_t5 ? 5 :
     s3_ratio < s3_t6 ? 6 :
     s3_ratio < s3_t7 ? 7 : 8

s3_body    = math.abs(close - open)
s3_minBody = math.max(syminfo.mintick, s3_atr * s3_minBodyAtr)
s3_bodyOk  = s3_minBodyAtr <= 0 or s3_body > s3_minBody

s3_band = s3_rawBand >= 6 and not s3_bodyOk ? 5 : s3_rawBand

// ─── LEVEL SET ────────────────────────────────────────────────
//  side  = +1 when the level sat above price at creation,
//          -1 when below, 0 when price was exactly on it.
//  left  = has price genuinely moved off the level since it was
//          drawn. Only relevant for side 0.

type S3Lvl
    float px
    int   side
    bool  left
    bool  broken
    line  ln
    label ky

type S3Set
    S3Lvl hi
    S3Lvl lo
    S3Lvl op
    S3Lvl cl
    int   band

var S3Set[] s3_sets = array.new<S3Set>()

s3_sizeOf(_s) =>
    _s == "Tiny" ? size.tiny : _s == "Small" ? size.small : size.normal

s3_keyText(string _tag, float _px) =>
    s3_showPrice ? _tag + " " + str.tostring(_px, format.mintick) : _tag

s3_mkLvl(bool _on, float _px, int _side, string _tag, color _col, int _w, bool _dashed) =>
    line  _ln = na
    label _ky = na
    if _on
        _ln := line.new(bar_index, _px, bar_index + 1, _px, color = _col, width = _w,
             style = _dashed ? line.style_dashed : line.style_solid)
        if s3_showKeys
            _ky := label.new(bar_index, _px, s3_keyText(_tag, _px),
                 style     = label.style_label_left,
                 color     = color.new(color.black, 100),
                 textcolor = _col,
                 size      = s3_sizeOf(s3_keySize))
    S3Lvl.new(_px, _side, false, false, _ln, _ky)

// Advance one level: extend it, or freeze it if price went through.
s3_step(S3Lvl _l, color _col) =>
    if not _l.broken and not na(_l.ln)
        bool touched = high >= _l.px and low <= _l.px
        bool hit     = false

        if _l.side == 0
            // Level drawn at price. It must be left before a
            // return to it counts as breaking it.
            if not _l.left and not touched
                _l.left := true
            if _l.left
                hit := s3_breakMode == "Wick touch" ? touched : (close != _l.px and touched)
        else if _l.side > 0
            hit := s3_breakMode == "Wick touch" ? high >= _l.px : close > _l.px
        else
            hit := s3_breakMode == "Wick touch" ? low <= _l.px : close < _l.px

        if hit
            _l.broken := true
            if s3_keepBroken
                line.set_x2(_l.ln, bar_index)
                line.set_style(_l.ln, line.style_dotted)
                line.set_color(_l.ln, color.new(_col, s3_brokenFade))
                label.delete(_l.ky)
                _l.ky := na
            else
                line.delete(_l.ln)
                label.delete(_l.ky)
                _l.ln := na
                _l.ky := na
        else
            line.set_x2(_l.ln, bar_index)
            if not na(_l.ky)
                label.set_x(_l.ky, bar_index)
    true

s3_killLvl(S3Lvl _l) =>
    line.delete(_l.ln)
    label.delete(_l.ky)
    true

// ─── ENGINE ───────────────────────────────────────────────────
if barstate.isconfirmed

    // --- extend or freeze every live rail ---
    int s3_n = array.size(s3_sets)
    if s3_n > 0
        for i = 0 to s3_n - 1
            S3Set st  = array.get(s3_sets, i)
            color hlc = s3_useBandCol ? (st.band == 8 ? s3_c8 : st.band == 7 ? s3_c7 : s3_c6) : s3_hlCol
            s3_step(st.hi, hlc)
            s3_step(st.lo, hlc)
            s3_step(st.op, s3_ocCol)
            s3_step(st.cl, s3_ocCol)

    // --- a qualifying candle just closed: lay down a new set ---
    if s3_band >= s3_trigBand
        color hlc = s3_useBandCol ? (s3_band == 8 ? s3_c8 : s3_band == 7 ? s3_c7 : s3_c6) : s3_hlCol

        S3Lvl nHi = s3_mkLvl(s3_hiOn, high,  1, "H", hlc,      s3_hlWidth, false)
        S3Lvl nLo = s3_mkLvl(s3_loOn, low,  -1, "L", hlc,      s3_hlWidth, false)
        S3Lvl nOp = s3_mkLvl(s3_opOn, open, open > close ? 1 : open < close ? -1 : 0, "O", s3_ocCol, s3_ocWidth, true)
        S3Lvl nCl = s3_mkLvl(s3_clOn, close, 0, "C", s3_ocCol, s3_ocWidth, true)

        array.push(s3_sets, S3Set.new(nHi, nLo, nOp, nCl, s3_band))

        while array.size(s3_sets) > s3_maxSets
            S3Set old = array.shift(s3_sets)
            s3_killLvl(old.hi)
            s3_killLvl(old.lo)
            s3_killLvl(old.op)
            s3_killLvl(old.cl)

// ─── ALERTS ───────────────────────────────────────────────────
s3_newSet = barstate.isconfirmed and s3_band >= s3_trigBand

alertcondition(s3_newSet, "New volatility levels",
     "A high volatility candle has closed -- a new set of levels is on the chart.")


// ═══════════════════════════════════════════════════════════════
//  QUANT PRIME — BUILD MENU · RECOIL TIER
//  MAIN 2 · VOLATILITY ZONES
// ───────────────────────────────────────────────────────────────
//  A high volatility candle on a higher timeframe leaves behind
//  a span of price that got covered in one move. Price tends to
//  come back and work through it, and the quarter, half and
//  three-quarter marks of that span are where it tends to pause.
//
//  Every time a candle closes in band 6, 7 or 8 on one of the
//  chosen timeframes, four zones are drawn across its BODY -- at
//  the quarter, half, three-quarter and full marks, measured back
//  from where the move finished. Each zone extends right until
//  price reaches it, then freezes.
//
//  The zones are anchored to the higher timeframe candle's own
//  start, so they sit in the correct place whatever timeframe
//  the chart is on. A 3 hour candle's zones read the same on a 3
//  minute chart as they do on a 30 minute one.
//
//  Draws no table. Safe to combine with any other Recoil piece.
//  All identifiers namespaced m2_ to avoid collisions.
// ═══════════════════════════════════════════════════════════════


// ─── TIMEFRAMES ───────────────────────────────────────────────
m2_gTf = "Timeframes"

m2_tf1On = input.bool(true,  "Timeframe 1", group = m2_gTf, inline = "t1")
m2_tf1   = input.timeframe("3", "", group = m2_gTf, inline = "t1")

m2_tf2On = input.bool(true,  "Timeframe 2", group = m2_gTf, inline = "t2")
m2_tf2   = input.timeframe("30", "", group = m2_gTf, inline = "t2")

m2_tf3On = input.bool(true,  "Timeframe 3", group = m2_gTf, inline = "t3")
m2_tf3   = input.timeframe("180", "", group = m2_gTf, inline = "t3",
     tooltip = "Higher timeframes produce fewer, larger zones that stay relevant for longer. Turning all three on builds a layered map at the cost of a busier chart.")

// ─── ZONE MARKS ───────────────────────────────────────────────
m2_gMarks = "Zone Marks"

m2_z1On = input.bool(true, "Quarter", group = m2_gMarks, inline = "z1")
m2_z1a  = input.float(24.0, "from", step = 1.0, group = m2_gMarks, inline = "z1")
m2_z1b  = input.float(26.0, "to",   step = 1.0, group = m2_gMarks, inline = "z1")

m2_z2On = input.bool(true, "Half", group = m2_gMarks, inline = "z2")
m2_z2a  = input.float(48.0, "from", step = 1.0, group = m2_gMarks, inline = "z2")
m2_z2b  = input.float(52.0, "to",   step = 1.0, group = m2_gMarks, inline = "z2")

m2_z3On = input.bool(true, "Three quarter", group = m2_gMarks, inline = "z3")
m2_z3a  = input.float(74.0, "from", step = 1.0, group = m2_gMarks, inline = "z3")
m2_z3b  = input.float(76.0, "to",   step = 1.0, group = m2_gMarks, inline = "z3")

m2_z4On = input.bool(true, "Full", group = m2_gMarks, inline = "z4")
m2_z4a  = input.float(97.0, "from", step = 1.0, group = m2_gMarks, inline = "z4")
m2_z4b  = input.float(100.0, "to",  step = 1.0, group = m2_gMarks, inline = "z4",
     tooltip = "Each zone is a band between two percentages of the candle's span rather than a single line, so a near miss still counts as a reaction.")

// ─── TRIGGER ──────────────────────────────────────────────────
m2_gTrig = "Trigger"

m2_atrLen = input.int(8, "ATR Length", minval = 1, group = m2_gTrig,
     tooltip = "The volatility baseline, applied on each higher timeframe separately. Matches the Recoil default.")

m2_trigBand = input.int(6, "Trigger from band # upward", minval = 6, maxval = 8, group = m2_gTrig,
     tooltip = "A higher timeframe candle closing in this band or above lays down a set of zones. Raise to 7 or 8 for fewer, more significant sets.")

m2_minBodyAtr = input.float(0.5, "Min Body Size (x ATR)", minval = 0.0, step = 0.05, group = m2_gTrig,
     tooltip = "The candle's body must clear this to qualify. Filters out wide candles made mostly of wick. Set to 0 to disable.")

// ─── LIFECYCLE ────────────────────────────────────────────────
m2_gLife = "Lifecycle"

m2_tapMode = input.string("Wick touch", "A zone is reached by", options = ["Wick touch", "Close inside"], group = m2_gLife,
     tooltip = "Wick touch freezes a zone as soon as price reaches its edge. Close inside waits for a candle to actually finish within the zone.")

m2_keepTapped = input.bool(true, "Keep reached zones visible", group = m2_gLife,
     tooltip = "On: a reached zone stops extending but stays on the chart, faded. Off: it is removed entirely.")

m2_tappedFade = input.int(85, "Reached zone fade", minval = 50, maxval = 98, group = m2_gLife)

m2_maxZones = input.int(40, "Maximum zones on chart", minval = 4, maxval = 200, group = m2_gLife,
     tooltip = "Every qualifying candle creates up to four zones, so this fills faster than it looks. Once the limit is reached the oldest zones are removed.")

// ─── APPEARANCE ───────────────────────────────────────────────
m2_gApp = "Appearance"

m2_c6 = input.color(#ffeb3b, "Band 6", group = m2_gApp, inline = "bc")
m2_c7 = input.color(#ff9800, "Band 7", group = m2_gApp, inline = "bc")
m2_c8 = input.color(#f23645, "Band 8", group = m2_gApp, inline = "bc")

m2_zoneFade = input.int(88, "Zone transparency", minval = 60, maxval = 98, group = m2_gApp)
m2_border   = input.bool(false, "Show zone borders", group = m2_gApp)

m2_showLbl = input.bool(true, "Label zones", group = m2_gApp,
     tooltip = "Marks each zone with its percentage and the timeframe it came from.")

m2_lblSize = input.string("Tiny", "Label size", options = ["Tiny", "Small", "Normal"], group = m2_gApp)

// ─── HIGHER TIMEFRAME READ ────────────────────────────────────
// Returns the last COMPLETED candle on the requested timeframe:
// its band, its extremes, its open and close, and the timestamp
// it began at. Band classification is identical to Volatility
// Bands, computed on that timeframe's own ATR.

m2_htfRead() =>
    float _atr   = ta.atr(m2_atrLen)
    float _ratio = ta.tr(true) / _atr
    int   _raw   = _ratio < 0.30 ? 1 : _ratio < 0.75 ? 2 : _ratio < 1.20 ? 3 : _ratio < 1.65 ? 4 : _ratio < 2.10 ? 5 : _ratio < 2.55 ? 6 : _ratio < 3.00 ? 7 : 8
    float _body  = math.abs(close - open)
    float _minB  = math.max(syminfo.mintick, _atr * m2_minBodyAtr)
    bool  _ok    = m2_minBodyAtr <= 0 or _body > _minB
    int   _band  = _raw >= 6 and not _ok ? 5 : _raw
    [_band[1], high[1], low[1], open[1], close[1], time[1]]

[m2_b1, m2_h1, m2_l1, m2_o1, m2_c1x, m2_t1t] = request.security(syminfo.tickerid, m2_tf1, m2_htfRead(), lookahead = barmerge.lookahead_off)
[m2_b2, m2_h2, m2_l2, m2_o2, m2_c2x, m2_t2t] = request.security(syminfo.tickerid, m2_tf2, m2_htfRead(), lookahead = barmerge.lookahead_off)
[m2_b3, m2_h3, m2_l3, m2_o3, m2_c3x, m2_t3t] = request.security(syminfo.tickerid, m2_tf3, m2_htfRead(), lookahead = barmerge.lookahead_off)

// ─── ZONE STORE ───────────────────────────────────────────────
type M2Zone
    float top
    float bot
    bool  tapped
    box   bx
    label lb

var M2Zone[] m2_zones = array.new<M2Zone>()

m2_sizeOf(_s) =>
    _s == "Tiny" ? size.tiny : _s == "Small" ? size.small : size.normal

m2_bandCol(int _b) =>
    _b == 8 ? m2_c8 : _b == 7 ? m2_c7 : m2_c6

// Turns a timeframe string into something readable. TradingView
// stores intraday timeframes as plain minutes, so "180" needs to
// come out as "3H" rather than being mistaken for a percentage.
m2_tfLabel(string _tf) =>
    string _out = _tf
    float  _n   = str.tonumber(_tf)
    if not na(_n)
        int _m = int(_n)
        _out := _m >= 1440 and _m % 1440 == 0 ? str.tostring(_m / 1440) + "D" :
             _m >= 60 and _m % 60 == 0 ? str.tostring(_m / 60) + "H" :
             str.tostring(_m) + "M"
    _out

// Build one zone between two percentages of the candle's span.
m2_addZone(bool _on, float _pa, float _pb, string _zName, float _anchor, float _span, int _dir, int _band, int _startT, string _tfName) =>
    if _on and _span > 0
        float _p1 = _anchor + _dir * _span * _pa / 100.0
        float _p2 = _anchor + _dir * _span * _pb / 100.0
        float _top = math.max(_p1, _p2)
        float _bot = math.min(_p1, _p2)
        color _col = m2_bandCol(_band)

        box _bx = box.new(_startT, _top, time, _bot,
             xloc         = xloc.bar_time,
             bgcolor      = color.new(_col, m2_zoneFade),
             border_color = m2_border ? color.new(_col, 40) : color.new(_col, 100),
             border_width = m2_border ? 1 : 0)

        label _lb = na
        if m2_showLbl
            _lb := label.new(time, _top, _tfName + " · " + _zName,
                 xloc      = xloc.bar_time,
                 style     = label.style_label_left,
                 color     = color.new(color.black, 100),
                 textcolor = color.new(_col, 20),
                 size      = m2_sizeOf(m2_lblSize))

        array.push(m2_zones, M2Zone.new(_top, _bot, false, _bx, _lb))

// Lay down a full set of four from one qualifying candle.
m2_addSet(int _band, float _h, float _l, float _o, float _c, int _startT, string _tfName) =>
    // The span is the BODY, open to close. Wicks are rejection,
    // not the move, and everything else in this method measures
    // against the body -- targets, stops, the minimum size filter.
    //
    // Zones are read as a retracement of that move, measured back
    // from where it finished. A bullish candle puts 25% just below
    // its close and 100% down at its open; a bearish one puts 25%
    // just above its close and 100% up at its open. Price coming
    // back into the candle meets the small marks first.
    float _anchor = _c
    float _far    = _o
    float _span   = math.abs(_far - _anchor)
    int   _dir    = _far >= _anchor ? 1 : -1

    m2_addZone(m2_z1On, m2_z1a, m2_z1b, "25%",  _anchor, _span, _dir, _band, _startT, _tfName)
    m2_addZone(m2_z2On, m2_z2a, m2_z2b, "50%",  _anchor, _span, _dir, _band, _startT, _tfName)
    m2_addZone(m2_z3On, m2_z3a, m2_z3b, "75%",  _anchor, _span, _dir, _band, _startT, _tfName)
    m2_addZone(m2_z4On, m2_z4a, m2_z4b, "100%", _anchor, _span, _dir, _band, _startT, _tfName)

// ─── ENGINE ───────────────────────────────────────────────────
m2_new1 = m2_tf1On and ta.change(m2_t1t) != 0 and m2_b1 >= m2_trigBand
m2_new2 = m2_tf2On and ta.change(m2_t2t) != 0 and m2_b2 >= m2_trigBand
m2_new3 = m2_tf3On and ta.change(m2_t3t) != 0 and m2_b3 >= m2_trigBand

if barstate.isconfirmed

    // --- extend live zones, freeze the ones price has reached ---
    int m2_n = array.size(m2_zones)
    if m2_n > 0
        for i = 0 to m2_n - 1
            M2Zone z = array.get(m2_zones, i)
            if not z.tapped
                bool _touch = high >= z.bot and low <= z.top
                bool _in    = close <= z.top and close >= z.bot
                bool _hit   = m2_tapMode == "Wick touch" ? _touch : _in
                if _hit
                    z.tapped := true
                    if m2_keepTapped
                        box.set_right(z.bx, time)
                        box.set_bgcolor(z.bx, color.new(m2_c6, m2_tappedFade))
                        label.delete(z.lb)
                        z.lb := na
                    else
                        box.delete(z.bx)
                        label.delete(z.lb)
                        z.bx := na
                        z.lb := na
                else
                    box.set_right(z.bx, time)
                    if not na(z.lb)
                        label.set_x(z.lb, time)

    // --- new qualifying candles ---
    if m2_new1
        m2_addSet(m2_b1, m2_h1, m2_l1, m2_o1, m2_c1x, m2_t1t, m2_tfLabel(m2_tf1))
    if m2_new2
        m2_addSet(m2_b2, m2_h2, m2_l2, m2_o2, m2_c2x, m2_t2t, m2_tfLabel(m2_tf2))
    if m2_new3
        m2_addSet(m2_b3, m2_h3, m2_l3, m2_o3, m2_c3x, m2_t3t, m2_tfLabel(m2_tf3))

    while array.size(m2_zones) > m2_maxZones
        M2Zone old = array.shift(m2_zones)
        box.delete(old.bx)
        label.delete(old.lb)

// ─── ALERTS ───────────────────────────────────────────────────
alertcondition(m2_new1 or m2_new2 or m2_new3, "New volatility zones",
     "A high volatility candle has closed on a tracked timeframe -- new zones are on the chart.")


// ═══════════════════════════════════════════════════════════════
//  QUANT PRIME — BUILD MENU · RECOIL TIER
//  SIDE 2 · POSITION SIZER
// ───────────────────────────────────────────────────────────────
//  A stop that moves with volatility means a position size that
//  has to move with it too. Trading a fixed lot through changing
//  conditions is not consistent risk -- it is the same size
//  taking wildly different amounts off the account depending on
//  how wide the correct stop happened to be that hour.
//
//  This reads the stop distance straight off the chart, applies
//  the risk you are willing to take, and returns the size that
//  makes those two agree. Long and short are shown separately
//  because their stops are not the same distance away.
//
//  It calculates its own stop rather than depending on any other
//  piece, so it works on its own.
//
//  Draws one table. Safe to combine with any other Recoil piece.
//  All identifiers namespaced d2_ to avoid collisions.
// ═══════════════════════════════════════════════════════════════


// ─── ACCOUNT ──────────────────────────────────────────────────
d2_gAcct = "Account"

d2_balance = input.float(1000.0, "Account balance", minval = 1.0, step = 100.0, group = d2_gAcct,
     tooltip = "Your own figure. Nothing is read from a broker -- this is a calculator, not a connection.")

d2_ccy = input.string("£", "Currency symbol", group = d2_gAcct)

d2_riskMode = input.string("Percent of balance", "Risk as", options = ["Percent of balance", "Fixed amount"], group = d2_gAcct)

d2_riskPct = input.float(1.0, "Risk percent", minval = 0.01, maxval = 100.0, step = 0.25, group = d2_gAcct)

d2_riskAmt = input.float(10.0, "Risk amount", minval = 0.01, step = 1.0, group = d2_gAcct)

// ─── STOP ─────────────────────────────────────────────────────
d2_gStop = "Stop"

d2_atrLen = input.int(8, "ATR Length", minval = 1, group = d2_gStop,
     tooltip = "The volatility baseline the buffer is measured in. Matches the Recoil default.")

d2_buffer = input.float(3.0, "Wick buffer (x ATR)", minval = 0.0, step = 0.25, group = d2_gStop,
     tooltip = "How far beyond the current candle's wick the stop sits. 3.0 is the Recoil scalping default. Set both this and ATR Length to match whatever you actually trade.")

d2_manualOn = input.bool(false, "Use a manual stop distance instead", group = d2_gStop,
     tooltip = "Ignores the chart and sizes against a fixed pip distance you type in. Useful for planning a trade you have already decided the stop for.")

d2_manualPips = input.float(10.0, "Manual stop (pips)", minval = 0.1, step = 0.5, group = d2_gStop)

// ─── INSTRUMENT ───────────────────────────────────────────────
d2_gInst = "Instrument"

d2_pipIn = input.float(0.0, "Pip size (0 = auto)", step = 0.00001, minval = 0.0, group = d2_gInst,
     tooltip = "Leave at 0 for automatic detection. Override where the automatic value is wrong -- for example set 1.0 for BTCUSD.")

d2_contract = input.float(100000.0, "Units per lot", minval = 1.0, step = 1000.0, group = d2_gInst,
     tooltip = "100000 for a standard forex lot. Set to 1 on instruments quoted in units rather than lots, and the size column reads as a straight unit count.")

d2_convert = input.float(1.0, "Conversion rate", minval = 0.0001, step = 0.01, group = d2_gInst,
     tooltip = "Only needed when the instrument's quote currency is not your account currency. On EURUSD with a dollar account, leave at 1. On EURGBP with a dollar account, set this to the GBP to USD rate. Getting it wrong scales every size shown here by the same factor.")

d2_maxLots = input.float(0.0, "Warn above N lots", minval = 0.0, step = 0.1, group = d2_gInst,
     tooltip = "Highlights the size in red when the calculation returns more than this. 0 disables it.")

// ─── PANEL ────────────────────────────────────────────────────
d2_gPanel = "Panel"

d2_pos = input.string("Bottom right", "Position", options = ["Top right", "Bottom right", "Bottom left", "Top left"], group = d2_gPanel,
     tooltip = "When combining several pieces, give each one its own corner so nothing stacks.")

d2_txtSize = input.string("Tiny", "Text size", options = ["Tiny", "Small", "Normal", "Large"], group = d2_gPanel)

d2_showLines = input.bool(true, "Show the stop levels on the chart", group = d2_gPanel)

// ─── THEME ────────────────────────────────────────────────────
d2_gTheme = "Theme"

d2_bg     = input.color(#131313, "Panel background", group = d2_gTheme)
d2_title  = input.color(#c9a84c, "Title",            group = d2_gTheme)
d2_label  = input.color(#8a877f, "Labels",           group = d2_gTheme)
d2_white  = input.color(#e8e6e1, "Values",           group = d2_gTheme)
d2_border = input.color(#1a1d24, "Border",           group = d2_gTheme)
d2_longC  = input.color(#00abff, "Long",             group = d2_gTheme, inline = "ls")
d2_shortC = input.color(#c9a84c, "Short",            group = d2_gTheme, inline = "ls")
d2_warnC  = input.color(#f23645, "Warning",          group = d2_gTheme)

// ─── ENGINE ───────────────────────────────────────────────────
d2_pipAuto = syminfo.mintick * (syminfo.mintick == 0.00001 or syminfo.mintick == 0.001 ? 10 : 1)
d2_pip     = d2_pipIn > 0 ? d2_pipIn : d2_pipAuto

d2_atr = ta.atr(d2_atrLen)

// Stop levels, taken from the current candle's own extremes.
d2_longStop  = low  - d2_atr * d2_buffer
d2_shortStop = high + d2_atr * d2_buffer

// Distance in price, then in pips.
d2_longDist  = d2_manualOn ? d2_manualPips * d2_pip : math.max(close - d2_longStop,  syminfo.mintick)
d2_shortDist = d2_manualOn ? d2_manualPips * d2_pip : math.max(d2_shortStop - close, syminfo.mintick)

d2_longPips  = d2_longDist  / d2_pip
d2_shortPips = d2_shortDist / d2_pip

// What is actually at risk.
d2_risk = d2_riskMode == "Percent of balance" ? d2_balance * d2_riskPct / 100.0 : d2_riskAmt

// Value of one pip on one lot, in account currency.
d2_pipValue = d2_pip * d2_contract * d2_convert

d2_longLots  = d2_pipValue > 0 and d2_longPips  > 0 ? d2_risk / (d2_longPips  * d2_pipValue) : 0.0
d2_shortLots = d2_pipValue > 0 and d2_shortPips > 0 ? d2_risk / (d2_shortPips * d2_pipValue) : 0.0

// What the sized position gains or loses per pip of movement.
d2_longPerPip  = d2_longLots  * d2_pipValue
d2_shortPerPip = d2_shortLots * d2_pipValue

d2_longWarn  = d2_maxLots > 0 and d2_longLots  > d2_maxLots
d2_shortWarn = d2_maxLots > 0 and d2_shortLots > d2_maxLots

// ─── STOP LEVELS ON CHART ─────────────────────────────────────
plot(d2_showLines and not d2_manualOn ? d2_longStop : na, title = "Long stop",
     color = d2_longC, linewidth = 1, style = plot.style_linebr)

plot(d2_showLines and not d2_manualOn ? d2_shortStop : na, title = "Short stop",
     color = d2_shortC, linewidth = 1, style = plot.style_linebr)

// ─── PANEL ────────────────────────────────────────────────────
d2_sizeOf(_s) =>
    _s == "Tiny" ? size.tiny : _s == "Small" ? size.small : _s == "Normal" ? size.normal : size.large

d2_posOf(_p) =>
    _p == "Top right" ? position.top_right : _p == "Bottom right" ? position.bottom_right : _p == "Bottom left" ? position.bottom_left : position.top_left

// Lots need more decimals than units do.
d2_lotStr(float _l) =>
    _l >= 100 ? str.tostring(_l, "#") : _l >= 10 ? str.tostring(_l, "#.#") : str.tostring(_l, "#.##")

var table d2_tbl = na

if barstate.islast
    if na(d2_tbl)
        d2_tbl := table.new(d2_posOf(d2_pos), 3, 7,
             bgcolor      = d2_bg,
             border_color = d2_border,
             border_width = 1,
             frame_color  = d2_title,
             frame_width  = 1)

    string _sz = d2_txtSize

    table.cell(d2_tbl, 0, 0, " QUANT PRIME — POSITION SIZER ",
         text_color = d2_title, text_size = d2_sizeOf(_sz), bgcolor = color.rgb(10, 10, 25))
    table.merge_cells(d2_tbl, 0, 0, 2, 0)

    table.cell(d2_tbl, 0, 1, " RISK ", text_color = d2_label, text_size = size.tiny, bgcolor = d2_bg)
    table.cell(d2_tbl, 1, 1,
         " " + d2_ccy + str.tostring(d2_risk, "#.##") +
         (d2_riskMode == "Percent of balance" ? "  ·  " + str.tostring(d2_riskPct, "#.##") + "% of " + d2_ccy + str.tostring(d2_balance, "#") : "") + " ",
         text_color = d2_white, text_size = d2_sizeOf(_sz), bgcolor = d2_bg)
    table.merge_cells(d2_tbl, 1, 1, 2, 1)

    table.cell(d2_tbl, 0, 2, "",        text_color = d2_label, text_size = size.tiny, bgcolor = d2_bg)
    table.cell(d2_tbl, 1, 2, " LONG ",  text_color = d2_longC, text_size = size.tiny, bgcolor = d2_bg)
    table.cell(d2_tbl, 2, 2, " SHORT ", text_color = d2_shortC, text_size = size.tiny, bgcolor = d2_bg)

    table.cell(d2_tbl, 0, 3, " STOP ", text_color = d2_label, text_size = d2_sizeOf(_sz), bgcolor = d2_bg)
    table.cell(d2_tbl, 1, 3, " " + str.tostring(d2_longPips,  "#.#") + " pips ", text_color = d2_white, text_size = d2_sizeOf(_sz), bgcolor = d2_bg)
    table.cell(d2_tbl, 2, 3, " " + str.tostring(d2_shortPips, "#.#") + " pips ", text_color = d2_white, text_size = d2_sizeOf(_sz), bgcolor = d2_bg)

    table.cell(d2_tbl, 0, 4, " SIZE ", text_color = d2_label, text_size = d2_sizeOf(_sz), bgcolor = d2_bg)
    table.cell(d2_tbl, 1, 4, " " + d2_lotStr(d2_longLots)  + " lots ", text_color = d2_longWarn  ? d2_warnC : d2_longC,  text_size = d2_sizeOf(_sz), bgcolor = d2_bg)
    table.cell(d2_tbl, 2, 4, " " + d2_lotStr(d2_shortLots) + " lots ", text_color = d2_shortWarn ? d2_warnC : d2_shortC, text_size = d2_sizeOf(_sz), bgcolor = d2_bg)

    table.cell(d2_tbl, 0, 5, " PER PIP ", text_color = d2_label, text_size = d2_sizeOf(_sz), bgcolor = d2_bg)
    table.cell(d2_tbl, 1, 5, " " + d2_ccy + str.tostring(d2_longPerPip,  "#.##") + " ", text_color = d2_white, text_size = d2_sizeOf(_sz), bgcolor = d2_bg)
    table.cell(d2_tbl, 2, 5, " " + d2_ccy + str.tostring(d2_shortPerPip, "#.##") + " ", text_color = d2_white, text_size = d2_sizeOf(_sz), bgcolor = d2_bg)

    table.cell(d2_tbl, 0, 6,
         " " + (d2_manualOn ? "manual stop " + str.tostring(d2_manualPips, "#.#") + " pips" :
              "wick + " + str.tostring(d2_buffer, "#.##") + " ATR") +
         "  ·  " + d2_ccy + str.tostring(d2_pipValue, "#.##") + " per pip per lot ",
         text_color = d2_label, text_size = size.tiny, bgcolor = d2_bg, text_formatting = text.format_italic)
    table.merge_cells(d2_tbl, 0, 6, 2, 6)

// ─── ALERTS ───────────────────────────────────────────────────
alertcondition(d2_longWarn or d2_shortWarn, "Position size above limit",
     "The calculated position size has exceeded the limit set on this instrument.")


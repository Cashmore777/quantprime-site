//@version=6
indicator("Quant Prime — Suite [S1+M3+D3]", overlay=true)

// ============================================================
// S1 — Regime Score Ribbon
// ============================================================

// ============================================================
// COC-S1 — Regime Score Ribbon
// Suite Build menu · Starter course
// Draws no tables (per QP Build convention for Starter pieces)
// ============================================================

// === Regime Score Inputs ===
s1_grp1 = "[S1] Regime Score"
s1_atrLen      = input.int(14, "ATR Length", group=s1_grp1)
s1_atrBaseLen  = input.int(100, "ATR Baseline Length", group=s1_grp1)
s1_adxLen      = input.int(14, "DMI Length", group=s1_grp1)
s1_adxSmooth   = input.int(14, "ADX Smoothing", group=s1_grp1)

s1_grp2 = "[S1] Grade Thresholds (0-90 scale)"
s1_primeMin      = input.int(68, "PRIME minimum", group=s1_grp2)
s1_favourableMin = input.int(45, "FAVOURABLE minimum", group=s1_grp2)
s1_marginalMin   = input.int(23, "MARGINAL minimum", group=s1_grp2)

s1_grp3 = "[S1] Ribbon"
s1_ribbonOffsetATR = input.float(1.5, "Ribbon Offset (x ATR below low)", minval=0.1, group=s1_grp3)
s1_ribbonWidth     = input.int(3, "Ribbon Thickness", minval=1, maxval=10, group=s1_grp3)

s1_grp4 = "[S1] Regime Colours"
s1_colPrime      = input.color(#c9a84c, "PRIME", group=s1_grp4)
s1_colFavourable = input.color(#00abff, "FAVOURABLE", group=s1_grp4)
s1_colMarginal   = input.color(#ff9800, "MARGINAL", group=s1_grp4)
s1_colDegraded   = input.color(#f23645, "DEGRADED", group=s1_grp4)

// === Volatility component (0-45): penalises deviation from baseline in either direction ===
s1_atrNow   = ta.atr(s1_atrLen)
s1_atrBase  = ta.sma(s1_atrNow, s1_atrBaseLen)
s1_volRatio = s1_atrBase == 0 ? 1.0 : s1_atrNow / s1_atrBase
s1_volDeviation = math.abs(s1_volRatio - 1.0)
s1_volScore = math.max(0.0, 45.0 - (s1_volDeviation * 90.0))

// === Trend-strength component (0-45): moderate ADX scores highest, extreme ADX decays ===
[s1_diplus, s1_diminus, s1_adx] = ta.dmi(s1_adxLen, s1_adxSmooth)
s1_adxScore = s1_adx <= 40 ? math.min(45.0, (s1_adx / 40.0) * 45.0) : math.max(0.0, 45.0 - ((s1_adx - 40.0) * 1.5))

// === Composite Regime Score (0-90) ===
s1_regimeScore = s1_volScore + s1_adxScore

s1_gradeColor = s1_regimeScore >= s1_primeMin ? s1_colPrime : s1_regimeScore >= s1_favourableMin ? s1_colFavourable : s1_regimeScore >= s1_marginalMin ? s1_colMarginal : s1_colDegraded

// === Ribbon plot — offset below current low, colour-graded by regime ===
s1_ribbonY = low - (s1_atrNow * s1_ribbonOffsetATR)
plot(s1_ribbonY, "Regime Ribbon", color=s1_gradeColor, linewidth=s1_ribbonWidth, style=plot.style_line)

// ============================================================
// M3 — Session Regime Tracker
// ============================================================

// ============================================================
// COC-M3 — Session Regime Tracker
// Suite Build menu · Main course
// Draws one table, top-right (Main course convention — only one
// Main-course piece is ever active in a given Build combination)
// Live m3_tracker of how the m3_grade has moved through the CURRENT
// session so far, not a historical multi-session report (that's
// Dessert-course territory)
// ============================================================

m3_grp1 = "[M3] Regime Score"
m3_atrLen      = input.int(14, "ATR Length", group=m3_grp1)
m3_atrBaseLen  = input.int(100, "ATR Baseline Length", group=m3_grp1)
m3_adxLen      = input.int(14, "DMI Length", group=m3_grp1)
m3_adxSmooth   = input.int(14, "ADX Smoothing", group=m3_grp1)

m3_grp2 = "[M3] Grade Thresholds (0-90 scale)"
m3_primeMin      = input.int(68, "PRIME minimum", group=m3_grp2)
m3_favourableMin = input.int(45, "FAVOURABLE minimum", group=m3_grp2)
m3_marginalMin   = input.int(23, "MARGINAL minimum", group=m3_grp2)

m3_grp3 = "[M3] Session"
m3_sessionInput = input.session("0000-2400", "Session (UTC) — default resets daily at 00:00 UTC", group=m3_grp3)
m3_showSessionZone  = input.bool(true, "Highlight Session Zone", group=m3_grp3)
m3_sessionZoneColor = input.color(color.new(#c9a84c, 90), "Session Zone Colour", group=m3_grp3)

m3_grp4 = "[M3] Regime Colours"
m3_colPrime      = input.color(#c9a84c, "PRIME", group=m3_grp4)
m3_colFavourable = input.color(#00abff, "FAVOURABLE", group=m3_grp4)
m3_colMarginal   = input.color(#ff9800, "MARGINAL", group=m3_grp4)
m3_colDegraded   = input.color(#f23645, "DEGRADED", group=m3_grp4)

m3_grp5 = "[M3] Table"
m3_tableSize = input.string(size.small, "Table Text Size", options=[size.tiny, size.small, size.normal], group=m3_grp5)

// === Volatility component (0-45) ===
m3_atrNow   = ta.atr(m3_atrLen)
m3_atrBase  = ta.sma(m3_atrNow, m3_atrBaseLen)
m3_volRatio = m3_atrBase == 0 ? 1.0 : m3_atrNow / m3_atrBase
m3_volDeviation = math.abs(m3_volRatio - 1.0)
m3_volScore = math.max(0.0, 45.0 - (m3_volDeviation * 90.0))

// === Trend-strength component (0-45) ===
[m3_diplus, m3_diminus, m3_adx] = ta.dmi(m3_adxLen, m3_adxSmooth)
m3_adxScore = m3_adx <= 40 ? math.min(45.0, (m3_adx / 40.0) * 45.0) : math.max(0.0, 45.0 - ((m3_adx - 40.0) * 1.5))

// === Composite Regime Score (0-90) + Grade ===
m3_regimeScore = m3_volScore + m3_adxScore
m3_grade      = m3_regimeScore >= m3_primeMin ? "PRIME" : m3_regimeScore >= m3_favourableMin ? "FAVOURABLE" : m3_regimeScore >= m3_marginalMin ? "MARGINAL" : "DEGRADED"
m3_gradeColor = m3_regimeScore >= m3_primeMin ? m3_colPrime : m3_regimeScore >= m3_favourableMin ? m3_colFavourable : m3_regimeScore >= m3_marginalMin ? m3_colMarginal : m3_colDegraded

// === Session boundary detection (custom UTC session window, not just exchange session) ===
m3_inSession  = not na(time(timeframe.period, m3_sessionInput, "UTC"))
m3_newSession = m3_inSession and not m3_inSession[1]

// === Background shading over exactly the bars being graded ===
bgcolor(m3_showSessionZone and m3_inSession ? m3_sessionZoneColor : na, title="Session Zone")

// === Session tracking state ===
var float m3_openScore   = na
var string m3_openGrade  = na
var float m3_bestScore   = na
var float m3_worstScore  = na
var int m3_changeCount   = 0
var string m3_prevGrade  = na

if m3_newSession
    m3_openScore  := m3_regimeScore
    m3_openGrade  := m3_grade
    m3_bestScore  := m3_regimeScore
    m3_worstScore := m3_regimeScore
    m3_changeCount := 0
    m3_prevGrade  := m3_grade
else if m3_inSession
    m3_bestScore  := math.max(m3_bestScore, m3_regimeScore)
    m3_worstScore := math.min(m3_worstScore, m3_regimeScore)
    if not na(m3_prevGrade) and m3_grade != m3_prevGrade
        m3_changeCount := m3_changeCount + 1
    m3_prevGrade := m3_grade

m3_bestGrade  = na(m3_bestScore) ? na : (m3_bestScore >= m3_primeMin ? "PRIME" : m3_bestScore >= m3_favourableMin ? "FAVOURABLE" : m3_bestScore >= m3_marginalMin ? "MARGINAL" : "DEGRADED")
m3_worstGrade = na(m3_worstScore) ? na : (m3_worstScore >= m3_primeMin ? "PRIME" : m3_worstScore >= m3_favourableMin ? "FAVOURABLE" : m3_worstScore >= m3_marginalMin ? "MARGINAL" : "DEGRADED")
m3_bestColor  = na(m3_bestScore) ? color.white : (m3_bestScore >= m3_primeMin ? m3_colPrime : m3_bestScore >= m3_favourableMin ? m3_colFavourable : m3_bestScore >= m3_marginalMin ? m3_colMarginal : m3_colDegraded)
m3_worstColor = na(m3_worstScore) ? color.white : (m3_worstScore >= m3_primeMin ? m3_colPrime : m3_worstScore >= m3_favourableMin ? m3_colFavourable : m3_worstScore >= m3_marginalMin ? m3_colMarginal : m3_colDegraded)
m3_openColor  = na(m3_openScore) ? color.white : (m3_openScore >= m3_primeMin ? m3_colPrime : m3_openScore >= m3_favourableMin ? m3_colFavourable : m3_openScore >= m3_marginalMin ? m3_colMarginal : m3_colDegraded)

// === QP dark/gold dashboard theme ===
m3_bgHeader = color.new(#1a1a1a, 0)
m3_bgRow    = color.new(#0d0d0d, 10)
m3_txtMuted = color.new(color.white, 40)
m3_txtGold  = color.new(#c9a84c, 0)

// === Table — one table, top right ===
var table m3_tracker = table.new(position.top_right, 2, 6, border_width=1)

if barstate.islast
    table.cell(m3_tracker, 0, 0, "SESSION REGIME TRACKER", text_color=m3_txtGold, bgcolor=m3_bgHeader, text_size=m3_tableSize)
    table.cell(m3_tracker, 1, 0, "", bgcolor=m3_bgHeader, text_size=m3_tableSize)

    table.cell(m3_tracker, 0, 1, "Session Open", text_color=m3_txtMuted, bgcolor=m3_bgRow, text_size=m3_tableSize)
    table.cell(m3_tracker, 1, 1, na(m3_openGrade) ? "—" : m3_openGrade, text_color=m3_openColor, bgcolor=m3_bgRow, text_size=m3_tableSize)

    table.cell(m3_tracker, 0, 2, "Current", text_color=m3_txtMuted, bgcolor=m3_bgRow, text_size=m3_tableSize)
    table.cell(m3_tracker, 1, 2, m3_grade, text_color=m3_gradeColor, bgcolor=m3_bgRow, text_size=m3_tableSize)

    table.cell(m3_tracker, 0, 3, "Session Best", text_color=m3_txtMuted, bgcolor=m3_bgRow, text_size=m3_tableSize)
    table.cell(m3_tracker, 1, 3, na(m3_bestGrade) ? "—" : m3_bestGrade, text_color=m3_bestColor, bgcolor=m3_bgRow, text_size=m3_tableSize)

    table.cell(m3_tracker, 0, 4, "Session Worst", text_color=m3_txtMuted, bgcolor=m3_bgRow, text_size=m3_tableSize)
    table.cell(m3_tracker, 1, 4, na(m3_worstGrade) ? "—" : m3_worstGrade, text_color=m3_worstColor, bgcolor=m3_bgRow, text_size=m3_tableSize)

    table.cell(m3_tracker, 0, 5, "Grade Changes", text_color=m3_txtMuted, bgcolor=m3_bgRow, text_size=m3_tableSize)
    table.cell(m3_tracker, 1, 5, str.tostring(m3_changeCount), text_color=color.white, bgcolor=m3_bgRow, text_size=m3_tableSize)

// ============================================================
// D3 — Regime Alert Panel
// ============================================================

// ============================================================
// COC-D3 — Regime Alert Panel
// Suite Build menu · Side course
// Draws one table, bottom-left (Side course convention)
// Lists currently-active regime CONDITIONS — analytical state
// flags only. This is explicitly not an entry signal d3_panel:
// nothing here fires an alert to buy or sell, only to describe
// what the market is currently doing
// ============================================================

d3_grp1 = "[D3] Regime Score"
d3_atrLen      = input.int(14, "ATR Length", group=d3_grp1)
d3_atrBaseLen  = input.int(100, "ATR Baseline Length", group=d3_grp1)
d3_adxLen      = input.int(14, "DMI Length", group=d3_grp1)
d3_adxSmooth   = input.int(14, "ADX Smoothing", group=d3_grp1)

d3_grp2 = "[D3] Grade Thresholds (0-90 scale)"
d3_primeMin      = input.int(68, "PRIME minimum", group=d3_grp2)
d3_favourableMin = input.int(45, "FAVOURABLE minimum", group=d3_grp2)
d3_marginalMin   = input.int(23, "MARGINAL minimum", group=d3_grp2)

d3_grp3 = "[D3] Regime Colours"
d3_colPrime      = input.color(#c9a84c, "PRIME", group=d3_grp3)
d3_colFavourable = input.color(#00abff, "FAVOURABLE", group=d3_grp3)
d3_colMarginal   = input.color(#ff9800, "MARGINAL", group=d3_grp3)
d3_colDegraded   = input.color(#f23645, "DEGRADED", group=d3_grp3)

d3_grp4 = "[D3] Alert Conditions"
d3_extremeVolRatio = input.float(2.0, "Extreme Volatility ratio (ATR / baseline ≥)", group=d3_grp4)
d3_compressedVolRatio = input.float(0.5, "Extreme Compression ratio (ATR / baseline ≤)", group=d3_grp4)
d3_recentChangeWindow = input.int(3, "Bars counted as \"Recently Changed\"", group=d3_grp4)

d3_grp5 = "[D3] Table"
d3_tableSize = input.string(size.small, "Table Text Size", options=[size.tiny, size.small, size.normal], group=d3_grp5)

// === Volatility component (0-45) ===
d3_atrNow   = ta.atr(d3_atrLen)
d3_atrBase  = ta.sma(d3_atrNow, d3_atrBaseLen)
d3_volRatio = d3_atrBase == 0 ? 1.0 : d3_atrNow / d3_atrBase
d3_volDeviation = math.abs(d3_volRatio - 1.0)
d3_volScore = math.max(0.0, 45.0 - (d3_volDeviation * 90.0))

// === Trend-strength component (0-45) ===
[d3_diplus, d3_diminus, d3_adx] = ta.dmi(d3_adxLen, d3_adxSmooth)
d3_adxScore = d3_adx <= 40 ? math.min(45.0, (d3_adx / 40.0) * 45.0) : math.max(0.0, 45.0 - ((d3_adx - 40.0) * 1.5))

// === Composite Regime Score (0-90) + Grade ===
d3_regimeScore = d3_volScore + d3_adxScore
d3_grade      = d3_regimeScore >= d3_primeMin ? "PRIME" : d3_regimeScore >= d3_favourableMin ? "FAVOURABLE" : d3_regimeScore >= d3_marginalMin ? "MARGINAL" : "DEGRADED"
d3_gradeColor = d3_regimeScore >= d3_primeMin ? d3_colPrime : d3_regimeScore >= d3_favourableMin ? d3_colFavourable : d3_regimeScore >= d3_marginalMin ? d3_colMarginal : d3_colDegraded

// === Condition flags (state descriptions, not signals) ===
d3_volExpanding   = d3_atrNow > d3_atrNow[1]
d3_volCompressing = d3_atrNow < d3_atrNow[1]
d3_trendStrengthening = d3_adx > d3_adx[1]
d3_trendWeakening      = d3_adx < d3_adx[1]
d3_extremeVol      = d3_volRatio >= d3_extremeVolRatio
d3_extremeCompression = d3_volRatio <= d3_compressedVolRatio

var string d3_prevGrade = na
var int d3_barsSinceChange = 0
d3_gradeChangedNow = not na(d3_prevGrade) and d3_grade != d3_prevGrade
if d3_gradeChangedNow
    d3_barsSinceChange := 0
else
    d3_barsSinceChange := d3_barsSinceChange + 1
d3_prevGrade := d3_grade
d3_recentlyChanged = d3_barsSinceChange <= d3_recentChangeWindow

// === QP dark/gold dashboard theme ===
d3_bgHeader = color.new(#1a1a1a, 0)
d3_bgRow    = color.new(#0d0d0d, 10)
d3_txtMuted = color.new(color.white, 40)
d3_txtGold  = color.new(#c9a84c, 0)
d3_colOn    = color.new(#c9a84c, 0)
d3_colOff   = color.new(color.white, 55)

d3_flagText(_active) => _active ? "ACTIVE" : "—"
d3_flagColor(_active) => _active ? d3_colOn : d3_colOff

// === Table — one table, bottom left ===
var table d3_panel = table.new(position.bottom_left, 2, 9, border_width=1)

if barstate.islast
    table.cell(d3_panel, 0, 0, "REGIME ALERT PANEL", text_color=d3_txtGold, bgcolor=d3_bgHeader, text_size=d3_tableSize)
    table.cell(d3_panel, 1, 0, "", bgcolor=d3_bgHeader, text_size=d3_tableSize)

    table.cell(d3_panel, 0, 1, "Grade", text_color=d3_txtMuted, bgcolor=d3_bgRow, text_size=d3_tableSize)
    table.cell(d3_panel, 1, 1, d3_grade, text_color=d3_gradeColor, bgcolor=d3_bgRow, text_size=d3_tableSize)

    table.cell(d3_panel, 0, 2, "Volatility Expanding", text_color=d3_txtMuted, bgcolor=d3_bgRow, text_size=d3_tableSize)
    table.cell(d3_panel, 1, 2, d3_flagText(d3_volExpanding), text_color=d3_flagColor(d3_volExpanding), bgcolor=d3_bgRow, text_size=d3_tableSize)

    table.cell(d3_panel, 0, 3, "Volatility Compressing", text_color=d3_txtMuted, bgcolor=d3_bgRow, text_size=d3_tableSize)
    table.cell(d3_panel, 1, 3, d3_flagText(d3_volCompressing), text_color=d3_flagColor(d3_volCompressing), bgcolor=d3_bgRow, text_size=d3_tableSize)

    table.cell(d3_panel, 0, 4, "Trend Strengthening", text_color=d3_txtMuted, bgcolor=d3_bgRow, text_size=d3_tableSize)
    table.cell(d3_panel, 1, 4, d3_flagText(d3_trendStrengthening), text_color=d3_flagColor(d3_trendStrengthening), bgcolor=d3_bgRow, text_size=d3_tableSize)

    table.cell(d3_panel, 0, 5, "Trend Weakening", text_color=d3_txtMuted, bgcolor=d3_bgRow, text_size=d3_tableSize)
    table.cell(d3_panel, 1, 5, d3_flagText(d3_trendWeakening), text_color=d3_flagColor(d3_trendWeakening), bgcolor=d3_bgRow, text_size=d3_tableSize)

    table.cell(d3_panel, 0, 6, "Extreme Volatility", text_color=d3_txtMuted, bgcolor=d3_bgRow, text_size=d3_tableSize)
    table.cell(d3_panel, 1, 6, d3_flagText(d3_extremeVol), text_color=d3_extremeVol ? d3_colDegraded : d3_colOff, bgcolor=d3_bgRow, text_size=d3_tableSize)

    table.cell(d3_panel, 0, 7, "Extreme Compression", text_color=d3_txtMuted, bgcolor=d3_bgRow, text_size=d3_tableSize)
    table.cell(d3_panel, 1, 7, d3_flagText(d3_extremeCompression), text_color=d3_extremeCompression ? d3_colMarginal : d3_colOff, bgcolor=d3_bgRow, text_size=d3_tableSize)

    table.cell(d3_panel, 0, 8, "Grade Recently Changed", text_color=d3_txtMuted, bgcolor=d3_bgRow, text_size=d3_tableSize)
    table.cell(d3_panel, 1, 8, d3_flagText(d3_recentlyChanged), text_color=d3_flagColor(d3_recentlyChanged), bgcolor=d3_bgRow, text_size=d3_tableSize)

//@version=6
indicator("Quant Prime — Suite [M3+D1+T1]", overlay=true)

// ============================================================
// M3 — Session Regime Tracker
// ============================================================

// ============================================================
// COC-M3 — Session Regime Tracker
// Suite Build menu · Main course
// Draws one table, top-right (Main course convention — only one
// Main-course piece is ever active in a given Build combination)
// Live m3_tracker of how the m3_grade has moved through the CURRENT
// session so far, not a historical multi-session report (that's
// Dessert-course territory)
// ============================================================

m3_grp1 = "[M3] Regime Score"
m3_atrLen      = input.int(14, "ATR Length", group=m3_grp1)
m3_atrBaseLen  = input.int(100, "ATR Baseline Length", group=m3_grp1)
m3_adxLen      = input.int(14, "DMI Length", group=m3_grp1)
m3_adxSmooth   = input.int(14, "ADX Smoothing", group=m3_grp1)

m3_grp2 = "[M3] Grade Thresholds (0-90 scale)"
m3_primeMin      = input.int(68, "PRIME minimum", group=m3_grp2)
m3_favourableMin = input.int(45, "FAVOURABLE minimum", group=m3_grp2)
m3_marginalMin   = input.int(23, "MARGINAL minimum", group=m3_grp2)

m3_grp3 = "[M3] Session"
m3_sessionInput = input.session("0000-2400", "Session (UTC) — default resets daily at 00:00 UTC", group=m3_grp3)
m3_showSessionZone  = input.bool(true, "Highlight Session Zone", group=m3_grp3)
m3_sessionZoneColor = input.color(color.new(#c9a84c, 90), "Session Zone Colour", group=m3_grp3)

m3_grp4 = "[M3] Regime Colours"
m3_colPrime      = input.color(#c9a84c, "PRIME", group=m3_grp4)
m3_colFavourable = input.color(#00abff, "FAVOURABLE", group=m3_grp4)
m3_colMarginal   = input.color(#ff9800, "MARGINAL", group=m3_grp4)
m3_colDegraded   = input.color(#f23645, "DEGRADED", group=m3_grp4)

m3_grp5 = "[M3] Table"
m3_tableSize = input.string(size.small, "Table Text Size", options=[size.tiny, size.small, size.normal], group=m3_grp5)

// === Volatility component (0-45) ===
m3_atrNow   = ta.atr(m3_atrLen)
m3_atrBase  = ta.sma(m3_atrNow, m3_atrBaseLen)
m3_volRatio = m3_atrBase == 0 ? 1.0 : m3_atrNow / m3_atrBase
m3_volDeviation = math.abs(m3_volRatio - 1.0)
m3_volScore = math.max(0.0, 45.0 - (m3_volDeviation * 90.0))

// === Trend-strength component (0-45) ===
[m3_diplus, m3_diminus, m3_adx] = ta.dmi(m3_adxLen, m3_adxSmooth)
m3_adxScore = m3_adx <= 40 ? math.min(45.0, (m3_adx / 40.0) * 45.0) : math.max(0.0, 45.0 - ((m3_adx - 40.0) * 1.5))

// === Composite Regime Score (0-90) + Grade ===
m3_regimeScore = m3_volScore + m3_adxScore
m3_grade      = m3_regimeScore >= m3_primeMin ? "PRIME" : m3_regimeScore >= m3_favourableMin ? "FAVOURABLE" : m3_regimeScore >= m3_marginalMin ? "MARGINAL" : "DEGRADED"
m3_gradeColor = m3_regimeScore >= m3_primeMin ? m3_colPrime : m3_regimeScore >= m3_favourableMin ? m3_colFavourable : m3_regimeScore >= m3_marginalMin ? m3_colMarginal : m3_colDegraded

// === Session boundary detection (custom UTC session window, not just exchange session) ===
m3_inSession  = not na(time(timeframe.period, m3_sessionInput, "UTC"))
m3_newSession = m3_inSession and not m3_inSession[1]

// === Background shading over exactly the bars being graded ===
bgcolor(m3_showSessionZone and m3_inSession ? m3_sessionZoneColor : na, title="Session Zone")

// === Session tracking state ===
var float m3_openScore   = na
var string m3_openGrade  = na
var float m3_bestScore   = na
var float m3_worstScore  = na
var int m3_changeCount   = 0
var string m3_prevGrade  = na

if m3_newSession
    m3_openScore  := m3_regimeScore
    m3_openGrade  := m3_grade
    m3_bestScore  := m3_regimeScore
    m3_worstScore := m3_regimeScore
    m3_changeCount := 0
    m3_prevGrade  := m3_grade
else if m3_inSession
    m3_bestScore  := math.max(m3_bestScore, m3_regimeScore)
    m3_worstScore := math.min(m3_worstScore, m3_regimeScore)
    if not na(m3_prevGrade) and m3_grade != m3_prevGrade
        m3_changeCount := m3_changeCount + 1
    m3_prevGrade := m3_grade

m3_bestGrade  = na(m3_bestScore) ? na : (m3_bestScore >= m3_primeMin ? "PRIME" : m3_bestScore >= m3_favourableMin ? "FAVOURABLE" : m3_bestScore >= m3_marginalMin ? "MARGINAL" : "DEGRADED")
m3_worstGrade = na(m3_worstScore) ? na : (m3_worstScore >= m3_primeMin ? "PRIME" : m3_worstScore >= m3_favourableMin ? "FAVOURABLE" : m3_worstScore >= m3_marginalMin ? "MARGINAL" : "DEGRADED")
m3_bestColor  = na(m3_bestScore) ? color.white : (m3_bestScore >= m3_primeMin ? m3_colPrime : m3_bestScore >= m3_favourableMin ? m3_colFavourable : m3_bestScore >= m3_marginalMin ? m3_colMarginal : m3_colDegraded)
m3_worstColor = na(m3_worstScore) ? color.white : (m3_worstScore >= m3_primeMin ? m3_colPrime : m3_worstScore >= m3_favourableMin ? m3_colFavourable : m3_worstScore >= m3_marginalMin ? m3_colMarginal : m3_colDegraded)
m3_openColor  = na(m3_openScore) ? color.white : (m3_openScore >= m3_primeMin ? m3_colPrime : m3_openScore >= m3_favourableMin ? m3_colFavourable : m3_openScore >= m3_marginalMin ? m3_colMarginal : m3_colDegraded)

// === QP dark/gold dashboard theme ===
m3_bgHeader = color.new(#1a1a1a, 0)
m3_bgRow    = color.new(#0d0d0d, 10)
m3_txtMuted = color.new(color.white, 40)
m3_txtGold  = color.new(#c9a84c, 0)

// === Table — one table, top right ===
var table m3_tracker = table.new(position.top_right, 2, 6, border_width=1)

if barstate.islast
    table.cell(m3_tracker, 0, 0, "SESSION REGIME TRACKER", text_color=m3_txtGold, bgcolor=m3_bgHeader, text_size=m3_tableSize)
    table.cell(m3_tracker, 1, 0, "", bgcolor=m3_bgHeader, text_size=m3_tableSize)

    table.cell(m3_tracker, 0, 1, "Session Open", text_color=m3_txtMuted, bgcolor=m3_bgRow, text_size=m3_tableSize)
    table.cell(m3_tracker, 1, 1, na(m3_openGrade) ? "—" : m3_openGrade, text_color=m3_openColor, bgcolor=m3_bgRow, text_size=m3_tableSize)

    table.cell(m3_tracker, 0, 2, "Current", text_color=m3_txtMuted, bgcolor=m3_bgRow, text_size=m3_tableSize)
    table.cell(m3_tracker, 1, 2, m3_grade, text_color=m3_gradeColor, bgcolor=m3_bgRow, text_size=m3_tableSize)

    table.cell(m3_tracker, 0, 3, "Session Best", text_color=m3_txtMuted, bgcolor=m3_bgRow, text_size=m3_tableSize)
    table.cell(m3_tracker, 1, 3, na(m3_bestGrade) ? "—" : m3_bestGrade, text_color=m3_bestColor, bgcolor=m3_bgRow, text_size=m3_tableSize)

    table.cell(m3_tracker, 0, 4, "Session Worst", text_color=m3_txtMuted, bgcolor=m3_bgRow, text_size=m3_tableSize)
    table.cell(m3_tracker, 1, 4, na(m3_worstGrade) ? "—" : m3_worstGrade, text_color=m3_worstColor, bgcolor=m3_bgRow, text_size=m3_tableSize)

    table.cell(m3_tracker, 0, 5, "Grade Changes", text_color=m3_txtMuted, bgcolor=m3_bgRow, text_size=m3_tableSize)
    table.cell(m3_tracker, 1, 5, str.tostring(m3_changeCount), text_color=color.white, bgcolor=m3_bgRow, text_size=m3_tableSize)

// ============================================================
// D1 — Regime Clock
// ============================================================

// ============================================================
// COC-D1 — Regime Clock
// Suite Build menu · Side course
// Draws one table, bottom-left (Side course convention)
// Countdown to next regime recalculation — the regime score is
// bar-based, so "next recalculation" is the next bar close
// ============================================================

d1_grp1 = "[D1] Regime Score"
d1_atrLen      = input.int(14, "ATR Length", group=d1_grp1)
d1_atrBaseLen  = input.int(100, "ATR Baseline Length", group=d1_grp1)
d1_adxLen      = input.int(14, "DMI Length", group=d1_grp1)
d1_adxSmooth   = input.int(14, "ADX Smoothing", group=d1_grp1)

d1_grp2 = "[D1] Grade Thresholds (0-90 scale)"
d1_primeMin      = input.int(68, "PRIME minimum", group=d1_grp2)
d1_favourableMin = input.int(45, "FAVOURABLE minimum", group=d1_grp2)
d1_marginalMin   = input.int(23, "MARGINAL minimum", group=d1_grp2)

d1_grp3 = "[D1] Regime Colours"
d1_colPrime      = input.color(#c9a84c, "PRIME", group=d1_grp3)
d1_colFavourable = input.color(#00abff, "FAVOURABLE", group=d1_grp3)
d1_colMarginal   = input.color(#ff9800, "MARGINAL", group=d1_grp3)
d1_colDegraded   = input.color(#f23645, "DEGRADED", group=d1_grp3)

d1_grp4 = "[D1] Table"
d1_tableSize = input.string(size.small, "Table Text Size", options=[size.tiny, size.small, size.normal], group=d1_grp4)

// === Volatility component (0-45) ===
d1_atrNow   = ta.atr(d1_atrLen)
d1_atrBase  = ta.sma(d1_atrNow, d1_atrBaseLen)
d1_volRatio = d1_atrBase == 0 ? 1.0 : d1_atrNow / d1_atrBase
d1_volDeviation = math.abs(d1_volRatio - 1.0)
d1_volScore = math.max(0.0, 45.0 - (d1_volDeviation * 90.0))

// === Trend-strength component (0-45) ===
[d1_diplus, d1_diminus, d1_adx] = ta.dmi(d1_adxLen, d1_adxSmooth)
d1_adxScore = d1_adx <= 40 ? math.min(45.0, (d1_adx / 40.0) * 45.0) : math.max(0.0, 45.0 - ((d1_adx - 40.0) * 1.5))

// === Composite Regime Score (0-90) + Grade ===
d1_regimeScore = d1_volScore + d1_adxScore
d1_grade      = d1_regimeScore >= d1_primeMin ? "PRIME" : d1_regimeScore >= d1_favourableMin ? "FAVOURABLE" : d1_regimeScore >= d1_marginalMin ? "MARGINAL" : "DEGRADED"
d1_gradeColor = d1_regimeScore >= d1_primeMin ? d1_colPrime : d1_regimeScore >= d1_favourableMin ? d1_colFavourable : d1_regimeScore >= d1_marginalMin ? d1_colMarginal : d1_colDegraded

// === Countdown to next bar close (next regime recalculation) ===
d1_remainingSec = math.max(0, int((time_close - timenow) / 1000))

d1_formatCountdown(_sec) =>
    _h = int(_sec / 3600)
    _m = int((_sec % 3600) / 60)
    _s = int(_sec % 60)
    _h > 0 ? str.tostring(_h) + "h " + str.tostring(_m) + "m" : _m > 0 ? str.tostring(_m) + "m " + str.tostring(_s) + "s" : str.tostring(_s) + "s"

d1_countdownText = d1_formatCountdown(d1_remainingSec)

// === QP dark/gold dashboard theme ===
d1_bgHeader = color.new(#1a1a1a, 0)
d1_bgRow    = color.new(#0d0d0d, 10)
d1_txtMuted = color.new(color.white, 40)
d1_txtGold  = color.new(#c9a84c, 0)

// === Table — one table, bottom left ===
var table d1_clock = table.new(position.bottom_left, 2, 3, border_width=1)

if barstate.islast
    table.cell(d1_clock, 0, 0, "REGIME CLOCK", text_color=d1_txtGold, bgcolor=d1_bgHeader, text_size=d1_tableSize)
    table.cell(d1_clock, 1, 0, "", bgcolor=d1_bgHeader, text_size=d1_tableSize)

    table.cell(d1_clock, 0, 1, "Current Grade", text_color=d1_txtMuted, bgcolor=d1_bgRow, text_size=d1_tableSize)
    table.cell(d1_clock, 1, 1, d1_grade, text_color=d1_gradeColor, bgcolor=d1_bgRow, text_size=d1_tableSize)

    table.cell(d1_clock, 0, 2, "Next Recalc", text_color=d1_txtMuted, bgcolor=d1_bgRow, text_size=d1_tableSize)
    table.cell(d1_clock, 1, 2, d1_countdownText, text_color=color.white, bgcolor=d1_bgRow, text_size=d1_tableSize)

// ============================================================
// T1 — Regime Report
// ============================================================

// ============================================================
// COC-T1 — Regime Report
// Suite Build menu · Dessert course
// Draws one table, bottom-right (Dessert course convention)
// Historical, cumulative — how much time has actually been
// spent in each t1_grade since this was added to the chart, not
// a live/current-state readout (that's Main/Side territory)
// ============================================================

t1_grp1 = "[T1] Regime Score"
t1_atrLen      = input.int(14, "ATR Length", group=t1_grp1)
t1_atrBaseLen  = input.int(100, "ATR Baseline Length", group=t1_grp1)
t1_adxLen      = input.int(14, "DMI Length", group=t1_grp1)
t1_adxSmooth   = input.int(14, "ADX Smoothing", group=t1_grp1)

t1_grp2 = "[T1] Grade Thresholds (0-90 scale)"
t1_primeMin      = input.int(68, "PRIME minimum", group=t1_grp2)
t1_favourableMin = input.int(45, "FAVOURABLE minimum", group=t1_grp2)
t1_marginalMin   = input.int(23, "MARGINAL minimum", group=t1_grp2)

t1_grp3 = "[T1] Regime Colours"
t1_colPrime      = input.color(#c9a84c, "PRIME", group=t1_grp3)
t1_colFavourable = input.color(#00abff, "FAVOURABLE", group=t1_grp3)
t1_colMarginal   = input.color(#ff9800, "MARGINAL", group=t1_grp3)
t1_colDegraded   = input.color(#f23645, "DEGRADED", group=t1_grp3)

t1_grp4 = "[T1] Lookback"
t1_lookbackBars = input.int(480, "Lookback (bars) — 0 = all loaded history. Default 480 = one day of 3m candles", minval=0, group=t1_grp4)

t1_grp5 = "[T1] Table"
t1_tableSize = input.string(size.small, "Table Text Size", options=[size.tiny, size.small, size.normal], group=t1_grp5)

// === Volatility component (0-45) ===
t1_atrNow   = ta.atr(t1_atrLen)
t1_atrBase  = ta.sma(t1_atrNow, t1_atrBaseLen)
t1_volRatio = t1_atrBase == 0 ? 1.0 : t1_atrNow / t1_atrBase
t1_volDeviation = math.abs(t1_volRatio - 1.0)
t1_volScore = math.max(0.0, 45.0 - (t1_volDeviation * 90.0))

// === Trend-strength component (0-45) ===
[t1_diplus, t1_diminus, t1_adx] = ta.dmi(t1_adxLen, t1_adxSmooth)
t1_adxScore = t1_adx <= 40 ? math.min(45.0, (t1_adx / 40.0) * 45.0) : math.max(0.0, 45.0 - ((t1_adx - 40.0) * 1.5))

// === Composite Regime Score (0-90) + Grade ===
t1_regimeScore = t1_volScore + t1_adxScore
t1_grade      = t1_regimeScore >= t1_primeMin ? "PRIME" : t1_regimeScore >= t1_favourableMin ? "FAVOURABLE" : t1_regimeScore >= t1_marginalMin ? "MARGINAL" : "DEGRADED"

// === Cumulative bar counts per t1_grade — two modes:
// bounded rolling window (ta.sma × length, recovers a rolling sum) when
// t1_lookbackBars > 0, or unbounded since-chart-load counters when t1_lookbackBars = 0 ===
t1_useLookback = t1_lookbackBars > 0
t1_safeLen     = math.max(t1_lookbackBars, 1)

t1_isPrime      = t1_grade == "PRIME" ? 1 : 0
t1_isFavourable = t1_grade == "FAVOURABLE" ? 1 : 0
t1_isMarginal   = t1_grade == "MARGINAL" ? 1 : 0
t1_isDegraded   = t1_grade == "DEGRADED" ? 1 : 0

t1_sumPrime      = ta.sma(t1_isPrime, t1_safeLen) * t1_safeLen
t1_sumFavourable = ta.sma(t1_isFavourable, t1_safeLen) * t1_safeLen
t1_sumMarginal   = ta.sma(t1_isMarginal, t1_safeLen) * t1_safeLen
t1_sumDegraded   = ta.sma(t1_isDegraded, t1_safeLen) * t1_safeLen

var int t1_cumPrime      = 0
var int t1_cumFavourable = 0
var int t1_cumMarginal   = 0
var int t1_cumDegraded   = 0
if t1_grade == "PRIME"
    t1_cumPrime := t1_cumPrime + 1
else if t1_grade == "FAVOURABLE"
    t1_cumFavourable := t1_cumFavourable + 1
else if t1_grade == "MARGINAL"
    t1_cumMarginal := t1_cumMarginal + 1
else
    t1_cumDegraded := t1_cumDegraded + 1

t1_primeBars      = t1_useLookback ? t1_sumPrime : t1_cumPrime
t1_favourableBars = t1_useLookback ? t1_sumFavourable : t1_cumFavourable
t1_marginalBars   = t1_useLookback ? t1_sumMarginal : t1_cumMarginal
t1_degradedBars   = t1_useLookback ? t1_sumDegraded : t1_cumDegraded

t1_totalBars = t1_primeBars + t1_favourableBars + t1_marginalBars + t1_degradedBars

t1_pct(_count) => t1_totalBars == 0 ? 0.0 : (_count / t1_totalBars) * 100.0

t1_headerLabel = t1_useLookback ? "REGIME REPORT (Last " + str.tostring(t1_lookbackBars) + ")" : "REGIME REPORT (All History)"

// === Current streak — how long the t1_grade has held without changing ===
var string t1_prevGrade = na
var int t1_streakBars = 0
if t1_grade == t1_prevGrade
    t1_streakBars := t1_streakBars + 1
else
    t1_streakBars := 1
t1_prevGrade := t1_grade

t1_streakColor = t1_grade == "PRIME" ? t1_colPrime : t1_grade == "FAVOURABLE" ? t1_colFavourable : t1_grade == "MARGINAL" ? t1_colMarginal : t1_colDegraded

// === QP dark/gold dashboard theme ===
t1_bgHeader = color.new(#1a1a1a, 0)
t1_bgRow    = color.new(#0d0d0d, 10)
t1_txtMuted = color.new(color.white, 40)
t1_txtGold  = color.new(#c9a84c, 0)

// === Table — one table, bottom right (Dessert course convention) ===
var table t1_report = table.new(position.bottom_right, 3, 7, border_width=1)

if barstate.islast
    table.cell(t1_report, 0, 0, t1_headerLabel, text_color=t1_txtGold, bgcolor=t1_bgHeader, text_size=t1_tableSize)
    table.cell(t1_report, 1, 0, "", bgcolor=t1_bgHeader, text_size=t1_tableSize)
    table.cell(t1_report, 2, 0, "", bgcolor=t1_bgHeader, text_size=t1_tableSize)

    table.cell(t1_report, 0, 1, "PRIME", text_color=t1_colPrime, bgcolor=t1_bgRow, text_size=t1_tableSize)
    table.cell(t1_report, 1, 1, str.tostring(t1_primeBars, "#"), text_color=color.white, bgcolor=t1_bgRow, text_size=t1_tableSize)
    table.cell(t1_report, 2, 1, str.tostring(t1_pct(t1_primeBars), "#.#") + "%", text_color=t1_txtMuted, bgcolor=t1_bgRow, text_size=t1_tableSize)

    table.cell(t1_report, 0, 2, "FAVOURABLE", text_color=t1_colFavourable, bgcolor=t1_bgRow, text_size=t1_tableSize)
    table.cell(t1_report, 1, 2, str.tostring(t1_favourableBars, "#"), text_color=color.white, bgcolor=t1_bgRow, text_size=t1_tableSize)
    table.cell(t1_report, 2, 2, str.tostring(t1_pct(t1_favourableBars), "#.#") + "%", text_color=t1_txtMuted, bgcolor=t1_bgRow, text_size=t1_tableSize)

    table.cell(t1_report, 0, 3, "MARGINAL", text_color=t1_colMarginal, bgcolor=t1_bgRow, text_size=t1_tableSize)
    table.cell(t1_report, 1, 3, str.tostring(t1_marginalBars, "#"), text_color=color.white, bgcolor=t1_bgRow, text_size=t1_tableSize)
    table.cell(t1_report, 2, 3, str.tostring(t1_pct(t1_marginalBars), "#.#") + "%", text_color=t1_txtMuted, bgcolor=t1_bgRow, text_size=t1_tableSize)

    table.cell(t1_report, 0, 4, "DEGRADED", text_color=t1_colDegraded, bgcolor=t1_bgRow, text_size=t1_tableSize)
    table.cell(t1_report, 1, 4, str.tostring(t1_degradedBars, "#"), text_color=color.white, bgcolor=t1_bgRow, text_size=t1_tableSize)
    table.cell(t1_report, 2, 4, str.tostring(t1_pct(t1_degradedBars), "#.#") + "%", text_color=t1_txtMuted, bgcolor=t1_bgRow, text_size=t1_tableSize)

    table.cell(t1_report, 0, 5, "Total Bars", text_color=t1_txtMuted, bgcolor=t1_bgRow, text_size=t1_tableSize)
    table.cell(t1_report, 1, 5, str.tostring(t1_totalBars, "#"), text_color=color.white, bgcolor=t1_bgRow, text_size=t1_tableSize)
    table.cell(t1_report, 2, 5, "", bgcolor=t1_bgRow, text_size=t1_tableSize)

    table.cell(t1_report, 0, 6, "Current Streak", text_color=t1_txtMuted, bgcolor=t1_bgRow, text_size=t1_tableSize)
    table.cell(t1_report, 1, 6, str.tostring(t1_streakBars) + " bars", text_color=t1_streakColor, bgcolor=t1_bgRow, text_size=t1_tableSize)
    table.cell(t1_report, 2, 6, "", bgcolor=t1_bgRow, text_size=t1_tableSize)

//@version=6
indicator("Quant Prime — Suite [S3+M2+D3+T3]", overlay=true)

// ============================================================
// S3 — Regime Change Marker
// ============================================================

// ============================================================
// COC-S3 — Regime Change Marker
// Suite Build menu · Starter course
// Draws no tables (per QP Build convention for Starter pieces)
// Uses the same regime-score formula as COC-S1 (kept standalone
// here since each piece must compile independently)
// ============================================================

s3_grp1 = "[S3] Regime Score"
s3_atrLen      = input.int(14, "ATR Length", group=s3_grp1)
s3_atrBaseLen  = input.int(100, "ATR Baseline Length", group=s3_grp1)
s3_adxLen      = input.int(14, "DMI Length", group=s3_grp1)
s3_adxSmooth   = input.int(14, "ADX Smoothing", group=s3_grp1)

s3_grp2 = "[S3] Grade Thresholds (0-90 scale)"
s3_primeMin      = input.int(68, "PRIME minimum", group=s3_grp2)
s3_favourableMin = input.int(45, "FAVOURABLE minimum", group=s3_grp2)
s3_marginalMin   = input.int(23, "MARGINAL minimum", group=s3_grp2)

s3_grp3 = "[S3] Marker"
s3_labelSize = input.string(size.small, "Label Size", options=[size.tiny, size.small, size.normal], group=s3_grp3)

s3_grp4 = "[S3] Regime Colours"
s3_colPrime      = input.color(#c9a84c, "PRIME", group=s3_grp4)
s3_colFavourable = input.color(#00abff, "FAVOURABLE", group=s3_grp4)
s3_colMarginal   = input.color(#ff9800, "MARGINAL", group=s3_grp4)
s3_colDegraded   = input.color(#f23645, "DEGRADED", group=s3_grp4)

s3_grp5 = "[S3] Label Spacing"
s3_offsetTiers = input.int(4, "Vertical Offset Tiers", minval=2, maxval=8, group=s3_grp5)
s3_offsetStep  = input.float(0.6, "Offset Step (x ATR per s3_tier)", minval=0.1, group=s3_grp5)
s3_baseOffset  = input.float(0.5, "Base Offset (x ATR)", minval=0.1, group=s3_grp5)

// === Volatility component (0-45) ===
s3_atrNow   = ta.atr(s3_atrLen)
s3_atrBase  = ta.sma(s3_atrNow, s3_atrBaseLen)
s3_volRatio = s3_atrBase == 0 ? 1.0 : s3_atrNow / s3_atrBase
s3_volDeviation = math.abs(s3_volRatio - 1.0)
s3_volScore = math.max(0.0, 45.0 - (s3_volDeviation * 90.0))

// === Trend-strength component (0-45) ===
[s3_diplus, s3_diminus, s3_adx] = ta.dmi(s3_adxLen, s3_adxSmooth)
s3_adxScore = s3_adx <= 40 ? math.min(45.0, (s3_adx / 40.0) * 45.0) : math.max(0.0, 45.0 - ((s3_adx - 40.0) * 1.5))

// === Composite Regime Score (0-90) + Grade ===
s3_regimeScore = s3_volScore + s3_adxScore

s3_grade = s3_regimeScore >= s3_primeMin ? "PRIME" : s3_regimeScore >= s3_favourableMin ? "FAVOURABLE" : s3_regimeScore >= s3_marginalMin ? "MARGINAL" : "DEGRADED"

s3_gradeColor = s3_regimeScore >= s3_primeMin ? s3_colPrime : s3_regimeScore >= s3_favourableMin ? s3_colFavourable : s3_regimeScore >= s3_marginalMin ? s3_colMarginal : s3_colDegraded

// === Marker on s3_grade shift only — vertical offset randomised per s3_tier,
// excluding whichever s3_tier was just used, so adjacent labels never stack ===
var string s3_prevGrade = na
s3_gradeShifted = not na(s3_prevGrade) and s3_grade != s3_prevGrade

var int s3_lastTier = -1
if s3_gradeShifted
    s3_randTier = int(math.random(0, s3_offsetTiers))
    s3_tier = s3_randTier == s3_lastTier ? (s3_randTier + 1) % s3_offsetTiers : s3_randTier
    s3_labelOffset = s3_baseOffset + (s3_tier * s3_offsetStep)
    label.new(bar_index, high + (s3_atrNow * s3_labelOffset), s3_grade, style=label.style_label_down, color=color.new(s3_gradeColor, 20), textcolor=color.white, size=s3_labelSize)
    s3_lastTier := s3_tier

s3_prevGrade := s3_grade

// ============================================================
// M2 — Multi-TF Regime Aggregator
// ============================================================

// ============================================================
// COC-M2 — Multi-TF Regime Aggregator
// Suite Build menu · Main course
// Draws one table, top-right (Main course convention — only one
// Main-course piece is ever active in a given Build combination,
// so M1/M2/M3 can safely share the same corner)
// ============================================================

m2_grp1 = "[M2] Regime Score"
m2_atrLen      = input.int(14, "ATR Length", group=m2_grp1)
m2_atrBaseLen  = input.int(100, "ATR Baseline Length", group=m2_grp1)
m2_adxLen      = input.int(14, "DMI Length", group=m2_grp1)
m2_adxSmooth   = input.int(14, "ADX Smoothing", group=m2_grp1)

m2_grp2 = "[M2] Grade Thresholds (0-90 scale)"
m2_primeMin      = input.int(68, "PRIME minimum", group=m2_grp2)
m2_favourableMin = input.int(45, "FAVOURABLE minimum", group=m2_grp2)
m2_marginalMin   = input.int(23, "MARGINAL minimum", group=m2_grp2)

m2_grp3 = "[M2] Timeframes"
m2_tf1 = input.timeframe("", "Timeframe 1 (defaults to chart TF)", group=m2_grp3)
m2_tf2 = input.timeframe("60", "Timeframe 2", group=m2_grp3)
m2_tf3 = input.timeframe("240", "Timeframe 3", group=m2_grp3)

m2_grp4 = "[M2] Regime Colours"
m2_colPrime      = input.color(#c9a84c, "PRIME", group=m2_grp4)
m2_colFavourable = input.color(#00abff, "FAVOURABLE", group=m2_grp4)
m2_colMarginal   = input.color(#ff9800, "MARGINAL", group=m2_grp4)
m2_colDegraded   = input.color(#f23645, "DEGRADED", group=m2_grp4)

m2_grp5 = "[M2] Table"
m2_tableSize = input.string(size.small, "Table Text Size", options=[size.tiny, size.small, size.normal], group=m2_grp5)

// === Regime score, computed natively on whichever timeframe calls it ===
m2_regimeScoreCalc(_atrLen, _atrBaseLen, _adxLen, _adxSmooth) =>
    _atrNow = ta.atr(_atrLen)
    _atrBase = ta.sma(_atrNow, _atrBaseLen)
    _volRatio = _atrBase == 0 ? 1.0 : _atrNow / _atrBase
    _volDeviation = math.abs(_volRatio - 1.0)
    _volScore = math.max(0.0, 45.0 - (_volDeviation * 90.0))
    [_diplus, _diminus, _adx] = ta.dmi(_adxLen, _adxSmooth)
    _adxScore = _adx <= 40 ? math.min(45.0, (_adx / 40.0) * 45.0) : math.max(0.0, 45.0 - ((_adx - 40.0) * 1.5))
    _volScore + _adxScore

m2_score1 = request.security(syminfo.tickerid, m2_tf1, m2_regimeScoreCalc(m2_atrLen, m2_atrBaseLen, m2_adxLen, m2_adxSmooth), lookahead=barmerge.lookahead_off)
m2_score2 = request.security(syminfo.tickerid, m2_tf2, m2_regimeScoreCalc(m2_atrLen, m2_atrBaseLen, m2_adxLen, m2_adxSmooth), lookahead=barmerge.lookahead_off)
m2_score3 = request.security(syminfo.tickerid, m2_tf3, m2_regimeScoreCalc(m2_atrLen, m2_atrBaseLen, m2_adxLen, m2_adxSmooth), lookahead=barmerge.lookahead_off)

m2_gradeOf(_score) =>
    _score >= m2_primeMin ? "PRIME" : _score >= m2_favourableMin ? "FAVOURABLE" : _score >= m2_marginalMin ? "MARGINAL" : "DEGRADED"

m2_colorOf(_score) =>
    _score >= m2_primeMin ? m2_colPrime : _score >= m2_favourableMin ? m2_colFavourable : _score >= m2_marginalMin ? m2_colMarginal : m2_colDegraded

m2_grade1 = m2_gradeOf(m2_score1)
m2_grade2 = m2_gradeOf(m2_score2)
m2_grade3 = m2_gradeOf(m2_score3)
m2_color1 = m2_colorOf(m2_score1)
m2_color2 = m2_colorOf(m2_score2)
m2_color3 = m2_colorOf(m2_score3)

// Tradeable = FAVOURABLE or better, per the manifesto's own sizing guidance
m2_tradeableCount = (m2_score1 >= m2_favourableMin ? 1 : 0) + (m2_score2 >= m2_favourableMin ? 1 : 0) + (m2_score3 >= m2_favourableMin ? 1 : 0)

// === Readable timeframe labels for the header row ===
m2_tfLabel(_tf) =>
    _mins = timeframe.in_seconds(_tf) / 60
    _mins < 60 ? str.tostring(_mins, "#") + "m" : _mins < 1440 ? str.tostring(_mins / 60, "#") + "H" : str.tostring(_mins / 1440, "#") + "D"

m2_label1 = m2_tfLabel(m2_tf1)
m2_label2 = m2_tfLabel(m2_tf2)
m2_label3 = m2_tfLabel(m2_tf3)

// === QP dark/gold dashboard theme ===
m2_bgHeader = color.new(#1a1a1a, 0)
m2_bgRow    = color.new(#0d0d0d, 10)
m2_txtMuted = color.new(color.white, 40)
m2_txtGold  = color.new(#c9a84c, 0)

// === Table — one table, top right, 4 columns (label + 3 timeframes) ===
var table m2_agg = table.new(position.top_right, 4, 5, border_width=1)

if barstate.islast
    table.cell(m2_agg, 0, 0, "REGIME AGGREGATOR", text_color=m2_txtGold, bgcolor=m2_bgHeader, text_size=m2_tableSize)
    table.cell(m2_agg, 1, 0, "", bgcolor=m2_bgHeader, text_size=m2_tableSize)
    table.cell(m2_agg, 2, 0, "", bgcolor=m2_bgHeader, text_size=m2_tableSize)
    table.cell(m2_agg, 3, 0, "", bgcolor=m2_bgHeader, text_size=m2_tableSize)

    table.cell(m2_agg, 0, 1, "", text_color=m2_txtMuted, bgcolor=m2_bgRow, text_size=m2_tableSize)
    table.cell(m2_agg, 1, 1, m2_label1, text_color=m2_txtMuted, bgcolor=m2_bgRow, text_size=m2_tableSize)
    table.cell(m2_agg, 2, 1, m2_label2, text_color=m2_txtMuted, bgcolor=m2_bgRow, text_size=m2_tableSize)
    table.cell(m2_agg, 3, 1, m2_label3, text_color=m2_txtMuted, bgcolor=m2_bgRow, text_size=m2_tableSize)

    table.cell(m2_agg, 0, 2, "Grade", text_color=m2_txtMuted, bgcolor=m2_bgRow, text_size=m2_tableSize)
    table.cell(m2_agg, 1, 2, m2_grade1, text_color=m2_color1, bgcolor=m2_bgRow, text_size=m2_tableSize)
    table.cell(m2_agg, 2, 2, m2_grade2, text_color=m2_color2, bgcolor=m2_bgRow, text_size=m2_tableSize)
    table.cell(m2_agg, 3, 2, m2_grade3, text_color=m2_color3, bgcolor=m2_bgRow, text_size=m2_tableSize)

    table.cell(m2_agg, 0, 3, "Score", text_color=m2_txtMuted, bgcolor=m2_bgRow, text_size=m2_tableSize)
    table.cell(m2_agg, 1, 3, str.tostring(m2_score1, "#.#"), text_color=color.white, bgcolor=m2_bgRow, text_size=m2_tableSize)
    table.cell(m2_agg, 2, 3, str.tostring(m2_score2, "#.#"), text_color=color.white, bgcolor=m2_bgRow, text_size=m2_tableSize)
    table.cell(m2_agg, 3, 3, str.tostring(m2_score3, "#.#"), text_color=color.white, bgcolor=m2_bgRow, text_size=m2_tableSize)

    table.cell(m2_agg, 0, 4, "Tradeable", text_color=m2_txtMuted, bgcolor=m2_bgRow, text_size=m2_tableSize)
    table.cell(m2_agg, 1, 4, str.tostring(m2_tradeableCount) + " / 3", text_color=m2_txtGold, bgcolor=m2_bgRow, text_size=m2_tableSize)
    table.cell(m2_agg, 2, 4, "", bgcolor=m2_bgRow, text_size=m2_tableSize)
    table.cell(m2_agg, 3, 4, "", bgcolor=m2_bgRow, text_size=m2_tableSize)

// ============================================================
// D3 — Regime Alert Panel
// ============================================================

// ============================================================
// COC-D3 — Regime Alert Panel
// Suite Build menu · Side course
// Draws one table, bottom-left (Side course convention)
// Lists currently-active regime CONDITIONS — analytical state
// flags only. This is explicitly not an entry signal d3_panel:
// nothing here fires an alert to buy or sell, only to describe
// what the market is currently doing
// ============================================================

d3_grp1 = "[D3] Regime Score"
d3_atrLen      = input.int(14, "ATR Length", group=d3_grp1)
d3_atrBaseLen  = input.int(100, "ATR Baseline Length", group=d3_grp1)
d3_adxLen      = input.int(14, "DMI Length", group=d3_grp1)
d3_adxSmooth   = input.int(14, "ADX Smoothing", group=d3_grp1)

d3_grp2 = "[D3] Grade Thresholds (0-90 scale)"
d3_primeMin      = input.int(68, "PRIME minimum", group=d3_grp2)
d3_favourableMin = input.int(45, "FAVOURABLE minimum", group=d3_grp2)
d3_marginalMin   = input.int(23, "MARGINAL minimum", group=d3_grp2)

d3_grp3 = "[D3] Regime Colours"
d3_colPrime      = input.color(#c9a84c, "PRIME", group=d3_grp3)
d3_colFavourable = input.color(#00abff, "FAVOURABLE", group=d3_grp3)
d3_colMarginal   = input.color(#ff9800, "MARGINAL", group=d3_grp3)
d3_colDegraded   = input.color(#f23645, "DEGRADED", group=d3_grp3)

d3_grp4 = "[D3] Alert Conditions"
d3_extremeVolRatio = input.float(2.0, "Extreme Volatility ratio (ATR / baseline ≥)", group=d3_grp4)
d3_compressedVolRatio = input.float(0.5, "Extreme Compression ratio (ATR / baseline ≤)", group=d3_grp4)
d3_recentChangeWindow = input.int(3, "Bars counted as \"Recently Changed\"", group=d3_grp4)

d3_grp5 = "[D3] Table"
d3_tableSize = input.string(size.small, "Table Text Size", options=[size.tiny, size.small, size.normal], group=d3_grp5)

// === Volatility component (0-45) ===
d3_atrNow   = ta.atr(d3_atrLen)
d3_atrBase  = ta.sma(d3_atrNow, d3_atrBaseLen)
d3_volRatio = d3_atrBase == 0 ? 1.0 : d3_atrNow / d3_atrBase
d3_volDeviation = math.abs(d3_volRatio - 1.0)
d3_volScore = math.max(0.0, 45.0 - (d3_volDeviation * 90.0))

// === Trend-strength component (0-45) ===
[d3_diplus, d3_diminus, d3_adx] = ta.dmi(d3_adxLen, d3_adxSmooth)
d3_adxScore = d3_adx <= 40 ? math.min(45.0, (d3_adx / 40.0) * 45.0) : math.max(0.0, 45.0 - ((d3_adx - 40.0) * 1.5))

// === Composite Regime Score (0-90) + Grade ===
d3_regimeScore = d3_volScore + d3_adxScore
d3_grade      = d3_regimeScore >= d3_primeMin ? "PRIME" : d3_regimeScore >= d3_favourableMin ? "FAVOURABLE" : d3_regimeScore >= d3_marginalMin ? "MARGINAL" : "DEGRADED"
d3_gradeColor = d3_regimeScore >= d3_primeMin ? d3_colPrime : d3_regimeScore >= d3_favourableMin ? d3_colFavourable : d3_regimeScore >= d3_marginalMin ? d3_colMarginal : d3_colDegraded

// === Condition flags (state descriptions, not signals) ===
d3_volExpanding   = d3_atrNow > d3_atrNow[1]
d3_volCompressing = d3_atrNow < d3_atrNow[1]
d3_trendStrengthening = d3_adx > d3_adx[1]
d3_trendWeakening      = d3_adx < d3_adx[1]
d3_extremeVol      = d3_volRatio >= d3_extremeVolRatio
d3_extremeCompression = d3_volRatio <= d3_compressedVolRatio

var string d3_prevGrade = na
var int d3_barsSinceChange = 0
d3_gradeChangedNow = not na(d3_prevGrade) and d3_grade != d3_prevGrade
if d3_gradeChangedNow
    d3_barsSinceChange := 0
else
    d3_barsSinceChange := d3_barsSinceChange + 1
d3_prevGrade := d3_grade
d3_recentlyChanged = d3_barsSinceChange <= d3_recentChangeWindow

// === QP dark/gold dashboard theme ===
d3_bgHeader = color.new(#1a1a1a, 0)
d3_bgRow    = color.new(#0d0d0d, 10)
d3_txtMuted = color.new(color.white, 40)
d3_txtGold  = color.new(#c9a84c, 0)
d3_colOn    = color.new(#c9a84c, 0)
d3_colOff   = color.new(color.white, 55)

d3_flagText(_active) => _active ? "ACTIVE" : "—"
d3_flagColor(_active) => _active ? d3_colOn : d3_colOff

// === Table — one table, bottom left ===
var table d3_panel = table.new(position.bottom_left, 2, 9, border_width=1)

if barstate.islast
    table.cell(d3_panel, 0, 0, "REGIME ALERT PANEL", text_color=d3_txtGold, bgcolor=d3_bgHeader, text_size=d3_tableSize)
    table.cell(d3_panel, 1, 0, "", bgcolor=d3_bgHeader, text_size=d3_tableSize)

    table.cell(d3_panel, 0, 1, "Grade", text_color=d3_txtMuted, bgcolor=d3_bgRow, text_size=d3_tableSize)
    table.cell(d3_panel, 1, 1, d3_grade, text_color=d3_gradeColor, bgcolor=d3_bgRow, text_size=d3_tableSize)

    table.cell(d3_panel, 0, 2, "Volatility Expanding", text_color=d3_txtMuted, bgcolor=d3_bgRow, text_size=d3_tableSize)
    table.cell(d3_panel, 1, 2, d3_flagText(d3_volExpanding), text_color=d3_flagColor(d3_volExpanding), bgcolor=d3_bgRow, text_size=d3_tableSize)

    table.cell(d3_panel, 0, 3, "Volatility Compressing", text_color=d3_txtMuted, bgcolor=d3_bgRow, text_size=d3_tableSize)
    table.cell(d3_panel, 1, 3, d3_flagText(d3_volCompressing), text_color=d3_flagColor(d3_volCompressing), bgcolor=d3_bgRow, text_size=d3_tableSize)

    table.cell(d3_panel, 0, 4, "Trend Strengthening", text_color=d3_txtMuted, bgcolor=d3_bgRow, text_size=d3_tableSize)
    table.cell(d3_panel, 1, 4, d3_flagText(d3_trendStrengthening), text_color=d3_flagColor(d3_trendStrengthening), bgcolor=d3_bgRow, text_size=d3_tableSize)

    table.cell(d3_panel, 0, 5, "Trend Weakening", text_color=d3_txtMuted, bgcolor=d3_bgRow, text_size=d3_tableSize)
    table.cell(d3_panel, 1, 5, d3_flagText(d3_trendWeakening), text_color=d3_flagColor(d3_trendWeakening), bgcolor=d3_bgRow, text_size=d3_tableSize)

    table.cell(d3_panel, 0, 6, "Extreme Volatility", text_color=d3_txtMuted, bgcolor=d3_bgRow, text_size=d3_tableSize)
    table.cell(d3_panel, 1, 6, d3_flagText(d3_extremeVol), text_color=d3_extremeVol ? d3_colDegraded : d3_colOff, bgcolor=d3_bgRow, text_size=d3_tableSize)

    table.cell(d3_panel, 0, 7, "Extreme Compression", text_color=d3_txtMuted, bgcolor=d3_bgRow, text_size=d3_tableSize)
    table.cell(d3_panel, 1, 7, d3_flagText(d3_extremeCompression), text_color=d3_extremeCompression ? d3_colMarginal : d3_colOff, bgcolor=d3_bgRow, text_size=d3_tableSize)

    table.cell(d3_panel, 0, 8, "Grade Recently Changed", text_color=d3_txtMuted, bgcolor=d3_bgRow, text_size=d3_tableSize)
    table.cell(d3_panel, 1, 8, d3_flagText(d3_recentlyChanged), text_color=d3_flagColor(d3_recentlyChanged), bgcolor=d3_bgRow, text_size=d3_tableSize)

// ============================================================
// T3 — Session Regime Report
// ============================================================

// ============================================================
// COC-T3 — Session Regime Report
// Suite Build menu · Dessert course
// Draws one table, bottom-right (Dessert course convention)
// Historical, bounded lookback — which of the three named
// sessions tends to produce which t3_grade most often. Last of
// the 12 Suite pieces.
// ============================================================

t3_grp1 = "[T3] Regime Score"
t3_atrLen      = input.int(14, "ATR Length", group=t3_grp1)
t3_atrBaseLen  = input.int(100, "ATR Baseline Length", group=t3_grp1)
t3_adxLen      = input.int(14, "DMI Length", group=t3_grp1)
t3_adxSmooth   = input.int(14, "ADX Smoothing", group=t3_grp1)

t3_grp2 = "[T3] Grade Thresholds (0-90 scale)"
t3_primeMin      = input.int(68, "PRIME minimum", group=t3_grp2)
t3_favourableMin = input.int(45, "FAVOURABLE minimum", group=t3_grp2)
t3_marginalMin   = input.int(23, "MARGINAL minimum", group=t3_grp2)

t3_grp3 = "[T3] Sessions (UTC)"
t3_asiaSession   = input.session("1900-0600", "Asia", group=t3_grp3)
t3_londonSession = input.session("0700-1200", "London", group=t3_grp3)
t3_nySession     = input.session("1200-1700", "New York", group=t3_grp3)

t3_grp4 = "[T3] Lookback"
t3_lookbackBars = input.int(0, "Lookback (bars) — 0 = all loaded history. Set 480 for one day of 3m candles", minval=0, group=t3_grp4)

t3_grp5 = "[T3] Regime Colours"
t3_colPrime      = input.color(#c9a84c, "PRIME", group=t3_grp5)
t3_colFavourable = input.color(#00abff, "FAVOURABLE", group=t3_grp5)
t3_colMarginal   = input.color(#ff9800, "MARGINAL", group=t3_grp5)
t3_colDegraded   = input.color(#f23645, "DEGRADED", group=t3_grp5)

t3_grp6 = "[T3] Table"
t3_tableSize = input.string(size.normal, "Table Text Size", options=[size.tiny, size.small, size.normal], group=t3_grp6)

// === Volatility component (0-45) ===
t3_atrNow   = ta.atr(t3_atrLen)
t3_atrBase  = ta.sma(t3_atrNow, t3_atrBaseLen)
t3_volRatio = t3_atrBase == 0 ? 1.0 : t3_atrNow / t3_atrBase
t3_volDeviation = math.abs(t3_volRatio - 1.0)
t3_volScore = math.max(0.0, 45.0 - (t3_volDeviation * 90.0))

// === Trend-strength component (0-45) ===
[t3_diplus, t3_diminus, t3_adx] = ta.dmi(t3_adxLen, t3_adxSmooth)
t3_adxScore = t3_adx <= 40 ? math.min(45.0, (t3_adx / 40.0) * 45.0) : math.max(0.0, 45.0 - ((t3_adx - 40.0) * 1.5))

// === Composite Regime Score (0-90) + Grade ===
t3_regimeScore = t3_volScore + t3_adxScore
t3_grade = t3_regimeScore >= t3_primeMin ? "PRIME" : t3_regimeScore >= t3_favourableMin ? "FAVOURABLE" : t3_regimeScore >= t3_marginalMin ? "MARGINAL" : "DEGRADED"

// === Session membership (independent — sessions may overlap, e.g. London/NY) ===
t3_inAsia   = not na(time(timeframe.period, t3_asiaSession, "UTC"))
t3_inLondon = not na(time(timeframe.period, t3_londonSession, "UTC"))
t3_inNY     = not na(time(timeframe.period, t3_nySession, "UTC"))

// === Per-session, per-t3_grade bar masks ===
t3_sessionGradeMasks(_inSession, _grade) =>
    _p = _inSession and _grade == "PRIME" ? 1 : 0
    _f = _inSession and _grade == "FAVOURABLE" ? 1 : 0
    _m = _inSession and _grade == "MARGINAL" ? 1 : 0
    _d = _inSession and _grade == "DEGRADED" ? 1 : 0
    [_p, _f, _m, _d]

[t3_asiaP, t3_asiaF, t3_asiaM, t3_asiaD]       = t3_sessionGradeMasks(t3_inAsia, t3_grade)
[t3_londonP, t3_londonF, t3_londonM, t3_londonD] = t3_sessionGradeMasks(t3_inLondon, t3_grade)
[t3_nyP, t3_nyF, t3_nyM, t3_nyD]               = t3_sessionGradeMasks(t3_inNY, t3_grade)

// === Bounded rolling counts (ta.sma × length recovers a rolling sum — no ta.sum in Pine v6) ===
t3_useLookback = t3_lookbackBars > 0
t3_safeLen     = math.max(t3_lookbackBars, 1)

t3_rollSum(_src) => ta.sma(_src, t3_safeLen) * t3_safeLen

t3_asiaPCount = t3_rollSum(t3_asiaP)
t3_asiaFCount = t3_rollSum(t3_asiaF)
t3_asiaMCount = t3_rollSum(t3_asiaM)
t3_asiaDCount = t3_rollSum(t3_asiaD)

t3_londonPCount = t3_rollSum(t3_londonP)
t3_londonFCount = t3_rollSum(t3_londonF)
t3_londonMCount = t3_rollSum(t3_londonM)
t3_londonDCount = t3_rollSum(t3_londonD)

t3_nyPCount = t3_rollSum(t3_nyP)
t3_nyFCount = t3_rollSum(t3_nyF)
t3_nyMCount = t3_rollSum(t3_nyM)
t3_nyDCount = t3_rollSum(t3_nyD)

// === Dominant t3_grade + tradeable % (PRIME+FAVOURABLE share) per session ===
t3_dominant(_p, _f, _m, _d) =>
    _total = _p + _f + _m + _d
    _max = math.max(_p, math.max(_f, math.max(_m, _d)))
    _grade = _total == 0 ? "—" : _max == _p ? "PRIME" : _max == _f ? "FAVOURABLE" : _max == _m ? "MARGINAL" : "DEGRADED"
    _tradeablePct = _total == 0 ? 0.0 : ((_p + _f) / _total) * 100.0
    [_grade, _tradeablePct, _total]

[t3_asiaDominant, t3_asiaTradeable, t3_asiaTotal]     = t3_dominant(t3_asiaPCount, t3_asiaFCount, t3_asiaMCount, t3_asiaDCount)
[t3_londonDominant, t3_londonTradeable, t3_londonTotal] = t3_dominant(t3_londonPCount, t3_londonFCount, t3_londonMCount, t3_londonDCount)
[t3_nyDominant, t3_nyTradeable, t3_nyTotal]           = t3_dominant(t3_nyPCount, t3_nyFCount, t3_nyMCount, t3_nyDCount)

t3_gradeColorOf(_g) => _g == "PRIME" ? t3_colPrime : _g == "FAVOURABLE" ? t3_colFavourable : _g == "MARGINAL" ? t3_colMarginal : _g == "DEGRADED" ? t3_colDegraded : color.white

t3_headerLabel = t3_useLookback ? "SESSION REGIME REPORT (Last " + str.tostring(t3_lookbackBars) + ")" : "SESSION REGIME REPORT (All History)"

t3_currentSessionText = t3_inLondon and t3_inNY ? "London + NY" : t3_inLondon ? "London" : t3_inNY ? "New York" : t3_inAsia ? "Asia" : "None Active"

// === QP dark/gold dashboard theme ===
t3_bgHeader = color.new(#1a1a1a, 0)
t3_bgRow    = color.new(#0d0d0d, 10)
t3_txtMuted = color.new(color.white, 40)
t3_txtGold  = color.new(#c9a84c, 0)

// === Table — one table, bottom right (Dessert course convention) ===
var table t3_report = table.new(position.bottom_right, 4, 7, border_width=1)

if barstate.islast
    table.cell(t3_report, 0, 0, t3_headerLabel, text_color=t3_txtGold, bgcolor=t3_bgHeader, text_size=t3_tableSize)
    table.cell(t3_report, 1, 0, "", bgcolor=t3_bgHeader, text_size=t3_tableSize)
    table.cell(t3_report, 2, 0, "", bgcolor=t3_bgHeader, text_size=t3_tableSize)
    table.cell(t3_report, 3, 0, "", bgcolor=t3_bgHeader, text_size=t3_tableSize)

    table.cell(t3_report, 0, 1, "Dominant t3_grade per session. London/NY can overlap.", text_color=t3_txtMuted, bgcolor=t3_bgRow, text_size=size.tiny, width=0.16)
    table.cell(t3_report, 1, 1, "", bgcolor=t3_bgRow, text_size=t3_tableSize)
    table.cell(t3_report, 2, 1, "", bgcolor=t3_bgRow, text_size=t3_tableSize)
    table.cell(t3_report, 3, 1, "", bgcolor=t3_bgRow, text_size=t3_tableSize)

    table.cell(t3_report, 0, 2, "Session", text_color=t3_txtMuted, bgcolor=t3_bgRow, text_size=t3_tableSize)
    table.cell(t3_report, 1, 2, "Bars", text_color=t3_txtMuted, bgcolor=t3_bgRow, text_size=t3_tableSize)
    table.cell(t3_report, 2, 2, "Dominant", text_color=t3_txtMuted, bgcolor=t3_bgRow, text_size=t3_tableSize)
    table.cell(t3_report, 3, 2, "Tradeable%", text_color=t3_txtMuted, bgcolor=t3_bgRow, text_size=t3_tableSize)

    table.cell(t3_report, 0, 3, "Asia", text_color=color.white, bgcolor=t3_bgRow, text_size=t3_tableSize)
    table.cell(t3_report, 1, 3, str.tostring(t3_asiaTotal, "#"), text_color=t3_txtMuted, bgcolor=t3_bgRow, text_size=t3_tableSize)
    table.cell(t3_report, 2, 3, t3_asiaDominant, text_color=t3_gradeColorOf(t3_asiaDominant), bgcolor=t3_bgRow, text_size=t3_tableSize)
    table.cell(t3_report, 3, 3, str.tostring(t3_asiaTradeable, "#.#") + "%", text_color=color.white, bgcolor=t3_bgRow, text_size=t3_tableSize)

    table.cell(t3_report, 0, 4, "London", text_color=color.white, bgcolor=t3_bgRow, text_size=t3_tableSize)
    table.cell(t3_report, 1, 4, str.tostring(t3_londonTotal, "#"), text_color=t3_txtMuted, bgcolor=t3_bgRow, text_size=t3_tableSize)
    table.cell(t3_report, 2, 4, t3_londonDominant, text_color=t3_gradeColorOf(t3_londonDominant), bgcolor=t3_bgRow, text_size=t3_tableSize)
    table.cell(t3_report, 3, 4, str.tostring(t3_londonTradeable, "#.#") + "%", text_color=color.white, bgcolor=t3_bgRow, text_size=t3_tableSize)

    table.cell(t3_report, 0, 5, "New York", text_color=color.white, bgcolor=t3_bgRow, text_size=t3_tableSize)
    table.cell(t3_report, 1, 5, str.tostring(t3_nyTotal, "#"), text_color=t3_txtMuted, bgcolor=t3_bgRow, text_size=t3_tableSize)
    table.cell(t3_report, 2, 5, t3_nyDominant, text_color=t3_gradeColorOf(t3_nyDominant), bgcolor=t3_bgRow, text_size=t3_tableSize)
    table.cell(t3_report, 3, 5, str.tostring(t3_nyTradeable, "#.#") + "%", text_color=color.white, bgcolor=t3_bgRow, text_size=t3_tableSize)

    table.cell(t3_report, 0, 6, "Current Session", text_color=t3_txtMuted, bgcolor=t3_bgRow, text_size=t3_tableSize)
    table.cell(t3_report, 1, 6, t3_currentSessionText, text_color=t3_txtGold, bgcolor=t3_bgRow, text_size=t3_tableSize)
    table.cell(t3_report, 2, 6, "", bgcolor=t3_bgRow, text_size=t3_tableSize)
    table.cell(t3_report, 3, 6, "", bgcolor=t3_bgRow, text_size=t3_tableSize)

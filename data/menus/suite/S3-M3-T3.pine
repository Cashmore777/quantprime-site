//@version=6
indicator("Quant Prime — Suite [S3+M3+T3]", overlay=true)

// ============================================================
// S3 — Regime Change Marker
// ============================================================

// ============================================================
// COC-S3 — Regime Change Marker
// Suite Build menu · Starter course
// Draws no tables (per QP Build convention for Starter pieces)
// Uses the same regime-score formula as COC-S1 (kept standalone
// here since each piece must compile independently)
// ============================================================

s3_grp1 = "[S3] Regime Score"
s3_atrLen      = input.int(14, "ATR Length", group=s3_grp1)
s3_atrBaseLen  = input.int(100, "ATR Baseline Length", group=s3_grp1)
s3_adxLen      = input.int(14, "DMI Length", group=s3_grp1)
s3_adxSmooth   = input.int(14, "ADX Smoothing", group=s3_grp1)

s3_grp2 = "[S3] Grade Thresholds (0-90 scale)"
s3_primeMin      = input.int(68, "PRIME minimum", group=s3_grp2)
s3_favourableMin = input.int(45, "FAVOURABLE minimum", group=s3_grp2)
s3_marginalMin   = input.int(23, "MARGINAL minimum", group=s3_grp2)

s3_grp3 = "[S3] Marker"
s3_labelSize = input.string(size.small, "Label Size", options=[size.tiny, size.small, size.normal], group=s3_grp3)

s3_grp4 = "[S3] Regime Colours"
s3_colPrime      = input.color(#c9a84c, "PRIME", group=s3_grp4)
s3_colFavourable = input.color(#00abff, "FAVOURABLE", group=s3_grp4)
s3_colMarginal   = input.color(#ff9800, "MARGINAL", group=s3_grp4)
s3_colDegraded   = input.color(#f23645, "DEGRADED", group=s3_grp4)

s3_grp5 = "[S3] Label Spacing"
s3_offsetTiers = input.int(4, "Vertical Offset Tiers", minval=2, maxval=8, group=s3_grp5)
s3_offsetStep  = input.float(0.6, "Offset Step (x ATR per s3_tier)", minval=0.1, group=s3_grp5)
s3_baseOffset  = input.float(0.5, "Base Offset (x ATR)", minval=0.1, group=s3_grp5)

// === Volatility component (0-45) ===
s3_atrNow   = ta.atr(s3_atrLen)
s3_atrBase  = ta.sma(s3_atrNow, s3_atrBaseLen)
s3_volRatio = s3_atrBase == 0 ? 1.0 : s3_atrNow / s3_atrBase
s3_volDeviation = math.abs(s3_volRatio - 1.0)
s3_volScore = math.max(0.0, 45.0 - (s3_volDeviation * 90.0))

// === Trend-strength component (0-45) ===
[s3_diplus, s3_diminus, s3_adx] = ta.dmi(s3_adxLen, s3_adxSmooth)
s3_adxScore = s3_adx <= 40 ? math.min(45.0, (s3_adx / 40.0) * 45.0) : math.max(0.0, 45.0 - ((s3_adx - 40.0) * 1.5))

// === Composite Regime Score (0-90) + Grade ===
s3_regimeScore = s3_volScore + s3_adxScore

s3_grade = s3_regimeScore >= s3_primeMin ? "PRIME" : s3_regimeScore >= s3_favourableMin ? "FAVOURABLE" : s3_regimeScore >= s3_marginalMin ? "MARGINAL" : "DEGRADED"

s3_gradeColor = s3_regimeScore >= s3_primeMin ? s3_colPrime : s3_regimeScore >= s3_favourableMin ? s3_colFavourable : s3_regimeScore >= s3_marginalMin ? s3_colMarginal : s3_colDegraded

// === Marker on s3_grade shift only — vertical offset randomised per s3_tier,
// excluding whichever s3_tier was just used, so adjacent labels never stack ===
var string s3_prevGrade = na
s3_gradeShifted = not na(s3_prevGrade) and s3_grade != s3_prevGrade

var int s3_lastTier = -1
if s3_gradeShifted
    s3_randTier = int(math.random(0, s3_offsetTiers))
    s3_tier = s3_randTier == s3_lastTier ? (s3_randTier + 1) % s3_offsetTiers : s3_randTier
    s3_labelOffset = s3_baseOffset + (s3_tier * s3_offsetStep)
    label.new(bar_index, high + (s3_atrNow * s3_labelOffset), s3_grade, style=label.style_label_down, color=color.new(s3_gradeColor, 20), textcolor=color.white, size=s3_labelSize)
    s3_lastTier := s3_tier

s3_prevGrade := s3_grade

// ============================================================
// M3 — Session Regime Tracker
// ============================================================

// ============================================================
// COC-M3 — Session Regime Tracker
// Suite Build menu · Main course
// Draws one table, top-right (Main course convention — only one
// Main-course piece is ever active in a given Build combination)
// Live m3_tracker of how the m3_grade has moved through the CURRENT
// session so far, not a historical multi-session report (that's
// Dessert-course territory)
// ============================================================

m3_grp1 = "[M3] Regime Score"
m3_atrLen      = input.int(14, "ATR Length", group=m3_grp1)
m3_atrBaseLen  = input.int(100, "ATR Baseline Length", group=m3_grp1)
m3_adxLen      = input.int(14, "DMI Length", group=m3_grp1)
m3_adxSmooth   = input.int(14, "ADX Smoothing", group=m3_grp1)

m3_grp2 = "[M3] Grade Thresholds (0-90 scale)"
m3_primeMin      = input.int(68, "PRIME minimum", group=m3_grp2)
m3_favourableMin = input.int(45, "FAVOURABLE minimum", group=m3_grp2)
m3_marginalMin   = input.int(23, "MARGINAL minimum", group=m3_grp2)

m3_grp3 = "[M3] Session"
m3_sessionInput = input.session("0000-2400", "Session (UTC) — default resets daily at 00:00 UTC", group=m3_grp3)
m3_showSessionZone  = input.bool(true, "Highlight Session Zone", group=m3_grp3)
m3_sessionZoneColor = input.color(color.new(#c9a84c, 90), "Session Zone Colour", group=m3_grp3)

m3_grp4 = "[M3] Regime Colours"
m3_colPrime      = input.color(#c9a84c, "PRIME", group=m3_grp4)
m3_colFavourable = input.color(#00abff, "FAVOURABLE", group=m3_grp4)
m3_colMarginal   = input.color(#ff9800, "MARGINAL", group=m3_grp4)
m3_colDegraded   = input.color(#f23645, "DEGRADED", group=m3_grp4)

m3_grp5 = "[M3] Table"
m3_tableSize = input.string(size.small, "Table Text Size", options=[size.tiny, size.small, size.normal], group=m3_grp5)

// === Volatility component (0-45) ===
m3_atrNow   = ta.atr(m3_atrLen)
m3_atrBase  = ta.sma(m3_atrNow, m3_atrBaseLen)
m3_volRatio = m3_atrBase == 0 ? 1.0 : m3_atrNow / m3_atrBase
m3_volDeviation = math.abs(m3_volRatio - 1.0)
m3_volScore = math.max(0.0, 45.0 - (m3_volDeviation * 90.0))

// === Trend-strength component (0-45) ===
[m3_diplus, m3_diminus, m3_adx] = ta.dmi(m3_adxLen, m3_adxSmooth)
m3_adxScore = m3_adx <= 40 ? math.min(45.0, (m3_adx / 40.0) * 45.0) : math.max(0.0, 45.0 - ((m3_adx - 40.0) * 1.5))

// === Composite Regime Score (0-90) + Grade ===
m3_regimeScore = m3_volScore + m3_adxScore
m3_grade      = m3_regimeScore >= m3_primeMin ? "PRIME" : m3_regimeScore >= m3_favourableMin ? "FAVOURABLE" : m3_regimeScore >= m3_marginalMin ? "MARGINAL" : "DEGRADED"
m3_gradeColor = m3_regimeScore >= m3_primeMin ? m3_colPrime : m3_regimeScore >= m3_favourableMin ? m3_colFavourable : m3_regimeScore >= m3_marginalMin ? m3_colMarginal : m3_colDegraded

// === Session boundary detection (custom UTC session window, not just exchange session) ===
m3_inSession  = not na(time(timeframe.period, m3_sessionInput, "UTC"))
m3_newSession = m3_inSession and not m3_inSession[1]

// === Background shading over exactly the bars being graded ===
bgcolor(m3_showSessionZone and m3_inSession ? m3_sessionZoneColor : na, title="Session Zone")

// === Session tracking state ===
var float m3_openScore   = na
var string m3_openGrade  = na
var float m3_bestScore   = na
var float m3_worstScore  = na
var int m3_changeCount   = 0
var string m3_prevGrade  = na

if m3_newSession
    m3_openScore  := m3_regimeScore
    m3_openGrade  := m3_grade
    m3_bestScore  := m3_regimeScore
    m3_worstScore := m3_regimeScore
    m3_changeCount := 0
    m3_prevGrade  := m3_grade
else if m3_inSession
    m3_bestScore  := math.max(m3_bestScore, m3_regimeScore)
    m3_worstScore := math.min(m3_worstScore, m3_regimeScore)
    if not na(m3_prevGrade) and m3_grade != m3_prevGrade
        m3_changeCount := m3_changeCount + 1
    m3_prevGrade := m3_grade

m3_bestGrade  = na(m3_bestScore) ? na : (m3_bestScore >= m3_primeMin ? "PRIME" : m3_bestScore >= m3_favourableMin ? "FAVOURABLE" : m3_bestScore >= m3_marginalMin ? "MARGINAL" : "DEGRADED")
m3_worstGrade = na(m3_worstScore) ? na : (m3_worstScore >= m3_primeMin ? "PRIME" : m3_worstScore >= m3_favourableMin ? "FAVOURABLE" : m3_worstScore >= m3_marginalMin ? "MARGINAL" : "DEGRADED")
m3_bestColor  = na(m3_bestScore) ? color.white : (m3_bestScore >= m3_primeMin ? m3_colPrime : m3_bestScore >= m3_favourableMin ? m3_colFavourable : m3_bestScore >= m3_marginalMin ? m3_colMarginal : m3_colDegraded)
m3_worstColor = na(m3_worstScore) ? color.white : (m3_worstScore >= m3_primeMin ? m3_colPrime : m3_worstScore >= m3_favourableMin ? m3_colFavourable : m3_worstScore >= m3_marginalMin ? m3_colMarginal : m3_colDegraded)
m3_openColor  = na(m3_openScore) ? color.white : (m3_openScore >= m3_primeMin ? m3_colPrime : m3_openScore >= m3_favourableMin ? m3_colFavourable : m3_openScore >= m3_marginalMin ? m3_colMarginal : m3_colDegraded)

// === QP dark/gold dashboard theme ===
m3_bgHeader = color.new(#1a1a1a, 0)
m3_bgRow    = color.new(#0d0d0d, 10)
m3_txtMuted = color.new(color.white, 40)
m3_txtGold  = color.new(#c9a84c, 0)

// === Table — one table, top right ===
var table m3_tracker = table.new(position.top_right, 2, 6, border_width=1)

if barstate.islast
    table.cell(m3_tracker, 0, 0, "SESSION REGIME TRACKER", text_color=m3_txtGold, bgcolor=m3_bgHeader, text_size=m3_tableSize)
    table.cell(m3_tracker, 1, 0, "", bgcolor=m3_bgHeader, text_size=m3_tableSize)

    table.cell(m3_tracker, 0, 1, "Session Open", text_color=m3_txtMuted, bgcolor=m3_bgRow, text_size=m3_tableSize)
    table.cell(m3_tracker, 1, 1, na(m3_openGrade) ? "—" : m3_openGrade, text_color=m3_openColor, bgcolor=m3_bgRow, text_size=m3_tableSize)

    table.cell(m3_tracker, 0, 2, "Current", text_color=m3_txtMuted, bgcolor=m3_bgRow, text_size=m3_tableSize)
    table.cell(m3_tracker, 1, 2, m3_grade, text_color=m3_gradeColor, bgcolor=m3_bgRow, text_size=m3_tableSize)

    table.cell(m3_tracker, 0, 3, "Session Best", text_color=m3_txtMuted, bgcolor=m3_bgRow, text_size=m3_tableSize)
    table.cell(m3_tracker, 1, 3, na(m3_bestGrade) ? "—" : m3_bestGrade, text_color=m3_bestColor, bgcolor=m3_bgRow, text_size=m3_tableSize)

    table.cell(m3_tracker, 0, 4, "Session Worst", text_color=m3_txtMuted, bgcolor=m3_bgRow, text_size=m3_tableSize)
    table.cell(m3_tracker, 1, 4, na(m3_worstGrade) ? "—" : m3_worstGrade, text_color=m3_worstColor, bgcolor=m3_bgRow, text_size=m3_tableSize)

    table.cell(m3_tracker, 0, 5, "Grade Changes", text_color=m3_txtMuted, bgcolor=m3_bgRow, text_size=m3_tableSize)
    table.cell(m3_tracker, 1, 5, str.tostring(m3_changeCount), text_color=color.white, bgcolor=m3_bgRow, text_size=m3_tableSize)

// ============================================================
// T3 — Session Regime Report
// ============================================================

// ============================================================
// COC-T3 — Session Regime Report
// Suite Build menu · Dessert course
// Draws one table, bottom-right (Dessert course convention)
// Historical, bounded lookback — which of the three named
// sessions tends to produce which t3_grade most often. Last of
// the 12 Suite pieces.
// ============================================================

t3_grp1 = "[T3] Regime Score"
t3_atrLen      = input.int(14, "ATR Length", group=t3_grp1)
t3_atrBaseLen  = input.int(100, "ATR Baseline Length", group=t3_grp1)
t3_adxLen      = input.int(14, "DMI Length", group=t3_grp1)
t3_adxSmooth   = input.int(14, "ADX Smoothing", group=t3_grp1)

t3_grp2 = "[T3] Grade Thresholds (0-90 scale)"
t3_primeMin      = input.int(68, "PRIME minimum", group=t3_grp2)
t3_favourableMin = input.int(45, "FAVOURABLE minimum", group=t3_grp2)
t3_marginalMin   = input.int(23, "MARGINAL minimum", group=t3_grp2)

t3_grp3 = "[T3] Sessions (UTC)"
t3_asiaSession   = input.session("1900-0600", "Asia", group=t3_grp3)
t3_londonSession = input.session("0700-1200", "London", group=t3_grp3)
t3_nySession     = input.session("1200-1700", "New York", group=t3_grp3)

t3_grp4 = "[T3] Lookback"
t3_lookbackBars = input.int(0, "Lookback (bars) — 0 = all loaded history. Set 480 for one day of 3m candles", minval=0, group=t3_grp4)

t3_grp5 = "[T3] Regime Colours"
t3_colPrime      = input.color(#c9a84c, "PRIME", group=t3_grp5)
t3_colFavourable = input.color(#00abff, "FAVOURABLE", group=t3_grp5)
t3_colMarginal   = input.color(#ff9800, "MARGINAL", group=t3_grp5)
t3_colDegraded   = input.color(#f23645, "DEGRADED", group=t3_grp5)

t3_grp6 = "[T3] Table"
t3_tableSize = input.string(size.normal, "Table Text Size", options=[size.tiny, size.small, size.normal], group=t3_grp6)

// === Volatility component (0-45) ===
t3_atrNow   = ta.atr(t3_atrLen)
t3_atrBase  = ta.sma(t3_atrNow, t3_atrBaseLen)
t3_volRatio = t3_atrBase == 0 ? 1.0 : t3_atrNow / t3_atrBase
t3_volDeviation = math.abs(t3_volRatio - 1.0)
t3_volScore = math.max(0.0, 45.0 - (t3_volDeviation * 90.0))

// === Trend-strength component (0-45) ===
[t3_diplus, t3_diminus, t3_adx] = ta.dmi(t3_adxLen, t3_adxSmooth)
t3_adxScore = t3_adx <= 40 ? math.min(45.0, (t3_adx / 40.0) * 45.0) : math.max(0.0, 45.0 - ((t3_adx - 40.0) * 1.5))

// === Composite Regime Score (0-90) + Grade ===
t3_regimeScore = t3_volScore + t3_adxScore
t3_grade = t3_regimeScore >= t3_primeMin ? "PRIME" : t3_regimeScore >= t3_favourableMin ? "FAVOURABLE" : t3_regimeScore >= t3_marginalMin ? "MARGINAL" : "DEGRADED"

// === Session membership (independent — sessions may overlap, e.g. London/NY) ===
t3_inAsia   = not na(time(timeframe.period, t3_asiaSession, "UTC"))
t3_inLondon = not na(time(timeframe.period, t3_londonSession, "UTC"))
t3_inNY     = not na(time(timeframe.period, t3_nySession, "UTC"))

// === Per-session, per-t3_grade bar masks ===
t3_sessionGradeMasks(_inSession, _grade) =>
    _p = _inSession and _grade == "PRIME" ? 1 : 0
    _f = _inSession and _grade == "FAVOURABLE" ? 1 : 0
    _m = _inSession and _grade == "MARGINAL" ? 1 : 0
    _d = _inSession and _grade == "DEGRADED" ? 1 : 0
    [_p, _f, _m, _d]

[t3_asiaP, t3_asiaF, t3_asiaM, t3_asiaD]       = t3_sessionGradeMasks(t3_inAsia, t3_grade)
[t3_londonP, t3_londonF, t3_londonM, t3_londonD] = t3_sessionGradeMasks(t3_inLondon, t3_grade)
[t3_nyP, t3_nyF, t3_nyM, t3_nyD]               = t3_sessionGradeMasks(t3_inNY, t3_grade)

// === Bounded rolling counts (ta.sma × length recovers a rolling sum — no ta.sum in Pine v6) ===
t3_useLookback = t3_lookbackBars > 0
t3_safeLen     = math.max(t3_lookbackBars, 1)

t3_rollSum(_src) => ta.sma(_src, t3_safeLen) * t3_safeLen

t3_asiaPCount = t3_rollSum(t3_asiaP)
t3_asiaFCount = t3_rollSum(t3_asiaF)
t3_asiaMCount = t3_rollSum(t3_asiaM)
t3_asiaDCount = t3_rollSum(t3_asiaD)

t3_londonPCount = t3_rollSum(t3_londonP)
t3_londonFCount = t3_rollSum(t3_londonF)
t3_londonMCount = t3_rollSum(t3_londonM)
t3_londonDCount = t3_rollSum(t3_londonD)

t3_nyPCount = t3_rollSum(t3_nyP)
t3_nyFCount = t3_rollSum(t3_nyF)
t3_nyMCount = t3_rollSum(t3_nyM)
t3_nyDCount = t3_rollSum(t3_nyD)

// === Dominant t3_grade + tradeable % (PRIME+FAVOURABLE share) per session ===
t3_dominant(_p, _f, _m, _d) =>
    _total = _p + _f + _m + _d
    _max = math.max(_p, math.max(_f, math.max(_m, _d)))
    _grade = _total == 0 ? "—" : _max == _p ? "PRIME" : _max == _f ? "FAVOURABLE" : _max == _m ? "MARGINAL" : "DEGRADED"
    _tradeablePct = _total == 0 ? 0.0 : ((_p + _f) / _total) * 100.0
    [_grade, _tradeablePct, _total]

[t3_asiaDominant, t3_asiaTradeable, t3_asiaTotal]     = t3_dominant(t3_asiaPCount, t3_asiaFCount, t3_asiaMCount, t3_asiaDCount)
[t3_londonDominant, t3_londonTradeable, t3_londonTotal] = t3_dominant(t3_londonPCount, t3_londonFCount, t3_londonMCount, t3_londonDCount)
[t3_nyDominant, t3_nyTradeable, t3_nyTotal]           = t3_dominant(t3_nyPCount, t3_nyFCount, t3_nyMCount, t3_nyDCount)

t3_gradeColorOf(_g) => _g == "PRIME" ? t3_colPrime : _g == "FAVOURABLE" ? t3_colFavourable : _g == "MARGINAL" ? t3_colMarginal : _g == "DEGRADED" ? t3_colDegraded : color.white

t3_headerLabel = t3_useLookback ? "SESSION REGIME REPORT (Last " + str.tostring(t3_lookbackBars) + ")" : "SESSION REGIME REPORT (All History)"

t3_currentSessionText = t3_inLondon and t3_inNY ? "London + NY" : t3_inLondon ? "London" : t3_inNY ? "New York" : t3_inAsia ? "Asia" : "None Active"

// === QP dark/gold dashboard theme ===
t3_bgHeader = color.new(#1a1a1a, 0)
t3_bgRow    = color.new(#0d0d0d, 10)
t3_txtMuted = color.new(color.white, 40)
t3_txtGold  = color.new(#c9a84c, 0)

// === Table — one table, bottom right (Dessert course convention) ===
var table t3_report = table.new(position.bottom_right, 4, 7, border_width=1)

if barstate.islast
    table.cell(t3_report, 0, 0, t3_headerLabel, text_color=t3_txtGold, bgcolor=t3_bgHeader, text_size=t3_tableSize)
    table.cell(t3_report, 1, 0, "", bgcolor=t3_bgHeader, text_size=t3_tableSize)
    table.cell(t3_report, 2, 0, "", bgcolor=t3_bgHeader, text_size=t3_tableSize)
    table.cell(t3_report, 3, 0, "", bgcolor=t3_bgHeader, text_size=t3_tableSize)

    table.cell(t3_report, 0, 1, "Dominant t3_grade per session. London/NY can overlap.", text_color=t3_txtMuted, bgcolor=t3_bgRow, text_size=size.tiny, width=0.16)
    table.cell(t3_report, 1, 1, "", bgcolor=t3_bgRow, text_size=t3_tableSize)
    table.cell(t3_report, 2, 1, "", bgcolor=t3_bgRow, text_size=t3_tableSize)
    table.cell(t3_report, 3, 1, "", bgcolor=t3_bgRow, text_size=t3_tableSize)

    table.cell(t3_report, 0, 2, "Session", text_color=t3_txtMuted, bgcolor=t3_bgRow, text_size=t3_tableSize)
    table.cell(t3_report, 1, 2, "Bars", text_color=t3_txtMuted, bgcolor=t3_bgRow, text_size=t3_tableSize)
    table.cell(t3_report, 2, 2, "Dominant", text_color=t3_txtMuted, bgcolor=t3_bgRow, text_size=t3_tableSize)
    table.cell(t3_report, 3, 2, "Tradeable%", text_color=t3_txtMuted, bgcolor=t3_bgRow, text_size=t3_tableSize)

    table.cell(t3_report, 0, 3, "Asia", text_color=color.white, bgcolor=t3_bgRow, text_size=t3_tableSize)
    table.cell(t3_report, 1, 3, str.tostring(t3_asiaTotal, "#"), text_color=t3_txtMuted, bgcolor=t3_bgRow, text_size=t3_tableSize)
    table.cell(t3_report, 2, 3, t3_asiaDominant, text_color=t3_gradeColorOf(t3_asiaDominant), bgcolor=t3_bgRow, text_size=t3_tableSize)
    table.cell(t3_report, 3, 3, str.tostring(t3_asiaTradeable, "#.#") + "%", text_color=color.white, bgcolor=t3_bgRow, text_size=t3_tableSize)

    table.cell(t3_report, 0, 4, "London", text_color=color.white, bgcolor=t3_bgRow, text_size=t3_tableSize)
    table.cell(t3_report, 1, 4, str.tostring(t3_londonTotal, "#"), text_color=t3_txtMuted, bgcolor=t3_bgRow, text_size=t3_tableSize)
    table.cell(t3_report, 2, 4, t3_londonDominant, text_color=t3_gradeColorOf(t3_londonDominant), bgcolor=t3_bgRow, text_size=t3_tableSize)
    table.cell(t3_report, 3, 4, str.tostring(t3_londonTradeable, "#.#") + "%", text_color=color.white, bgcolor=t3_bgRow, text_size=t3_tableSize)

    table.cell(t3_report, 0, 5, "New York", text_color=color.white, bgcolor=t3_bgRow, text_size=t3_tableSize)
    table.cell(t3_report, 1, 5, str.tostring(t3_nyTotal, "#"), text_color=t3_txtMuted, bgcolor=t3_bgRow, text_size=t3_tableSize)
    table.cell(t3_report, 2, 5, t3_nyDominant, text_color=t3_gradeColorOf(t3_nyDominant), bgcolor=t3_bgRow, text_size=t3_tableSize)
    table.cell(t3_report, 3, 5, str.tostring(t3_nyTradeable, "#.#") + "%", text_color=color.white, bgcolor=t3_bgRow, text_size=t3_tableSize)

    table.cell(t3_report, 0, 6, "Current Session", text_color=t3_txtMuted, bgcolor=t3_bgRow, text_size=t3_tableSize)
    table.cell(t3_report, 1, 6, t3_currentSessionText, text_color=t3_txtGold, bgcolor=t3_bgRow, text_size=t3_tableSize)
    table.cell(t3_report, 2, 6, "", bgcolor=t3_bgRow, text_size=t3_tableSize)
    table.cell(t3_report, 3, 6, "", bgcolor=t3_bgRow, text_size=t3_tableSize)

  "courses": {
    "starter": {
      "name": "Starter",
      "question": "What's the regime?",
      "description": "Visual regime indicators",
      "position": 0,
      "dishes": {
        "1": {
          "id": "regime-score-ribbon",
          "code": "S1",
          "name": "Regime Score Ribbon",
          "description": "A colour-graded line plotted just below price, showing the current regime score (0-90) translated into PRIME/FAVOURABLE/MARGINAL/DEGRADED at a glance. Built from two components — how far current volatility sits from its own baseline, and how strong the underlying trend is — so the colour reflects genuine market conditions, not just price direction.",
          "shortDesc": "Visual regime grade line"
        },
        "2": {
          "id": "htf-bias-arrow",
          "code": "S2",
          "name": "HTF Bias Arrow",
          "description": "Flags a directional bias shift on a higher timeframe using a 4-EMA stack (8/26/80/233) — only fires when all four EMAs are cleanly aligned in one direction, not on a partial or crossed stack. A floating label sits ahead of price showing the current read, so you're not hunting for the last arrow.",
          "shortDesc": "Higher timeframe bias signals"
        },
        "3": {
          "id": "regime-change-marker",
          "code": "S3",
          "name": "Regime Change Marker",
          "description": "Drops a label the moment the regime grade actually shifts — PRIME to FAVOURABLE, MARGINAL to DEGRADED, whichever direction — so you can see exactly when conditions changed, not just what they are right now. Labels are spaced to avoid stacking on top of each other during choppy, fast-changing stretches.",
          "shortDesc": "Grade transition alerts"
        }
      }
    },
    "main": {
      "name": "Main",
      "question": "What's the score?",
      "description": "Core regime analysis",
      "position": 1,
      "dishes": {
        "1": {
          "id": "regime-scanner-table",
          "code": "M1",
          "name": "Regime Scanner Table",
          "description": "The core regime readout — current grade, composite score out of 90, and the volatility and trend sub-scores that make it up, all in one table. Shows you not just what the grade is, but why, so a PRIME reading built on strong volatility looks different from one built on strong trend.",
          "shortDesc": "Full regime breakdown"
        },
        "2": {
          "id": "multi-tf-regime-aggregator",
          "code": "M2",
          "name": "Multi-TF Regime Aggregator",
          "description": "Runs the regime score independently on three timeframes at once and shows whether they agree. A grade that holds on the 15m, 1H, and 4H simultaneously is a far sturdier read than one that only shows up on a single chart — the \"Tradeable\" row tells you how many of the three are currently FAVOURABLE or better.",
          "shortDesc": "Cross-timeframe alignment"
        },
        "3": {
          "id": "session-regime-tracker",
          "code": "M3",
          "name": "Session Regime Tracker",
          "description": "Tracks how the grade has moved since the session opened — where it started, where it is now, the best and worst grade seen, and how many times it's flipped. A session that's held PRIME the whole way through is a more trustworthy read than one that's flickered between grades a dozen times, even if both show PRIME right now.",
          "shortDesc": "Intra-session grade history"
        }
      }
    },
    "side": {
      "name": "Side",
      "question": "How confident?",
      "description": "Confidence and timing tools",
      "position": 2,
      "dishes": {
        "1": {
          "id": "regime-clock",
          "code": "D1",
          "name": "Regime Clock",
          "description": "A simple countdown to the next bar close — the point at which the regime score next recalculates — alongside the current grade, so you always know how fresh the reading in front of you actually is.",
          "shortDesc": "Next recalculation timer"
        },
        "2": {
          "id": "confidence-meter",
          "code": "D2",
          "name": "Confidence Meter",
          "description": "Checks whether the volatility and trend components underneath the grade actually agree with each other, and separately how much margin the score has before it would flip to a different grade. A PRIME reading with low agreement and a thin margin is a shakier signal than the headline grade alone would suggest.",
          "shortDesc": "Grade stability check"
        },
        "3": {
          "id": "regime-alert-panel",
          "code": "D3",
          "name": "Regime Alert Panel",
          "description": "A checklist of what's currently happening underneath the grade — volatility expanding or compressing, trend strengthening or weakening, extreme readings in either direction, and whether the grade just changed. State descriptions only, not trade signals.",
          "shortDesc": "Live condition flags"
        }
      }
    },
    "dessert": {
      "name": "Dessert",
      "question": "What does history say?",
      "description": "Historical regime analysis",
      "position": 3,
      "dishes": {
        "1": {
          "id": "regime-report",
          "code": "T1",
          "name": "Regime Report",
          "description": "A historical breakdown of how much time has actually been spent in each grade over a set lookback window, plus the current streak. Useful for sanity-checking whether PRIME conditions are common or rare on the instrument and timeframe you're trading.",
          "shortDesc": "Grade time distribution"
        },
        "2": {
          "id": "cross-tf-report",
          "code": "T2",
          "name": "Cross-TF Report",
          "description": "Tracks how often your three chosen timeframes call the exact same regime grade at once, not just similar readings, over a bounded lookback window. Full Agreement means all three match; Partial means two of three; None means all three disagree — a running record of how often your setup is genuinely aligned across scales.",
          "shortDesc": "Multi-TF agreement stats"
        },
        "3": {
          "id": "session-regime-report",
          "code": "T3",
          "name": "Session Regime Report",
          "description": "Breaks down which of the three major trading sessions — Asia, London, New York — tends to produce which grade most often, plus each session's \"tradeable\" rate. Sessions are tracked independently and can overlap, same as real market hours.",
          "shortDesc": "Session performance stats"
        }
      }
    }
  },
